</style>

<script>
  import {
    buildFrontierPlotModel,
    type FrontierPlotPoint,
  } from '../utils/frontier-chart';
  import {
    computeGroupSampleStats,
    computePairedValueBars,
    type AnalyzedRun,
    type FrontierViewMode,
    type PricingLens,
  } from '../utils/telemetry';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const usdFmt = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  const dataEl = document.getElementById('frontier-runs-data');
  const runs: AnalyzedRun[] = dataEl?.textContent
    ? (JSON.parse(dataEl.textContent) as AnalyzedRun[])
    : [];
  const runById = new Map(runs.map((r) => [r.id, r]));
  const groupStats = computeGroupSampleStats(runs);

  let activeLens: PricingLens = 'billed';
  let activeMode: FrontierViewMode = 'speed-7-of-7';
  let includePromos = false;
  let activeHighlight = '';
  let inspectedRunId: string | null = null;

  const workspace = document.getElementById('frontier-workspace');
  const actionTitle = document.getElementById('swd-action-title');
  const leadCopy = document.getElementById('swd-lead');
  const vfPicksGrid = document.getElementById('vf-picks-grid');
  const vfSvg = document.getElementById('vf-svg') as SVGSVGElement | null;
  const vfPairedLensPill = document.getElementById('vf-paired-lens-pill');
  const vfExecBars = document.getElementById('vf-exec-bars');
  const vfValueBars = document.getElementById('vf-value-bars');
  const vfPartialBars = document.getElementById('vf-partial-bars');
  const vfPromoBars = document.getElementById('vf-promo-bars');
  const vfInsBadge = document.getElementById('vf-ins-badge');
  const vfInsTitle = document.getElementById('vf-ins-title');
  const vfInsStats = document.getElementById('vf-ins-stats');
  const vfInsNote = document.getElementById('vf-ins-note');
  const vfInsLink = document.getElementById('vf-ins-link') as HTMLAnchorElement | null;
  const vfModeBtns = document.querySelectorAll<HTMLButtonElement>('[data-vf-mode]');
  const vfLensBtns = document.querySelectorAll<HTMLButtonElement>('[data-vf-lens]');
  const vfTogglePromos = document.getElementById('vf-toggle-promos') as HTMLInputElement | null;
  const statusRegion = document.getElementById('frontier-status');

  const highlightBanner = document.getElementById('highlight-banner');
  const hbTitle = document.getElementById('hb-title');
  const hbCaveat = document.getElementById('hb-caveat');
  const hbScopeModel = document.getElementById('hb-scope-model') as HTMLButtonElement | null;
  const hbScopeHarness = document.getElementById('hb-scope-harness') as HTMLButtonElement | null;
  const hbDossierLink = document.getElementById('hb-dossier-link') as HTMLAnchorElement | null;
  const hbClearBtn = document.getElementById('hb-clear-btn') as HTMLButtonElement | null;

  function formatDurShort(mins: number): string {
    if (mins < 60) return `${mins}m`;
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return m === 0 ? `${h}h` : `${h}h ${m}m`;
  }

  function formatLensLabel(lens: PricingLens): string {
    if (lens === 'standard') return 'Standard API';
    if (lens === 'uncached') return 'Uncached';
    return 'Billed';
  }

  function resolveHighlightedRunIds(raw: string): {
    ids: Set<string>;
    kind: 'none' | 'run' | 'model' | 'harness' | 'query';
    label: string;
    caveat: string;
    singleRun: AnalyzedRun | null;
  } {
    const val = raw.trim();
    if (!val) return { ids: new Set(), kind: 'none', label: '', caveat: '', singleRun: null };

    const exactRun = runById.get(val);
    if (exactRun) {
      const mStat = groupStats.byModel[exactRun.data.model];
      const hStat = groupStats.byHarness[exactRun.data.codingHarness];
      const parts: string[] = [];
      if (mStat) parts.push(`model n=${mStat.n}`);
      if (hStat) {
        parts.push(
          `harness ${exactRun.displayHarness} n=${hStat.n}${hStat.singlePeerCaveat ? ' (single-model caveat)' : ''}`
        );
      }
      if (exactRun.costMetrics.profile?.pricingBadge) {
        parts.push(exactRun.costMetrics.profile.pricingBadge);
      }
      return {
        ids: new Set([exactRun.id]),
        kind: 'run',
        label: `${exactRun.displayHarness} / ${exactRun.data.model}${exactRun.data.effort ? ` (${exactRun.data.effort})` : ''}`,
        caveat: parts.join(' · '),
        singleRun: exactRun,
      };
    }

    if (val.toLowerCase().startsWith('model:')) {
      const targetModel = val.slice(6).trim().toLowerCase();
      const matched = runs.filter((r) => r.data.model.toLowerCase() === targetModel);
      if (matched.length > 0) {
        const canonical = matched[0].data.model;
        const mStat = groupStats.byModel[canonical];
        return {
          ids: new Set(matched.map((r) => r.id)),
          kind: 'model',
          label: `Model: ${canonical}`,
          caveat: `n=${mStat?.n ?? matched.length} (${mStat?.fullPass ?? 0}/${matched.length} passed 7/7 · harnesses: ${mStat?.peers.join(', ') ?? ''})`,
          singleRun: matched.length === 1 ? matched[0] : null,
        };
      }
    }

    if (val.toLowerCase().startsWith('harness:')) {
      const targetHarness = val.slice(8).trim().toLowerCase();
      const matched = runs.filter(
        (r) =>
          r.data.codingHarness.toLowerCase() === targetHarness ||
          r.displayHarness.toLowerCase() === targetHarness
      );
      if (matched.length > 0) {
        const canonicalSlug = matched[0].data.codingHarness;
        const hStat = groupStats.byHarness[canonicalSlug];
        return {
          ids: new Set(matched.map((r) => r.id)),
          kind: 'harness',
          label: `Harness: ${matched[0].displayHarness}`,
          caveat: `n=${hStat?.n ?? matched.length} (${hStat?.fullPass ?? 0}/${matched.length} passed 7/7${hStat?.singlePeerCaveat ? ' · single-model harness' : ` · ${hStat?.peers.length ?? 0} models`})`,
          singleRun: matched.length === 1 ? matched[0] : null,
        };
      }
    }

    const lower = val.toLowerCase();
    const matched = runs.filter(
      (r) =>
        r.data.model.toLowerCase().includes(lower) ||
        r.displayHarness.toLowerCase() === lower ||
        r.data.codingHarness.toLowerCase() === lower
    );
    if (matched.length > 0) {
      return {
        ids: new Set(matched.map((r) => r.id)),
        kind: 'query',
        label: val,
        caveat: `n=${matched.length} matching runs`,
        singleRun: matched.length === 1 ? matched[0] : null,
      };
    }

    return { ids: new Set(), kind: 'none', label: '', caveat: '', singleRun: null };
  }

  function syncUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      if (activeLens !== 'billed') params.set('lens', activeLens);
      else params.delete('lens');

      if (activeMode !== 'speed-7-of-7') params.set('mode', activeMode);
      else params.delete('mode');

      if (includePromos) params.set('promos', '1');
      else params.delete('promos');

      if (activeHighlight) params.set('highlight', activeHighlight);
      else params.delete('highlight');

      const qs = params.toString();
      const nextUrl = `${window.location.pathname}${qs ? `?${qs}` : ''}${window.location.hash}`;
      if (nextUrl !== `${window.location.pathname}${window.location.search}${window.location.hash}`) {
        window.history.replaceState(null, '', nextUrl);
      }
    } catch {}
  }

  function hydrateFromUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      const lens = params.get('lens');
      const mode = params.get('mode');
      const promos = params.get('promos');
      const highlight = params.get('highlight');

      if (lens === 'billed' || lens === 'standard' || lens === 'uncached') activeLens = lens;
      if (mode === 'speed-7-of-7' || mode === 'all-outcomes') activeMode = mode;
      if (promos === '1') includePromos = true;
      if (highlight && highlight.trim()) {
        activeHighlight = highlight.trim();
        const resolved = resolveHighlightedRunIds(activeHighlight);
        if (resolved.singleRun) {
          inspectedRunId = resolved.singleRun.id;
          if (resolved.singleRun.plan.ratio < 1 && !mode) activeMode = 'all-outcomes';
          if (resolved.singleRun.data.costUsd <= 0 && !promos) includePromos = true;
        }
      }
    } catch {}
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(
    tag: K,
    attrs: Record<string, string | number> = {},
    text?: string
  ): SVGElementTagNameMap[K] {
    const el = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    if (text !== undefined) el.textContent = text;
    return el;
  }

  function updateHighlightBanner(resolved: ReturnType<typeof resolveHighlightedRunIds>) {
    const hasHl = resolved.ids.size > 0;
    if (!highlightBanner) return;
    highlightBanner.hidden = !hasHl;
    if (!hasHl) return;

    if (hbTitle) hbTitle.textContent = resolved.label;
    if (hbCaveat) hbCaveat.textContent = resolved.caveat;
    if (hbDossierLink) {
      if (resolved.singleRun) {
        hbDossierLink.hidden = false;
        hbDossierLink.href = `/runs/${resolved.singleRun.id}`;
      } else {
        hbDossierLink.hidden = true;
      }
    }
    if (hbScopeModel) {
      const sr = resolved.singleRun;
      const mStat = sr ? groupStats.byModel[sr.data.model] : null;
      if (sr && mStat && mStat.n > 1 && resolved.kind === 'run') {
        hbScopeModel.hidden = false;
        hbScopeModel.textContent = `All ${sr.data.model} (n=${mStat.n})`;
        hbScopeModel.dataset.targetHighlight = `model:${sr.data.model}`;
      } else {
        hbScopeModel.hidden = true;
      }
    }
    if (hbScopeHarness) {
      const sr = resolved.singleRun;
      const hStat = sr ? groupStats.byHarness[sr.data.codingHarness] : null;
      if (sr && hStat && hStat.n > 1 && resolved.kind === 'run') {
        hbScopeHarness.hidden = false;
        hbScopeHarness.textContent = `All ${sr.displayHarness} (n=${hStat.n})`;
        hbScopeHarness.dataset.targetHighlight = `harness:${sr.data.codingHarness}`;
      } else {
        hbScopeHarness.hidden = true;
      }
    }
  }

  function updateInspectorFromRun(runId: string) {
    const run = runById.get(runId);
    if (!run) return;
    inspectedRunId = runId;

    const plotModel = buildFrontierPlotModel(runs, {
      lens: activeLens,
      mode: activeMode,
      includeZeroCostPromos: includePromos,
      highlightedIds: resolveHighlightedRunIds(activeHighlight).ids,
    });
    const pt =
      plotModel.points.find((p) => p.id === runId) ??
      plotModel.hiddenPromoPoints.find((p) => p.id === runId);

    const lensCost =
      activeLens === 'standard'
        ? run.costMetrics.standardApiCostUsd
        : activeLens === 'uncached'
          ? run.costMetrics.uncachedCounterfactualCostUsd
          : run.data.costUsd;

    const isPromo = lensCost <= 0;
    const costPerStage =
      !isPromo && run.plan.completed > 0 ? usdFmt.format(lensCost / run.plan.completed) : null;

    if (vfInsBadge) {
      vfInsBadge.className = 'hl vf-inspector-badge';
      if (isPromo) {
        vfInsBadge.classList.add('hl-mint');
        vfInsBadge.textContent = '$0 Promo';
      } else if (pt?.isFrontier) {
        vfInsBadge.classList.add('hl-acid');
        vfInsBadge.textContent =
          pt.frontierOrder === 1
            ? 'Cheapest 7/7'
            : pt.frontierOrder === plotModel.frontier.frontierIds.length
              ? 'Fastest 7/7'
              : 'Balanced Pick';
      } else if (run.plan.ratio === 1) {
        vfInsBadge.classList.add('hl-sky');
        vfInsBadge.textContent = '7/7 Full Pass';
      } else {
        vfInsBadge.classList.add('hl-magenta');
        vfInsBadge.textContent = `${run.plan.completed}/${run.plan.total} Partial`;
      }
    }

    if (vfInsTitle) {
      vfInsTitle.textContent = `${run.displayHarness} / ${run.data.model} (${run.data.effort ?? 'Standard'})`;
    }
    if (vfInsStats) {
      const costSummary = isPromo
        ? '$0.00 (promo)'
        : `${usdFmt.format(lensCost)} (${costPerStage}/stage)`;
      const testsPart = run.data.tests ? ` · ${run.data.tests.passed}/${run.data.tests.total} tests` : '';
      vfInsStats.textContent = `${run.plan.completed}/${run.plan.total} stages · ${formatDurShort(run.data.durationMinutes)} · ${costSummary} · ${run.data.tokens?.total ?? '—'} tokens (${run.tokens.cacheHitRatePct}% cache)${testsPart}`;
    }
    if (vfInsNote) {
      const mStat = groupStats.byModel[run.data.model];
      const hStat = groupStats.byHarness[run.data.codingHarness];
      const notes: string[] = [];
      if (run.costMetrics.profile?.pricingStatusNote) {
        notes.push(run.costMetrics.profile.pricingStatusNote);
      }
      if (mStat && hStat) {
        notes.push(
          `Model n=${mStat.n} · Harness ${run.displayHarness} n=${hStat.n}${hStat.singlePeerCaveat ? ' (single-model harness — harness & model effects are confounded)' : ''}.`
        );
      }
      vfInsNote.textContent = notes.join(' ');
    }
    if (vfInsLink) vfInsLink.href = `/runs/${run.id}`;
  }

  function renderAll(announce?: string) {
    if (!vfSvg || runs.length === 0) return;

    const resolved = resolveHighlightedRunIds(activeHighlight);
    const hlIds = resolved.ids;
    const hasHl = hlIds.size > 0;
    updateHighlightBanner(resolved);

    vfModeBtns.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.vfMode === activeMode));
    });
    vfLensBtns.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.vfLens === activeLens));
    });
    if (vfTogglePromos) vfTogglePromos.checked = includePromos;

    const model = buildFrontierPlotModel(runs, {
      lens: activeLens,
      mode: activeMode,
      includeZeroCostPromos: includePromos,
      highlightedIds: hlIds,
    });

    const paidModel = buildFrontierPlotModel(runs, {
      lens: activeLens,
      mode: 'speed-7-of-7',
      includeZeroCostPromos: false,
    });

    // Dynamic SWD action title
    if (actionTitle && leadCopy) {
      const fIds = paidModel.frontier.frontierIds;
      const fastPt = paidModel.points.find((p) => p.id === fIds[fIds.length - 1]);
      const domCount = paidModel.points.length - fIds.length;
      if (activeMode === 'speed-7-of-7') {
        actionTitle.innerHTML = `Only ${fIds.length} paid runs set the pace.<br /><span class="muted">Spending past ${fastPt ? usdFmt.format(fastPt.lensCostUsd) : '$3.14'} (${formatLensLabel(activeLens)}) never bought more speed.</span>`;
        leadCopy.textContent = `Out of ${paidModel.points.length} paid runs that passed all 7 stages, ${fIds.length} define the real speed-vs-cost choices. The other ${domCount} cost more, took longer, or both.`;
      } else {
        actionTitle.innerHTML = `${model.frontier.thresholds.totalFullPassCount} of ${runs.length} runs cleared all 7 stages.<br /><span class="muted">${model.frontier.thresholds.partialCount} stopped short—mostly on the final Ctrl-C / shutdown stage.</span>`;
        leadCopy.textContent = `Top band shows 7/7 full passes (faster sits higher); everything below the dashed line missed one or more holdout stages.`;
      }
    }

    // Update 3 pick cards for active pricing lens
    if (vfPicksGrid) {
      const fIds = paidModel.frontier.frontierIds;
      const pickMap: Record<string, string | undefined> = {
        budget: fIds[0],
        balanced: fIds.length >= 3 ? fIds[Math.floor(fIds.length / 2)] : fIds[1] ?? fIds[0],
        fastest: fIds[fIds.length - 1],
      };
      vfPicksGrid.querySelectorAll<HTMLButtonElement>('.pick-card').forEach((card) => {
        const key = card.dataset.pickKey ?? '';
        const rid = pickMap[key];
        const pt = paidModel.points.find((p) => p.id === rid);
        if (!pt) return;
        card.dataset.vfRun = pt.id;
        card.setAttribute('aria-pressed', String(hasHl && hlIds.has(pt.id)));
        const big = card.querySelector('.pick-metric-big');
        if (big) big.textContent = usdFmt.format(pt.lensCostUsd);
      });
    }

    const gridLayer = vfSvg.querySelector('#vf-layer-grid');
    const quadLayer = vfSvg.querySelector('#vf-layer-quadrants');
    const axesLayer = vfSvg.querySelector('#vf-layer-axes');
    const annLayer = vfSvg.querySelector('#vf-layer-annotations');
    const labelsLayer = vfSvg.querySelector('#vf-layer-labels');
    const pointsLayer = vfSvg.querySelector('#vf-layer-points');

    // Minimal tick marks only (no noisy gridlines)
    if (gridLayer) {
      gridLayer.replaceChildren();
      if (model.includeZeroCostPromos && model.promoBreakX !== null && model.promoGutterCenter !== null) {
        gridLayer.append(
          svgEl('line', {
            x1: model.promoBreakX,
            y1: model.padT,
            x2: model.promoBreakX,
            y2: model.height - model.padB,
            class: 'vf-promo-break',
          }),
          svgEl(
            'text',
            {
              x: model.promoGutterCenter,
              y: model.height - model.padB + 22,
              'text-anchor': 'middle',
              class: 'vf-axis-label',
            },
            '$0 promo'
          )
        );
      }

      for (const t of model.yTicks) {
        gridLayer.append(
          svgEl('line', {
            x1: model.padL - 5,
            y1: t.pos,
            x2: model.padL,
            y2: t.pos,
            class: 'vf-tick-mark',
          }),
          svgEl(
            'text',
            {
              x: model.padL - 10,
              y: t.pos + 4,
              'text-anchor': 'end',
              class: 'vf-axis-label',
            },
            t.label
          )
        );
      }

      for (const t of model.xTicks) {
        gridLayer.append(
          svgEl('line', {
            x1: t.pos,
            y1: model.height - model.padB,
            x2: t.pos,
            y2: model.height - model.padB + 5,
            class: 'vf-tick-mark',
          }),
          svgEl(
            'text',
            {
              x: t.pos,
              y: model.height - model.padB + 22,
              'text-anchor': 'middle',
              class: 'vf-axis-label',
            },
            t.label
          )
        );
      }
    }

    if (quadLayer) {
      quadLayer.replaceChildren();
      if (model.passGateY !== null) {
        quadLayer.append(
          svgEl('line', {
            x1: model.padL,
            y1: model.passGateY,
            x2: model.width - model.padR,
            y2: model.passGateY,
            class: 'vf-pass-gate-line',
          }),
          svgEl(
            'text',
            {
              x: model.width - model.padR - 4,
              y: model.passGateY - 6,
              'text-anchor': 'end',
              class: 'vf-gray-callout',
            },
            '7/7 pass gate'
          )
        );
      }
    }

    if (axesLayer) {
      const idealHint = axesLayer.querySelector('#vf-ideal-hint');
      if (idealHint) {
        idealHint.setAttribute('x', String(model.paidXStart + 12));
        idealHint.textContent =
          model.mode === 'speed-7-of-7' ? '↖ Faster & cheaper' : '↖ 7/7 & cheaper';
      }
      const xTitle = axesLayer.querySelector('#vf-x-axis-title');
      if (xTitle) {
        xTitle.setAttribute('x', String((model.paidXStart + model.width - model.padR) / 2));
        xTitle.textContent = `Cost per run (USD, log scale · ${formatLensLabel(activeLens)})`;
      }
      const yTitle = axesLayer.querySelector('#vf-y-axis-title');
      if (yTitle) {
        yTitle.textContent =
          model.mode === 'speed-7-of-7' ? 'Time (faster ↑)' : 'Stages passed (7/7 top)';
      }
    }

    // One quiet direct annotation explaining the gray dots (SWD: replace legend with inline callout)
    if (annLayer) {
      annLayer.replaceChildren();
      if (model.mode === 'speed-7-of-7' && !hasHl) {
        const grayCount = model.points.filter((p) => !p.isFrontier && !p.isZeroCostPromo).length;
        if (grayCount > 0) {
          annLayer.append(
            svgEl(
              'text',
              {
                x: model.width - model.padR - 8,
                y: model.height - model.padB - 14,
                'text-anchor': 'end',
                class: 'vf-gray-callout',
              },
              `Gray dots (${grayCount} runs): slower & pricier than a highlighted pick — hover any dot`
            )
          );
        }
      }
    }

    const pointById = new Map<string, FrontierPlotPoint>(model.points.map((p) => [p.id, p]));
    const fCount = model.frontier.frontierIds.length;

    if (labelsLayer) {
      labelsLayer.replaceChildren();
      for (const lbl of model.labels) {
        const pt = pointById.get(lbl.id);
        if (!pt) continue;
        // In SWD mode, skip non-frontier anchor labels unless highlighted or promo
        if (!pt.isFrontier && !pt.inPromoGutter && !hlIds.has(pt.id)) continue;

        const isMatch = hasHl && hlIds.has(lbl.id);
        const grp = svgEl('g', {
          class: `vf-label-group${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`,
          'data-label-for': lbl.id,
        });
        if (lbl.needsLeader) {
          grp.append(
            svgEl('line', {
              x1: pt.cx,
              y1: pt.cy,
              x2: lbl.x,
              y2: lbl.y - 4,
              class: 'vf-leader',
            })
          );
        }
        const roleTag = pt.isFrontier
          ? pt.frontierOrder === 1
            ? 'Cheapest'
            : pt.frontierOrder === fCount
              ? 'Fastest'
              : 'Balanced'
          : '';
        const primaryText = roleTag ? `${roleTag}: ${pt.model}` : pt.shortLabel;
        const subText = `${pt.harness} · ${pt.isZeroCostPromo ? '$0' : usdFmt.format(pt.lensCostUsd)} · ${formatDurShort(pt.durationMinutes)}`;

        grp.append(
          svgEl(
            'text',
            {
              x: lbl.x,
              y: lbl.y,
              'text-anchor': lbl.anchor,
              class: `vf-node-label${pt.isFrontier ? ' is-frontier' : ''}`,
            },
            primaryText
          ),
          svgEl(
            'text',
            {
              x: lbl.x,
              y: lbl.y + 14,
              'text-anchor': lbl.anchor,
              class: 'vf-label-sub',
            },
            subText
          )
        );
        labelsLayer.append(grp);
      }
    }

    if (pointsLayer) {
      pointsLayer.replaceChildren();
      // Draw gray peers first, then highlighted / frontier winners on top
      const orderedPts = [...model.points].sort((a, b) => {
        const pa = (hlIds.has(a.id) ? 2 : 0) + (a.isFrontier ? 1 : 0);
        const pb = (hlIds.has(b.id) ? 2 : 0) + (b.isFrontier ? 1 : 0);
        return pa - pb;
      });

      for (const pt of orderedPts) {
        const isMatch = hasHl && hlIds.has(pt.id);
        const cls = [
          'vf-point',
          pt.isFrontier ? 'is-frontier' : '',
          !pt.isFullPass ? 'is-partial' : '',
          pt.isZeroCostPromo ? 'is-promo' : '',
          isMatch ? 'is-highlighted' : '',
          hasHl && !isMatch ? 'is-dimmed' : '',
        ]
          .filter(Boolean)
          .join(' ');

        const g = svgEl('g', {
          class: cls,
          role: 'button',
          tabindex: '0',
          'data-vf-run': pt.id,
          'aria-pressed': String(isMatch),
          'aria-label': `${pt.harness} / ${pt.model}: ${pt.completed}/${pt.total} stages, ${pt.durationMinutes}m, ${usdFmt.format(pt.lensCostUsd)}`,
        });

        g.append(svgEl('circle', { cx: pt.cx, cy: pt.cy, r: 16, class: 'vf-hit-target' }));
        if (pt.isZeroCostPromo) {
          g.append(
            svgEl('polygon', {
              points: `${pt.cx},${pt.cy - 8} ${pt.cx + 8},${pt.cy + 6} ${pt.cx - 8},${pt.cy + 6}`,
              class: 'vf-marker-promo',
            })
          );
        } else if (pt.isFrontier) {
          g.append(
            svgEl('circle', {
              cx: pt.cx,
              cy: pt.cy,
              r: 9,
              class: 'vf-marker-frontier',
            })
          );
        } else if (!pt.isFullPass) {
          g.append(
            svgEl('circle', {
              cx: pt.cx,
              cy: pt.cy,
              r: 5.5,
              class: 'vf-marker-partial',
            })
          );
        } else {
          g.append(
            svgEl('circle', {
              cx: pt.cx,
              cy: pt.cy,
              r: 5.5,
              class: 'vf-marker-peer',
            })
          );
        }

        pointsLayer.append(g);
      }
    }

    // Paired Paid 7/7 Bars
    const bars = computePairedValueBars(runs, activeLens);
    const paid7Exec = bars.executionRows.filter((r) => r.isFullPass && !r.isZeroCostPromo);
    const paid7Val = bars.paidValueRows.filter((r) => r.isFullPass);
    const partialList = bars.executionRows.filter((r) => !r.isFullPass);

    if (vfPairedLensPill) vfPairedLensPill.textContent = `Lens: ${formatLensLabel(activeLens)}`;

    if (vfExecBars) {
      vfExecBars.replaceChildren();
      paid7Exec.forEach((item) => {
        const isMatch = hasHl && hlIds.has(item.id);
        const accent = hasHl ? isMatch : item.isPaidFrontier;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${item.isPaidFrontier ? ' is-frontier' : ''}${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="vf-bar-label">
              <strong>${item.model}</strong>
              <span class="vf-bar-harness">${item.harness}</span>
            </span>
            <span class="mono vf-bar-val">${formatDurShort(item.durationMinutes)}</span>
          </div>
          <div class="vf-bar-track" aria-hidden="true">
            <span class="vf-bar-fill${accent ? ' is-accent' : ''}" style="inline-size: ${item.executionBarPct}%"></span>
          </div>
        `;
        vfExecBars.append(btn);
      });
    }

    if (vfValueBars) {
      vfValueBars.replaceChildren();
      paid7Val.forEach((item, idx) => {
        const speedIdx = paid7Exec.findIndex((r) => r.id === item.id);
        const shift = speedIdx !== -1 ? speedIdx - idx : 0;
        const isMatch = hasHl && hlIds.has(item.id);
        const accent = hasHl ? isMatch : item.isPaidFrontier;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${item.isPaidFrontier ? ' is-frontier' : ''}${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="vf-bar-label">
              <strong>${item.model}</strong>
              <span class="vf-bar-harness">${item.harness}</span>
            </span>
            <span class="mono vf-bar-val">
              ${usdFmt.format(item.lensCostUsd)}
              ${shift >= 3 ? `<span class="vf-delta is-up">↑+${shift}</span>` : ''}
            </span>
          </div>
          <div class="vf-bar-track" aria-hidden="true">
            <span class="vf-bar-fill${accent ? ' is-accent' : ''}" style="inline-size: ${item.valueBarPct ?? 14}%"></span>
          </div>
        `;
        vfValueBars.append(btn);
      });
    }

    if (vfPartialBars) {
      vfPartialBars.replaceChildren();
      partialList.forEach((item) => {
        const isMatch = hasHl && hlIds.has(item.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="vf-bar-label">
              <span class="mono vf-stage-tag">${item.completed}/7</span>
              <strong>${item.model}</strong>
              <span class="vf-bar-harness">${item.harness}</span>
              ${item.isOffPeak ? '<span class="mono vf-tag-offpeak">off-peak</span>' : ''}
            </span>
            <span class="mono vf-bar-val">${formatDurShort(item.durationMinutes)} · ${usdFmt.format(item.lensCostUsd)}</span>
          </div>
        `;
        vfPartialBars.append(btn);
      });
    }

    if (vfPromoBars) {
      vfPromoBars.replaceChildren();
      bars.promoRows.forEach((item) => {
        const isMatch = hasHl && hlIds.has(item.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="vf-bar-label">
              <span class="mono vf-stage-tag">${item.completed}/7</span>
              <strong>${item.model}</strong>
              <span class="vf-bar-harness">${item.harness}</span>
              <span class="mono vf-tag-promo">free (limited time)</span>
            </span>
            <span class="mono vf-bar-val">${formatDurShort(item.durationMinutes)} · $0.00</span>
          </div>
        `;
        vfPromoBars.append(btn);
      });
    }

    const defaultId =
      (inspectedRunId && runById.has(inspectedRunId) ? inspectedRunId : null) ??
      model.frontier.frontierIds[Math.floor(model.frontier.frontierIds.length / 2)] ??
      model.points[0]?.id;
    if (defaultId) updateInspectorFromRun(defaultId);

    syncUrlState();
    if (announce && statusRegion) statusRegion.textContent = announce;
  }

  function toggleHighlight(nextVal: string) {
    activeHighlight = activeHighlight === nextVal ? '' : nextVal;
    const resolved = resolveHighlightedRunIds(activeHighlight);
    if (resolved.singleRun) {
      inspectedRunId = resolved.singleRun.id;
      if (resolved.singleRun.plan.ratio < 1 && activeMode !== 'all-outcomes') activeMode = 'all-outcomes';
      if (resolved.singleRun.data.costUsd <= 0 && !includePromos) includePromos = true;
    }
    renderAll(activeHighlight ? `Focused ${resolved.label}` : 'Cleared highlight');
  }

  vfModeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextMode = btn.dataset.vfMode as FrontierViewMode | undefined;
      if (!nextMode || nextMode === activeMode) return;
      activeMode = nextMode;
      renderAll();
    });
  });

  vfLensBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextLens = btn.dataset.vfLens as PricingLens | undefined;
      if (!nextLens || nextLens === activeLens) return;
      activeLens = nextLens;
      renderAll();
    });
  });

  vfTogglePromos?.addEventListener('change', () => {
    includePromos = Boolean(vfTogglePromos.checked);
    renderAll();
  });

  // Focusgroup roving-tabindex fallback for browsers without native focusgroup
  const vfToolbar = document.querySelector<HTMLElement>('.vf-toolbar[role="toolbar"]');
  if (vfToolbar && !('focusGroup' in HTMLElement.prototype)) {
    const items = Array.from(vfToolbar.querySelectorAll<HTMLButtonElement>('button'));
    items.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
    });
    vfToolbar.addEventListener('focusin', (e) => {
      const target = e.target as HTMLButtonElement | null;
      if (target && items.includes(target)) {
        items.forEach((b) => {
          b.tabIndex = b === target ? 0 : -1;
        });
      }
    });
    vfToolbar.addEventListener('keydown', (e) => {
      const current = document.activeElement as HTMLButtonElement | null;
      const idx = current ? items.indexOf(current) : -1;
      if (idx === -1) return;
      const rtl = getComputedStyle(vfToolbar).direction === 'rtl';
      let nextIdx: number | null = null;
      if (e.key === 'ArrowRight') nextIdx = (idx + (rtl ? -1 : 1) + items.length) % items.length;
      else if (e.key === 'ArrowLeft') nextIdx = (idx + (rtl ? 1 : -1) + items.length) % items.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = items.length - 1;
      if (nextIdx !== null) {
        e.preventDefault();
        items[nextIdx].focus();
      }
    });
  }

  workspace?.addEventListener('mouseover', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) updateInspectorFromRun(runId);
  });

  workspace?.addEventListener('focusin', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) updateInspectorFromRun(runId);
  });

  workspace?.addEventListener('click', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) toggleHighlight(runId);
  });

  vfSvg?.addEventListener('keydown', (e) => {
    const pt = (e.target as Element | null)?.closest<SVGElement>('.vf-point[data-vf-run]');
    const runId = pt?.getAttribute('data-vf-run');
    if (!runId) return;
    if (e.key === 'Enter') {
      e.preventDefault();
      toggleHighlight(runId);
    } else if (e.key === ' ') {
      e.preventDefault();
    }
  });

  vfSvg?.addEventListener('keyup', (e) => {
    if (e.key !== ' ') return;
    const pt = (e.target as Element | null)?.closest<SVGElement>('.vf-point[data-vf-run]');
    const runId = pt?.getAttribute('data-vf-run');
    if (runId) {
      e.preventDefault();
      toggleHighlight(runId);
    }
  });

  hbScopeModel?.addEventListener('click', () => {
    const target = hbScopeModel.dataset.targetHighlight;
    if (target) {
      activeHighlight = target;
      renderAll();
    }
  });
  hbScopeHarness?.addEventListener('click', () => {
    const target = hbScopeHarness.dataset.targetHighlight;
    if (target) {
      activeHighlight = target;
      renderAll();
    }
  });
  hbClearBtn?.addEventListener('click', () => {
    activeHighlight = '';
    renderAll('Cleared highlight');
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && activeHighlight) {
      activeHighlight = '';
      renderAll('Cleared highlight');
    }
  });

  hydrateFromUrlState();
  renderAll();
</script>
