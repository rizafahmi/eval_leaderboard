---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDuration, formatCost } from "../utils/format";
import {
	analyzeAndRankRuns,
	computeGroupSampleStats,
	computePairedValueBars,
	type AnalyzedRun,
} from "../utils/telemetry";
import {
	buildFrontierPlotModel,
	formatShortCostTick,
} from "../utils/frontier-chart";

const allRuns = await getCollection(
	"runs",
	({ data }) => data.published !== false,
);
const analyzedRuns = analyzeAndRankRuns(
	allRuns.map((entry) => ({ id: entry.id, data: entry.data })),
);

const initialPlotModel = buildFrontierPlotModel(analyzedRuns, {
	lens: "billed",
	mode: "speed-7-of-7",
	includeZeroCostPromos: false,
});
const initialPairedBars = computePairedValueBars(analyzedRuns, "billed");
const groupSampleStats = computeGroupSampleStats(analyzedRuns);

const paid7of7Exec = initialPairedBars.executionRows.filter(
	(r) => r.isFullPass && !r.isZeroCostPromo,
);
const paid7of7Value = initialPairedBars.paidValueRows.filter(
	(r) => r.isFullPass,
);
const partialRows = initialPairedBars.executionRows.filter((r) => !r.isFullPass);

const frontierIds = initialPlotModel.frontier.frontierIds;
const cheapestId = frontierIds[0];
const fastestId = frontierIds[frontierIds.length - 1];
const balancedId =
	frontierIds.length >= 3
		? frontierIds[Math.floor(frontierIds.length / 2)]
		: frontierIds[1] ?? cheapestId;

const fastestPt = initialPlotModel.points.find((p) => p.id === fastestId);
const dominatedCount =
	initialPlotModel.points.length - initialPlotModel.frontier.frontierIds.length;

const pickSpecs = [
	{
		key: "budget",
		badge: "Cheapest 7/7",
		headline: "Lowest paid cost for a full pass",
		runId: cheapestId,
	},
	{
		key: "balanced",
		badge: "Balanced Pick",
		headline: "Fast and under $2",
		runId: balancedId,
	},
	{
		key: "fastest",
		badge: "Fastest 7/7",
		headline: "Shortest wall-clock time",
		runId: fastestId,
	},
]
	.map((spec) => {
		const pt = initialPlotModel.points.find((p) => p.id === spec.runId);
		if (!pt) return null;
		const hStat = groupSampleStats.byHarness[pt.harnessSlug];
		return {
			...spec,
			pt,
			caveat: hStat?.singlePeerCaveat
				? `n=${hStat.n} (single-model harness)`
				: `n=${hStat?.n ?? 1} on ${pt.harness}`,
		};
	})
	.filter((x): x is NonNullable<typeof x> => Boolean(x));

const firstPt =
	initialPlotModel.points.find((p) => p.id === balancedId) ??
	initialPlotModel.points[0];
const firstModelStat = firstPt ? groupSampleStats.byModel[firstPt.model] : null;
const firstHarnessStat = firstPt
	? groupSampleStats.byHarness[firstPt.harnessSlug]
	: null;

const clientAnalyzedRunsPayload = analyzedRuns.map((r: AnalyzedRun) => ({
	id: r.id,
	data: {
		timestamp: r.data.timestamp,
		codingHarness: r.data.codingHarness,
		model: r.data.model,
		effort: r.data.effort,
		provider: r.data.provider,
		durationMinutes: r.data.durationMinutes,
		costUsd: r.data.costUsd,
		tests: r.data.tests
			? { passed: r.data.tests.passed, total: r.data.tests.total }
			: undefined,
		planCompletion: r.data.planCompletion,
		tokens: r.data.tokens
			? { total: r.data.tokens.total, cacheHitRate: r.data.tokens.cacheHitRate }
			: undefined,
	},
	displayHarness: r.displayHarness,
	displayProvider: r.displayProvider,
	plan: r.plan,
	tokens: r.tokens,
	costMetrics: {
		billedCostUsd: r.costMetrics.billedCostUsd,
		standardApiCostUsd: r.costMetrics.standardApiCostUsd,
		uncachedCounterfactualCostUsd: r.costMetrics.uncachedCounterfactualCostUsd,
		cacheSavingsUsd: r.costMetrics.cacheSavingsUsd,
		cacheSavingsPct: r.costMetrics.cacheSavingsPct,
		comparisonCostUsd: r.costMetrics.comparisonCostUsd,
		comparisonLabel: r.costMetrics.comparisonLabel,
		profile: r.costMetrics.profile
			? {
					pricingBadge: r.costMetrics.profile.pricingBadge,
					pricingStatusNote: r.costMetrics.profile.pricingStatusNote,
				}
			: null,
	},
}));
---

<BaseLayout
  title="Which Model Fits Your Workflow?"
  description="Decluttered, story-first view of Capy Bench speed, cost, and value tradeoffs across all published runs."
  activeNav="frontier"
>
  <div class="swd-page" id="frontier-workspace">
    <!-- ACTION-TITLE HEADER (SWD: lead with the takeaway) -->
    <header class="swd-header">
      <p class="swd-kicker">
        <a href="/">← Leaderboard</a>
        <span aria-hidden="true">·</span>
        <span>{analyzedRuns.length} published runs</span>
      </p>
      <h1 class="headline-two-tone" id="swd-action-title">
        Only {frontierIds.length} paid runs set the pace.<br />
        <span class="muted">
          Spending past {fastestPt ? formatCost(fastestPt.lensCostUsd) : '$3.14'} never bought more speed.
        </span>
      </h1>
      <p class="swd-lead" id="swd-lead">
        Out of {initialPlotModel.points.length} paid runs that passed all 7 stages, {frontierIds.length} define the real speed-vs-cost choices. The other {dominatedCount} cost more, took longer, or both.
      </p>
    </header>

    <!-- 3 SIMPLE PICKS (Answers "Which model is suitable for me?") -->
    <section class="swd-picks" aria-label="Three frontier picks by priority">
      <div class="picks-grid" id="vf-picks-grid">
        {pickSpecs.map((pick) => (
          <button
            type="button"
            class="pick-card"
            data-vf-run={pick.pt.id}
            data-pick-key={pick.key}
            aria-pressed="false"
          >
            <div class="pick-card-top">
              <span class="hl hl-acid">{pick.badge}</span>
              <span class="mono pick-card-caveat">{pick.caveat}</span>
            </div>
            <strong class="pick-card-name">{pick.pt.model}</strong>
            <span class="pick-card-harness">via {pick.pt.harness}</span>
            <div class="mono pick-card-metrics">
              <span class="pick-metric-big">{formatCost(pick.pt.lensCostUsd)}</span>
              <span aria-hidden="true">·</span>
              <span>{formatDuration(pick.pt.durationMinutes)}</span>
            </div>
            <p class="pick-card-why">{pick.headline}</p>
          </button>
        ))}
      </div>
    </section>

    <!-- ACTIVE FOCUS STRIP -->
    <div
      id="highlight-banner"
      class="highlight-banner"
      role="region"
      aria-label="Focused run"
      hidden
    >
      <div class="highlight-banner-main">
        <span class="hl hl-acid">Focused</span>
        <strong id="hb-title" class="highlight-banner-title"></strong>
        <span id="hb-caveat" class="mono highlight-banner-caveat"></span>
      </div>
      <div class="highlight-banner-actions">
        <button type="button" id="hb-scope-model" class="btn btn-sm btn-secondary" hidden></button>
        <button type="button" id="hb-scope-harness" class="btn btn-sm btn-secondary" hidden></button>
        <a id="hb-dossier-link" href="/" class="btn btn-sm btn-secondary" hidden>Read dossier →</a>
        <button type="button" id="hb-clear-btn" class="btn btn-sm btn-secondary">Clear (Esc)</button>
      </div>
    </div>

    <!-- DECLUTTERED SCATTER STORY (SWD: gray baseline + 1 accent + direct labels, no gridlines, no box, no staircase) -->
    <section class="swd-chart-section" aria-labelledby="swd-action-title">
      <div class="swd-controls-row">
        <div
          class="vf-toolbar"
          role="toolbar"
          focusgroup="toolbar wrap"
          aria-label="Chart view and pricing lens"
          aria-controls="vf-svg vf-paired-bars"
        >
          <div class="vf-toolbar-group" role="group" aria-label="Runs shown">
            <button type="button" class="vf-ctrl-btn" data-vf-mode="speed-7-of-7" aria-pressed="true">
              7/7 Full Passes ({initialPlotModel.frontier.thresholds.paidFullPassCount})
            </button>
            <button type="button" class="vf-ctrl-btn" data-vf-mode="all-outcomes" aria-pressed="false">
              All {analyzedRuns.length} Runs
            </button>
          </div>

          <span class="vf-toolbar-sep" role="separator" aria-orientation="vertical"></span>

          <div class="vf-toolbar-group" role="group" aria-label="Pricing lens">
            <button type="button" class="vf-ctrl-btn" data-vf-lens="billed" aria-pressed="true">
              Billed
            </button>
            <button type="button" class="vf-ctrl-btn" data-vf-lens="standard" aria-pressed="false">
              Standard API
            </button>
            <button type="button" class="vf-ctrl-btn" data-vf-lens="uncached" aria-pressed="false">
              Uncached
            </button>
          </div>
        </div>

        <label class="swd-check">
          <input type="checkbox" id="vf-toggle-promos" />
          <span>Show 2 limited-time $0 promos</span>
        </label>
      </div>

      <div id="frontier-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

      <figure class="vf-figure">
        <svg
          id="vf-svg"
          viewBox={`0 0 ${initialPlotModel.width} ${initialPlotModel.height}`}
          class="vf-svg"
          role="img"
          aria-labelledby="vf-svg-title vf-svg-desc"
        >
          <title id="vf-svg-title">Capy Bench Paid 7/7 Speed vs. Cost</title>
          <desc id="vf-svg-desc">
            Decluttered scatter plot highlighting the 3 paid 7/7 frontier leaders in accent color while keeping the remaining slower and pricier runs in quiet gray.
          </desc>

          <!-- Minimal axes only (zero gridline clutter) -->
          <g id="vf-layer-grid"></g>
          <g id="vf-layer-quadrants"></g>

          <g id="vf-layer-axes">
            <line
              x1={initialPlotModel.padL}
              y1={initialPlotModel.padT}
              x2={initialPlotModel.padL}
              y2={initialPlotModel.height - initialPlotModel.padB}
              class="vf-axis-line"
            />
            <line
              x1={initialPlotModel.padL}
              y1={initialPlotModel.height - initialPlotModel.padB}
              x2={initialPlotModel.width - initialPlotModel.padR}
              y2={initialPlotModel.height - initialPlotModel.padB}
              class="vf-axis-line"
            />
            <text
              x={initialPlotModel.paidXStart + 12}
              y={initialPlotModel.padT + 14}
              text-anchor="start"
              class="vf-ideal-hint"
              id="vf-ideal-hint"
            >
              ↖ Faster &amp; cheaper
            </text>
            <text
              x={(initialPlotModel.paidXStart + initialPlotModel.width - initialPlotModel.padR) / 2}
              y={initialPlotModel.height - 8}
              text-anchor="middle"
              class="vf-axis-title"
              id="vf-x-axis-title"
            >
              Cost per run (USD, log scale · Billed)
            </text>
            <text
              x={16}
              y={initialPlotModel.padT + (initialPlotModel.height - initialPlotModel.padT - initialPlotModel.padB) / 2}
              text-anchor="middle"
              transform={`rotate(-90 16 ${initialPlotModel.padT + (initialPlotModel.height - initialPlotModel.padT - initialPlotModel.padB) / 2})`}
              class="vf-axis-title"
              id="vf-y-axis-title"
            >
              Time (faster ↑)
            </text>
          </g>

          <g id="vf-layer-annotations"></g>
          <g id="vf-layer-labels"></g>
          <g id="vf-layer-points"></g>
        </svg>

        <!-- QUIET 1-ROW INSPECTOR STRIP -->
        {firstPt && (
          <div class="vf-inspector-bar" id="vf-inspector" aria-live="polite">
            <div class="vf-inspector-left">
              <div class="vf-inspector-top">
                <span class="hl hl-acid vf-inspector-badge" id="vf-ins-badge">
                  Balanced Pick
                </span>
                <strong class="vf-inspector-title" id="vf-ins-title">
                  {firstPt.harness} / {firstPt.model} ({firstPt.effort})
                </strong>
              </div>
              <div class="mono vf-inspector-stats" id="vf-ins-stats">
                {firstPt.completed}/{firstPt.total} stages · {formatDuration(firstPt.durationMinutes)} · {formatCost(firstPt.lensCostUsd)} ({formatCost(firstPt.lensCostUsd / Math.max(1, firstPt.completed))}/stage) · {firstPt.tokensTotal} tokens ({firstPt.cacheHitRatePct}% cache)
              </div>
              <div class="vf-inspector-note" id="vf-ins-note">
                {firstModelStat && firstHarnessStat
                  ? `Model n=${firstModelStat.n} · Harness ${firstPt.harness} n=${firstHarnessStat.n}${firstHarnessStat.singlePeerCaveat ? ' (single-model harness — harness & model effects are confounded)' : ''}.`
                  : ''}
              </div>
            </div>
            <div class="vf-inspector-actions">
              <a href={`/runs/${firstPt.id}`} class="btn btn-sm" id="vf-ins-link">
                Read dossier →
              </a>
            </div>
          </div>
        )}
      </figure>
    </section>

    <!-- CLEAN PAID 7/7 COMPARISON BARS (SWD: gray baseline, accent ONLY on winners / focus) -->
    <section class="vf-paired-section" id="vf-paired-bars" aria-labelledby="vf-paired-heading">
      <div class="vf-paired-header">
        <div>
          <h2 id="vf-paired-heading" class="vf-paired-title">
            The ranking flips when you care about cost
          </h2>
          <p class="vf-paired-sub">
            Only the {paid7of7Exec.length} paid runs that passed all 7 stages. Highlighted bars are the 3 frontier picks; everything else sits in gray. Click any row to locate it on the chart.
          </p>
        </div>
        <span class="mono vf-paired-lens-pill" id="vf-paired-lens-pill">Lens: Billed</span>
      </div>

      <div class="vf-paired-grid">
        <div class="vf-bar-col">
          <div class="vf-bar-col-head">
            <span class="vf-bar-col-title">By Speed (fastest first)</span>
          </div>
          <div class="vf-bar-list" id="vf-exec-bars">
            {paid7of7Exec.map((item) => (
              <button
                type="button"
                class:list={['vf-bar-row', { 'is-frontier': item.isPaidFrontier }]}
                data-bar-run={item.id}
                aria-pressed="false"
              >
                <div class="vf-bar-meta">
                  <span class="vf-bar-label">
                    <strong>{item.model}</strong>
                    <span class="vf-bar-harness">{item.harness}</span>
                  </span>
                  <span class="mono vf-bar-val">{formatDuration(item.durationMinutes)}</span>
                </div>
                <div class="vf-bar-track" aria-hidden="true">
                  <span
                    class:list={['vf-bar-fill', { 'is-accent': item.isPaidFrontier }]}
                    style={`inline-size: ${item.executionBarPct}%`}
                  />
                </div>
              </button>
            ))}
          </div>
        </div>

        <div class="vf-bar-col">
          <div class="vf-bar-col-head">
            <span class="vf-bar-col-title">By Cost (cheapest first)</span>
          </div>
          <div class="vf-bar-list" id="vf-value-bars">
            {paid7of7Value.map((item, idx) => {
              const speedIdx = paid7of7Exec.findIndex((r) => r.id === item.id);
              const shift = speedIdx !== -1 ? speedIdx - idx : 0;
              return (
                <button
                  type="button"
                  class:list={['vf-bar-row', { 'is-frontier': item.isPaidFrontier }]}
                  data-bar-run={item.id}
                  aria-pressed="false"
                >
                  <div class="vf-bar-meta">
                    <span class="vf-bar-label">
                      <strong>{item.model}</strong>
                      <span class="vf-bar-harness">{item.harness}</span>
                    </span>
                    <span class="mono vf-bar-val">
                      {formatCost(item.lensCostUsd)}
                      {shift >= 3 && <span class="vf-delta is-up">↑+{shift}</span>}
                    </span>
                  </div>
                  <div class="vf-bar-track" aria-hidden="true">
                    <span
                      class:list={['vf-bar-fill', { 'is-accent': item.isPaidFrontier }]}
                      style={`inline-size: ${item.valueBarPct ?? 14}%`}
                    />
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <details class="reading-disclosure vf-extra-disclosure" id="vf-extra-runs">
        <summary>
          See the {partialRows.length} partial runs (&lt;7/7) and {initialPairedBars.promoRows.length} limited-time $0 promos
        </summary>
        <div class="disclosure-body vf-extra-grid">
          <div>
            <div class="vf-bar-col-head">
              <span class="vf-bar-col-title">Partial Runs (&lt;7/7)</span>
            </div>
            <div class="vf-bar-list" id="vf-partial-bars">
              {partialRows.map((item) => (
                <button type="button" class="vf-bar-row" data-bar-run={item.id} aria-pressed="false">
                  <div class="vf-bar-meta">
                    <span class="vf-bar-label">
                      <span class="mono vf-stage-tag">{item.completed}/7</span>
                      <strong>{item.model}</strong>
                      <span class="vf-bar-harness">{item.harness}</span>
                      {item.isOffPeak && <span class="mono vf-tag-offpeak">off-peak</span>}
                    </span>
                    <span class="mono vf-bar-val">
                      {formatDuration(item.durationMinutes)} · {formatCost(item.lensCostUsd)}
                    </span>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <div>
            <div class="vf-bar-col-head">
              <span class="vf-bar-col-title">$0 Limited-Time Promos</span>
            </div>
            <div class="vf-bar-list" id="vf-promo-bars">
              {initialPairedBars.promoRows.map((item) => (
                <button type="button" class="vf-bar-row" data-bar-run={item.id} aria-pressed="false">
                  <div class="vf-bar-meta">
                    <span class="vf-bar-label">
                      <span class="mono vf-stage-tag">{item.completed}/7</span>
                      <strong>{item.model}</strong>
                      <span class="vf-bar-harness">{item.harness}</span>
                      <span class="mono vf-tag-promo">free (limited time)</span>
                    </span>
                    <span class="mono vf-bar-val">
                      {formatDuration(item.durationMinutes)} · $0.00
                    </span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        </div>
      </details>
    </section>

    <script
      id="frontier-runs-data"
      type="application/json"
      set:html={JSON.stringify(clientAnalyzedRunsPayload)}
    />
  </div>
</BaseLayout>

<style>
  .swd-page {
    padding-block-start: 2.75rem;
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .swd-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .swd-kicker a {
    color: var(--text-secondary);
    text-underline-offset: 0.25em;
  }

  .swd-header .headline-two-tone {
    font-size: clamp(1.75rem, 3.2vw, 2.45rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .swd-lead {
    max-inline-size: 62ch;
    margin-block: 1rem 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* 3 picks */
  .picks-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  #frontier-workspace :global(.pick-card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    border: var(--border-row);
    border-block-start: 3px solid var(--hl-acid);
    border-radius: var(--radius-none);
    background: var(--bg-surface);
    color: var(--text-primary);
    text-align: start;
    cursor: pointer;
  }

  :global([data-theme="light"]) #frontier-workspace :global(.pick-card) {
    border-block-start-color: var(--accent-cobalt);
  }

  @media (hover: hover) {
    #frontier-workspace :global(.pick-card:hover) {
      border-color: var(--border-strong-color);
      border-block-start-color: var(--hl-acid);
    }

    :global([data-theme="light"]) #frontier-workspace :global(.pick-card:hover) {
      border-block-start-color: var(--accent-cobalt);
    }
  }

  #frontier-workspace :global(.pick-card[aria-pressed="true"]) {
    outline: 2px solid var(--hl-acid);
    outline-offset: -2px;
  }

  :global([data-theme="light"]) #frontier-workspace :global(.pick-card[aria-pressed="true"]) {
    outline-color: var(--accent-cobalt);
  }

  #frontier-workspace :global(.pick-card-top) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    inline-size: 100%;
    margin-block-end: 0.25rem;
  }

  #frontier-workspace :global(.pick-card-caveat) {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  #frontier-workspace :global(.pick-card-name) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    line-height: 1.25;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  #frontier-workspace :global(.pick-card-harness) {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  #frontier-workspace :global(.pick-card-metrics) {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-block: 0.3rem 0.15rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  #frontier-workspace :global(.pick-metric-big) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  #frontier-workspace :global(.pick-card-why) {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  /* Focus banner */
  .highlight-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.85rem 1rem;
    border: var(--border-frame);
    background: var(--bg-surface);
  }

  .highlight-banner-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }

  .highlight-banner-title {
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .highlight-banner-caveat {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .highlight-banner-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* Controls row */
  .swd-chart-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .swd-controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  #frontier-workspace .vf-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  #frontier-workspace .vf-toolbar-group {
