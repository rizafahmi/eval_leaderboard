---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
} from '../utils/format';
import {
  analyzeAndRankRuns,
  discoverAblationPresets,
} from '../utils/telemetry';
import { BENCHMARK_STAGES } from '../data/benchmark';

const allRuns = await getCollection('runs', ({ data }) => data.published !== false);
const analyzedRuns = analyzeAndRankRuns(
  allRuns.map((entry) => ({ id: entry.id, data: entry.data }))
);
const ablationPresets = discoverAblationPresets(analyzedRuns);

const shortPresetLabels: Record<string, string> = {
  'harness-gpt6-sol': 'Pi vs. Codex (gpt-6-sol)',
  'harness-muse-spark-1-3-contrib': 'Pi vs. Muse Code',
  'effort-glm-flash-high-vs-low': 'Flash: High vs. Low',
  'effort-glm-flash-high-vs-max': 'Flash: High vs. Max',
  'model-gpt61-vs-gpt6': 'gpt-6.1 vs. gpt-6.0',
  'model-glm-flash-vs-flagship': 'Flash vs. Flagship',
  'pareto-cost-vs-speed': 'Lowest Cost vs. Fastest',
};

const defaultPreset = ablationPresets[0];
const defaultRunA =
  analyzedRuns.find((r) => r.id === defaultPreset?.runAId) ?? analyzedRuns[0];
const defaultRunB =
  analyzedRuns.find((r) => r.id === defaultPreset?.runBId) ?? analyzedRuns[1] ?? analyzedRuns[0];

const serializedRuns = analyzedRuns.map((r, idx) => ({
  id: r.id,
  rank: idx + 1,
  harness: r.displayHarness,
  rawHarness: r.data.codingHarness,
  model: r.data.model,
  effort: r.data.effort ?? 'Standard',
  provider: r.displayProvider,
  durationMinutes: r.data.durationMinutes,
  costUsd: r.data.costUsd,
  standardApiCostUsd: r.costMetrics.standardApiCostUsd,
  uncachedCostUsd: r.costMetrics.uncachedCounterfactualCostUsd,
  cacheSavingsUsd: r.costMetrics.cacheSavingsUsd,
  cacheSavingsPct: r.costMetrics.cacheSavingsPct,
  planCompleted: r.plan.completed,
  planTotal: r.plan.total,
  planRatio: r.plan.ratio,
  isPareto: r.isParetoFrontier,
  paretoOrder: r.paretoOrder,
  tokens: r.tokens,
  peakContextTokens: r.context.peakTokens,
  contextWindowStr: r.data.contextWindow ?? '—',
  llmCalls: r.llmCalls,
  toolTotalCalls: r.toolTotalCalls,
  toolErrorCalls: r.toolErrorCalls,
  toolSuccessRatePct: r.toolSuccessRatePct,
  pollingCalls: r.pollingCalls,
  pollingSharePct: r.pollingSharePct,
  estimatedPollingWasteUsd: r.estimatedPollingWasteUsd,
  testsPassed: r.data.tests?.passed ?? null,
  testsTotal: r.data.tests?.total ?? null,
  testsDurationSec: r.data.tests?.durationSeconds ?? null,
  commits: r.data.commits ?? null,
  stages: r.stages,
  nonStageLlmCalls: r.nonStageLlmCalls,
  nonStageCostUsd: r.nonStageCostUsd,
}));
---

<BaseLayout
  title="Compare Personal Evaluation Runs"
  description="Compare outcome, time, and cost in Riza Fahmi’s personal Elixir/OTP coding-agent evaluation. Explore stages and field notes; other stacks may differ."
  activeNav="compare"
>
  <div class="compare-quiet">
    <header class="compare-hero">
      <h1 id="compare-hero-heading" class="headline-two-tone">
        Two runs.<br />
        <span class="muted">A closer look.</span>
      </h1>
      <p class="compare-lead">
        Choose two runs to see what changed. Start with outcome, time, and cost;
        open the stages and field notes when you want the whole story.
      </p>

      <details class="reading-disclosure preset-disclosure" id="guided-comparisons-details">
        <summary class="preset-summary">
          Guided comparisons
        </summary>
        <div class="disclosure-body">
          <p class="preset-summary-active" id="active-preset-summary">
            {shortPresetLabels[defaultPreset?.id ?? ''] ?? defaultPreset?.title ?? 'Choose a pair'}
          </p>
          <div class="v3-preset-bar preset-grid" role="group" aria-label="Controlled ablation presets">
            {ablationPresets.map((preset, idx) => (
              <button
                type="button"
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class:list={['preset-btn', { 'is-active': idx === 0 }]}
                data-preset-id={preset.id}
                data-run-a={preset.runAId}
                data-run-b={preset.runBId}
                data-finding={preset.findingHeadline}
                data-badge={preset.badge}
                data-title={preset.title}
                data-short-label={shortPresetLabels[preset.id] ?? preset.title}
              >
                <span class="preset-title">{shortPresetLabels[preset.id] ?? preset.title}</span>
                <span class="preset-subtitle">{preset.title}</span>
              </button>
            ))}
          </div>
        </div>
      </details>
    </header>

    <section class="compare-workbench" aria-label="Head-to-head run comparison">
      <div class="v3-contenders-grid">
        <div class="v3-contender-card v3-contender-a">
          <div class="contender-card-head">
            <label class="contender-label" for="select-run-a">
              <span class="contender-index contender-index-a">A</span>
              <span class="contender-role">Baseline run</span>
            </label>
            <div class="contender-meta-inline">
              <span id="contender-meta-a">
                Rank #{analyzedRuns.findIndex((r) => r.id === defaultRunA.id) + 1} · {defaultRunA.displayProvider} · {defaultRunA.data.effort ?? 'Standard'}
              </span>
              <a href={`/runs/${defaultRunA.id}`} class="contender-inspect-link" id="contender-link-a">
                Inspect run →
              </a>
            </div>
          </div>
          <select id="select-run-a" class="select control-select">
            {serializedRuns.map((r) => (
              <option value={r.id} selected={r.id === defaultRunA.id}>
                {r.harness} / {r.model} ({r.effort})
              </option>
            ))}
          </select>
        </div>

        <div class="v3-swap-bridge">
          <button
            type="button"
            id="swap-runs-btn"
            class="btn btn-secondary swap-btn"
            title="Swap Run A and Run B"
          >
            <svg class="swap-svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 5h10M10 2l3 3-3 3M13 11H3M6 8l-3 3 3 3" />
            </svg>
            Swap A / B
          </button>
        </div>

        <div class="v3-contender-card v3-contender-b">
          <div class="contender-card-head">
            <label class="contender-label" for="select-run-b">
              <span class="contender-index contender-index-b">B</span>
              <span class="contender-role">Comparison run</span>
            </label>
            <div class="contender-meta-inline">
              <span id="contender-meta-b">
                Rank #{analyzedRuns.findIndex((r) => r.id === defaultRunB.id) + 1} · {defaultRunB.displayProvider} · {defaultRunB.data.effort ?? 'Standard'}
              </span>
              <a href={`/runs/${defaultRunB.id}`} class="contender-inspect-link" id="contender-link-b">
                Inspect run →
              </a>
            </div>
          </div>
          <select id="select-run-b" class="select control-select">
            {serializedRuns.map((r) => (
              <option value={r.id} selected={r.id === defaultRunB.id}>
                {r.harness} / {r.model} ({r.effort})
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="v3-verdict-banner" id="ablation-finding-banner" role="status" aria-live="polite">
        <span class="finding-badge" id="finding-badge">{defaultPreset?.badge ?? 'Head-to-head diff'}</span>
        <p class="finding-copy" id="finding-copy">
          {defaultPreset?.findingHeadline ?? 'Comparing telemetry and stage-by-stage cost profiles.'}
        </p>
      </div>

      <div class="table-wrapper compare-table-wrap" tabindex="0" role="region" aria-label="Core outcome, duration, and cost comparison">
        <table class="app-table leaderboard-table static-table compare-table">
          <caption class="visually-hidden">
            Side-by-side comparison of Run A and Run B across holdout specification outcome, wall-clock duration, and billed API cost
          </caption>
          <thead>
            <tr>
              <th scope="col" class="col-metric">Metric</th>
              <th scope="col" class="col-run-a" id="th-run-a">
                <a href={`/runs/${defaultRunA.id}`} class="compare-th-link js-th-link-a" id="th-link-a">
                  A · {defaultRunA.displayHarness} / {defaultRunA.data.model}
                </a>
              </th>
              <th scope="col" class="col-run-b" id="th-run-b">
                <a href={`/runs/${defaultRunB.id}`} class="compare-th-link js-th-link-b" id="th-link-b">
                  B · {defaultRunB.displayHarness} / {defaultRunB.data.model}
                </a>
              </th>
              <th scope="col" class="col-delta">Difference</th>
            </tr>
          </thead>
          <tbody id="telemetry-diff-tbody">
            <!-- Core 3 visible metrics (Outcome, Duration, Billed Cost) populated deterministically -->
          </tbody>
        </table>
      </div>
    </section>

    <section class="compare-disclosures" aria-label="Detailed telemetry disclosures">
      <details class="reading-disclosure" id="more-core-metrics-details">
        <summary>
          Tests, tokens &amp; context
        </summary>
        <div class="disclosure-body">
          <div class="table-wrapper compare-table-wrap" tabindex="0" role="region" aria-label="Execution and context metrics comparison">
            <table class="app-table leaderboard-table static-table compare-table">
              <caption class="visually-hidden">
                Comparison of Run A and Run B across total token volume, peak context window, and LLM turns with test suite results
              </caption>
              <thead>
                <tr>
                  <th scope="col" class="col-metric">Metric</th>
                  <th scope="col" class="col-run-a">
                    <a href={`/runs/${defaultRunA.id}`} class="compare-th-link js-th-link-a">
                      A · {defaultRunA.displayHarness} / {defaultRunA.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-run-b">
                    <a href={`/runs/${defaultRunB.id}`} class="compare-th-link js-th-link-b">
                      B · {defaultRunB.displayHarness} / {defaultRunB.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-delta">Difference</th>
                </tr>
              </thead>
              <tbody id="secondary-telemetry-tbody">
                <!-- Additional core metrics populated deterministically -->
              </tbody>
            </table>
          </div>
        </div>
      </details>

      <details class="reading-disclosure" id="stage-breakdown-details">
        <summary>
          The seven stages, side by side
        </summary>
        <div class="disclosure-body">
          <div class="table-wrapper compare-table-wrap" tabindex="0" role="region" aria-label="Stage-by-stage S1 to S7 comparison">
            <table class="app-table leaderboard-table static-table compare-table">
              <caption class="visually-hidden">
                Stage-by-stage comparison of Run A and Run B across S1 through S7 implementation slices and stage totals
              </caption>
              <thead>
                <tr>
                  <th scope="col" class="col-metric">Stage slice</th>
                  <th scope="col" class="col-run-a">
                    <a href={`/runs/${defaultRunA.id}`} class="compare-th-link js-th-link-a">
                      A · {defaultRunA.displayHarness} / {defaultRunA.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-run-b">
                    <a href={`/runs/${defaultRunB.id}`} class="compare-th-link js-th-link-b">
                      B · {defaultRunB.displayHarness} / {defaultRunB.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-delta">Stage difference</th>
                </tr>
              </thead>
              <tbody id="stage-diff-tbody">
                <!-- S1-S7 stages populated deterministically -->
              </tbody>
              <tfoot id="stage-diff-tfoot">
                <!-- Stage total populated deterministically -->
              </tfoot>
            </table>
          </div>
        </div>
      </details>

      <details class="reading-disclosure deep-accounting-details" id="deep-accounting-details">
        <summary>
          Token accounting &amp; cache savings
        </summary>
        <div class="disclosure-body">
          <div class="table-wrapper compare-table-wrap" tabindex="0" role="region" aria-label="Deep token and cache accounting">
            <table class="app-table leaderboard-table static-table compare-table">
              <caption class="visually-hidden">
                Deep token and cache accounting comparison between Run A and Run B across standard API equivalent cost, uncached counterfactual cost, prefix cache hit rate, output and reasoning tokens, and tool errors and task polling
              </caption>
              <thead>
                <tr>
                  <th scope="col" class="col-metric">Accounting metric</th>
                  <th scope="col" class="col-run-a">
                    <a href={`/runs/${defaultRunA.id}`} class="compare-th-link js-th-link-a">
                      A · {defaultRunA.displayHarness} / {defaultRunA.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-run-b">
                    <a href={`/runs/${defaultRunB.id}`} class="compare-th-link js-th-link-b">
                      B · {defaultRunB.displayHarness} / {defaultRunB.data.model}
                    </a>
                  </th>
                  <th scope="col" class="col-delta">Difference</th>
                </tr>
              </thead>
              <tbody id="deep-accounting-tbody">
                <!-- Secondary accounting rows populated deterministically -->
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </section>
  </div>

  <script
    is:inline
    id="compare-runs-data"
    type="application/json"
    set:html={JSON.stringify({
      runs: serializedRuns,
      stages: BENCHMARK_STAGES.map((s) => ({ id: s.id, title: s.title })),
      presets: ablationPresets,
    })}
  />
</BaseLayout>

<style>
  .compare-quiet {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding-block: 2rem 3rem;
    font-variant-numeric: tabular-nums;
  }

  /* 1. HERO & GUIDED COMPARISONS DISCLOSURE */
  .compare-hero {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block-end: 0.5rem;
  }

  .compare-hero .headline-two-tone {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }

  .compare-lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-inline-size: 64ch;
  }

  /* Fallback & reinforcement for shared .reading-disclosure / .disclosure-body */
  .reading-disclosure {
    border-block-start: var(--border-row);
    border-block-end: var(--border-row);
  }

  .reading-disclosure + .reading-disclosure {
    border-block-start: none;
  }

  .reading-disclosure > summary {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-primary);
    padding: 1rem 0.25rem;
    min-block-size: 3rem;
    cursor: pointer;
  }

  .reading-disclosure > summary:hover {
    color: var(--link-color);
  }

  .disclosure-body {
    padding-block: 0.5rem 1.5rem;
  }

  .preset-summary-active {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-inline-start: 0.35rem;
  }

  .preset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
  }

  .preset-btn {
    text-align: start;
    cursor: pointer;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle-color);
    border-radius: var(--radius-none);
    min-block-size: 3.25rem;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.25rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }

  .preset-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .preset-subtitle {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .preset-btn:hover {
    background-color: var(--bg-elevated);
    border-color: var(--border-strong-color);
  }

  .preset-btn.is-active {
    border: var(--border-frame);
    border-color: var(--hl-acid);
    background-color: var(--bg-elevated);
  }

  :global([data-theme="light"]) .preset-btn.is-active {
    border-color: var(--accent-cobalt);
  }

  /* 2. COMPARISON WORKBENCH (SELECTORS, FINDING, CORE TABLE) */
  .compare-workbench {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .v3-contenders-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: end;
  }

  .v3-contender-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-inline-size: 0;
  }

  .contender-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .contender-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-body);
    cursor: pointer;
  }

  .contender-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .contender-index-a,
  .contender-index-b {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle-color);
  }

  .contender-role {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .contender-meta-inline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .contender-inspect-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contender-inspect-link:hover {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    text-decoration: none;
  }

  .control-select {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    min-block-size: 3rem;
    padding: 0.65rem 2.25rem 0.65rem 0.9rem;
    background-color: var(--bg-surface);
    border: var(--border-row);
    color: var(--text-primary);
    text-overflow: ellipsis;
  }

  .v3-swap-bridge {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swap-btn {
    min-block-size: 3rem;
    min-inline-size: 7.5rem;
    padding: 0.65rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    background-color: var(--bg-surface);
  }

  .swap-svg {
    inline-size: 1rem;
    block-size: 1rem;
    flex-shrink: 0;
  }

  /* Finding callout */
  .v3-verdict-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--bg-surface);
    border-block: var(--border-row);
  }

  .finding-badge {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .finding-copy {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--text-primary);
    line-height: 1.6;
    max-inline-size: 72ch;
  }
  /* 3. COMPARISON TABLES */
  .compare-table-wrap {
    border: var(--border-row);
  }

  .compare-table {
    table-layout: auto;
    inline-size: 100%;
  }

  .compare-table .col-metric {
    inline-size: 26%;
  }

  .compare-table .col-run-a,
  .compare-table .col-run-b {
    inline-size: 26%;
  }

  .compare-table .col-delta {
    inline-size: 22%;
  }

  .compare-quiet .leaderboard-table thead th {
    background-color: var(--bg-surface);
    padding: 0.95rem 1.15rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-secondary);
    white-space: normal;
  }

  .compare-quiet :global(.leaderboard-table :is(td, tbody th, tfoot th)) {
    padding: 1rem 1.15rem;
    font-size: 1rem;
    line-height: 1.5;
    vertical-align: middle;
  }

  .compare-quiet :global(.leaderboard-table :is(tbody th, tfoot th)) {
    font-family: var(--font-body);
    color: var(--text-primary);
  }

  @container (width >= 40rem) {
    .compare-quiet :global(.leaderboard-table :is(thead, tbody, tfoot) tr > :is(th, td):not(:first-child)) {
      border-inline-start: var(--border-row);
    }
  }

  .compare-th-link {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 700;
  }

  .compare-th-link:hover {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    text-decoration: none;
  }

  :global(.cell-primary) {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  :global(.cell-primary.is-lead) {
    color: var(--text-primary);
    font-weight: 700;
  }

  :global(.cell-inline-muted) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-inline-start: 0.35rem;
  }

  /* Quiet Delta cell layout */
  :global(.delta-cell-wrap) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.adv-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border-subtle-color);
    color: var(--text-secondary);
    background-color: transparent;
    line-height: 1.25;
    flex-shrink: 0;
  }

  :global(.adv-pill.adv-a) {
    color: var(--hl-acid);
    border-color: var(--hl-acid);
  }

  :global([data-theme="light"] .adv-pill.adv-a) {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    border-color: var(--raw-ebony);
  }

  :global(.adv-pill.adv-b) {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--border-strong-color);
  }

  :global(.delta-figure) {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  :global(.delta-neutral) {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  /* Stage-by-Stage cell structure */
  :global(.stage-cell-line) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  :global(.stage-cost) {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  :global(.stage-cost.is-lead) {
    color: var(--text-primary);
    font-weight: 700;
  }

  :global(.stage-inline-meta) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  :global(.stage-miss-tag) {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.08rem 0.4rem;
    line-height: 1.25;
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-strong-color);
  }

  :global(.stage-compare-bar-track) {
    inline-size: 100%;
    max-inline-size: 10rem;
    block-size: 0.25rem;
    background-color: var(--bg-surface);
    margin-block-start: 0.35rem;
    overflow: hidden;
  }

  :global(.stage-compare-bar-fill-a) {
    display: block;
    block-size: 100%;
    background-color: var(--hl-acid);
  }

  :global([data-theme="light"] .stage-compare-bar-fill-a) {
    background-color: var(--raw-ebony);
  }

  :global(.stage-compare-bar-fill-b) {
    display: block;
    block-size: 100%;
    background-color: var(--text-muted);
  }

  :global(#stage-diff-tfoot tr) {
    background-color: var(--bg-surface);
    border-block-start: var(--border-frame);
  }

  /* 4. SECONDARY DISCLOSURES STACK */
  .compare-disclosures {
    display: flex;
    flex-direction: column;
  }

  /* 5. MOBILE & NARROW CONTAINER ADAPTATIONS */
  @container (width < 40rem) {
    .compare-quiet :global(.leaderboard-table),
    .compare-quiet :global(.leaderboard-table tbody),
    .compare-quiet :global(.leaderboard-table tfoot),
    .compare-quiet :global(.leaderboard-table tr:not([hidden])),
    .compare-quiet :global(.leaderboard-table tbody th),
    .compare-quiet :global(.leaderboard-table tfoot th),
    .compare-quiet :global(.leaderboard-table td) {
      display: block;
    }

    .compare-quiet .leaderboard-table thead {
      display: none;
    }

    .compare-quiet :global(.leaderboard-table.static-table :is(tbody, tfoot) tr:not([hidden])) {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1rem 1.15rem;
    }

    .compare-quiet :global(.leaderboard-table :is(tbody th, tfoot th)) {
      padding: 0 0 0.5rem;
      font-size: 1rem;
    }

    .compare-quiet :global(.leaderboard-table.static-table td) {
      padding: 0.6rem 0;
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 0.5rem 1rem;
    }

    .compare-quiet :global(.leaderboard-table :is(td, tbody th, tfoot th)[data-cell]::before) {
      content: attr(data-cell);
      font-family: var(--font-body);
      font-size: 0.875rem;
      font-weight: 700;
      text-transform: none;
      letter-spacing: normal;
      color: var(--text-secondary);
      min-inline-size: 0;
      max-inline-size: 100%;
      flex-shrink: 1;
      overflow-wrap: anywhere;
    }

    :global(.stage-compare-bar-track) {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .compare-quiet {
      gap: 2.5rem;
      padding-block: 1.5rem 2.5rem;
    }

    .v3-contenders-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .v3-swap-bridge {
      justify-content: flex-start;
    }
  }
</style>

<script>
  interface SerializedStage {
    stageId: string;
    completed: boolean;
    wasAttempted: boolean;
    llmCalls: number;
    costUsd: number;
    thinkingTokens: number;
    stepCount: number;
    pollingCalls: number;
    callSharePct: number;
    costSharePct: number;
    isPeakCost: boolean;
  }

  interface SerializedRun {
    id: string;
    rank: number;
    harness: string;
    rawHarness: string;
    model: string;
    effort: string;
    provider: string;
    durationMinutes: number;
    costUsd: number;
    standardApiCostUsd: number;
    uncachedCostUsd: number;
    cacheSavingsUsd: number;
    cacheSavingsPct: number;
    planCompleted: number;
    planTotal: number;
    planRatio: number;
    isPareto: boolean;
    paretoOrder: number | null;
    tokens: {
      uncachedInput: number;
      cachedInput: number;
      output: number;
      thinking: number;
      total: number;
      cacheHitRatePct: number;
    };
    peakContextTokens: number | null;
    contextWindowStr: string;
    llmCalls: number;
    toolTotalCalls: number;
    toolErrorCalls: number;
    toolSuccessRatePct: number | null;
    pollingCalls: number;
    pollingSharePct: number;
    estimatedPollingWasteUsd: number;
    testsPassed: number | null;
    testsTotal: number | null;
    testsDurationSec: number | null;
    commits: number | null;
    stages: Record<string, SerializedStage>;
    nonStageLlmCalls: number;
    nonStageCostUsd: number;
  }

  const dataEl = document.getElementById('compare-runs-data');
  const payload = dataEl ? JSON.parse(dataEl.textContent || '{}') : { runs: [], stages: [], presets: [] };
  const runsById = new Map<string, SerializedRun>(
    (payload.runs as SerializedRun[]).map((r) => [r.id, r])
  );
  const stagesList: Array<{ id: string; title: string }> = payload.stages || [];
  const presetsList: Array<{
    id: string;
    badge: string;
    title: string;
    runAId: string;
    runBId: string;
    findingHeadline: string;
  }> = payload.presets || [];

  const qAll = <T extends Element>(selector: string): T[] =>
    Array.from(document.querySelectorAll<T>(selector));

  let activeRunAId = (document.querySelector<HTMLSelectElement>('#select-run-a')?.value) || '';
  let activeRunBId = (document.querySelector<HTMLSelectElement>('#select-run-b')?.value) || '';
  const usd = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  function fmtCompact(n: number): string {
    if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2)}M`;
    if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
    return n.toLocaleString('en-US');
  }

  function fmtDur(mins: number): string {
    if (mins < 60) return `${mins}m`;
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return m > 0 ? `${h}h ${m}m` : `${h}h`;
  }

  function fmtBadgeLabel(raw: string): string {
    if (!raw) return 'Head-to-head comparison';
    const lower = raw.toLowerCase();
    return lower.charAt(0).toUpperCase() + lower.slice(1);
  }

  function computeAutoFinding(a: SerializedRun, b: SerializedRun): { badge: string; text: string } {
    const matchingPreset = presetsList.find(
      (p) => (p.runAId === a.id && p.runBId === b.id) || (p.runAId === b.id && p.runBId === a.id)
    );
    if (matchingPreset) {
      return { badge: fmtBadgeLabel(matchingPreset.badge), text: matchingPreset.findingHeadline };
    }

    if (a.model.toLowerCase() === b.model.toLowerCase() && a.harness !== b.harness) {
      const tokRatio = b.tokens.total > 0 ? ((a.tokens.total - b.tokens.total) / b.tokens.total) * 100 : 0;
      return {
        badge: 'Harness ablation',
        text: `Same model (${a.model}), different coding harness (${a.harness} vs ${b.harness}): ${Math.abs(Math.round(tokRatio))}% token volume delta (${fmtCompact(a.tokens.total)} vs ${fmtCompact(b.tokens.total)}).`,
      };
    }

    if (a.harness === b.harness && a.model.toLowerCase() === b.model.toLowerCase() && a.effort !== b.effort) {
      return {
        badge: 'Effort scaling',
        text: `Same harness & model (${a.harness} / ${a.model}) at ${a.effort} vs ${b.effort} effort: ${a.planCompleted}/7 (${usd.format(a.costUsd)}, ${fmtDur(a.durationMinutes)}) vs ${b.planCompleted}/7 (${usd.format(b.costUsd)}, ${fmtDur(b.durationMinutes)}).`,
      };
    }

    return {
      badge: 'Head-to-head comparison',
      text: `${a.harness} / ${a.model} (#${a.rank}, ${a.planCompleted}/7, ${usd.format(a.costUsd)}) vs. ${b.harness} / ${b.model} (#${b.rank}, ${b.planCompleted}/7, ${usd.format(b.costUsd)}).`,
    };
  }

  function renderComparison() {
    const a = runsById.get(activeRunAId);
    const b = runsById.get(activeRunBId);
    if (!a || !b) return;

    for (const selA of qAll<HTMLSelectElement>('[id="select-run-a"]')) {
      if (selA.value !== a.id) selA.value = a.id;
    }
    for (const selB of qAll<HTMLSelectElement>('[id="select-run-b"]')) {
      if (selB.value !== b.id) selB.value = b.id;
    }

    let activePresetLabel = 'Custom pair';
    for (const btn of qAll<HTMLButtonElement>('.preset-btn')) {
      const pA = btn.dataset.runA;
      const pB = btn.dataset.runB;
      const isMatch = (pA === a.id && pB === b.id) || (pA === b.id && pB === a.id);
      btn.classList.toggle('is-active', isMatch);
      btn.setAttribute('aria-pressed', String(isMatch));
      if (isMatch) {
        activePresetLabel = btn.dataset.shortLabel || btn.dataset.title || 'Preset';
      }
    }
    for (const el of qAll('[id="active-preset-summary"]')) {
      el.textContent = activePresetLabel;
    }

    const finding = computeAutoFinding(a, b);
    for (const el of qAll('[id="finding-badge"]')) el.textContent = finding.badge;
    for (const el of qAll('[id="finding-copy"]')) el.textContent = finding.text;

    const labelA = `A · ${a.harness} / ${a.model}`;
    const labelB = `B · ${b.harness} / ${b.model}`;

    for (const linkA of qAll<HTMLAnchorElement>('[id="th-link-a"], .js-th-link-a')) {
      linkA.href = `/runs/${a.id}`;
      linkA.textContent = labelA;
    }
    for (const linkB of qAll<HTMLAnchorElement>('[id="th-link-b"], .js-th-link-b')) {
      linkB.href = `/runs/${b.id}`;
      linkB.textContent = labelB;
    }
    for (const linkA of qAll<HTMLAnchorElement>('[id="contender-link-a"]')) {
      linkA.href = `/runs/${a.id}`;
    }
    for (const linkB of qAll<HTMLAnchorElement>('[id="contender-link-b"]')) {
      linkB.href = `/runs/${b.id}`;
    }
    for (const metaA of qAll('[id="contender-meta-a"]')) {
      metaA.textContent = `Rank #${a.rank} · ${a.provider} · ${a.effort}`;
    }
    for (const metaB of qAll('[id="contender-meta-b"]')) {
      metaB.textContent = `Rank #${b.rank} · ${b.provider} · ${b.effort}`;
    }

    const cDiff = a.costUsd - b.costUsd;
    const pctA = b.costUsd > 0 ? Math.round((Math.abs(cDiff) / b.costUsd) * 100) : 0;
    const pctB = a.costUsd > 0 ? Math.round((Math.abs(cDiff) / a.costUsd) * 100) : 0;
    const tDiff = a.tokens.total - b.tokens.total;
    const tokPctA = b.tokens.total > 0 ? Math.round((Math.abs(tDiff) / b.tokens.total) * 100) : 0;
    const tokPctB = a.tokens.total > 0 ? Math.round((Math.abs(tDiff) / a.tokens.total) * 100) : 0;
    const fmtDeltaCell = (winner: 'a' | 'b' | 'par' | 'info', text: string) => {
      if (winner === 'par') {
        return `<span class="delta-cell-wrap"><span class="adv-pill">PAR</span><span class="delta-neutral">${text}</span></span>`;
      }
      if (winner === 'info') {
        return `<span class="delta-neutral">${text}</span>`;
      }
      const tag = winner === 'a' ? `<span class="adv-pill adv-a">A</span>` : `<span class="adv-pill adv-b">B</span>`;
      return `<span class="delta-cell-wrap">${tag}<span class="delta-figure">${text}</span></span>`;
    };

    const specLead: 'a' | 'b' | 'par' =
      a.planCompleted > b.planCompleted ? 'a' : a.planCompleted < b.planCompleted ? 'b' : 'par';
    const costLead: 'a' | 'b' | 'par' =
      Math.abs(a.costUsd - b.costUsd) < 0.005 ? 'par' : a.costUsd < b.costUsd ? 'a' : 'b';
    const durLead: 'a' | 'b' | 'par' =
      a.durationMinutes < b.durationMinutes ? 'a' : a.durationMinutes > b.durationMinutes ? 'b' : 'par';
    const tokLead: 'a' | 'b' | 'par' =
      a.tokens.total < b.tokens.total ? 'a' : a.tokens.total > b.tokens.total ? 'b' : 'par';
    const peakLead: 'a' | 'b' | 'par' =
      a.peakContextTokens && b.peakContextTokens
        ? a.peakContextTokens < b.peakContextTokens
          ? 'a'
          : a.peakContextTokens > b.peakContextTokens
            ? 'b'
            : 'par'
        : 'par';
    const callLead: 'a' | 'b' | 'par' =
      a.llmCalls < b.llmCalls ? 'a' : a.llmCalls > b.llmCalls ? 'b' : 'par';

    // 1. Primary Visible Metrics (Outcome, Duration, Billed Cost)
    const primaryCoreRows = [
      {
        label: 'Holdout Spec (S1–S7)',
        valA: `${a.planCompleted}/${a.planTotal} (${Math.round(a.planRatio * 100)}%)`,
        valB: `${b.planCompleted}/${b.planTotal} (${Math.round(b.planRatio * 100)}%)`,
        lead: specLead,
        deltaHtml:
          specLead === 'par'
            ? fmtDeltaCell('par', 'Same completion')
            : specLead === 'a'
              ? fmtDeltaCell('a', `+${a.planCompleted - b.planCompleted} stages`)
              : fmtDeltaCell('b', `+${b.planCompleted - a.planCompleted} stages`),
      },
      {
        label: 'Wall-Clock Duration',
        valA: fmtDur(a.durationMinutes),
        valB: fmtDur(b.durationMinutes),
        lead: durLead,
        deltaHtml:
          durLead === 'par'
            ? fmtDeltaCell('par', '0m diff')
            : durLead === 'a'
              ? fmtDeltaCell('a', `-${fmtDur(b.durationMinutes - a.durationMinutes)} faster`)
              : fmtDeltaCell('b', `-${fmtDur(a.durationMinutes - b.durationMinutes)} faster`),
      },
      {
        label: 'Billed API Cost',
        valA: usd.format(a.costUsd),
        valB: usd.format(b.costUsd),
        lead: costLead,
        deltaHtml:
          costLead === 'par'
            ? fmtDeltaCell('par', '$0.00')
            : costLead === 'a'
              ? fmtDeltaCell('a', `-${usd.format(b.costUsd - a.costUsd)} (-${pctA}%)`)
              : fmtDeltaCell('b', `-${usd.format(a.costUsd - b.costUsd)} (-${pctB}%)`),
      },
    ];

    // 2. Secondary Core Metrics (Available in Disclosure)
    const secondaryCoreRows = [
      {
        label: 'Total Token Volume',
        valA: fmtCompact(a.tokens.total),
        valB: fmtCompact(b.tokens.total),
        lead: tokLead,
        deltaHtml:
          tokLead === 'par'
            ? fmtDeltaCell('par', '0 tok')
            : tokLead === 'a'
              ? fmtDeltaCell('a', `-${fmtCompact(b.tokens.total - a.tokens.total)} (-${tokPctA}%)`)
              : fmtDeltaCell('b', `-${fmtCompact(a.tokens.total - b.tokens.total)} (-${tokPctB}%)`),
      },
      {
        label: 'Peak Context Window',
        valA: a.peakContextTokens ? fmtCompact(a.peakContextTokens) : a.contextWindowStr,
        valB: b.peakContextTokens ? fmtCompact(b.peakContextTokens) : b.contextWindowStr,
        lead: peakLead,
        deltaHtml:
          a.peakContextTokens && b.peakContextTokens
            ? peakLead === 'par'
              ? fmtDeltaCell('par', '0 tok')
              : peakLead === 'a'
                ? fmtDeltaCell('a', `-${fmtCompact(b.peakContextTokens - a.peakContextTokens)} lower`)
                : fmtDeltaCell('b', `-${fmtCompact(a.peakContextTokens - b.peakContextTokens)} lower`)
            : fmtDeltaCell('info', '—'),
      },
      {
        label: 'LLM Turns & ExUnit Suite',
        valA: `${a.llmCalls} turns${a.testsPassed !== null ? ` <span class="cell-inline-muted">· ${a.testsPassed}/${a.testsTotal} tests</span>` : ''}`,
        valB: `${b.llmCalls} turns${b.testsPassed !== null ? ` <span class="cell-inline-muted">· ${b.testsPassed}/${b.testsTotal} tests</span>` : ''}`,
        lead: callLead,
        deltaHtml:
          callLead === 'par'
            ? fmtDeltaCell('par', '0 turn diff')
            : callLead === 'a'
              ? fmtDeltaCell('a', `-${b.llmCalls - a.llmCalls} fewer turns`)
              : fmtDeltaCell('b', `-${a.llmCalls - b.llmCalls} fewer turns`),
      },
    ];

    const renderMetricRows = (rows: typeof primaryCoreRows) =>
      rows
        .map(
          (r) => `
        <tr>
          <th scope="row"><strong>${r.label}</strong></th>
          <td class="mono" data-cell="${labelA}"><span class="cell-primary ${r.lead === 'a' ? 'is-lead' : ''}">${r.valA}</span></td>
          <td class="mono" data-cell="${labelB}"><span class="cell-primary ${r.lead === 'b' ? 'is-lead' : ''}">${r.valB}</span></td>
          <td class="mono" data-cell="Difference">${r.deltaHtml}</td>
        </tr>
      `
        )
        .join('');

    for (const tbody of qAll('[id="telemetry-diff-tbody"]')) {
      tbody.innerHTML = renderMetricRows(primaryCoreRows);
    }

    for (const tbody of qAll('[id="secondary-telemetry-tbody"]')) {
      tbody.innerHTML = renderMetricRows(secondaryCoreRows);
    }

    // 3. Stage-by-Stage S1-S7 Rows (Separate Disclosure Table)
    {
      const maxStageCost = Math.max(
        0.01,
        ...stagesList.flatMap((s) => [
          a.stages[s.id]?.costUsd ?? 0,
          b.stages[s.id]?.costUsd ?? 0,
        ])
      );

      let sumCallsA = 0;
      let sumCallsB = 0;
      let sumCostA = 0;
      let sumCostB = 0;
      let hasAnySliceA = false;
      let hasAnySliceB = false;

      const stageRowsMarkup = stagesList
        .map((st) => {
          const sA = a.stages[st.id];
          const sB = b.stages[st.id];
          const hasA = Boolean(sA && sA.llmCalls > 0);
          const hasB = Boolean(sB && sB.llmCalls > 0);

          if (hasA && sA) {
            hasAnySliceA = true;
            sumCallsA += sA.llmCalls;
            sumCostA += sA.costUsd;
          }
          if (hasB && sB) {
            hasAnySliceB = true;
            sumCallsB += sB.llmCalls;
            sumCostB += sB.costUsd;
          }

          const wA = Math.min(100, ((sA?.costUsd ?? 0) / maxStageCost) * 100).toFixed(1);
          const wB = Math.min(100, ((sB?.costUsd ?? 0) / maxStageCost) * 100).toFixed(1);

          const solePassA = Boolean(sA?.completed && !sB?.completed);
          const solePassB = Boolean(sB?.completed && !sA?.completed);
          const missA = !sA?.completed ? `<span class="stage-miss-tag">Missed</span>` : '';
          const missB = !sB?.completed ? `<span class="stage-miss-tag">Missed</span>` : '';

          const leadCostA = hasA && hasB && sA && sB && sA.costUsd < sB.costUsd;
          const leadCostB = hasA && hasB && sA && sB && sB.costUsd < sA.costUsd;

          const cellAText =
            hasA && sA
              ? `<div class="stage-cell-line">
                   ${missA}
                   <span class="stage-cost ${leadCostA ? 'is-lead' : ''}">${usd.format(sA.costUsd)}</span>
                   <span class="stage-inline-meta">· ${sA.llmCalls} turns</span>
                 </div>
                 <div class="stage-compare-bar-track" aria-hidden="true"><span class="stage-compare-bar-fill-a" style="inline-size:${wA}%"></span></div>`
              : `<div class="stage-cell-line">
                   ${missA}
                   <span class="delta-neutral">${sA?.completed ? 'Passed (no slice log)' : 'Not completed'}</span>
                 </div>`;

          const cellBText =
            hasB && sB
              ? `<div class="stage-cell-line">
                   ${missB}
                   <span class="stage-cost ${leadCostB ? 'is-lead' : ''}">${usd.format(sB.costUsd)}</span>
                   <span class="stage-inline-meta">· ${sB.llmCalls} turns</span>
                 </div>
                 <div class="stage-compare-bar-track" aria-hidden="true"><span class="stage-compare-bar-fill-b" style="inline-size:${wB}%"></span></div>`
              : `<div class="stage-cell-line">
                   ${missB}
                   <span class="delta-neutral">${sB?.completed ? 'Passed (no slice log)' : 'Not completed'}</span>
                 </div>`;

          let deltaStr = '<span class="delta-neutral">—</span>';
          if (solePassA || solePassB) {
            const passWin: 'a' | 'b' = solePassA ? 'a' : 'b';
            deltaStr = fmtDeltaCell(passWin, solePassA ? 'A passed (B missed)' : 'B passed (A missed)');
          } else if (hasA && hasB && sA && sB) {
            const callDiff = sA.llmCalls - sB.llmCalls;
            const costDiff = sA.costUsd - sB.costUsd;
            const stWinner: 'a' | 'b' | 'par' =
              Math.abs(costDiff) < 0.005 ? 'par' : costDiff < 0 ? 'a' : 'b';
            deltaStr = fmtDeltaCell(
              stWinner,
              stWinner === 'par'
                ? `Par (${callDiff >= 0 ? '+' : ''}${callDiff}t)`
                : `-${usd.format(Math.abs(costDiff))} (${callDiff >= 0 ? '+' : ''}${callDiff}t)`
            );
          } else if (sA?.completed && sB?.completed) {
            deltaStr = `<span class="delta-neutral">Both passed</span>`;
          }

          return `
            <tr>
              <th scope="row">
                <strong>${st.id}: ${st.title}</strong>
              </th>
              <td class="mono" data-cell="${labelA}">${cellAText}</td>
              <td class="mono" data-cell="${labelB}">${cellBText}</td>
              <td class="mono" data-cell="Stage difference">${deltaStr}</td>
            </tr>
          `;
        })
        .join('');

      for (const tbody of qAll('[id="stage-diff-tbody"]')) {
        tbody.innerHTML = stageRowsMarkup;
      }

      const footWinner: 'a' | 'b' | 'par' =
        hasAnySliceA && hasAnySliceB
          ? Math.abs(sumCostA - sumCostB) < 0.005
            ? 'par'
            : sumCostA < sumCostB
              ? 'a'
              : 'b'
          : 'par';

      const footCallDiff = sumCallsA - sumCallsB;
      const footMarkup = `
        <tr>
          <th scope="row"><strong>S1–S7 Total</strong></th>
          <td class="mono" data-cell="${labelA}">
            ${
              hasAnySliceA
                ? `<span class="cell-primary ${footWinner === 'a' ? 'is-lead' : ''}">${usd.format(sumCostA)}</span> <span class="cell-inline-muted">· ${sumCallsA} turns</span>`
                : `<span class="delta-neutral">${usd.format(a.costUsd)} (${a.llmCalls} turns)</span>`
            }
          </td>
          <td class="mono" data-cell="${labelB}">
            ${
              hasAnySliceB
                ? `<span class="cell-primary ${footWinner === 'b' ? 'is-lead' : ''}">${usd.format(sumCostB)}</span> <span class="cell-inline-muted">· ${sumCallsB} turns</span>`
                : `<span class="delta-neutral">${usd.format(b.costUsd)} (${b.llmCalls} turns)</span>`
            }
          </td>
          <td class="mono" data-cell="Stage difference">
            ${
              hasAnySliceA && hasAnySliceB
                ? fmtDeltaCell(
                    footWinner,
                    footWinner === 'par'
                      ? '$0.00'
                      : `-${usd.format(Math.abs(sumCostA - sumCostB))} (${footCallDiff >= 0 ? '+' : ''}${footCallDiff}t)`
                  )
                : `<span class="delta-neutral">Diff: ${usd.format(Math.abs(a.costUsd - b.costUsd))}</span>`
            }
          </td>
        </tr>
      `;
      for (const tfoot of qAll('[id="stage-diff-tfoot"]')) {
        tfoot.innerHTML = footMarkup;
      }
    }

    // 4. Populate Collapsible Deep Accounting Drawer
    {
      const stdCostLead: 'a' | 'b' | 'par' =
        Math.abs(a.standardApiCostUsd - b.standardApiCostUsd) < 0.005
          ? 'par'
          : a.standardApiCostUsd < b.standardApiCostUsd
            ? 'a'
            : 'b';
      const deepRows = [
        {
          label: 'Standard API Equivalent Cost',
          valA: usd.format(a.standardApiCostUsd),
          valB: usd.format(b.standardApiCostUsd),
          delta:
            stdCostLead === 'par'
              ? fmtDeltaCell('par', '$0.00')
              : fmtDeltaCell(
                  stdCostLead,
                  `-${usd.format(Math.abs(a.standardApiCostUsd - b.standardApiCostUsd))}`
                ),
        },
        {
          label: 'Uncached Counterfactual (0% Cache)',
          valA: `${usd.format(a.uncachedCostUsd)} <span class="cell-inline-muted">(-${usd.format(a.cacheSavingsUsd)} saved)</span>`,
          valB: `${usd.format(b.uncachedCostUsd)} <span class="cell-inline-muted">(-${usd.format(b.cacheSavingsUsd)} saved)</span>`,
          delta: fmtDeltaCell('info', `Discount: ${a.cacheSavingsPct}% vs ${b.cacheSavingsPct}%`),
        },
        {
          label: 'Prefix Cache Hit Rate',
          valA: `${a.tokens.cacheHitRatePct}% <span class="cell-inline-muted">(${fmtCompact(a.tokens.uncachedInput)} uncached)</span>`,
          valB: `${b.tokens.cacheHitRatePct}% <span class="cell-inline-muted">(${fmtCompact(b.tokens.uncachedInput)} uncached)</span>`,
          delta: fmtDeltaCell(
            'info',
            `${a.tokens.cacheHitRatePct >= b.tokens.cacheHitRatePct ? '+' : ''}${(a.tokens.cacheHitRatePct - b.tokens.cacheHitRatePct).toFixed(2)}%pt`
          ),
        },
        {
          label: 'Output & Reasoning Tokens',
          valA: `${fmtCompact(a.tokens.output)} out <span class="cell-inline-muted">(${fmtCompact(a.tokens.thinking)} think)</span>`,
          valB: `${fmtCompact(b.tokens.output)} out <span class="cell-inline-muted">(${fmtCompact(b.tokens.thinking)} think)</span>`,
          delta: fmtDeltaCell(
            'info',
            `${a.tokens.thinking >= b.tokens.thinking ? '+' : ''}${fmtCompact(a.tokens.thinking - b.tokens.thinking)} think`
          ),
        },
        {
          label: 'Tool Errors & Task Polling',
          valA: `${a.toolErrorCalls} err · ${a.pollingCalls} polls`,
          valB: `${b.toolErrorCalls} err · ${b.pollingCalls} polls`,
          delta: fmtDeltaCell(
            'info',
            `${a.toolErrorCalls - b.toolErrorCalls >= 0 ? '+' : ''}${a.toolErrorCalls - b.toolErrorCalls} err · ${a.pollingCalls - b.pollingCalls >= 0 ? '+' : ''}${a.pollingCalls - b.pollingCalls} polls`
          ),
        },
      ];

      for (const tbody of qAll('[id="deep-accounting-tbody"]')) {
        tbody.innerHTML = deepRows
          .map(
            (r) => `
            <tr>
              <th scope="row" class="col-metric"><strong>${r.label}</strong></th>
              <td class="mono col-run-a" data-cell="${labelA}">${r.valA}</td>
              <td class="mono col-run-b" data-cell="${labelB}">${r.valB}</td>
              <td class="mono col-delta" data-cell="Difference">${r.delta}</td>
            </tr>
          `
          )
          .join('');
      }
    }

    try {
      const params = new URLSearchParams(window.location.search);
      params.set('a', a.id);
      params.set('b', b.id);
      const nextUrl = `${window.location.pathname}?${params.toString()}`;
      if (nextUrl !== `${window.location.pathname}${window.location.search}`) {
        window.history.replaceState(null, '', nextUrl);
      }
    } catch {}
  }

  try {
    const params = new URLSearchParams(window.location.search);
    const paramPreset = params.get('preset');
    const paramA = params.get('a');
    const paramB = params.get('b');

    if (paramPreset) {
      const found = presetsList.find((p) => p.id === paramPreset);
      if (found) {
        activeRunAId = found.runAId;
        activeRunBId = found.runBId;
      }
    }
    if (paramA && runsById.has(paramA)) {
      activeRunAId = paramA;
    }
    if (paramB && runsById.has(paramB)) {
      activeRunBId = paramB;
    }
  } catch {}

  renderComparison();

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    if (target.id === 'select-run-a' && target instanceof HTMLSelectElement) {
      activeRunAId = target.value;
      renderComparison();
    } else if (target.id === 'select-run-b' && target instanceof HTMLSelectElement) {
      activeRunBId = target.value;
      renderComparison();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const swap = target.closest('#swap-runs-btn');
    if (swap) {
      const tmp = activeRunAId;
      activeRunAId = activeRunBId;
      activeRunBId = tmp;
      renderComparison();
      return;
    }
    const presetBtn = target.closest<HTMLButtonElement>('.preset-btn');
    if (presetBtn) {
      const rA = presetBtn.dataset.runA;
      const rB = presetBtn.dataset.runB;
      if (rA && rB) {
        activeRunAId = rA;
        activeRunBId = rB;
        renderComparison();
      }
    }
  });
</script>
