    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .run-detail-quiet .tool-bar-track {
    block-size: 0.35rem;
    border-width: 1px;
    border-color: var(--border-subtle-color);
  }

  .run-detail-quiet .tool-bar-done {
    background-color: var(--hl-acid);
  }

  :global([data-theme="light"]) .run-detail-quiet .tool-bar-done {
    background-color: var(--raw-ebony);
  }

  /* Terminal & Commit Log */
  .run-detail-quiet .terminal-box {
    border-width: 1px;
    border-color: var(--border-subtle-color);
    background-color: var(--bg-surface);
    font-size: 0.875rem;
  }

  .run-detail-quiet .interface-footer-meta {
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .run-detail-quiet .commit-row {
    padding: 0.9rem 0.65rem;
  }

  .run-detail-quiet .commit-hash {
    font-size: 0.8125rem;
    background-color: transparent;
    border-color: var(--border-subtle-color);
    color: var(--text-secondary);
  }

  .run-detail-quiet .commit-stage-badge {
    font-size: 0.8125rem;
    border: 1px solid var(--border-subtle-color);
    background-color: transparent;
    color: var(--text-muted);
    padding: 0.08rem 0.4rem;
  }

  .run-detail-quiet .commit-stage-badge.is-miss {
    border-color: var(--hl-magenta);
    color: var(--text-primary);
  }

  .run-detail-quiet .commit-msg {
    font-size: 0.875rem;
  }

  .run-detail-quiet .commit-author,
  .run-detail-quiet .commit-time {
    font-size: 0.8125rem;
  }

  /* Sibling Runs & Bottom Pager */
  .run-detail-quiet .detail-siblings-bar {
    background-color: transparent;
    border: none;
    border-block-end: 1px solid var(--border-subtle-color);
    padding: 2.5rem 0;
    margin-block-start: 0;
    gap: 1rem;
  }

  .run-detail-quiet .detail-siblings-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: normal;
    text-transform: none;
  }

  .run-detail-quiet .detail-sibling-chip {
    min-block-size: 2.75rem;
    padding: 0.55rem 0.85rem;
    font-size: 0.875rem;
    gap: 0.55rem;
  }

  .run-detail-quiet .detail-sibling-rel,
  .run-detail-quiet .detail-sibling-delta {
    font-size: 0.8125rem;
  }

  .run-detail-quiet .detail-bottom-pager {
    margin-block-start: 2.5rem;
  }

  .run-detail-quiet .detail-pager-card {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-strong-color);
    padding: 1.35rem 1.5rem;
    min-block-size: 2.75rem;
  }

  .run-detail-quiet .detail-pager-dir {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    letter-spacing: normal;
    text-transform: none;
  }

  .run-detail-quiet .detail-pager-meta {
    font-size: 0.8125rem;
  }
</style>
<script>
  function bindCopyButton(btnId: string, statusId: string, label: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const status = document.getElementById(statusId) as HTMLElement | null;
    btn?.addEventListener('click', async () => {
      const cmd = btn.dataset.cmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const original = btn.textContent;
        btn.textContent = '✓ Copied!';
        if (status) status.textContent = `${label} copied to clipboard.`;
        setTimeout(() => {
          btn.textContent = original;
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        btn.textContent = 'Failed to copy';
        if (status) status.textContent = `Failed to copy ${label.toLowerCase()}.`;
      }
    });
  }

  bindCopyButton('copy-cmd-btn', 'copy-cmd-status', 'Command');
  bindCopyButton('copy-commits-btn', 'copy-commits-status', 'Commit log');

  const backLink = document.getElementById('back-to-leaderboard-link') as HTMLAnchorElement | null;
  if (backLink && document.referrer) {
    try {
      const refUrl = new URL(document.referrer);
      if (
        refUrl.origin === window.location.origin &&
        (refUrl.pathname === '/' || refUrl.pathname === '') &&
        refUrl.search
      ) {
        backLink.href = `/${refUrl.search}`;
      }
    } catch {}
  }

  const notesSection = document.getElementById('notes-section') as HTMLElement | null;
  const toggleNotesBtn = document.getElementById('toggle-notes-btn') as HTMLButtonElement | null;
  const toggleNotesLabel = document.getElementById('toggle-notes-label') as HTMLElement | null;
  const toggleNotesStatus = document.getElementById('toggle-notes-status') as HTMLElement | null;
  const noteDisclosures = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('#notes-section .note-disclosure')
  );

  function syncToggleNotesBtn() {
    if (!toggleNotesBtn || noteDisclosures.length === 0) return;
    const allOpen = noteDisclosures.every((d) => d.open);
    const labelText = allOpen ? 'Collapse All Notes' : 'Expand All Notes';
    if (toggleNotesLabel) {
      toggleNotesLabel.textContent = labelText;
    } else {
      toggleNotesBtn.textContent = labelText;
    }
    toggleNotesBtn.setAttribute('aria-expanded', String(allOpen));
  }


  toggleNotesBtn?.addEventListener('click', () => {
    const allOpen = noteDisclosures.every((d) => d.open);
    const nextOpen = !allOpen;
    for (const d of noteDisclosures) {
      d.open = nextOpen;
    }
    syncToggleNotesBtn();
    if (!nextOpen && notesSection && notesSection.getBoundingClientRect().top < 0) {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      notesSection.scrollIntoView({ behavior: prefersReduced ? 'instant' : 'smooth', block: 'start' });
    }
    if (toggleNotesStatus) {
      toggleNotesStatus.textContent = nextOpen
        ? `Expanded all ${noteDisclosures.length} field notes.`
        : `Collapsed all ${noteDisclosures.length} field notes.`;
    }
  });

  for (const d of noteDisclosures) {
    d.addEventListener('toggle', syncToggleNotesBtn);
  }

  const notePermalinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.note-permalink-btn')
  );
  for (const link of notePermalinks) {
    link.addEventListener('click', async (e) => {
      const noteHash = link.dataset.noteHash;
      const noteLabel = link.dataset.noteLabel || noteHash;
      if (!noteHash) return;
      e.preventDefault();
      const fullUrl = `${window.location.origin}${window.location.pathname}${noteHash}`;
      try {
        await navigator.clipboard.writeText(fullUrl);
        const original = link.textContent;
        link.textContent = `✓ Copied ${noteLabel} link`;
        if (toggleNotesStatus) {
          toggleNotesStatus.textContent = `Copied ${noteLabel} link to clipboard.`;
        }
        setTimeout(() => {
          link.textContent = original;
          if (toggleNotesStatus) toggleNotesStatus.textContent = '';
        }, 1800);
      } catch {
        window.location.hash = noteHash;
      }
    });
  }

  const tableWrappers = Array.from(document.querySelectorAll<HTMLElement>('.table-wrapper'));
  if (tableWrappers.length > 0) {
    const syncTableWrapperFocus = () => {
      for (const wrapper of tableWrappers) {
        if (wrapper.scrollWidth > wrapper.clientWidth + 1) {
          wrapper.setAttribute('tabindex', '0');
        } else {
          wrapper.removeAttribute('tabindex');
        }
      }
    };
    syncTableWrapperFocus();
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(syncTableWrapperFocus);
      for (const wrapper of tableWrappers) {
        ro.observe(wrapper);
      }
    }
    const techDisclosures = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('.tech-disclosure')
    );
    for (const td of techDisclosures) {
      td.addEventListener('toggle', syncTableWrapperFocus);
    }
  }

  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#detail-jump-bar .detail-jump-link')
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(
      '#plan-section, #notes-section, #slice-section, #tokens-cost-section, #calls-section, #interface-section, #commits-section, #siblings-section'
    )
  );

  if (jumpLinks.length > 0 && sections.length > 0) {
    const updateActiveSection = () => {
      const triggerY = window.innerHeight * 0.25;
      let activeId = sections[0].id;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= triggerY) {
          activeId = sec.id;
        }
      }
      for (const link of jumpLinks) {
        const isActive = link.getAttribute('href') === `#${activeId}`;
        link.setAttribute('aria-current', isActive ? 'true' : 'false');
      }
    };
    updateActiveSection();
    document.addEventListener('scroll', updateActiveSection, { passive: true });
    window.addEventListener('resize', updateActiveSection, { passive: true });
  }

  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.isComposing || e.repeat || e.metaKey || e.ctrlKey || e.altKey) {
      return;
    }
    if (window.getSelection()?.toString()) return;

    const target = e.target as HTMLElement | null;
    if (
      target &&
      (target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT' ||
        target.isContentEditable)
    ) {
      return;
    }

    const interactiveAncestor = target?.closest<HTMLElement>(
      'a, button, summary, input, textarea, select, [contenteditable="true"], [role="button"], [role="link"], [role="region"][tabindex], [tabindex]:not([tabindex="-1"])'
    );

    if (e.key === '[') {
      const prev = document.getElementById('prev-run-link') as HTMLAnchorElement | null;
      if (!prev || (interactiveAncestor && interactiveAncestor !== prev)) return;
      e.preventDefault();
      window.location.href = prev.href;
    } else if (e.key === ']') {
      const next = document.getElementById('next-run-link') as HTMLAnchorElement | null;
      if (!next || (interactiveAncestor && interactiveAncestor !== next)) return;
      e.preventDefault();
      window.location.href = next.href;
    } else if (e.key === 'e' && toggleNotesBtn && notesSection) {
      const isFocusOnToggle = interactiveAncestor === toggleNotesBtn;
      const isFocusInsideNotes = Boolean(
        target &&
          notesSection.contains(target) &&
          (!interactiveAncestor ||
            interactiveAncestor === toggleNotesBtn ||
            interactiveAncestor.tagName === 'SUMMARY')
      );
      const rect = notesSection.getBoundingClientRect();
      const isNotesInViewport = rect.top < window.innerHeight && rect.bottom > 0;
      const isUnfocusedBody = !interactiveAncestor && isNotesInViewport;

      if (!isFocusOnToggle && !isFocusInsideNotes && !isUnfocusedBody) return;
      e.preventDefault();
      toggleNotesBtn.click();
    }
  });
</script>
