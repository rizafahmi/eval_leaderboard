---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import { createCssVariablesTheme } from 'shiki';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  formatHarnessName,
  formatProviderName,
  getPlanStats,
  matchSliceStageId,
  matchCommitStageId,
  getStepRangeCount,
  splitContextWindow,
  splitCostString,
  parseNoteBullet,
  tokenizeNoteText,
} from '../../utils/format';
import { BENCHMARK_STAGES } from '../../data/benchmark';
import { analyzeAndRankRuns } from '../../utils/telemetry';

const neoAcidCodeTheme = createCssVariablesTheme({
  name: 'neo-acid',
  variablePrefix: '--code-',
});

export async function getStaticPaths() {
  const runs = await getCollection('runs', ({ data }) => data.published !== false);
  const sorted = analyzeAndRankRuns(runs);

  const durations = sorted.map((r) => r.data.durationMinutes);
  const costs = sorted.map((r) => r.data.costUsd);
  const fastestMin = durations.length > 0 ? Math.min(...durations) : 0;
  const slowestMin = durations.length > 0 ? Math.max(...durations) : 0;
  const lowestCost = costs.length > 0 ? Math.min(...costs) : 0;
  const highestCost = costs.length > 0 ? Math.max(...costs) : 0;
  const totalRuns = sorted.length;

  const toNavSummary = (r: (typeof sorted)[number], rIdx: number) => {
    const rPlan = getPlanStats(r.data.planCompletion);
    return {
      id: r.id,
      rank: rIdx + 1,
      harness: formatHarnessName(r.data.codingHarness),
      model: r.data.model,
      effort: r.data.effort,
      costUsd: r.data.costUsd,
      durationMinutes: r.data.durationMinutes,
      completed: rPlan.completed,
      total: rPlan.total,
      ratio: rPlan.ratio,
    };
  };

  return sorted.map((entry, idx) => {
    const prevRun = idx > 0 ? toNavSummary(sorted[idx - 1], idx - 1) : null;
    const nextRun = idx < sorted.length - 1 ? toNavSummary(sorted[idx + 1], idx + 1) : null;
    const sameModel = sorted
      .map((r, i) => ({ r, i }))
      .filter(({ r, i }) => i !== idx && r.data.model.toLowerCase() === entry.data.model.toLowerCase())
      .map(({ r, i }) => ({ ...toNavSummary(r, i), relation: 'same-model' as const }));
    const sameHarness = sorted
      .map((r, i) => ({ r, i }))
      .filter(
        ({ r, i }) =>
          i !== idx &&
          r.data.model.toLowerCase() !== entry.data.model.toLowerCase() &&
          formatHarnessName(r.data.codingHarness) === formatHarnessName(entry.data.codingHarness)
      )
      .map(({ r, i }) => ({ ...toNavSummary(r, i), relation: 'same-harness' as const }));
    const siblingRuns = [...sameModel, ...sameHarness].slice(0, 4);

    return {
      params: { id: entry.id },
      props: {
        entry,
        telemetry: entry,
        rank: idx + 1,
        totalRuns,
        fastestMin,
        slowestMin,
        lowestCost,
        highestCost,
        prevRun,
        nextRun,
        siblingRuns,
      },
    };
  });
}

const {
  entry,
  telemetry,
  rank,
  totalRuns,
  fastestMin,
  slowestMin,
  lowestCost,
  highestCost,
  prevRun,
  nextRun,
  siblingRuns,
} = Astro.props;
const d = entry.data;
const plan = getPlanStats(d.planCompletion);

const stageMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));
const sliceByStage = new Map<
  string,
  { llmCalls: number; costUsd: number; isPeak: boolean }
>();

const hasInterface =
  d.interface && (d.interface.command || d.interface.details || d.interface.type);
const hasTokenSection =
  (d.tokens && (d.tokens.input || d.tokens.output || d.tokens.cacheHitRate)) ||
  Boolean(d.contextWindow);
const hasCallsSection =
  d.calls && (d.calls.llmCalls !== undefined || d.calls.toolCalls !== undefined);
const hasCommitLog = d.commitLog && d.commitLog.length > 0;
const uniqueCommitAuthors = hasCommitLog
  ? Array.from(new Set(d.commitLog!.map((c) => c.author).filter(Boolean)))
  : [];
const singleCommitAuthor = uniqueCommitAuthors.length === 1 ? uniqueCommitAuthors[0] : null;
const hasRelativeCommitTimes = Boolean(d.commitLog?.some((c) => Boolean(c.relativeTime)));
const commitLogText = d.commitLog
  ? d.commitLog
      .map((c) => {
        const rel = c.relativeTime ? `(${c.relativeTime} before capture)  ` : '';
        return `* ${c.hash}  ${rel}${c.message}`;
      })
      .join('\n')
  : '';
const hasCostBreakdown = d.costBreakdown && d.costBreakdown.length > 0;
const costItemRows =
  d.costBreakdown?.filter((r) => !r.component.trim().toLowerCase().startsWith('total')) ?? [];
const costTotalRows =
  d.costBreakdown?.filter((r) => r.component.trim().toLowerCase().startsWith('total')) ?? [];
const hasTokenOrCostSection = hasTokenSection || hasCostBreakdown;
const has2027Pricing = Boolean(
  d.costBreakdown?.some((r) => Boolean(r.rate2027) || Boolean(r.cost2027))
);
const costComparisonText = (d.costBreakdown ?? [])
  .map((r) => `${r.rate2026 ?? ''} ${r.cost2026 ?? ''} ${r.rate2027 ?? ''} ${r.cost2027 ?? ''}`)
  .join(' ');
const isAutoApiComparison =
  has2027Pricing && /Cursor Auto API|Auto API/i.test(costComparisonText);
const isGpt6SolComparison =
  has2027Pricing &&
  !isAutoApiComparison &&
  (/gpt-6\.1-sol/i.test(costComparisonText) ||
    (!/2027/.test(costComparisonText) &&
      (/95% off/i.test(costComparisonText) || d.model === 'gpt-6-sol')));
const costSectionSubtitle = hasCostBreakdown
  ? isAutoApiComparison
    ? 'Included Tier vs Standard API USD'
    : isGpt6SolComparison
      ? 'gpt-6-sol vs gpt-6.1-sol API USD'
      : has2027Pricing
        ? '2026 vs 2027 Standard API USD'
        : telemetry.costMetrics.profile?.billedTier.label ?? '2026 USD Rates'
  : 'Token Telemetry';
const costPrimaryRateHeader = isAutoApiComparison
  ? 'Billed Rate'
  : isGpt6SolComparison
    ? 'Rate (gpt-6-sol)'
    : has2027Pricing
      ? 'Rate (2026)'
      : 'Rate';
const costPrimaryCostHeader = isAutoApiComparison
  ? 'Billed Cost'
  : isGpt6SolComparison
    ? 'Cost (gpt-6-sol)'
    : has2027Pricing
      ? 'Cost (2026 Rate)'
      : 'Estimated Cost';
const costComparisonRateHeader = isAutoApiComparison
  ? 'Standard API Rate'
  : isGpt6SolComparison
    ? 'Rate (gpt-6.1-sol)'
    : 'Rate (2027)';
const costComparisonCostHeader = isAutoApiComparison
  ? 'Standard API Cost'
  : isGpt6SolComparison
    ? 'Cost (gpt-6.1-sol)'
    : 'Cost (2027 Rate)';
const costTableCaption = isAutoApiComparison
  ? 'Token volume and estimated cost breakdown comparing billed tier and standard API rates'
  : isGpt6SolComparison
    ? 'Token volume and estimated cost breakdown comparing gpt-6-sol and gpt-6.1-sol pricing rates'
    : has2027Pricing
      ? 'Token volume and estimated cost breakdown comparing 2026 and 2027 pricing rates'
      : 'Token volume and estimated cost breakdown';
const hasSliceBreakdown = d.sliceBreakdown && d.sliceBreakdown.length > 0;
const hasTaskPolls = Boolean(d.sliceBreakdown?.some((r) => (r.manageTaskPolls ?? 0) > 0));
const hasSliceThinking = Boolean(
  d.sliceBreakdown?.some((r) => r.thinkingTokens !== undefined && r.thinkingTokens > 0)
);
const totalSliceLlmCalls = d.sliceBreakdown?.reduce((sum, r) => sum + r.llmCalls, 0) ?? 0;
const totalSliceSteps =
  d.sliceBreakdown?.reduce((sum, r) => sum + (getStepRangeCount(r.stepRange) ?? 0), 0) ?? 0;
const totalSlicePolls =
  d.sliceBreakdown?.reduce((sum, r) => sum + (r.manageTaskPolls ?? 0), 0) ?? 0;
const totalSliceThinking =
  d.sliceBreakdown?.reduce((sum, r) => sum + (r.thinkingTokens ?? 0), 0) ?? 0;
const totalSliceCostUsd = d.sliceBreakdown?.reduce((sum, r) => sum + r.costUsd, 0) ?? 0;
const displaySliceTotalCostUsd =
  Math.abs(totalSliceCostUsd - d.costUsd) <= 0.02 ? d.costUsd : totalSliceCostUsd;
const hasNotesDetails = d.notesDetails && d.notesDetails.length > 0;
const hasNotes = (d.notes && d.notes.length > 0) || hasNotesDetails;

const maxToolCalls =
  d.calls?.toolCalls?.breakdown && d.calls.toolCalls.breakdown.length > 0
    ? Math.max(...d.calls.toolCalls.breakdown.map((b) => b.total))
    : 1;

const isCostLeader = plan.ratio === 1 && 1.0 >= d.costUsd;
const hasTestFailures = Boolean(d.tests && d.tests.total > d.tests.passed);
const rawMaxSliceCost =
  hasSliceBreakdown && d.sliceBreakdown!.length > 1
    ? Math.max(...d.sliceBreakdown!.map((r) => r.costUsd))
    : 0;
const maxSliceCost = rawMaxSliceCost > 0 ? rawMaxSliceCost : 0;
const maxSliceCalls =
  hasSliceBreakdown && d.sliceBreakdown!.length > 1
    ? Math.max(...d.sliceBreakdown!.map((r) => r.llmCalls))
    : 0;

let nonStageLlmCalls = 0;
let nonStageCostUsd = 0;

if (hasSliceBreakdown) {
  for (const row of d.sliceBreakdown!) {
    const stageId = matchSliceStageId(row.slice);
    if (stageId) {
      const prev = sliceByStage.get(stageId);
      const combinedCost = (prev?.costUsd ?? 0) + row.costUsd;
      const combinedCalls = (prev?.llmCalls ?? 0) + row.llmCalls;
      const isRowPeak =
        maxSliceCost > 0
          ? row.costUsd === maxSliceCost
          : maxSliceCalls > 0 && row.llmCalls === maxSliceCalls;
      sliceByStage.set(stageId, {
        llmCalls: combinedCalls,
        costUsd: Number(combinedCost.toFixed(4)),
        isPeak: (prev?.isPeak ?? false) || isRowPeak,
      });
    } else {
      nonStageLlmCalls += row.llmCalls;
      nonStageCostUsd = Number((nonStageCostUsd + row.costUsd).toFixed(4));
    }
  }
}

const committedStageIds = new Set<string>();
if (hasCommitLog) {
  for (const c of d.commitLog!) {
    const stageId = matchCommitStageId(c.message);
    if (stageId) {
      committedStageIds.add(stageId);
    }
  }
}

function isStageInRange(stageId: string, text: string): boolean {
  const stageNum = Number(stageId.slice(1));
  if (isNaN(stageNum)) return false;
  for (const match of text.matchAll(/\bS([1-7])\s*[–-]\s*S([1-7])\b/gi)) {
    const start = Number(match[1]);
    const end = Number(match[2]);
    if (stageNum >= Math.min(start, end) && stageNum <= Math.max(start, end)) {
      return true;
    }
  }
  return false;
}

let firstFailureNoteIdx: number | null = null;
const missedStageNoteAnchor = new Map<string, { href: string; label: string }>();
if (hasNotes && plan.ratio < 1) {
  for (const [stageId, completed] of plan.entries) {
    if (!completed) {
      const stageRegex = new RegExp(`\\b${stageId}\\b`, 'i');
      if (hasNotesDetails) {
        let matchIdx = d.notesDetails!.findIndex((n) => {
          const mainTitle = n.title.replace(/\([^)]*\)/g, '');
          return (
            stageRegex.test(mainTitle) ||
            (new RegExp(`S[1-7]\\s*[–-]\\s*S[1-7]`, 'i').test(mainTitle) &&
              isStageInRange(stageId, mainTitle))
          );
        });
        if (matchIdx === -1) {
          matchIdx = d.notesDetails!.findIndex(
            (n) =>
              stageRegex.test(n.title) ||
              (new RegExp(`S[1-7]\\s*[–-]\\s*S[1-7]`, 'i').test(n.title) &&
                isStageInRange(stageId, n.title))
          );
        }
        if (matchIdx === -1) {
          matchIdx = d.notesDetails!.findIndex((n) =>
            n.bullets.some((b) => stageRegex.test(b) || isStageInRange(stageId, b))
          );
        }
        if (matchIdx !== -1) {
          if (firstFailureNoteIdx === null) {
            firstFailureNoteIdx = matchIdx;
          }
          const noteNum = String(matchIdx + 1).padStart(2, '0');
          missedStageNoteAnchor.set(stageId, {
            href: `#note-${matchIdx + 1}`,
            label: `Note #${noteNum} ↓`,
          });
          continue;
        }
      }
      missedStageNoteAnchor.set(stageId, {
        href: '#notes-section',
        label: 'Diagnosis ↓',
      });
    }
  }
}
const primaryFailureDiagHref =
  firstFailureNoteIdx !== null ? `#note-${firstFailureNoteIdx + 1}` : '#notes-section';

const displayHarness = formatHarnessName(d.codingHarness);
const displayProvider = formatProviderName(d.provider);
const metaSpecSummary = [
  displayProvider,
  d.effort ? `${d.effort} effort` : null,
  d.interface?.type ? d.interface.type.toUpperCase() : null,
]
  .filter(Boolean)
  .join(' · ');
const wallClockMatch = d.interface?.details?.match(
  /(?:wall-clock elapsed was\s+(\d+)\s*m|(\d+)\s*m\s+wall-clock)/i
);
const wallClockMinutes = wallClockMatch ? Number(wallClockMatch[1] ?? wallClockMatch[2]) : null;
const contextWindowParts = splitContextWindow(d.contextWindow);
const runDescription = `Riza Fahmi’s personal Elixir/OTP evaluation: ${displayHarness} / ${d.model} (${displayProvider}), ${plan.completed}/${plan.total} stages, ${formatDuration(d.durationMinutes)}, ${formatCost(d.costUsd)} billed. Other stacks may differ.`;
const peakStageId = telemetry.peakStageId;
const peakStageStat = peakStageId ? telemetry.stages[peakStageId] : null;
const peakStageTitle = peakStageId ? stageMap.get(peakStageId) : null;

let forensicSynopsis = '';
if (1 > plan.ratio) {
  const missedCount = plan.total - plan.completed;
  const missedNoun = missedCount === 1 ? 'slice' : 'slices';
  const peakClause =
    peakStageStat && peakStageStat.llmCalls > 0 && peakStageId
      ? ` — while ${peakStageId} (${peakStageTitle}) absorbed ${
          peakStageStat.costSharePct > 0
            ? `${peakStageStat.costSharePct}% of total budget (${formatCost(peakStageStat.costUsd)}, ${peakStageStat.llmCalls} calls)`
            : `${peakStageStat.llmCalls} LLM calls`
        }`
      : '';
  if (!hasTestFailures && d.tests && d.tests.total > 0) {
    forensicSynopsis = `Passed all ${d.tests.passed}/${d.tests.total} self-authored ExUnit tests yet missed ${missedCount} specification ${missedNoun} in post-run live verification${peakClause}.`;
  } else {
    forensicSynopsis = `Completed ${plan.completed} of ${plan.total} TDD slices in ${formatDuration(d.durationMinutes)} at ${formatCost(d.costUsd)}${peakClause}.`;
  }
} else {
  const clauses: string[] = [];
  if (telemetry.costMetrics.cacheSavingsUsd > 0 && d.tokens?.cacheHitRate && d.tokens?.total) {
    clauses.push(
      `Served ${d.tokens.cacheHitRate} of ${d.tokens.total} tokens from prefix cache — saving ${formatCost(telemetry.costMetrics.cacheSavingsUsd)} (${telemetry.costMetrics.cacheSavingsPct}%) vs. ${formatCost(telemetry.costMetrics.uncachedCounterfactualCostUsd)} uncached`
    );
  } else if (d.tokens?.total) {
    clauses.push(
      `Processed ${d.tokens.total} tokens across ${d.calls?.llmCalls ?? totalSliceLlmCalls} inference turns in ${formatDuration(d.durationMinutes)}`
    );
  }
  if (peakStageStat && peakStageStat.llmCalls > 0 && peakStageId) {
    const peakMetric =
      peakStageStat.costSharePct > 0
        ? `${peakStageStat.costSharePct}% of run cost (${formatCost(peakStageStat.costUsd)}, ${peakStageStat.llmCalls} calls)`
        : `${peakStageStat.llmCalls} LLM calls`;
    clauses.push(`concentrated peak effort in ${peakStageId} (${peakStageTitle}: ${peakMetric})`);
  }
  if (telemetry.toolErrorCalls > 0 && telemetry.toolTotalCalls > 0) {
    clauses.push(
      `recovered from ${telemetry.toolErrorCalls} tool ${telemetry.toolErrorCalls === 1 ? 'error' : 'errors'} across ${telemetry.toolTotalCalls} executions`
    );
  }
  forensicSynopsis = clauses.length > 0 ? `${clauses.join('; ')}.` : '';
}

const runLeadCopy = plan.ratio < 1 || hasTestFailures
  ? forensicSynopsis
  : hasNotesDetails
    ? d.notesDetails![0].title
    : d.notes?.[0] ?? '';

const hasSecondarySummary = Boolean(
  d.tests || d.tokens?.total || d.calls?.llmCalls !== undefined || d.commits !== undefined || d.contextWindow
);

const pageSections = [
  { id: 'plan-section', label: `Plan (${plan.completed}/${plan.total})` },
  ...(hasNotes
    ? [
        {
          id: 'notes-section',
          label: `Field Notes (${hasNotesDetails ? d.notesDetails!.length : d.notes!.length})`,
        },
      ]
    : []),
  ...(hasSliceBreakdown
    ? [{ id: 'slice-section', label: `Phases (${d.sliceBreakdown!.length})` }]
    : []),
  ...(hasTokenOrCostSection ? [{ id: 'tokens-cost-section', label: 'Tokens & Cost' }] : []),
  ...(hasCallsSection ? [{ id: 'calls-section', label: 'Calls & Tools' }] : []),
  ...(hasInterface ? [{ id: 'interface-section', label: 'Command' }] : []),
  ...(hasCommitLog
    ? [{ id: 'commits-section', label: `Commits (${d.commitLog!.length})` }]
    : []),
];
---

<BaseLayout
  title={`${displayHarness} — ${d.model}`}
  activeNav="leaderboard"
  description={runDescription}
  ogType="article"
>
  <div class="run-detail-quiet">
    <div class="detail-nav-row">
      <div class="detail-nav-left">
        <a href="/" class="detail-nav-link" id="back-to-leaderboard-link">
          <span aria-hidden="true">←</span> All runs
        </a>
        <a
          href={
            siblingRuns.length > 0
              ? `/compare?a=${entry.id}&b=${siblingRuns[0].id}`
              : `/compare?a=${entry.id}`
          }
          class="detail-nav-link"
        >
          Compare this run <span aria-hidden="true">→</span>
        </a>
      </div>
      <nav aria-label="Adjacent ranked runs" class="detail-nav-pager">
        {
          prevRun && (
            <a
              href={`/runs/${prevRun.id}`}
              class="detail-nav-link detail-nav-pager-btn"
              id="prev-run-link"
              aria-keyshortcuts="["
            >
              Previous run
              <span class="visually-hidden">: {prevRun.harness} / {prevRun.model}</span>
            </a>
          )
        }
        {
          nextRun && (
            <a
              href={`/runs/${nextRun.id}`}
              class="detail-nav-link detail-nav-pager-btn"
              id="next-run-link"
              aria-keyshortcuts="]"
            >
              Next run
              <span class="visually-hidden">: {nextRun.harness} / {nextRun.model}</span>
            </a>
          )
        }
      </nav>
    </div>

    <!-- Top Summary Header -->
    <section class="card detail-header-card" aria-labelledby="run-detail-heading">
      <div class="detail-top-row">
        <div class="detail-heading-block">
          <h1 id="run-detail-heading" class="headline-two-tone">
            {displayHarness}{' '}
            <span class="muted">/ {d.model}</span>
          </h1>
          <div class="entry-meta detail-entry-meta">
            <span class="detail-meta-rank">
              Rank <strong class="mono">#{rank}</strong> of <span class="mono">{totalRuns}</span>
            </span>
            <span class="detail-meta-sep" aria-hidden="true">·</span>
            <span class="detail-meta-text">{metaSpecSummary}</span>
            <span class="detail-meta-sep" aria-hidden="true">·</span>
            <span class="detail-meta-text">
              <time class="mono" datetime={d.timestamp}>{formatTimestamp(d.timestamp)}</time>
            </span>
            {telemetry.isParetoFrontier && (
              <>
                <span class="detail-meta-sep" aria-hidden="true">·</span>
                <span
                  class="detail-meta-pareto"
                  title={`Pareto Frontier #${telemetry.paretoOrder}: non-dominated on 7/7 speed and cost`}
                >
                  Pareto frontier <strong class="mono">#{telemetry.paretoOrder}</strong>
                </span>
              </>
            )}
            {d.commits !== undefined && (
              <>
                <span class="detail-meta-sep" aria-hidden="true">·</span>
                {hasCommitLog ? (
                  <a href="#commits-section" class="detail-meta-link">
                    <span class="mono">{d.commits}</span> {d.commits === 1 ? 'commit' : 'commits'} ↓
                  </a>
                ) : (
                  <span class="detail-meta-text">
                    <span class="mono">{d.commits}</span> {d.commits === 1 ? 'commit' : 'commits'}
                  </span>
                )}
              </>
            )}
            {siblingRuns.length > 0 && (
              <>
                <span class="detail-meta-sep" aria-hidden="true">·</span>
                <a href="#siblings-section" class="detail-meta-link">
                  Compare <span class="mono">{siblingRuns.length}</span> related{' '}
                  {siblingRuns.length === 1 ? 'run' : 'runs'} ↓
                </a>
              </>
            )}
          </div>
        </div>
      </div>

      {runLeadCopy && (
        <p class="detail-lead-copy">
          {runLeadCopy}
          {hasNotes && (
            <>
              {' '}
              <a
                href={plan.ratio < 1 ? primaryFailureDiagHref : '#notes-section'}
                class="detail-lead-link dossier-hook-link"
              >
                {plan.ratio < 1 ? 'Read failure diagnosis ↓' : 'Read field notes ↓'}
              </a>
            </>
          )}
        </p>
      )}

      <dl class="kpi-grid detail-kpi-grid">
        <div class="kpi-box">
          <dt class="kpi-label">Outcome</dt>
          <dd class="kpi-val">
            {plan.ratio < 1 || hasTestFailures ? (
              <span class="kpi-miss-underline">
                {plan.completed}/{plan.total} slices
              </span>
            ) : (
              `${plan.completed}/${plan.total} slices`
            )}
          </dd>
          <dd class="kpi-sub">
            {hasTestFailures && d.tests
              ? `${d.tests.total - d.tests.passed} test ${d.tests.total - d.tests.passed === 1 ? 'failure' : 'failures'} (${d.tests.passed}/${d.tests.total} passed)`
              : plan.ratio < 1
                ? `${plan.total - plan.completed} spec ${plan.total - plan.completed === 1 ? 'slice' : 'slices'} missed${d.tests ? ` · ${d.tests.passed}/${d.tests.total} ExUnit tests passed` : ''}`
                : d.tests
                  ? `All 7 specification slices passed · ${d.tests.passed}/${d.tests.total} tests`
                  : 'All 7 specification slices passed'}
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">Time Elapsed</dt>
          <dd class="kpi-val">{formatDuration(d.durationMinutes)}</dd>
          <dd class="kpi-sub">
            {wallClockMinutes && wallClockMinutes > d.durationMinutes
              ? `Active (${formatDuration(wallClockMinutes)} wall-clock incl. halts) · range ${formatDuration(fastestMin)}–${formatDuration(slowestMin)}`
              : `Range ${formatDuration(fastestMin)}–${formatDuration(slowestMin)} (${totalRuns} runs)`}
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">Estimated Cost</dt>
          <dd class="kpi-val">
            {
              isCostLeader ? (
                <span class="kpi-acid-underline">{formatCost(d.costUsd)}</span>
              ) : (
                formatCost(d.costUsd)
              )
            }
          </dd>
          <dd class="kpi-sub" title={telemetry.costMetrics.profile?.pricingStatusNote}>
            {telemetry.costMetrics.profile?.pricingBadge
              ? `${telemetry.costMetrics.profile.billedTier.label} (Nov 2026 · paid rate TBD)`
              : isCostLeader
                ? `Sub-$1.00 7/7 leader · range ${formatCost(lowestCost)}–${formatCost(highestCost)}`
                : `USD · range ${formatCost(lowestCost)}–${formatCost(highestCost)}`}
          </dd>
        </div>
      </dl>

      {(hasTestFailures || plan.ratio < 1) && (
        <div
          class:list={[
            'detail-verification-alert',
            hasTestFailures ? 'is-fail' : 'is-warn',
          ]}
          role="note"
          aria-label="Verification status"
        >
          <strong class="detail-test-tag">
            {hasTestFailures ? 'Test Diagnostic:' : 'Verification Divergence:'}
          </strong>
          <p class="detail-test-callout-copy">
            {d.tests?.details ??
              `Completed ${plan.completed} of ${plan.total} specification slices in post-run live verification.`}
            {!hasTestFailures && plan.ratio < 1 && d.tests
              ? ` (Agent ExUnit suite passed ${d.tests.passed}/${d.tests.total}; post-run live verification missed ${plan.total - plan.completed} ${plan.total - plan.completed === 1 ? 'slice' : 'slices'}.)`
              : ''}
          </p>
        </div>
      )}

      {hasSecondarySummary && (
        <details class="reading-disclosure header-secondary-disclosure">
          <summary class="tech-disclosure-summary">
            <span class="tech-summary-title">Test suite &amp; secondary run metrics</span>
            <span class="tech-summary-meta">Tests, context, calls &amp; commits</span>
          </summary>
          <div class="disclosure-body">
            {forensicSynopsis && plan.ratio === 1 && <p class="detail-lead-copy">{forensicSynopsis}</p>}
            <dl class="secondary-metrics-grid">
              {d.tests && (
                <div class="secondary-metric-item">
                  <dt class="kpi-label">Test Suite</dt>
                  <dd class="mono secondary-metric-val">
                    {hasTestFailures ? (
                      <span class="kpi-miss-underline">
                        {d.tests.passed}/{d.tests.total}
                      </span>
                    ) : (
                      `${d.tests.passed}/${d.tests.total}`
                    )}
                  </dd>
                  <dd class="kpi-sub">
                    {hasTestFailures
                      ? `${d.tests.total - d.tests.passed} failed · ${d.tests.total > 0 ? Math.round((d.tests.passed / d.tests.total) * 100) : 0}% passed${d.tests.durationSeconds !== undefined ? ` (${d.tests.durationSeconds}s)` : ''}`
                      : d.tests.durationSeconds !== undefined
                        ? `${d.tests.total > 0 ? Math.round((d.tests.passed / d.tests.total) * 100) : 0}% passed (${d.tests.durationSeconds}s)`
                        : 'ExUnit suite results'}
                  </dd>
                </div>
              )}

              {d.tokens?.total && (
                <div class="secondary-metric-item">
                  <dt class="kpi-label">Total Tokens</dt>
                  <dd class="mono secondary-metric-val">{d.tokens.total}</dd>
                  <dd class="kpi-sub">
                    {[
                      d.tokens.cacheHitRate ? `${d.tokens.cacheHitRate} cache hit` : null,
                      d.tokens.input ? `${d.tokens.input} uncached` : null,
                      d.tokens.output ? `${d.tokens.output} out` : null,
                    ]
                      .filter(Boolean)
                      .join(' · ') || 'Prompt + completion volume'}
                  </dd>
                </div>
              )}

              {d.calls?.llmCalls !== undefined && (
                <div class="secondary-metric-item">
                  <dt class="kpi-label">LLM &amp; Tool Calls</dt>
                  <dd class="mono secondary-metric-val">{d.calls.llmCalls} turns</dd>
                  <dd class="kpi-sub">
                    {d.calls.toolCalls?.total !== undefined
                      ? `${d.calls.toolCalls.total} tool executions${d.calls.toolCalls.error ? ` (${d.calls.toolCalls.error} errors)` : ''}`
                      : 'Completed inference turns'}
                  </dd>
                </div>
              )}

              {d.contextWindow && (
                <div class="secondary-metric-item">
                  <dt class="kpi-label">Peak Context</dt>
                  <dd class="mono secondary-metric-val">{contextWindowParts.headline}</dd>
                  <dd class="kpi-sub">{contextWindowParts.detail ?? 'Peak prompt context window'}</dd>
                </div>
              )}

              {d.commits !== undefined && (
                <div class="secondary-metric-item">
                  <dt class="kpi-label">Git Commits</dt>
                  <dd class="mono secondary-metric-val">{d.commits}</dd>
                  <dd class="kpi-sub">
                    {hasCommitLog ? 'Recorded in commit log below' : 'Checkpoints recorded'}
                  </dd>
                </div>
              )}
            </dl>

            {d.tests?.details && !hasTestFailures && plan.ratio === 1 && (
              <div class="detail-test-strip">
                <strong class="detail-test-tag is-pass">Verification Verdict:</strong>
                <p class="detail-test-callout-copy">{d.tests.details}</p>
              </div>
            )}
          </div>
        </details>
      )}
    </section>

    <nav aria-label="On this page" class="detail-jump-bar" id="detail-jump-bar">
      <span class="detail-jump-label">On this page:</span>
      <div class="detail-jump-links" id="detail-jump-links">
        {
          pageSections.map((sec) => (
            <a href={`#${sec.id}`} class="detail-jump-link">
              {sec.label}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="section-grid">
      <!-- Plan Completion Checklist -->
      <section class="card col-12" id="plan-section" aria-labelledby="plan-completion-heading">
        <div class="card-title">
          <div class="card-title-group">
            <h2 id="plan-completion-heading" class="card-heading headline-two-tone">
              Plan Completion{' '}<span class="muted">/ {plan.completed} of {plan.total} Slices</span>
            </h2>
            {nonStageLlmCalls > 0 && (
              <a href="#slice-nonstage" class="badge-static badge-link">
                +<span class="mono">{nonStageLlmCalls}</span> prep/wrap-up calls
                {nonStageCostUsd > 0 ? ` · ${formatCost(nonStageCostUsd)}` : ''} ↓
              </a>
            )}
            {!hasSliceBreakdown && (
              <span class="badge-static">Per-slice telemetry n/a</span>
            )}
          </div>
          <div class="card-title-group">
            {hasNotes && plan.ratio < 1 && (
              <a href={primaryFailureDiagHref} class="action-link plan-failure-diag-trigger">
                Read Failure Diagnosis <span aria-hidden="true">↓</span>
              </a>
            )}
            <a href="/about#stages" class="action-link">
              View Stage Specs <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <ul class="plan-checklist" role="list">
          {
            plan.entries.map(([stageId, completed]) => {
              const sliceStat = sliceByStage.get(stageId);
              const wasAttempted =
                completed ||
                Boolean(sliceStat && sliceStat.llmCalls > 0) ||
                committedStageIds.has(stageId) ||
                (!hasSliceBreakdown && !hasCommitLog && Boolean(d.tests && d.tests.total > 0));
              const missNoteLink = !completed ? missedStageNoteAnchor.get(stageId) : undefined;
              return (
                <li
                  id={`plan-${stageId.toLowerCase()}`}
                  class:list={[
                    'plan-item',
                    completed ? 'completed' : wasAttempted ? 'spec-miss' : 'incomplete',
                    { 'is-peak-stage': Boolean(sliceStat?.isPeak) },
                  ]}
                >
                  <div class="plan-item-head">
                    <span class="mono plan-stage-id">
                      {stageId}
                      <span class="visually-hidden">
                        : {completed ? 'Passed' : 'Missed'}
                        {sliceStat?.isPeak ? ' (Peak effort bottleneck)' : ''}
                      </span>
                    </span>
                    {stageMap.get(stageId) && (
                      <span class="plan-stage-title">{stageMap.get(stageId)}</span>
                    )}
                    <div class="plan-item-badges" aria-hidden="true">
                      {sliceStat?.isPeak && (
                        <span class="hl hl-acid plan-peak-badge">
                          Peak effort
                        </span>
                      )}
                      <span
                        class:list={[
                          'plan-status-badge',
                          completed ? 'is-pass' : 'is-miss',
                        ]}
                      >
                        {completed ? 'Passed' : 'Missed'}
                      </span>
                    </div>
                  </div>
                  <div class="plan-item-body">
                    <div class="plan-stage-links">
                      {!completed && sliceStat && (
                        <span class="plan-stage-telemetry is-discrepancy">
                          {committedStageIds.has(stageId) ||
                          (d.tests && d.tests.total > 0 && d.tests.passed === d.tests.total)
                            ? 'Built · failed live check'
                            : 'Attempted · incomplete'}
                        </span>
                      )}
                      {sliceStat ? (
                        <a
                          href={`#slice-${stageId.toLowerCase()}`}
                          class="mono plan-stage-telemetry"
                        >
                          {sliceStat.llmCalls} calls · {formatCost(sliceStat.costUsd)}<span aria-hidden="true"> ↓</span>
                        </a>
                      ) : (
                        <span class="plan-stage-telemetry">
                          {!completed && !wasAttempted
                            ? 'Not reached · 0 calls'
                            : !completed && wasAttempted
                              ? 'Built · failed live check'
                              : !hasSliceBreakdown
                                ? 'Slice passed'
                                : 'Bundled in adjacent slice'}
                        </span>
                      )}
                      {missNoteLink && (
                        <a href={missNoteLink.href} class="plan-stage-diag-link">
                          {missNoteLink.label}
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- Promoted: Notes & Key Findings (Forensic Investigations) -->
      {
        hasNotes && (
          <section
            class="card col-12"
            id="notes-section"
            aria-labelledby="notes-findings-heading"
          >
            <div class="card-title">
              <div class="card-title-group">
                <h2 id="notes-findings-heading" class="card-heading headline-two-tone">
                  Field Notes{' '}
                  <span class="muted">
                    / {hasNotesDetails ? d.notesDetails!.length : d.notes!.length} Observations
                  </span>
                </h2>
              </div>
              {hasNotesDetails && (
                <div>
                  {d.notesDetails!.length > 1 && (
                    <button
                      type="button"
                      class="btn btn-sm btn-secondary"
                      id="toggle-notes-btn"
                      aria-expanded="false"
                      aria-keyshortcuts="e"
                    >
                      <span id="toggle-notes-label">Expand All Notes</span>
                      <kbd class="menu-kbd" aria-hidden="true">e</kbd>
                    </button>
                  )}
                  <span
                    id="toggle-notes-status"
                    class="visually-hidden"
                    role="status"
                    aria-live="polite"
                  />
                </div>
              )}
            </div>

            {hasNotesDetails ? (
              <ol class="notes-list" role="list">
                {d.notesDetails!.map((note, idx) => {
                  const noteLeads = note.bullets
                    .map((b) => {
                      const p = parseNoteBullet(b);
                      return p.lead ? p.lead.map((s) => s.value).join('').replace(/:$/, '') : '';
                    })
                    .filter(Boolean);
                  return (
                    <li class="note-card">
                      <details
                        class="note-disclosure reading-disclosure"
                        id={`note-${idx + 1}`}
                        open={idx === (firstFailureNoteIdx ?? 0)}
                      >
                        <summary class="note-summary">
                          <span class="mono note-num" aria-hidden="true">
                            {String(idx + 1).padStart(2, '0')}
                          </span>
                          <strong class="note-title">
                            {tokenizeNoteText(note.title).map((seg) =>
                              seg.type === 'code' ? (
                                <code class="note-inline-code">{seg.value}</code>
                              ) : (
                                seg.value
                              )
                            )}
                          </strong>
                          <span class="note-count-badge">
                            ({note.bullets.length} {note.bullets.length === 1 ? 'point' : 'points'})
                          </span>
                          {noteLeads.length > 0 && (
                            <span class="note-summary-teaser">
                              {noteLeads.join(' · ')}
                            </span>
                          )}
                        </summary>
                        <div class="note-body disclosure-body">
                          <ul class="note-bullets" role="list">
                            {note.bullets.map((b) => {
                              const parsed = parseNoteBullet(b);
                              return (
                                <li
                                  class:list={[
                                    'note-bullet-item',
                                    {
                                      'is-intro': parsed.isIntro,
                                      'has-block-lead': parsed.isBlockLead,
                                    },
                                  ]}
                                >
                                  {parsed.lead && (
                                    <strong
                                      class:list={[
                                        'note-bullet-lead',
                                        { 'note-bullet-lead-block': parsed.isBlockLead },
                                      ]}
                                    >
                                      {parsed.lead.map((seg) =>
                                        seg.type === 'code' ? (
                                          <code class="note-inline-code">{seg.value}</code>
                                        ) : (
                                          seg.value
                                        )
                                      )}
                                    </strong>
                                  )}{' '}
                                  <span class="note-bullet-copy">
                                    {parsed.body.map((seg) =>
                                      seg.type === 'code' ? (
                                        <code class="note-inline-code">{seg.value}</code>
                                      ) : (
                                        seg.value
                                      )
                                    )}
                                  </span>
                                </li>
                              );
                            })}
                          </ul>
                          <div class="note-body-footer">
                            <a
                              href={`#note-${idx + 1}`}
                              class="action-link note-permalink-btn"
                              data-note-hash={`#note-${idx + 1}`}
                              data-note-label={`#note-${String(idx + 1).padStart(2, '0')}`}
                            >
                              Copy #note-{String(idx + 1).padStart(2, '0')} link
                            </a>
                          </div>
                        </div>
                      </details>
                    </li>
                  );
                })}
              </ol>
            ) : (
              <ol class="notes-list" role="list">
                {d.notes!.map((note, idx) => (
                  <li class="note-item">
                    <span class="mono note-num" aria-hidden="true">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span>
                      {tokenizeNoteText(note).map((seg) =>
                        seg.type === 'code' ? (
                          <code class="note-inline-code">{seg.value}</code>
                        ) : (
                          seg.value
                        )
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            )}
          </section>
        )
      }

      <!-- Secondary Technical Disclosures (Non-Exclusive Native Details) -->
      {
        hasSliceBreakdown && (
          <details
            class="reading-disclosure tech-disclosure col-12"
            id="slice-section"
          >
            <summary class="tech-disclosure-summary">
              <span class="tech-summary-title">Slice / Phase Breakdown</span>
              <span class="tech-summary-meta">
                {d.sliceBreakdown!.length} phases · {totalSliceLlmCalls} LLM calls ·{' '}
                {formatCost(displaySliceTotalCostUsd)}
                {peakStageId ? ` · peak in ${peakStageId}` : ''}
              </span>
            </summary>
            <div class="disclosure-body">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="slice-breakdown-heading" class="card-heading headline-two-tone">
                    Slice / Phase Breakdown{' '}
                    <span class="muted">/ {d.sliceBreakdown!.length} Phases</span>
                  </h2>
                </div>
                <div class="card-title-group">
                  <a href="#plan-section" class="action-link">
                    <span aria-hidden="true">↑</span> Plan Overview
                  </a>
                </div>
              </div>
              <p class="section-subnote">
                Step Range spans transcript events (LLM + tool + system turns) · LLM Calls count completed model inference turns
                {hasTaskPolls ? ' · manage_task Polls count background status checks' : ''}
              </p>
              <div
                class="table-wrapper"
                tabindex="0"
                role="region"
                aria-labelledby="slice-breakdown-heading"
              >
                <table class="app-table leaderboard-table static-table">
                  <caption class="visually-hidden">
                    Per-stage slice breakdown of step ranges, LLM calls, thinking tokens, and cost
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Slice / Phase</th>
                      <th scope="col">Step Range</th>
                      <th scope="col">LLM Calls</th>
                      {hasTaskPolls && <th scope="col">manage_task Polls</th>}
                      {hasSliceThinking && <th scope="col">Thinking Tokens</th>}
                      <th scope="col">Estimated Cost</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(() => {
                      const seenStageIds = new Set<string>();
                      let seenNonStageRow = false;
                      let hasSeenAnyStage = false;
                      return d.sliceBreakdown!.map((row) => {
                        const isPeakCostSlice =
                          maxSliceCost > 0
                            ? row.costUsd === maxSliceCost
                            : maxSliceCalls > 0 && row.llmCalls === maxSliceCalls;
                        const costSharePct =
                          totalSliceCostUsd > 0
                            ? Math.round((row.costUsd / totalSliceCostUsd) * 100)
                            : totalSliceLlmCalls > 0
                              ? Math.round((row.llmCalls / totalSliceLlmCalls) * 100)
                              : 0;
                        const barRatio =
                          maxSliceCost > 0
                            ? row.costUsd / maxSliceCost
                            : maxSliceCalls > 0
                              ? row.llmCalls / maxSliceCalls
                              : 0;
                        const stepCount = getStepRangeCount(row.stepRange);
                        const matchedStage = matchSliceStageId(row.slice);
                        if (matchedStage) {
                          hasSeenAnyStage = true;
                        }
                        const stagePassed = matchedStage
                          ? d.planCompletion?.[matchedStage as keyof typeof d.planCompletion]
                          : undefined;
                        let rowAnchorId: string | undefined;
                        if (matchedStage && !seenStageIds.has(matchedStage)) {
                          seenStageIds.add(matchedStage);
                          rowAnchorId = `slice-${matchedStage.toLowerCase()}`;
                        } else if (!matchedStage && !seenNonStageRow) {
                          seenNonStageRow = true;
                          rowAnchorId = 'slice-nonstage';
                        }
                        return (
                          <tr id={rowAnchorId} class:list={[{ 'slice-row-peak': isPeakCostSlice }]}>
                            <th scope="row" data-cell="Slice / Phase">
                              <div class="slice-phase-cell">
                                {stagePassed !== undefined ? (
                                  <span
                                    class:list={[
                                      'mono',
                                      'slice-stage-badge',
                                      stagePassed ? 'is-pass' : 'is-miss',
                                    ]}
                                  >
                                    {matchedStage} {stagePassed ? 'Pass' : 'Miss'}
                                  </span>
                                ) : (
                                  <span class="badge-static slice-stage-badge">
                                    {!hasSeenAnyStage ||
                                    /^s0\b|prep|init|environment|explore|exploration|setup|preflight|pre-flight/i.test(
                                      row.slice
                                    )
                                      ? 'Prep'
                                      : 'Post'}
                                  </span>
                                )}
                                <strong>{row.slice}</strong>
                              </div>
                            </th>
                            <td class="mono" data-cell="Step Range">
                              {row.stepRange}
                              {stepCount !== null && (
                                <span class="metric-sub metric-inline">
                                  ({stepCount} {stepCount === 1 ? 'step' : 'steps'})
                                </span>
                              )}
                            </td>
                            <td class="mono" data-cell="LLM Calls">{row.llmCalls}</td>
                            {hasTaskPolls && (
                              <td class="mono" data-cell="manage_task Polls">
                                {row.manageTaskPolls ?? 0}
                              </td>
                            )}
                            {hasSliceThinking && (
                              <td class="mono" data-cell="Thinking Tokens">
                                {row.thinkingTokens?.toLocaleString() ?? '—'}
                              </td>
                            )}
                            <td class="mono" data-cell="Estimated Cost">
                              <div class="slice-cost-cell">
                                <div class="slice-cost-head">
                                  <span class="cost-mono">
                                    {formatCost(row.costUsd)}
                                    {costSharePct > 0 && (
                                      <>
                                        {' '}
                                        <span class="metric-sub metric-inline">({costSharePct}%)</span>
                                      </>
                                    )}
                                  </span>
                                  {isPeakCostSlice && (
                                    <span class="hl hl-acid slice-peak-tag">Peak</span>
                                  )}
                                </div>
                                {barRatio > 0 && (
                                  <div class="slice-cost-track" aria-hidden="true">
                                    <span
                                      class:list={[
                                        'slice-cost-fill',
                                        isPeakCostSlice ? 'is-peak' : 'is-normal',
                                        { 'is-track-end': barRatio >= 1 },
                                      ]}
                                      style={`inline-size: ${Math.min(100, barRatio * 100).toFixed(1)}%`}
                                    />
                                  </div>
                                )}
                              </div>
                            </td>
                          </tr>
                        );
                      });
                    })()}
                  </tbody>
                  <tfoot>
                    <tr class="table-row-total">
                      <th scope="row" data-cell="Slice / Phase">
                        <strong>Total ({d.sliceBreakdown!.length} phases)</strong>
                      </th>
                      <td class="mono" data-cell="Step Range">
                        {totalSliceSteps > 0 ? (
                          <strong>{totalSliceSteps.toLocaleString()} steps</strong>
                        ) : (
                          '—'
                        )}
                      </td>
                      <td class="mono" data-cell="LLM Calls">
                        <strong>{totalSliceLlmCalls}</strong>
                      </td>
                      {hasTaskPolls && (
                        <td class="mono" data-cell="manage_task Polls">
                          <strong>{totalSlicePolls}</strong>
                        </td>
                      )}
                      {hasSliceThinking && (
                        <td class="mono" data-cell="Thinking Tokens">
                          <strong>{totalSliceThinking.toLocaleString()}</strong>
                        </td>
                      )}
                      <td class="mono" data-cell="Estimated Cost">
                        <strong class:list={['cost-mono', { 'kpi-acid-underline': isCostLeader }]}>
                          {formatCost(displaySliceTotalCostUsd)}
                        </strong>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </details>
        )
      }

      <!-- Unified Conditional: Tokens, Cache & Cost Breakdown -->
      {
        hasTokenOrCostSection && (
          <details
            class="reading-disclosure tech-disclosure col-12"
            id="tokens-cost-section"
          >
            <summary class="tech-disclosure-summary">
              <span class="tech-summary-title">Tokens, Cache &amp; Cost</span>
              <span class="tech-summary-meta">
                {[
                  d.tokens?.total ? `${d.tokens.total} tokens` : null,
                  d.tokens?.cacheHitRate ? `${d.tokens.cacheHitRate} cache hit` : null,
                  costSectionSubtitle,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </summary>
            <div class="disclosure-body">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="token-usage-heading" class="card-heading headline-two-tone">
                    Tokens, Cache &amp; Cost{' '}
                    <span class="muted">
                      / {costSectionSubtitle}
                    </span>
                  </h2>
                </div>
              </div>

              {hasTokenSection && hasCostBreakdown && (
                <dl class="tokens-meta-strip">
                  {d.tokens?.total && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Total Tokens</dt>
                      <dd class="mono">
                        <strong>{d.tokens.total}</strong>
                        {d.tokens.input && d.tokens.output ? (
                          <span class="tokens-meta-sub">
                            ({d.tokens.input} uncached · {d.tokens.output} out)
                          </span>
                        ) : null}
                      </dd>
                    </div>
                  )}

                  {d.tokens?.cacheHitRate && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Cache Hit Rate</dt>
                      <dd class="mono">
                        <strong class="kpi-acid-underline">{d.tokens.cacheHitRate}</strong>
                        {d.tokens.cachedInput && d.tokens.total ? (
                          <span class="tokens-meta-sub">
                            ({d.tokens.cachedInput} / {d.tokens.total})
                          </span>
                        ) : null}
                      </dd>
                    </div>
                  )}

                  {d.tokens?.thinking && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Thinking Tokens</dt>
                      <dd class="mono">
                        <strong>{d.tokens.thinking}</strong>
                        {d.tokens.output ? (
                          <span class="tokens-meta-sub">(of {d.tokens.output} output)</span>
                        ) : null}
                      </dd>
                    </div>
                  )}

                  {d.contextWindow && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Peak Context</dt>
                      <dd class="mono">
                        <strong>{contextWindowParts.headline}</strong>
                        {contextWindowParts.detail ? (
                          <span class="tokens-meta-sub">({contextWindowParts.detail})</span>
                        ) : null}
                      </dd>
                    </div>
                  )}

                  {telemetry.costMetrics.cacheSavingsUsd > 0 && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Cache Savings</dt>
                      <dd class="mono">
                        <strong class="kpi-acid-underline">
                          -{formatCost(telemetry.costMetrics.cacheSavingsUsd)} ({telemetry.costMetrics.cacheSavingsPct}%)
                        </strong>
                        <span class="tokens-meta-sub">
                          (vs {formatCost(telemetry.costMetrics.uncachedCounterfactualCostUsd)} uncached)
                        </span>
                      </dd>
                    </div>
                  )}

                  {telemetry.costPerCompletedSlice !== null && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Unit Economics</dt>
                      <dd class="mono">
                        <strong>{formatCost(telemetry.costPerCompletedSlice)} / slice</strong>
                        {telemetry.tokensPerCompletedSlice !== null && (
                          <span class="tokens-meta-sub">
                            ({(telemetry.tokensPerCompletedSlice / 1_000_000).toFixed(2)}M tok/slice)
                          </span>
                        )}
                      </dd>
                    </div>
                  )}

                  {telemetry.toolSuccessRatePct !== null && (
                    <div class="tokens-meta-item">
                      <dt class="tokens-meta-label">Tool Precision</dt>
                      <dd class="mono">
                        <strong>{telemetry.toolSuccessRatePct}% ok</strong>
                        <span class="tokens-meta-sub">
                          ({telemetry.toolErrorCalls} err / {telemetry.toolTotalCalls} calls
                          {telemetry.pollingCalls > 0
                            ? ` · ${telemetry.pollingCalls} polls ~${formatCost(telemetry.estimatedPollingWasteUsd)}`
                            : ''})
                        </span>
                      </dd>
                    </div>
                  )}
                </dl>
              )}

              {hasTokenSection && !hasCostBreakdown && (
                <dl class="kpi-grid kpi-grid-tokens-summary">
                  {(d.tokens?.total || d.tokens?.input) && (
                    <div class="kpi-box">
                      <dt class="kpi-label">
                        {d.tokens?.total ? 'Total Tokens' : 'Input (Uncached)'}
                      </dt>
                      <dd class="kpi-val">{d.tokens?.total ?? d.tokens?.input}</dd>
                      <dd class="kpi-sub">
                        {d.tokens?.input && d.tokens?.cachedInput
                          ? `${d.tokens.input} uncached · ${d.tokens.cachedInput} cached`
                          : d.tokens?.cachedInput
                            ? `Includes ${d.tokens.cachedInput} cached reads`
                            : 'Prompt + completion token volume'}
                      </dd>
                    </div>
                  )}

                  {d.tokens?.cacheHitRate && (
                    <div class="kpi-box">
                      <dt class="kpi-label">Cache Hit Rate</dt>
                      <dd class="kpi-val">
                        <span class="kpi-acid-underline">{d.tokens.cacheHitRate}</span>
                      </dd>
                      <dd class="kpi-sub">
                        {d.tokens.cachedInput && d.tokens.total
                          ? `${d.tokens.cachedInput} cached of ${d.tokens.total} total tokens`
                          : 'Cached input share of total prompt tokens'}
                      </dd>
                    </div>
                  )}

                  {(d.tokens?.output || d.tokens?.thinking) && (
                    <div class="kpi-box">
                      <dt class="kpi-label">
                        {d.tokens?.output && d.tokens?.thinking
                          ? 'Output & Thinking'
                          : d.tokens?.output
                            ? 'Output Tokens'
                            : 'Thinking Tokens'}
                      </dt>
                      <dd class="kpi-val">{d.tokens?.output ?? d.tokens?.thinking}</dd>
                      <dd class="kpi-sub">
                        {d.tokens?.output && d.tokens?.thinking
                          ? `Includes ${d.tokens.thinking} reasoning tokens`
                          : d.tokens?.thinking
                            ? 'Reasoning token volume'
                            : 'Completion token volume'}
                      </dd>
                    </div>
                  )}

                  {d.contextWindow && (
                    <div class="kpi-box">
                      <dt class="kpi-label">Context Window Usage</dt>
                      <dd class="kpi-val">
                        <span>{contextWindowParts.headline}</span>
                      </dd>
                      <dd class="kpi-sub">
                        {contextWindowParts.detail ?? 'Peak prompt context window'}
                      </dd>
                    </div>
                  )}
                </dl>
              )}

              {hasCostBreakdown && (
                <div
                  class="table-wrapper"
                  tabindex="0"
                  role="region"
                  aria-labelledby="token-usage-heading"
                >
                  <table class="app-table leaderboard-table static-table">
                    <caption class="visually-hidden">
                      {costTableCaption}
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Component</th>
                        <th scope="col">Tokens</th>
                        <th scope="col">{costPrimaryRateHeader}</th>
                        <th scope="col">{costPrimaryCostHeader}</th>
                        {has2027Pricing && <th scope="col">{costComparisonRateHeader}</th>}
                        {has2027Pricing && <th scope="col">{costComparisonCostHeader}</th>}
                      </tr>
                    </thead>
                    <tbody>
                      {costItemRows.map((row) => {
                        const c26 = splitCostString(row.cost2026);
                        const c27 = splitCostString(row.cost2027);
                        return (
                          <tr>
                            <th scope="row" data-cell="Component">
                              <strong>{row.component}</strong>
                            </th>
                            <td class="mono" data-cell="Tokens">{row.tokens}</td>
                            <td
                              class="mono"
                              data-cell={costPrimaryRateHeader}
                            >
                              {row.rate2026 ?? '—'}
                            </td>
                            <td
                              class="mono"
                              data-cell={costPrimaryCostHeader}
                            >
                              <span class="cost-mono">{c26.primary}</span>
                              {c26.detail && (
                                <>
                                  {' '}
                                  <span class="metric-sub metric-inline">({c26.detail})</span>
                                </>
                              )}
                            </td>
                            {has2027Pricing && (
                              <td class="mono" data-cell={costComparisonRateHeader}>{row.rate2027 ?? '—'}</td>
                            )}
                            {has2027Pricing && (
                              <td class="mono" data-cell={costComparisonCostHeader}>
                                <span class="cost-mono">{c27.primary}</span>
                                {c27.detail && (
                                  <>
                                    {' '}
                                    <span class="metric-sub metric-inline">({c27.detail})</span>
                                  </>
                                )}
                              </td>
                            )}
                          </tr>
                        );
                      })}
                    </tbody>
                    {costTotalRows.length > 0 && (
                      <tfoot>
                        {costTotalRows.map((row) => {
                          const c26 = splitCostString(row.cost2026);
                          const c27 = splitCostString(row.cost2027);
                          return (
                            <tr class="table-row-total">
                              <th scope="row" data-cell="Component">
                                <strong>{row.component}</strong>
                              </th>
                              <td class="mono" data-cell="Tokens">
                                <strong>{row.tokens}</strong>
                              </td>
                              <td
                                class="mono"
                                data-cell={costPrimaryRateHeader}
                              >
                                {row.rate2026 ?? '—'}
                              </td>
                              <td
                                class="mono"
                                data-cell={costPrimaryCostHeader}
                              >
                                <strong class:list={['cost-mono', { 'kpi-acid-underline': isCostLeader }]}>
                                  {c26.primary}
                                </strong>
                                {c26.detail && (
                                  <>
                                    {' '}
                                    <span class="metric-sub metric-inline">({c26.detail})</span>
                                  </>
                                )}
                              </td>
                              {has2027Pricing && (
                                <td class="mono" data-cell={costComparisonRateHeader}>{row.rate2027 ?? '—'}</td>
                              )}
                              {has2027Pricing && (
                                <td class="mono" data-cell={costComparisonCostHeader}>
                                  <span class="cost-pill cost-pill-projected">{c27.primary}</span>
                                  {c27.detail && (
                                    <>
                                      {' '}
                                      <span class="metric-sub metric-inline">({c27.detail})</span>
                                    </>
                                  )}
                                </td>
                              )}
                            </tr>
                          );
                        })}
                      </tfoot>
                    )}
                  </table>
                </div>
              )}
            </div>
          </details>
        )
      }

      <!-- Conditional: Calls (LLM & Tool Call Telemetry) -->
      {
        hasCallsSection && (
          <details
            class="reading-disclosure tech-disclosure col-12"
            id="calls-section"
          >
            <summary class="tech-disclosure-summary">
              <span class="tech-summary-title">Calls &amp; Tool Breakdown</span>
              <span class="tech-summary-meta">
                {[
                  d.calls?.llmCalls !== undefined ? `${d.calls.llmCalls} LLM turns` : null,
                  d.calls?.toolCalls?.total !== undefined
                    ? `${d.calls.toolCalls.total} tool executions`
                    : null,
                  d.calls?.toolCalls?.error ? `${d.calls.toolCalls.error} errors` : null,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </summary>
            <div class="disclosure-body">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="calls-breakdown-heading" class="card-heading headline-two-tone">
                    Calls &amp; Tool Breakdown{' '}<span class="muted">/ Tool Loop</span>
                  </h2>
                </div>
              </div>

              <dl class="calls-summary-strip">
                {d.calls?.llmCalls !== undefined && (
                  <div class="calls-summary-item">
                    <dt class="kpi-label">LLM Inference Turns</dt>
                    <dd class="calls-summary-val">
                      <strong class="mono">{d.calls.llmCalls}</strong>
                      <span class="calls-summary-sub">completed agent_response steps</span>
                    </dd>
                  </div>
                )}

                {d.calls?.toolCalls?.total !== undefined && (
                  <div class="calls-summary-item">
                    <dt class="kpi-label">Tool Executions</dt>
                    <dd class="calls-summary-val">
                      <strong class="mono">{d.calls.toolCalls.total}</strong>
                      {d.calls.toolCalls.done !== undefined && (
                        <span class="calls-summary-sub">{d.calls.toolCalls.done} succeeded</span>
                      )}
                      {d.calls.toolCalls.error !== undefined && d.calls.toolCalls.error > 0 && (
                        <span class="tool-err-pill">
                          · {d.calls.toolCalls.error} non-zero / error
                        </span>
                      )}
                    </dd>
                  </div>
                )}
              </dl>

              {d.calls?.toolCalls?.breakdown && d.calls.toolCalls.breakdown.length > 0 && (
                <ul class="command-list tool-list tool-list-grid" role="list">
                  {d.calls.toolCalls.breakdown.map((item) => {
                    const doneCount = item.done ?? item.total - (item.error ?? 0);
                    const errCount = item.error ?? 0;
                    const totalCallsDenom = d.calls?.toolCalls?.total || maxToolCalls;
                    const sharePct =
                      totalCallsDenom > 0 ? Math.round((item.total / totalCallsDenom) * 100) : 0;
                    const barDenom = maxToolCalls > 0 ? maxToolCalls : 1;
                    const doneBarPct = Math.min(100, (doneCount / barDenom) * 100);
                    const errBarPct = Math.min(100 - doneBarPct, (errCount / barDenom) * 100);
                    const isFullTrack = doneCount + errCount >= barDenom;

                    return (
                      <li class="command-row tool-row">
                        <div class="tool-row-header">
                          <span class="tool-name">
                            <span class="prefix">tool/</span>
                            <span class="mono tool-name-badge">
                              {item.tool}
                            </span>
                          </span>
                          <div class="tool-counts">
                            <strong>{item.total}</strong>
                            <span class="tool-status-note">
                              ({sharePct}%
                              {item.done !== undefined || (item.error && item.error > 0)
                                ? ` · ${doneCount} ok${errCount > 0 ? `, ${errCount} err` : ''}`
                                : ''}
                              )
                            </span>
                          </div>
                        </div>
                        <div class="tool-bar-track" aria-hidden="true">
                          {doneCount > 0 && (
                            <span
                              class:list={[
                                'tool-bar-fill tool-bar-done',
                                { 'is-track-end': isFullTrack && errCount === 0 },
                              ]}
                              style={`inline-size: ${doneBarPct.toFixed(2)}%`}
                            />
                          )}
                          {errCount > 0 && (
                            <span
                              class:list={[
                                'tool-bar-fill tool-bar-error',
                                { 'is-track-end': isFullTrack },
                              ]}
                              style={`inline-size: ${errBarPct.toFixed(2)}%`}
                            />
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          </details>
        )
      }

      <!-- Conditional: Command / Interface Used -->
      {
        hasInterface && (
          <details
            class="reading-disclosure tech-disclosure col-12"
            id="interface-section"
          >
            <summary class="tech-disclosure-summary">
              <span class="tech-summary-title">Command &amp; Interface Used</span>
              <span class="tech-summary-meta">
                {[
                  d.interface?.type ? d.interface.type.toUpperCase() : null,
                  wallClockMinutes && wallClockMinutes > d.durationMinutes
                    ? `${formatDuration(wallClockMinutes)} wall-clock`
                    : 'Single-prompt workflow',
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </summary>
            <div class="disclosure-body">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="interface-heading" class="card-heading headline-two-tone">
                    Command / Interface Used{' '}
                    {d.interface?.type && (
                      <span class="muted">/ {d.interface.type.toUpperCase()}</span>
                    )}
                  </h2>
                </div>
                {d.interface?.command && (
                  <div>
                    <button
                      type="button"
                      class="btn btn-sm btn-secondary"
                      id="copy-cmd-btn"
                      data-cmd={d.interface.command}
                    >
                      Copy Command
                    </button>
                    <span
                      id="copy-cmd-status"
                      class="visually-hidden"
                      role="status"
                      aria-live="polite"
                    />
                  </div>
                )}
              </div>

              {d.interface?.command && (
                <Code
                  code={d.interface.command}
                  lang="bash"
                  theme={neoAcidCodeTheme}
                  wrap={null}
                  transformers={[
                    {
                      pre(node) {
                        delete node.properties.style;
                      },
                    },
                  ]}
                  class="terminal-box terminal-box-wrap"
                />
              )}

              {d.interface?.details && (
                <p class="interface-details">
                  {d.interface.details}
                </p>
              )}

              <div class="interface-footer-meta">
                <span class="text-muted">
                  {wallClockMinutes && wallClockMinutes > d.durationMinutes
                    ? `Execution mode: Manual 'continue' nudges across ${formatDuration(wallClockMinutes)} wall-clock`
                    : 'Execution mode: Single-prompt Outside-In TDD workflow'}
                </span>
                <a href="/about#prompt-spec-heading" class="action-link">
                  View Prompt Contract <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </details>
        )
      }

      <!-- Conditional: Git Commit Log -->
      {
        hasCommitLog && (
          <details
            class="reading-disclosure tech-disclosure col-12"
            id="commits-section"
          >
            <summary class="tech-disclosure-summary">
              <span class="tech-summary-title">Git Commits</span>
              <span class="tech-summary-meta">
                {d.commitLog!.length} {d.commitLog!.length === 1 ? 'checkpoint' : 'checkpoints'}
                {singleCommitAuthor ? ` · ${singleCommitAuthor}` : ''}
              </span>
            </summary>
            <div class="disclosure-body">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="git-commits-heading" class="card-heading headline-two-tone">
                    Git Commits{' '}<span class="muted">/ {d.commitLog!.length} Checkpoints</span>
                  </h2>
                </div>
                <div>
                  <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    id="copy-commits-btn"
                    data-cmd={commitLogText}
                  >
                    Copy Log
                  </button>
                  <span
                    id="copy-commits-status"
                    class="visually-hidden"
                    role="status"
                    aria-live="polite"
                  />
                </div>
              </div>
              {(singleCommitAuthor || hasRelativeCommitTimes) && (
                <p class="section-subnote">
                  {[
                    singleCommitAuthor ? `Author: ${singleCommitAuthor}` : null,
                    hasRelativeCommitTimes ? 'Timestamps relative to post-run capture' : null,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              )}
              <ol class="command-list commit-list" role="list">
                {d.commitLog!.map((c) => {
                  const commitStage = matchCommitStageId(c.message);
                  const commitStagePassed = commitStage
                    ? d.planCompletion?.[commitStage as keyof typeof d.planCompletion]
                    : undefined;
                  return (
                    <li class="command-row commit-row">
                      <div class="commit-main">
                        <code class="commit-hash">{c.hash}</code>
                        {commitStage && (
                          <a
                            href={`#plan-${commitStage.toLowerCase()}`}
                            aria-label={`Jump to stage ${commitStage} (${commitStagePassed === false ? 'Missed' : 'Passed'}) in Plan Completion`}
                            class:list={[
                              'mono',
                              'commit-stage-badge',
                              commitStagePassed === false ? 'is-miss' : 'is-pass',
                            ]}
                          >
                            {commitStage}
                            {commitStagePassed === false ? ' Miss' : ''}
                          </a>
                        )}
                        <span class="commit-msg">{c.message}</span>
                      </div>
                      {((!singleCommitAuthor && c.author) || c.relativeTime) && (
                        <div class="commit-meta-right">
                          {!singleCommitAuthor && c.author && (
                            <span class="commit-author">{c.author}</span>
                          )}
                          {c.relativeTime && (
                            <span class="commit-time" title={`${c.relativeTime} before capture`}>
                              -{c.relativeTime}
                            </span>
                          )}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          </details>
        )
      }
    </div>

    {
      siblingRuns.length > 0 && (
        <aside class="card detail-siblings-bar" id="siblings-section" aria-label="Compare related runs">
          <span class="detail-siblings-label">Compare related runs</span>
          <div class="detail-siblings-list">
            {siblingRuns.map((sib) => {
              const sliceDiff = sib.completed - plan.completed;
              const costDiff = Number((sib.costUsd - d.costUsd).toFixed(2));
              const durDiff = sib.durationMinutes - d.durationMinutes;
              const deltaParts: string[] = [];
              let betterCount = 0;
              let worseCount = 0;

              if (sliceDiff !== 0) {
                const absSlices = Math.abs(sliceDiff);
                deltaParts.push(
                  `${sliceDiff > 0 ? '+' : '-'}${absSlices} ${absSlices === 1 ? 'slice' : 'slices'}`
                );
              }
              if (costDiff < 0) {
                betterCount++;
                deltaParts.push(`${formatCost(Math.abs(costDiff))} cheaper`);
              } else if (costDiff > 0) {
                worseCount++;
                deltaParts.push(`${formatCost(costDiff)} pricier`);
              } else {
                deltaParts.push(formatCost(sib.costUsd));
              }
              if (durDiff < 0) {
                betterCount++;
                deltaParts.push(`${formatDuration(Math.abs(durDiff))} faster`);
              } else if (durDiff > 0) {
                worseCount++;
                deltaParts.push(`${formatDuration(durDiff)} slower`);
              } else {
                deltaParts.push(formatDuration(sib.durationMinutes));
              }
              const deltaText =
                sliceDiff === 0 && costDiff === 0 && durDiff === 0
                  ? `${formatCost(sib.costUsd)} · ${formatDuration(sib.durationMinutes)} (par)`
                  : deltaParts.join(' · ');
              const deltaToneClass =
                sliceDiff > 0
                  ? 'is-better'
                  : sliceDiff < 0
                    ? 'is-worse'
                    : betterCount > 0 && worseCount === 0
                      ? 'is-better'
                      : worseCount > 0 && betterCount === 0
                        ? 'is-worse'
                        : '';
              const deltaPrefix =
                deltaToneClass === 'is-better'
                  ? '▲ '
                  : deltaToneClass === 'is-worse'
                    ? '▼ '
                    : betterCount > 0 && worseCount > 0
                      ? '⇄ '
                      : '';

              return (
                <a href={`/runs/${sib.id}`} class="detail-sibling-chip">
                  <span class="mono">#{sib.rank}</span>
                  <strong>
                    {sib.harness} / {sib.model}
                    {sib.effort ? ` (${sib.effort})` : ''}
                  </strong>
                  <span class="badge-static detail-sibling-rel">
                    {sib.relation === 'same-model' ? 'same model' : 'same harness'} ·{' '}
                    <span class="mono">{sib.completed}/{sib.total}</span>
                  </span>
                  <span class:list={['mono detail-sibling-delta', deltaToneClass]}>
                    {deltaPrefix}{deltaText}
                  </span>
                </a>
              );
            })}
          </div>
        </aside>
      )
    }

    <nav aria-label="Rank pagination" class="detail-bottom-pager">
      {
        prevRun ? (
          <a href={`/runs/${prevRun.id}`} class="card card-interactive detail-pager-card">
            <span class="detail-pager-dir">← Previous rank (<span class="mono">#{prevRun.rank}</span>)</span>
            <strong class="detail-pager-title">
              {prevRun.harness} / {prevRun.model}
              {prevRun.effort ? ` (${prevRun.effort})` : ''}
            </strong>
            <span class="mono detail-pager-meta">
              {prevRun.completed}/{prevRun.total} slices · {formatCost(prevRun.costUsd)} ·{' '}
              {formatDuration(prevRun.durationMinutes)}
            </span>
          </a>
        ) : (
          <a href="/" class="card card-interactive detail-pager-card">
            <span class="detail-pager-dir">← Leaderboard index</span>
            <strong class="detail-pager-title">All Benchmark Runs</strong>
            <span class="detail-pager-meta">Compare all <span class="mono">{totalRuns}</span> verified evaluations</span>
          </a>
        )
      }
      {
        nextRun ? (
          <a href={`/runs/${nextRun.id}`} class="card card-interactive detail-pager-card">
            <span class="detail-pager-dir">Next rank (<span class="mono">#{nextRun.rank}</span>) →</span>
            <strong class="detail-pager-title">
              {nextRun.harness} / {nextRun.model}
              {nextRun.effort ? ` (${nextRun.effort})` : ''}
            </strong>
            <span class="mono detail-pager-meta">
              {nextRun.completed}/{nextRun.total} slices · {formatCost(nextRun.costUsd)} ·{' '}
              {formatDuration(nextRun.durationMinutes)}
            </span>
          </a>
        ) : (
          <a href="/" class="card card-interactive detail-pager-card">
            <span class="detail-pager-dir">Leaderboard index →</span>
            <strong class="detail-pager-title">All Benchmark Runs</strong>
            <span class="detail-pager-meta">Compare all <span class="mono">{totalRuns}</span> verified evaluations</span>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     CALM FIELD-NOTE RUN DETAIL (Neo-Acid Read/Operate Restraint)
     Paces the run report like readable engineering field notes:
     - Generous vertical breathing room (hero ~3rem, sections >=2.5rem, rows ~1rem)
     - Schibsted Grotesk for prose, labels, and controls; Martian Mono for numbers/code
     - Main copy >=1rem, metadata >=0.8125rem, interactive controls >=44px (2.75rem)
     - Native non-exclusive <details> disclosures with native markers
     ========================================================================== */

  /* Top Navigation Bar */
  .run-detail-quiet .detail-nav-row {
    padding-block: 1rem;
    border-block-end: none;
    gap: 0.75rem 1rem;
  }

  .run-detail-quiet .detail-nav-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .detail-nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    gap: 0.5rem;
    font: 0.875rem var(--font-body);
    color: var(--text-muted);
    text-decoration: none;
  }

  .detail-nav-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .run-detail-quiet .detail-nav-pager {
    margin-inline-start: 0;
    gap: 1.25rem;
  }

  .run-detail-quiet :is(.btn, .btn-sm, .action-link, .badge-link) {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    min-block-size: 2.75rem;
    padding-block: 0.55rem;
    padding-inline: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-transform: none;
    letter-spacing: normal;
  }

  .run-detail-quiet .action-link {
    padding-inline: 0.35rem;
  }

  .run-detail-quiet .btn-secondary {
    border-width: 1px;
    border-color: var(--border-strong-color);
    background-color: transparent;
    color: var(--text-primary);
  }

  .run-detail-quiet .btn-secondary:hover:not(:disabled),
  .run-detail-quiet .btn-secondary:focus-visible {
    background-color: var(--hl-acid);
    border-color: var(--raw-ebony);
    color: var(--hl-ink);
  }

  .run-detail-quiet .menu-kbd {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.08rem 0.38rem;
  }

  /* Hero / Masthead Section (~3rem spacing, no outer card cage, no eyebrow above h1) */
  .run-detail-quiet .detail-header-card {
    background-color: transparent;
    border: none;
    border-block-end: none;
    padding-block: 2rem 2.5rem;
    padding-inline: 0;
    margin-block-end: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .run-detail-quiet .detail-top-row {
    padding-block-end: 0;
    border-block-end: none;
  }

  .detail-heading-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .run-detail-quiet .detail-entry-meta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    gap: 0.45rem 0.65rem;
    margin: 0;
  }

  .detail-meta-rank {
    color: var(--text-primary);
  }

  .detail-meta-pareto {
    color: var(--text-muted);
  }

  .run-detail-quiet .detail-meta-text {
    color: var(--text-secondary);
  }

  .run-detail-quiet .detail-meta-sep {
    color: var(--text-muted);
  }

  .run-detail-quiet .detail-meta-link {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-strong-color);
    text-underline-offset: 3px;
  }

  .run-detail-quiet .detail-meta-link:hover,
  .run-detail-quiet .detail-meta-link:focus-visible {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    text-decoration: none;
  }

  /* Single Meaningful Lead / Synopsis */
  .detail-lead-copy {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-inline-size: 68ch;
  }

  .detail-lead-link {
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--hl-acid);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  :global([data-theme="light"]) .detail-lead-link {
    text-decoration-color: var(--accent-cobalt);
  }

  .detail-lead-link:hover,
  .detail-lead-link:focus-visible {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    text-decoration: none;
  }

  /* Primary Visible Metrics (Outcome, Time Elapsed, Estimated Cost) */
  .run-detail-quiet .detail-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-block: 1px solid var(--border-subtle-color);
    background-color: transparent;
    margin: 0;
  }

  .run-detail-quiet .detail-kpi-grid .kpi-box {
    border: none;
    border-inline-end: var(--border-row);
    background-color: transparent;
    padding: 1.25rem 1.5rem;
  }

  .run-detail-quiet .detail-kpi-grid .kpi-box:first-child {
    padding-inline-start: 0;
  }

  .run-detail-quiet .detail-kpi-grid .kpi-box:last-child {
    border-inline-end: none;
    padding-inline-end: 0;
  }

  @media (width < 48em) {
    .run-detail-quiet .detail-kpi-grid {
      grid-template-columns: 1fr;
    }

    .run-detail-quiet .detail-kpi-grid .kpi-box {
      border-inline-end: none;
      border-block-end: var(--border-row);
      padding-inline: 0;
      padding-block: 1rem;
    }

    .run-detail-quiet .detail-kpi-grid .kpi-box:last-child {
      border-block-end: none;
    }
  }

  .kpi-label,
  .tokens-meta-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
    margin: 0 0 0.3rem;
    display: block;
    text-transform: none;
    letter-spacing: normal;
  }

  .run-detail-quiet .kpi-val {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .run-detail-quiet .kpi-sub {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-block-start: 0.35rem !important;
  }

  .kpi-acid-underline {
    border-block-end: 2px solid var(--hl-acid);
    padding-block-end: 0.06rem;
  }

  :global([data-theme="light"]) .kpi-acid-underline {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    border-block-end: none;
    padding-inline: 0.25rem;
  }

  .kpi-miss-underline {
    border-block-end: 2px solid var(--hl-magenta);
    padding-block-end: 0.06rem;
  }

  /* Visible Verification Discrepancy / Test Failure Notice */
  .detail-verification-alert {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-strong-color);
    border-inline-start: 1px solid var(--hl-magenta);
  }

  .detail-verification-alert.is-warn {
    border-inline-start-color: var(--hl-magenta);
  }

  .detail-test-tag {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .run-detail-quiet .detail-test-callout-copy {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
    flex: 1;
    min-inline-size: min(100%, 22rem);
    max-inline-size: 68ch;
  }

  .run-detail-quiet .detail-test-strip {
    border: none;
    border-block-start: var(--border-row);
    background-color: transparent;
    padding: 1rem 0 0;
    margin-block-start: 1rem;
    gap: 0.5rem 0.75rem;
  }

  /* Secondary Metrics Disclosure in Header */
  .header-secondary-disclosure {
    border-block-start: var(--border-row);
  }

  .secondary-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1.25rem 1.75rem;
    margin: 0;
    padding-block-start: 0.5rem;
  }

  .secondary-metric-item {
    display: flex;
    flex-direction: column;
  }

  .secondary-metric-item dd {
    margin: 0;
  }

  .secondary-metric-val {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Shared Native Disclosure Styling (.reading-disclosure, .tech-disclosure) */
  .run-detail-quiet .reading-disclosure {
    border-block-end: 1px solid var(--border-subtle-color);
  }

  .run-detail-quiet .reading-disclosure > summary {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    padding-block: 1.05rem;
    padding-inline: 0.25rem;
    min-block-size: 2.75rem;
    cursor: pointer;
    color: var(--text-primary);
  }

  .run-detail-quiet .reading-disclosure > summary:hover,
  .run-detail-quiet .reading-disclosure > summary:focus-visible {
    background-color: var(--bg-surface);
  }

  .tech-summary-title {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-inline-end: 0.75rem;
  }

  .tech-summary-meta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .header-secondary-disclosure .tech-summary-meta {
    display: none;
  }

  .run-detail-quiet .disclosure-body {
    padding-block: 0.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Quiet, Non-Sticky On-Page Navigation */
  .run-detail-quiet .detail-jump-bar {
    position: static;
    background-color: transparent;
    border: none;
    border-block-end: 1px solid var(--border-subtle-color);
    padding: 0.75rem 0;
    margin-block-end: 0;
    gap: 0.5rem 1rem;
  }

  .run-detail-quiet .detail-jump-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: normal;
    text-transform: none;
  }

  .run-detail-quiet .detail-jump-links {
    scroll-target-group: none;
    gap: 0.25rem 0.5rem;
  }

  .run-detail-quiet .detail-jump-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    min-block-size: 2.75rem;
    background-color: transparent;
    border: none;
    border-block-end: 2px solid transparent;
    padding: 0.45rem 0.65rem;
    color: var(--text-secondary);
  }

  .run-detail-quiet .detail-jump-link:hover,
  .run-detail-quiet .detail-jump-link:focus-visible {
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .run-detail-quiet .detail-jump-link[aria-current="true"] {
    background-color: transparent;
    color: var(--text-primary);
    border-block-end-color: var(--hl-acid);
  }

  :global([data-theme="light"]) .run-detail-quiet .detail-jump-link[aria-current="true"] {
    border-block-end-color: var(--accent-cobalt);
  }

  /* Open Document Sections (>=2.5rem spacing, no outer 2px card cages) */
  .run-detail-quiet .section-grid {
    gap: 0;
  }

  .run-detail-quiet .section-grid > .card {
    background-color: transparent;
    border: none;
    border-block-end: 1px solid var(--border-strong-color);
    padding-block: 2.75rem;
    padding-inline: 0;
    gap: 1.5rem;
  }

  .run-detail-quiet .section-grid > .tech-disclosure {
    border-block-end: 1px solid var(--border-subtle-color);
    padding-block: 0.25rem;
  }

  .run-detail-quiet .card-heading {
    font-size: 1.35rem;
  }

  .run-detail-quiet .badge-static {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    border-color: var(--border-subtle-color);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    padding: 0.2rem 0.55rem;
  }

  /* Plan Completion: Readable 7-Slice Vertical Ledger (~1rem row spacing) */
  .run-detail-quiet .plan-checklist {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid var(--border-subtle-color);
    background-color: transparent;
  }

  .run-detail-quiet .plan-item {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1.5rem;
    border: none;
    border-block-end: var(--border-row);
    background-color: transparent;
    padding: 1.05rem 1rem;
  }

  .run-detail-quiet .plan-item:last-child {
    border-block-end: none;
  }

  .run-detail-quiet .plan-item.is-peak-stage {
    background-color: var(--bg-surface);
    border-inline-start: 3px solid var(--hl-acid);
  }

  .run-detail-quiet .plan-item.spec-miss {
    background-color: var(--bg-surface);
    border-inline-start: 3px solid var(--hl-magenta);
  }

  .run-detail-quiet .plan-item.incomplete {
    border-inline-start: 3px dashed var(--border-strong-color);
  }

  .run-detail-quiet .plan-item-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex: 1 1 20rem;
    inline-size: auto;
  }

  .run-detail-quiet .plan-stage-id {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    min-inline-size: 2rem;
  }

  .run-detail-quiet .plan-stage-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0;
  }

  .run-detail-quiet .plan-item-badges {
    margin-inline-start: 0.35rem;
    gap: 0.45rem;
  }

  .run-detail-quiet .plan-peak-badge {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    text-transform: none;
  }

  .run-detail-quiet .plan-status-badge {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
  }

  .run-detail-quiet .plan-status-badge.is-pass {
    color: var(--text-muted);
  }

  .run-detail-quiet .plan-status-badge.is-miss {
    color: var(--text-primary);
    border-block-end: 2px solid var(--hl-magenta);
  }

  .run-detail-quiet .plan-item-body {
    flex: 0 1 auto;
    inline-size: auto;
  }

  .run-detail-quiet .plan-stage-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    margin: 0;
  }

  .run-detail-quiet .plan-stage-telemetry {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .run-detail-quiet .plan-stage-telemetry.is-discrepancy {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--text-primary);
  }

  .run-detail-quiet .plan-stage-diag-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.35rem;
  }

  /* Field Notes: Cozy Reading Measure & Native Disclosure Stack */
  .run-detail-quiet .notes-list {
    gap: 0;
    border-block: 1px solid var(--border-subtle-color);
  }

  .run-detail-quiet .note-card {
    border: none;
    border-block-end: var(--border-row);
    background-color: transparent;
    overflow: visible;
  }

  .run-detail-quiet .note-card:last-child {
    border-block-end: none;
  }

  .run-detail-quiet .note-disclosure > summary.note-summary {
    display: list-item;
    list-style: disclosure-closed inside;
    background-color: transparent;
    padding: 1.15rem 0.5rem;
    min-block-size: 2.75rem;
    line-height: 1.55;
  }

  .run-detail-quiet .note-disclosure[open] > summary.note-summary {
    list-style-type: disclosure-open;
    background-color: transparent;
    border-block-end: var(--border-row);
  }

  .run-detail-quiet .note-summary::-webkit-details-marker {
    display: inline-block;
  }

  .run-detail-quiet .note-summary:hover,
  .run-detail-quiet .note-summary:focus-visible {
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .run-detail-quiet .note-summary:hover :is(.note-num, .note-inline-code, .note-count-badge),
  .run-detail-quiet .note-summary:focus-visible :is(.note-num, .note-inline-code, .note-count-badge) {
    color: var(--text-primary);
    background-color: transparent;
    border-color: var(--border-strong-color);
  }

  .run-detail-quiet .note-num {
    font-size: 0.8125rem;
    border-width: 1px;
    border-color: var(--border-subtle-color);
    background-color: transparent;
    color: var(--text-muted);
    padding: 0.1rem 0.4rem;
    margin-inline-end: 0.55rem;
  }

  .run-detail-quiet .note-title {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-inline-end: 0.55rem;
  }

  .run-detail-quiet .note-count-badge {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .note-summary-teaser {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-muted);
    margin-block-start: 0.35rem;
    padding-inline-start: 1.35rem;
    max-inline-size: 68ch;
  }

  .note-disclosure[open] .note-summary-teaser {
    display: none;
  }

  .run-detail-quiet .note-body {
    padding: 1.35rem 0.5rem 1.5rem 1.35rem;
    background-color: transparent;
  }

  .run-detail-quiet .note-bullets {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    gap: 1.1rem;
  }

  .run-detail-quiet .note-bullet-item,
  .run-detail-quiet .note-item > span:not(.note-num) {
    max-inline-size: 66ch;
    padding-block-end: 1rem;
  }

  .run-detail-quiet .note-bullet-lead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    border-block-end: none;
    padding: 0;
  }

  .run-detail-quiet .note-bullet-lead-block {
    display: block;
    margin-block-end: 0.3rem;
  }

  .run-detail-quiet .note-item {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    border: none;
    border-block-end: var(--border-row);
    background-color: transparent;
    padding: 1.1rem 0.5rem;
  }

  .run-detail-quiet .note-permalink-btn {
    font-family: var(--font-body);
    font-size: 0.8125rem;
  }

  /* Tables, Token Strips & Tool Call Breakdown */
  .run-detail-quiet .section-subnote {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .run-detail-quiet .table-wrapper {
    border-width: 1px;
    border-color: var(--border-subtle-color);
  }

  .run-detail-quiet .leaderboard-table thead th {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: normal;
    background-color: var(--bg-surface);
    border-block-end: 1px solid var(--border-strong-color);
    padding: 0.85rem 1rem;
  }

  .run-detail-quiet .leaderboard-table :is(td, tbody th, tfoot th) {
    padding: 0.95rem 1rem;
    font-size: 0.9375rem;
  }

  .run-detail-quiet .metric-sub {
    font-size: 0.8125rem;
  }

  .run-detail-quiet .slice-stage-badge {
    border: 1px solid var(--border-subtle-color);
    background-color: transparent;
    color: var(--text-muted);
    font-size: 0.8125rem;
    padding: 0.08rem 0.4rem;
  }

  .run-detail-quiet .slice-stage-badge.is-miss {
    border-color: var(--hl-magenta);
    color: var(--text-primary);
  }

  .slice-cost-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
  }

  .slice-peak-tag {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.06rem 0.38rem;
    text-transform: none;
  }

  .run-detail-quiet .slice-cost-fill.is-peak {
    background-color: var(--hl-acid);
  }

  .run-detail-quiet .slice-cost-fill.is-normal {
    background-color: var(--border-strong-color);
  }

  .run-detail-quiet .tokens-meta-strip,
  .run-detail-quiet .calls-summary-strip {
    border: none;
    border-block-end: var(--border-row);
    background-color: transparent;
    padding: 0.25rem 0 1rem;
    margin-block-end: 0.5rem;
  }

  .run-detail-quiet .tokens-meta-item,
  .run-detail-quiet .tokens-meta-sub,
  .run-detail-quiet .calls-summary-sub {
    font-size: 0.8125rem;
  }

  .run-detail-quiet .calls-summary-sub {
    font-family: var(--font-body);
  }

  .run-detail-quiet .kpi-grid-tokens-summary {
    gap: 0;
    border: 1px solid var(--border-subtle-color);
  }

  .run-detail-quiet .kpi-grid-tokens-summary .kpi-box {
    border: none;
    border-inline-end: var(--border-row);
    background-color: transparent;
  }

  .run-detail-quiet .kpi-grid-tokens-summary .kpi-box:last-child {
    border-inline-end: none;
  }

  /* Tool Call Breakdown */
  .run-detail-quiet .tool-row {
    padding: 0.95rem 0.65rem;
  }

  .run-detail-quiet .tool-name-badge {
    border: none;
    background-color: transparent;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .run-detail-quiet .tool-status-note,
  .run-detail-quiet .tool-err-pill {
