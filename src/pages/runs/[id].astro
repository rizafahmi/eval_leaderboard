---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  formatHarnessName,
  formatProviderName,
  getPlanStats,
  parseNoteBullet,
  tokenizeNoteText,
} from '../../utils/format';
import { BENCHMARK_STAGES } from '../../data/benchmark';

export async function getStaticPaths() {
  const runs = await getCollection('runs', ({ data }) => data.published !== false);
  return runs.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const plan = getPlanStats(d.planCompletion);

const stageMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));

const hasInterface =
  d.interface && (d.interface.command || d.interface.details || d.interface.type);
const hasTokenSection =
  (d.tokens && (d.tokens.input || d.tokens.output || d.tokens.cacheHitRate)) ||
  Boolean(d.contextWindow);
const hasCallsSection =
  d.calls && (d.calls.llmCalls !== undefined || d.calls.toolCalls !== undefined);
const hasCommitLog = d.commitLog && d.commitLog.length > 0;
const commitLogText = d.commitLog
  ? d.commitLog
      .map(
        (c) =>
          `* ${c.hash}  ${c.relativeTime ? `(${c.relativeTime})  ` : ''}${c.author ? `<${c.author}>   ` : ''}${c.message}`
      )
      .join('\n')
  : '';
const hasCostBreakdown = d.costBreakdown && d.costBreakdown.length > 0;
const hasSliceBreakdown = d.sliceBreakdown && d.sliceBreakdown.length > 0;
const hasNotesDetails = d.notesDetails && d.notesDetails.length > 0;
const hasNotes = (d.notes && d.notes.length > 0) || hasNotesDetails;

const maxToolCalls =
  d.calls?.toolCalls?.breakdown && d.calls.toolCalls.breakdown.length > 0
    ? Math.max(...d.calls.toolCalls.breakdown.map((b) => b.total))
    : 1;

const displayHarness = formatHarnessName(d.codingHarness);
const displayProvider = formatProviderName(d.provider);
const runDescription = `Capy Bench evaluation run for ${displayHarness} (${d.model} by ${displayProvider}): ${plan.completed}/${plan.total} stages (${Math.round(plan.ratio * 100)}%) completed in ${formatDuration(d.durationMinutes)} at ${formatCost(d.costUsd)}.`;
---

<BaseLayout
  title={`${displayHarness} — ${d.model}`}
  breadcrumbLabel={`${displayHarness} / ${d.model}`}
  description={runDescription}
  ogType="article"
>
  <div class="detail-nav-row">
    <a href="/" class="btn btn-sm btn-secondary">
      <span aria-hidden="true">←</span> Back to Leaderboard
    </a>
    <span class="mono detail-run-id">
      RUN ID: <code>{entry.id}</code>
    </span>
  </div>

  <!-- Top Summary Header -->
  <section class="card detail-header-card" aria-labelledby="run-detail-heading">
    <div class="detail-top-row">
      <div>
        <div class="entry-meta detail-entry-meta">
          <span class="hl hl-sky">provider:{displayProvider}</span>
          {d.effort && <span class="hl hl-violet">effort:{d.effort}</span>}
          {d.interface?.type && (
            <span class="hl hl-acid">interface:{d.interface.type}</span>
          )}
          <span class="tag-outline">
            <time datetime={d.timestamp}>{formatTimestamp(d.timestamp)}</time>
          </span>
        </div>
        <h1 id="run-detail-heading" class="headline-two-tone">
          {displayHarness}
          <span class="muted">/ {d.model}</span>
        </h1>
      </div>

      <div>
        <span class:list={['hl', plan.ratio === 1 ? 'hl-mint' : 'hl-acid']}>
          {plan.ratio === 1 ? 'ALL 7 SLICES PASSED' : `${plan.completed}/${plan.total} SLICES`}
        </span>
      </div>
    </div>

    <dl class="kpi-grid">
      <div class="kpi-box">
        <dt class="section-kicker">TIME ELAPSED</dt>
        <dd class="stat-value kpi-val">{formatDuration(d.durationMinutes)}</dd>
        <dd class="kpi-sub">Total wall-clock duration</dd>
      </div>

      <div class="kpi-box">
        <dt class="section-kicker">ESTIMATED COST</dt>
        <dd class="stat-value kpi-val">
          <span class="hl hl-mint">{formatCost(d.costUsd)}</span>
        </dd>
        <dd class="kpi-sub">Total run cost (USD)</dd>
      </div>

      <div class="kpi-box">
        <dt class="section-kicker" id="kpi-plan-label">PLAN COMPLETION</dt>
        <dd class="stat-value kpi-val">
          {plan.completed}/{plan.total}
        </dd>
        <dd class="kpi-sub">{Math.round(plan.ratio * 100)}% of checkpoints done</dd>
      </div>

      {
        d.tests && (
          <div class="kpi-box">
            <dt class="section-kicker">TEST SUITE</dt>
            <dd class="stat-value kpi-val">
              {d.tests.passed}/{d.tests.total}
            </dd>
            <dd class="kpi-sub">
              {d.tests.durationSeconds !== undefined
                ? `${d.tests.total > 0 ? Math.round((d.tests.passed / d.tests.total) * 100) : 0}% passed (${d.tests.durationSeconds}s)`
                : d.tests.passed === d.tests.total
                  ? '100% tests passed'
                  : 'Test suite results'}
            </dd>
          </div>
        )
      }

      {
        d.commits !== undefined && (
          <div class="kpi-box">
            <dt class="section-kicker">GIT COMMITS</dt>
            <dd class="stat-value kpi-val">{d.commits}</dd>
            <dd class="kpi-sub">Git checkpoints recorded</dd>
          </div>
        )
      }
    </dl>
  </section>

  <div class="section-grid">
    <!-- Plan Completion Checklist -->
    <section class="card col-12" aria-labelledby="plan-completion-heading">
      <div class="card-title">
        <div>
          <span class="section-kicker">01 · CHECKPOINT VERIFICATION</span>
          <h2 id="plan-completion-heading" class="card-heading">
            Plan Completion ({plan.completed}/{plan.total})
          </h2>
        </div>
        <a href="/about#stages" class="action-link">
          View Stage Specs <span aria-hidden="true">→</span>
        </a>
      </div>

      <progress
        class="plan-progress"
        value={plan.completed}
        max={plan.total}
        aria-labelledby="plan-completion-heading"
      ></progress>

      <ul class="plan-checklist" role="list">
        {
          plan.entries.map(([stageId, completed]) => (
            <li class:list={['plan-item', completed ? 'completed' : 'incomplete']}>
              <span class:list={['hl', completed ? 'hl-mint' : 'hl-magenta']} aria-hidden="true">
                {completed ? 'PASS' : 'MISS'}
              </span>
              <div>
                <div class="mono plan-stage-id">
                  {stageId}
                  <span class="visually-hidden">
                    {' '}
                    — {completed ? 'Completed' : 'Incomplete'}
                  </span>
                </div>
                {stageMap.get(stageId) && (
                  <div class="plan-stage-title">{stageMap.get(stageId)}</div>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Conditional: Command / Interface Used -->
    {
      hasInterface && (
        <section class="card col-12" aria-labelledby="interface-heading">
          <div class="card-title">
            <div>
              <span class="section-kicker">02 · DISPATCH COMMAND</span>
              <div class="card-title-group">
                <h2 id="interface-heading" class="card-heading">Command / Interface Used</h2>
                {d.interface?.type && (
                  <span class="hl hl-sky">{d.interface.type}</span>
                )}
              </div>
            </div>
            {d.interface?.command && (
              <div>
                <button
                  type="button"
                  class="btn btn-sm btn-secondary"
                  id="copy-cmd-btn"
                  data-cmd={d.interface.command}
                >
                  Copy Command
                </button>
                <span
                  id="copy-cmd-status"
                  class="visually-hidden"
                  role="status"
                  aria-live="polite"
                />
              </div>
            )}
          </div>

          {d.interface?.command && (
            <Code
              code={d.interface.command}
              lang="bash"
              theme="ayu-dark"
              wrap={null}
              transformers={[
                {
                  pre(node) {
                    delete node.properties.style;
                  },
                },
              ]}
              class="terminal-box terminal-box-wrap"
            />
          )}

          {d.interface?.details && (
            <p class:list={['interface-details', { 'has-cmd': Boolean(d.interface.command) }]}>
              {d.interface.details}
            </p>
          )}
        </section>
      )
    }

    <!-- Conditional: Token & Context Window Usage -->
    {
      hasTokenSection && (
        <section
          class:list={['card', hasCallsSection ? 'col-6' : 'col-12']}
          aria-labelledby="token-usage-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">03 · TELEMETRY &amp; CONTEXT</span>
              <h2 id="token-usage-heading" class="card-heading">Token &amp; Context Usage</h2>
            </div>
            <span class="hl hl-violet">token telemetry</span>
          </div>

          <dl class="kpi-grid">
            {d.tokens?.input && (
              <div class="kpi-box">
                <dt class="section-kicker">INPUT (UNCACHED)</dt>
                <dd class="kpi-val">{d.tokens.input}</dd>
              </div>
            )}

            {d.tokens?.cachedInput && (
              <div class="kpi-box">
                <dt class="section-kicker">CACHED INPUT</dt>
                <dd class="kpi-val">{d.tokens.cachedInput}</dd>
              </div>
            )}

            {d.tokens?.output && (
              <div class="kpi-box">
                <dt class="section-kicker">OUTPUT TOKENS</dt>
                <dd class="kpi-val">{d.tokens.output}</dd>
                {d.tokens?.thinking && (
                  <dd class="kpi-sub">incl. {d.tokens.thinking} thinking</dd>
                )}
              </div>
            )}

            {d.tokens?.total && (
              <div class="kpi-box">
                <dt class="section-kicker">TOTAL TOKENS</dt>
                <dd class="kpi-val">{d.tokens.total}</dd>
                <dd class="kpi-sub">incl. cached reads</dd>
              </div>
            )}

            {d.tokens?.cacheHitRate && (
              <div class="kpi-box kpi-span-2">
                <dt class="section-kicker">CACHE HIT RATE</dt>
                <dd class="kpi-val">
                  <span class="hl hl-mint">{d.tokens.cacheHitRate}</span>
                </dd>
                <dd class="kpi-sub">
                  Formula: <code>CacheRead / (input + cacheRead + cacheWrite)</code>
                </dd>
              </div>
            )}

            {d.contextWindow && (
              <div class="kpi-box kpi-span-2">
                <dt class="section-kicker">CONTEXT WINDOW USAGE</dt>
                <dd class="kpi-val kpi-val-compact">{d.contextWindow}</dd>
              </div>
            )}
          </dl>
        </section>
      )
    }

    <!-- Conditional: Calls (LLM & Tool Call Telemetry) -->
    {
      hasCallsSection && (
        <section
          class:list={['card', hasTokenSection ? 'col-6' : 'col-12']}
          aria-labelledby="calls-breakdown-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">04 · AGENT LOOP CALLS</span>
              <h2 id="calls-breakdown-heading" class="card-heading">Calls &amp; Tool Breakdown</h2>
            </div>
            <span class="hl hl-sky">tool loop</span>
          </div>

          <dl class="kpi-grid kpi-grid-spaced">
            {d.calls?.llmCalls !== undefined && (
              <div class="kpi-box">
                <dt class="section-kicker">LLM API CALLS</dt>
                <dd class="kpi-val">{d.calls.llmCalls}</dd>
                <dd class="kpi-sub">completed agent_response steps</dd>
              </div>
            )}

            {d.calls?.toolCalls?.total !== undefined && (
              <div class="kpi-box">
                <dt class="section-kicker">TOOL CALLS</dt>
                <dd class="kpi-val">{d.calls.toolCalls.total}</dd>
                <dd class="kpi-sub">
                  {d.calls.toolCalls.done !== undefined && (
                    <span>{d.calls.toolCalls.done} DONE</span>
                  )}
                  {d.calls.toolCalls.error !== undefined && d.calls.toolCalls.error > 0 && (
                    <span class="hl hl-magenta tool-err-pill">
                      {d.calls.toolCalls.error} ERROR
                    </span>
                  )}
                </dd>
              </div>
            )}
          </dl>

          {d.calls?.toolCalls?.breakdown && d.calls.toolCalls.breakdown.length > 0 && (
            <ul class="command-list tool-list" role="list">
              {d.calls.toolCalls.breakdown.map((item, idx) => {
                const doneCount = item.done ?? item.total - (item.error ?? 0);
                const errCount = item.error ?? 0;
                const labelId = `tool-label-${idx}`;

                return (
                  <li class="command-row tool-row">
                    <div class="tool-row-header">
                      <span class="tool-name" id={labelId}>
                        <span class="prefix">tool/</span>
                        <span class:list={['hl', errCount > 0 ? 'hl-magenta' : 'hl-acid']}>
                          {item.tool}
                        </span>
                      </span>
                      <div class="tool-counts">
                        <strong>{item.total}</strong>
                        {(item.done !== undefined || (item.error && item.error > 0)) && (
                          <span class="tool-status-note">
                            ({doneCount} DONE
                            {errCount > 0 ? `, ${errCount} ERROR` : ''})
                          </span>
                        )}
                      </div>
                    </div>
                    <progress
                      class:list={['tool-progress', { 'has-error': errCount > 0 }]}
                      value={item.total}
                      max={maxToolCalls}
                      aria-labelledby={labelId}
                    />
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      )
    }

    <!-- Conditional: Cost Breakdown -->
    {
      hasCostBreakdown && (
        <section
          class="card col-12 deferred-section"
          aria-labelledby="cost-breakdown-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">05 · COST MATRIX</span>
              <h2 id="cost-breakdown-heading" class="card-heading">Estimated Cost Breakdown</h2>
            </div>
            <span class="hl hl-mint">USD pricing</span>
          </div>
          <div
            class="table-wrapper table-wrapper-flat"
            tabindex="0"
            role="region"
            aria-labelledby="cost-breakdown-heading"
          >
            <table class="app-table leaderboard-table static-table">
              <caption class="visually-hidden">
                Token volume and estimated cost breakdown comparing 2026 and 2027 pricing rates
              </caption>
              <thead>
                <tr>
                  <th scope="col">Component</th>
                  <th scope="col">Tokens</th>
                  <th scope="col">Rate (2026)</th>
                  <th scope="col">Cost (2026 Rate)</th>
                  <th scope="col">Rate (2027)</th>
                  <th scope="col">Cost (2027 Rate)</th>
                </tr>
              </thead>
              <tbody>
                {d.costBreakdown!.map((row) => (
                  <tr>
                    <th scope="row" data-cell="Component">
                      <strong>{row.component}</strong>
                    </th>
                    <td class="mono" data-cell="Tokens">{row.tokens}</td>
                    <td class="mono" data-cell="Rate (2026)">{row.rate2026 ?? '—'}</td>
                    <td class="mono" data-cell="Cost (2026)">
                      <span class="hl hl-mint">{row.cost2026}</span>
                    </td>
                    <td class="mono" data-cell="Rate (2027)">{row.rate2027 ?? '—'}</td>
                    <td class="mono" data-cell="Cost (2027)">{row.cost2027 ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <!-- Conditional: Slice / Phase Breakdown -->
    {
      hasSliceBreakdown && (
        <section
          class="card col-12 deferred-section"
          aria-labelledby="slice-breakdown-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">06 · SLICE TELEMETRY</span>
              <h2 id="slice-breakdown-heading" class="card-heading">Slice / Phase Breakdown</h2>
            </div>
            <span class="hl hl-violet">per-stage metrics</span>
          </div>
          <div
            class="table-wrapper table-wrapper-flat"
            tabindex="0"
            role="region"
            aria-labelledby="slice-breakdown-heading"
          >
            <table class="app-table leaderboard-table static-table">
              <caption class="visually-hidden">
                Per-stage slice breakdown of step ranges, LLM calls, task polls, thinking tokens, and
                cost
              </caption>
              <thead>
                <tr>
                  <th scope="col">Slice / Phase</th>
                  <th scope="col">Step Range</th>
                  <th scope="col">LLM Calls</th>
                  <th scope="col">manage_task Polls</th>
                  <th scope="col">Thinking Tokens</th>
                  <th scope="col">Cost (2026 Rate)</th>
                </tr>
              </thead>
              <tbody>
                {d.sliceBreakdown!.map((row) => (
                  <tr>
                    <th scope="row" data-cell="Slice / Phase">
                      <strong>{row.slice}</strong>
                    </th>
                    <td class="mono" data-cell="Step Range">{row.stepRange}</td>
                    <td class="mono" data-cell="LLM Calls">{row.llmCalls}</td>
                    <td class="mono" data-cell="manage_task Polls">{row.manageTaskPolls ?? 0}</td>
                    <td class="mono" data-cell="Thinking Tokens">
                      {row.thinkingTokens?.toLocaleString() ?? '—'}
                    </td>
                    <td class="mono" data-cell="Cost (2026)">
                      <span class="hl hl-mint cost-pill">{formatCost(row.costUsd)}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <!-- Conditional: Git Commit Log -->
    {
      hasCommitLog && (
        <section
          class="card col-12 deferred-section"
          aria-labelledby="git-commits-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">07 · GIT CHECKPOINTS</span>
              <h2 id="git-commits-heading" class="card-heading">
                Git Commits ({d.commitLog!.length})
              </h2>
            </div>
            <span class="hl hl-acid">git log</span>
          </div>
          <pre class="terminal-box" tabindex="0"><code>{commitLogText}</code></pre>
        </section>
      )
    }

    <!-- Conditional: Notes -->
    {
      hasNotes && (
        <section
          class="card col-12 deferred-section"
          id="notes-section"
          aria-labelledby="notes-findings-heading"
        >
          <div class="card-title">
            <div>
              <span class="section-kicker">08 · FIELD NOTES</span>
              <div class="card-title-group">
                <h2 id="notes-findings-heading" class="card-heading">Notes &amp; Key Findings</h2>
                <span class="hl hl-violet">
                  {hasNotesDetails ? d.notesDetails!.length : d.notes!.length} findings
                </span>
              </div>
            </div>
            {hasNotesDetails && d.notesDetails!.length > 1 && (
              <button
                type="button"
                class="btn btn-sm btn-secondary"
                id="toggle-notes-btn"
                aria-expanded="false"
              >
                Expand All
              </button>
            )}
          </div>

          {hasNotesDetails ? (
            <ol class="notes-list" role="list">
              {d.notesDetails!.map((note, idx) => (
                <li class="note-card">
                  <details class="note-disclosure" open={idx === 0}>
                    <summary class="note-summary">
                      <span class="hl hl-acid note-num" aria-hidden="true">
                        {String(idx + 1).padStart(2, '0')}
                      </span>
                      <strong class="note-title">
                        {tokenizeNoteText(note.title).map((seg) =>
                          seg.type === 'code' ? (
                            <code class="note-inline-code">{seg.value}</code>
                          ) : (
                            seg.value
                          )
                        )}
                      </strong>
                      <span class="note-summary-meta">
                        <span class="tag-outline note-count-badge">
                          {note.bullets.length} {note.bullets.length === 1 ? 'point' : 'points'}
                        </span>
                        <span class="note-chevron" aria-hidden="true">▸</span>
                      </span>
                    </summary>
                    <div class="note-body">
                      <ul class="note-bullets" role="list">
                        {note.bullets.map((b) => {
                          const parsed = parseNoteBullet(b);
                          return (
                            <li
                              class:list={[
                                'note-bullet-item',
                                {
                                  'is-intro': parsed.isIntro,
                                  'has-block-lead': parsed.isBlockLead,
                                },
                              ]}
                            >
                              {parsed.lead && (
                                <strong
                                  class:list={[
                                    'note-bullet-lead',
                                    { 'note-bullet-lead-block': parsed.isBlockLead },
                                  ]}
                                >
                                  {parsed.lead.map((seg) =>
                                    seg.type === 'code' ? (
                                      <code class="note-inline-code">{seg.value}</code>
                                    ) : (
                                      seg.value
                                    )
                                  )}
                                </strong>
                              )}{' '}
                              <span class="note-bullet-copy">
                                {parsed.body.map((seg) =>
                                  seg.type === 'code' ? (
                                    <code class="note-inline-code">{seg.value}</code>
                                  ) : (
                                    seg.value
                                  )
                                )}
                              </span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          ) : (
            <ol class="notes-list" role="list">
              {d.notes!.map((note, idx) => (
                <li class="note-item">
                  <span class="hl hl-acid note-num" aria-hidden="true">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <span>
                    {tokenizeNoteText(note).map((seg) =>
                      seg.type === 'code' ? (
                        <code class="note-inline-code">{seg.value}</code>
                      ) : (
                        seg.value
                      )
                    )}
                  </span>
                </li>
              ))}
            </ol>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-cmd-btn') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-cmd-status') as HTMLElement | null;
  copyBtn?.addEventListener('click', async () => {
    const cmd = copyBtn.dataset.cmd;
    if (!cmd) return;
    try {
      await navigator.clipboard.writeText(cmd);
      const original = copyBtn.textContent;
      copyBtn.textContent = '✓ Copied!';
      if (copyStatus) copyStatus.textContent = 'Command copied to clipboard.';
      setTimeout(() => {
        copyBtn.textContent = original;
        if (copyStatus) copyStatus.textContent = '';
      }, 1800);
    } catch {
      copyBtn.textContent = 'Failed to copy';
      if (copyStatus) copyStatus.textContent = 'Failed to copy command.';
    }
  });

  const toggleNotesBtn = document.getElementById('toggle-notes-btn') as HTMLButtonElement | null;
  const noteDisclosures = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('#notes-section .note-disclosure')
  );

  function syncToggleNotesBtn() {
    if (!toggleNotesBtn || noteDisclosures.length === 0) return;
    const allOpen = noteDisclosures.every((d) => d.open);
    toggleNotesBtn.textContent = allOpen ? 'Collapse All' : 'Expand All';
    toggleNotesBtn.setAttribute('aria-expanded', String(allOpen));
  }

  toggleNotesBtn?.addEventListener('click', () => {
    const allOpen = noteDisclosures.every((d) => d.open);
    for (const d of noteDisclosures) {
      d.open = !allOpen;
    }
    syncToggleNotesBtn();
  });

  for (const d of noteDisclosures) {
    d.addEventListener('toggle', syncToggleNotesBtn);
  }
</script>
