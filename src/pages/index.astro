---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  parseTokenString,
  getPlanStats,
} from '../utils/format';

const allRuns = await getCollection('runs');

const enrichedRuns = allRuns
  .map((entry) => {
    const d = entry.data;
    const plan = getPlanStats(d.planCompletion);
    const inputTokens = parseTokenString(d.tokens?.input);
    const outputTokens = parseTokenString(d.tokens?.output);
    const totalTokens = inputTokens + outputTokens;
    const hasCalls =
      d.calls && (d.calls.llmCalls !== undefined || d.calls.toolCalls?.total !== undefined);
    const totalCalls = hasCalls
      ? (d.calls?.llmCalls ?? 0) + (d.calls?.toolCalls?.total ?? 0)
      : undefined;
    const testsRatio =
      d.tests && d.tests.total > 0 ? d.tests.passed / d.tests.total : -1;
    const timeMs = new Date(d.timestamp).getTime() || 0;

    return {
      id: entry.id,
      data: d,
      plan,
      inputTokens,
      outputTokens,
      totalTokens,
      totalCalls,
      testsRatio,
      timeMs,
    };
  })
  .sort((a, b) => {
    if (b.plan.ratio !== a.plan.ratio) return b.plan.ratio - a.plan.ratio;
    if (b.testsRatio !== a.testsRatio) return b.testsRatio - a.testsRatio;
    if (a.data.costUsd !== b.data.costUsd) return a.data.costUsd - b.data.costUsd;
    return a.data.durationMinutes - b.data.durationMinutes;
  });

const harnesses = [...new Set(enrichedRuns.map((r) => r.data.codingHarness))].sort();
const providers = [...new Set(enrichedRuns.map((r) => r.data.provider))].sort();

const fastestMin =
  enrichedRuns.length > 0
    ? Math.min(...enrichedRuns.map((r) => r.data.durationMinutes))
    : 0;
const lowestCost =
  enrichedRuns.length > 0
    ? Math.min(...enrichedRuns.map((r) => r.data.costUsd))
    : 0;
---

<BaseLayout title="Leaderboard" activeNav="leaderboard">
  <section class="hero-card" aria-labelledby="hero-heading">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span aria-hidden="true">🦫</span>
        <span>PERSONAL CODING AGENT BENCHMARK</span>
      </div>
      <h1 id="hero-heading" class="hero-title">Capy Bench Leaderboard</h1>
      <p class="hero-subtitle">
        Evaluating coding harnesses and language models on an end-to-end multi-stage engineering
        plan (<code>S1</code>–<code>S7</code>). Tracking completion, duration, token usage, cache
        efficiency, and real cost.
      </p>
      <p class="hero-note">
        <span class="badge badge-effort">Personal Code Evaluation</span>
        <span>
          Independent, hands-on runs on a real project workflow — meant as practical field notes
          rather than a formal academic benchmark.
        </span>
      </p>
    </div>

    <dl class="hero-stats">
      <div class="stat-box">
        <dt class="stat-label">Total Runs</dt>
        <dd class="stat-value">{enrichedRuns.length}</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Harnesses</dt>
        <dd class="stat-value">{harnesses.length}</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Fastest Run</dt>
        <dd class="stat-value">{formatDuration(fastestMin)}</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Lowest Cost</dt>
        <dd class="stat-value">{formatCost(lowestCost)}</dd>
      </div>
    </dl>
  </section>

  <!-- Filter & Sort Controls -->
  <search class="controls-bar" aria-label="Leaderboard filters and sorting">
    <div class="control-group">
      <label class="control-label" for="search-input">Search</label>
      <input
        id="search-input"
        name="q"
        type="search"
        class="control-input"
        placeholder="Harness, model, provider..."
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />

      <label class="control-label" for="harness-filter">Harness</label>
      <select id="harness-filter" name="harness" class="control-select">
        <option value="all">All Harnesses</option>
        {harnesses.map((h) => <option value={h}>{h}</option>)}
      </select>

      <label class="control-label" for="provider-filter">Provider</label>
      <select id="provider-filter" name="provider" class="control-select">
        <option value="all">All Providers</option>
        {providers.map((p) => <option value={p}>{p}</option>)}
      </select>
    </div>

    <div class="control-group">
      <label class="control-label" for="sort-select">Sort By</label>
      <select id="sort-select" name="sort" class="control-select">
        <option value="plan" selected>Plan Completion (S1–S7)</option>
        <option value="duration">Duration (Time Elapsed)</option>
        <option value="cost">Total Cost ($)</option>
        <option value="tokens">Total Tokens (In + Out)</option>
        <option value="tests">Tests Passed</option>
        <option value="timestamp">Run Date</option>
      </select>
      <button
        id="sort-dir-btn"
        type="button"
        class="sort-dir-btn"
        data-dir="desc"
        aria-label="Sort direction: descending. Activate to switch to ascending"
      >
        <span aria-hidden="true">↓</span> DESC
      </button>
    </div>

    <div
      id="leaderboard-status"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
  </search>

  <!-- Leaderboard Table -->
  <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="leaderboard-caption">
    <table class="leaderboard-table" id="leaderboard-table">
      <caption id="leaderboard-caption" class="visually-hidden">
        Capy Bench evaluation runs ranked by plan completion, tests passed, duration, token usage,
        and cost
      </caption>
      <thead>
        <tr>
          <th scope="col" class="col-rank">Rank</th>
          <th scope="col">Coding Harness & Model</th>
          <th scope="col" class="sortable active-sort" data-sort-col="plan" aria-sort="descending">
            <button type="button" class="sort-header-btn">
              <span>Plan Completion</span>
              <span class="sort-indicator" aria-hidden="true">↓</span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tests" aria-sort="none">
            <button type="button" class="sort-header-btn">
              <span>Tests & Commits</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="duration" aria-sort="none">
            <button type="button" class="sort-header-btn">
              <span>Duration</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tokens" aria-sort="none">
            <button type="button" class="sort-header-btn">
              <span>Token Usage</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="cost" aria-sort="none">
            <button type="button" class="sort-header-btn">
              <span>Cost</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="col-details">Details</th>
        </tr>
      </thead>
      <tbody id="leaderboard-tbody">
        {
          enrichedRuns.map((run, index) => {
            const { data, plan } = run;
            const rank = index + 1;
            const hasTokens =
              data.tokens && (data.tokens.input || data.tokens.output || data.tokens.cacheHitRate);
            const vtName = `run-${run.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;

            return (
              <tr
                class="run-row"
                style={`--vt-name: ${vtName};`}
                data-href={`/runs/${run.id}`}
                data-harness={data.codingHarness}
                data-provider={data.provider}
                data-search={`${data.codingHarness} ${data.model} ${data.provider} ${data.effort ?? ''}`.toLowerCase()}
                data-plan={plan.ratio}
                data-duration={data.durationMinutes}
                data-cost={data.costUsd}
                data-tokens={run.totalTokens}
                data-tests={run.testsRatio}
                data-timestamp={run.timeMs}
              >
                <td data-cell="Rank">
                  <span
                    class:list={[
                      'rank-badge',
                      { 'rank-1': rank === 1, 'rank-2': rank === 2, 'rank-3': rank === 3 },
                    ]}
                  >
                    #{rank}
                  </span>
                </td>

                <th scope="row" data-cell="Harness & Model">
                  <div class="entry-title">
                    <span>{data.codingHarness}</span>
                    <span class="text-muted-sep" aria-hidden="true">/</span>
                    <span class="entry-model">{data.model}</span>
                  </div>
                  <div class="entry-meta">
                    <span class="badge badge-provider">{data.provider}</span>
                    {data.effort && <span class="badge badge-effort">Effort: {data.effort}</span>}
                    {data.interface?.type && (
                      <span class="badge badge-interface">{data.interface.type}</span>
                    )}
                    <time datetime={data.timestamp} class="metric-sub metric-inline">
                      {formatTimestamp(data.timestamp)}
                    </time>
                  </div>
                </th>

                <td data-cell="Plan Completion">
                  <div class="metric-primary">
                    {plan.completed}/{plan.total} stages ({Math.round(plan.ratio * 100)}%)
                  </div>
                </td>

                <td data-cell="Tests & Commits">
                  {data.tests ? (
                    <div class="metric-primary">
                      {data.tests.passed}/{data.tests.total} passed
                    </div>
                  ) : (
                    <div class="metric-empty">—</div>
                  )}
                  {data.commits !== undefined && (
                    <div class="metric-sub">{data.commits} commits</div>
                  )}
                </td>

                <td data-cell="Duration">
                  <div class="metric-primary">{formatDuration(data.durationMinutes)}</div>
                  {run.totalCalls !== undefined && (
                    <div class="metric-sub">{run.totalCalls.toLocaleString()} calls</div>
                  )}
                </td>

                <td data-cell="Token Usage">
                  {hasTokens ? (
                    <div>
                      <div class="metric-primary">
                        {data.tokens?.input ?? '—'} in / {data.tokens?.output ?? '—'} out
                      </div>
                      <div class="metric-sub">
                        {data.tokens?.cacheHitRate && (
                          <span>Cache: {data.tokens.cacheHitRate}</span>
                        )}
                        {data.tokens?.cacheHitRate && data.contextWindow && (
                          <span aria-hidden="true"> • </span>
                        )}
                        {data.contextWindow && <span>Ctx: {data.contextWindow}</span>}
                      </div>
                    </div>
                  ) : (
                    <span class="metric-empty">—</span>
                  )}
                </td>

                <td data-cell="Cost">
                  <span class="cost-pill">{formatCost(data.costUsd)}</span>
                </td>

                <td data-cell="Details">
                  <a href={`/runs/${run.id}`} class="view-btn">
                    <span>Inspect</span>
                    <span class="visually-hidden">
                      {' '}
                      {data.codingHarness} {data.model}
                    </span>
                    <span aria-hidden="true">→</span>
                  </a>
                </td>
              </tr>
            );
          })
        }
        <tr id="empty-state-row" hidden>
          <td colspan="8" class="empty-state-cell">
            No benchmark runs match the current filters.
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</BaseLayout>

<script>
  const tbody = document.getElementById('leaderboard-tbody') as HTMLTableSectionElement | null;
  const emptyStateRow = document.getElementById('empty-state-row') as HTMLTableRowElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const harnessFilter = document.getElementById('harness-filter') as HTMLSelectElement | null;
  const providerFilter = document.getElementById('provider-filter') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const sortDirBtn = document.getElementById('sort-dir-btn') as HTMLButtonElement | null;
  const statusRegion = document.getElementById('leaderboard-status') as HTMLElement | null;
  const sortableHeaders = document.querySelectorAll<HTMLTableCellElement>('th.sortable');

  const defaultSortDirs: Record<string, 'asc' | 'desc'> = {
    plan: 'desc',
    tests: 'desc',
    duration: 'asc',
    cost: 'asc',
    tokens: 'asc',
    timestamp: 'desc',
  };

  let announceTimer: ReturnType<typeof setTimeout> | null = null;

  function setSortDirButtonState(dir: 'asc' | 'desc') {
    if (!sortDirBtn) return;
    sortDirBtn.dataset.dir = dir;
    sortDirBtn.innerHTML = `<span aria-hidden="true">${dir === 'asc' ? '↑' : '↓'}</span> ${dir === 'asc' ? 'ASC' : 'DESC'}`;
    sortDirBtn.setAttribute(
      'aria-label',
      `Sort direction: ${dir === 'asc' ? 'ascending' : 'descending'}. Activate to switch to ${dir === 'asc' ? 'descending' : 'ascending'}`
    );
  }

  function applyLeaderboardUpdate() {
    if (!tbody || !sortSelect || !sortDirBtn) return;

    const query = (searchInput?.value ?? '').trim().toLowerCase();
    const harness = harnessFilter?.value ?? 'all';
    const provider = providerFilter?.value ?? 'all';
    const sortBy = sortSelect.value;
    const sortDir = (sortDirBtn.dataset.dir as 'asc' | 'desc') || 'desc';

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row'));

    // Filter rows
    rows.forEach((row) => {
      const rowSearch = row.dataset.search ?? '';
      const rowHarness = row.dataset.harness ?? '';
      const rowProvider = row.dataset.provider ?? '';

      const matchesSearch = !query || rowSearch.includes(query);
      const matchesHarness = harness === 'all' || rowHarness === harness;
      const matchesProvider = provider === 'all' || rowProvider === provider;

      row.hidden = !(matchesSearch && matchesHarness && matchesProvider);
    });

    // Sort rows
    rows.sort((a, b) => {
      const valA = parseFloat(a.dataset[sortBy] ?? '0');
      const valB = parseFloat(b.dataset[sortBy] ?? '0');

      if (valA !== valB) {
        return sortDir === 'asc' ? valA - valB : valB - valA;
      }
      // Tie-breaker: higher plan ratio, then lower cost
      const planDiff =
        parseFloat(b.dataset.plan ?? '0') - parseFloat(a.dataset.plan ?? '0');
      if (planDiff !== 0) return planDiff;
      return parseFloat(a.dataset.cost ?? '0') - parseFloat(b.dataset.cost ?? '0');
    });

    // Re-order and re-rank visible rows using moveBefore when supported to preserve DOM state
    const supportsMoveBefore = 'moveBefore' in Element.prototype;
    let visibleRank = 1;
    rows.forEach((row) => {
      const refNode = emptyStateRow ?? null;
      if (supportsMoveBefore) {
        (tbody as unknown as { moveBefore: (node: Node, child: Node | null) => void }).moveBefore(
          row,
          refNode
        );
      } else {
        tbody.insertBefore(row, refNode);
      }

      if (!row.hidden) {
        const badge = row.querySelector('.rank-badge');
        if (badge) {
          badge.textContent = `#${visibleRank}`;
          badge.classList.remove('rank-1', 'rank-2', 'rank-3');
          if (visibleRank === 1) badge.classList.add('rank-1');
          if (visibleRank === 2) badge.classList.add('rank-2');
          if (visibleRank === 3) badge.classList.add('rank-3');
        }
        visibleRank++;
      }
    });

    const visibleCount = visibleRank - 1;
    if (emptyStateRow) {
      emptyStateRow.hidden = visibleCount > 0;
    }

    // Update table header indicators and aria-sort
    sortableHeaders.forEach((th) => {
      const col = th.dataset.sortCol;
      const indicator = th.querySelector('.sort-indicator');
      if (col === sortBy) {
        th.classList.add('active-sort');
        th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
        if (indicator) indicator.textContent = sortDir === 'asc' ? '↑' : '↓';
      } else {
        th.classList.remove('active-sort');
        th.setAttribute('aria-sort', 'none');
        if (indicator) indicator.textContent = '';
      }
    });

    // Debounce polite live region announcement
    if (statusRegion) {
      if (announceTimer) clearTimeout(announceTimer);
      const sortLabel = sortSelect.selectedOptions[0]?.textContent ?? sortBy;
      announceTimer = setTimeout(() => {
        statusRegion.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'run' : 'runs'}, sorted by ${sortLabel} (${sortDir === 'asc' ? 'ascending' : 'descending'}).`;
      }, 250);
    }
  }

  function updateLeaderboard(withTransition = true) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (withTransition && !prefersReducedMotion && 'startViewTransition' in document) {
      document.startViewTransition(() => applyLeaderboardUpdate());
    } else {
      applyLeaderboardUpdate();
    }
  }

  searchInput?.addEventListener('input', () => updateLeaderboard(false));
  harnessFilter?.addEventListener('change', () => updateLeaderboard(true));
  providerFilter?.addEventListener('change', () => updateLeaderboard(true));

  sortSelect?.addEventListener('change', () => {
    const col = sortSelect.value;
    const defaultDir = defaultSortDirs[col] ?? 'desc';
    setSortDirButtonState(defaultDir);
    updateLeaderboard(true);
  });

  sortDirBtn?.addEventListener('click', () => {
    const current = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
    setSortDirButtonState(current);
    updateLeaderboard(true);
  });

  sortableHeaders.forEach((th) => {
    const btn = th.querySelector<HTMLButtonElement>('.sort-header-btn');
    (btn ?? th).addEventListener('click', () => {
      const col = th.dataset.sortCol;
      if (!col || !sortSelect || !sortDirBtn) return;

      if (sortSelect.value === col) {
        const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
        setSortDirButtonState(nextDir);
      } else {
        sortSelect.value = col;
        const defaultDir = defaultSortDirs[col] ?? 'desc';
        setSortDirButtonState(defaultDir);
      }
      updateLeaderboard(true);
    });
  });

  // Row click navigation
  document.querySelectorAll<HTMLTableRowElement>('tr.run-row').forEach((row) => {
    row.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button')) return;
      const href = row.dataset.href;
      if (href) window.location.href = href;
    });
  });
</script>
