---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  formatCompactContextWindow,
  formatHarnessName,
  formatProviderName,
} from '../utils/format';
import {
  analyzeAndRankRuns,
  computeStageBottleneckMatrix,
  discoverAblationPresets,
} from '../utils/telemetry';
import { BENCHMARK_STAGES } from '../data/benchmark';

const stageTitleMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));
const allRuns = await getCollection('runs', ({ data }) => data.published !== false);

const analyzedRuns = analyzeAndRankRuns(
  allRuns.map((entry) => ({ id: entry.id, data: entry.data }))
);
const stageMatrix = computeStageBottleneckMatrix(analyzedRuns);
const ablationPresets = discoverAblationPresets(analyzedRuns).slice(0, 3);

const enrichedRuns = analyzedRuns.map((run) => {
  const d = run.data;
  const compactContext = formatCompactContextWindow(d.contextWindow);
  const toolsPerTurn =
    run.llmCalls > 0 && run.toolTotalCalls > 0
      ? (run.toolTotalCalls / run.llmCalls).toFixed(2)
      : null;
  const secPerTurn =
    run.llmCalls > 0 && d.durationMinutes > 0
      ? ((d.durationMinutes * 60) / run.llmCalls).toFixed(1)
      : null;
  const testsRatio =
    d.tests && d.tests.total > 0 ? d.tests.passed / d.tests.total : -1;
  const testsPassed = d.tests?.passed ?? -1;
  const timeMs = new Date(d.timestamp).getTime() || 0;

  return {
    id: run.id,
    data: d,
    telemetry: run,
    plan: run.plan,
    inputTokens: run.tokens.uncachedInput,
    cachedTokens: run.tokens.cachedInput,
    outputTokens: run.tokens.output,
    totalTokens: run.tokens.total,
    compactContext,
    toolsPerTurn,
    secPerTurn,
    testsRatio,
    testsPassed,
    timeMs,
    leadNotes: [
      ...(d.notes ?? []),
      ...(d.notesDetails ?? []).flatMap((n) => n.bullets ?? []),
    ]
      .slice(0, 2)
      .map((b) => (b.length > 220 ? `${b.slice(0, 217)}...` : b)),
    shortDate: new Date(d.timestamp).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    }),
    peakCtxCompact: run.context.peakTokens
      ? `${Math.round(run.context.peakTokens / 1000)}k peak`
      : compactContext,
  };
});


const harnesses = [...new Set(enrichedRuns.map((r) => r.data.codingHarness))].sort((a, b) =>
  formatHarnessName(a).localeCompare(formatHarnessName(b), undefined, { sensitivity: 'base' })
);
const providers = [...new Set(enrichedRuns.map((r) => r.data.provider))].sort((a, b) =>
  formatProviderName(a).localeCompare(formatProviderName(b), undefined, { sensitivity: 'base' })
);

const fullPassRuns = enrichedRuns.filter((r) => r.plan.ratio === 1);
const fullPassCount = fullPassRuns.length;
const paretoFrontierRuns = fullPassRuns
  .filter((r) => r.telemetry.isParetoFrontier)
  .sort((a, b) => (a.telemetry.paretoOrder ?? 99) - (b.telemetry.paretoOrder ?? 99));


// SVG coordinates for the 7/7 Speed x Cost Pareto Frontier Plot
const chartW = 680;
const chartH = 250;
const padL = 52;
const padR = 24;
const padT = 22;
const padB = 38;
const plotW = chartW - padL - padR;
const plotH = chartH - padT - padB;

const maxPlotDur = Math.max(120, ...fullPassRuns.map((r) => r.data.durationMinutes));
const maxPlotCost = Math.max(14, ...fullPassRuns.map((r) => r.data.costUsd));

const toSvgX = (dur: number) => padL + (dur / maxPlotDur) * plotW;
const toSvgY = (cost: number) => padT + plotH - (cost / maxPlotCost) * plotH;

let paretoStepPath = '';
if (paretoFrontierRuns.length > 0) {
  const pts = paretoFrontierRuns.map((r) => ({
    x: Number(toSvgX(r.data.durationMinutes).toFixed(1)),
    y: Number(toSvgY(r.data.costUsd).toFixed(1)),
  }));
  const segs: string[] = [`M ${pts[0].x} ${pts[0].y}`];
  for (let i = 1; i < pts.length; i++) {
    segs.push(`L ${pts[i].x} ${pts[i - 1].y}`);
    segs.push(`L ${pts[i].x} ${pts[i].y}`);
  }
  paretoStepPath = segs.join(' ');
}
---

<BaseLayout title="Personal Coding-Agent Field Notes" activeNav="leaderboard">
  <div class="leaderboard-quiet">
    <header class="reading-intro">
      <div class="reading-intro-copy">
        <h1 id="hero-heading" class="headline-two-tone">
          Same task.<br />
          <span class="muted">Different journeys.</span>
        </h1>
        <p class="reading-intro-description">
          My personal evaluation of how coding agents build an Elixir/OTP CLI.
          Start with the results. Follow the details that interest you.
        </p>
        <p class="reading-intro-context">
          {enrichedRuns.length} published runs <span aria-hidden="true">·</span> Seven stages
          <a href="/about#evaluation-scope">Why the stack matters</a>
        </p>
      </div>
      {fullPassCount > 1 && (
        <aside class="reading-invitation" aria-label="A question to explore">
          <a href="/compare?preset=pareto-cost-vs-speed">
            Does faster always cost more?
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
          </a>
          <p>Compare two complete runs. See what happens along the way.</p>
        </aside>
      )}
    </header>

    <section class="run-ledger" aria-labelledby="runs-heading">
      <div class="ledger-heading-row">
        <h2 id="runs-heading">The runs</h2>
        <span id="visible-count-badge" class="controls-result-count">{enrichedRuns.length} runs</span>
      </div>
      <search class="reading-controls" aria-label="Filter and sort benchmark runs">
        <div class="reading-toolbar">
          <div class="scenario-pills-group" role="group" aria-label="Run outcomes">
            <button type="button" class="scenario-pill is-active" data-scenario="all" aria-pressed="true">
              All runs
            </button>
            <button type="button" class="scenario-pill" data-scenario="full-pass" aria-pressed="false">
              Completed all stages
            </button>
          </div>
          <div class="toolbar-search">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" />
              <path d="m13 13 4 4" />
            </svg>
            <input
              id="search-input"
              name="q"
              type="search"
              class="input"
              placeholder="Find a model or harness"
              aria-label="Filter runs by harness, model, provider, or effort"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            />
          </div>
          <button id="reset-filters-btn" type="button" class="btn btn-sm btn-secondary" hidden>
            Reset
          </button>
        </div>

        <details class="reading-disclosure run-options" id="run-options">
          <summary>Filter &amp; sort</summary>
          <div class="disclosure-body options-grid">
            <label class="option-field">
              Harness
              <select id="harness-filter" name="harness" class="select">
                <option value="all">All harnesses</option>
                {harnesses.map((h) => <option value={h}>{formatHarnessName(h)}</option>)}
              </select>
            </label>
            <label class="option-field">
              Provider
              <select id="provider-filter" name="provider" class="select">
                <option value="all">All providers</option>
                {providers.map((p) => <option value={p}>{formatProviderName(p)}</option>)}
              </select>
            </label>
            <label class="option-field">
              Sort by
              <select id="sort-select" name="sort" class="select">
                <option value="plan" selected>Completion, then time</option>
                <option value="duration">Time elapsed</option>
                <option value="turns">Turns (LLM calls)</option>
                <option value="cost">Cost in selected lens</option>
                <option value="tokens">Total tokens</option>
                <option value="tests">Agent tests passed</option>
                <option value="timestamp">Run date</option>
              </select>
            </label>
            <div class="option-field">
              <span>Sort direction</span>
              <button id="sort-dir-btn" type="button" class="btn btn-secondary" data-dir="desc" aria-label="Sort descending; activate to sort ascending">
                Descending
              </button>
            </div>
            <label class="option-field">
              Cost lens
              <select id="pricing-lens-select" name="lens" class="select">
                <option value="billed" selected>Actually billed</option>
                <option value="standard">Standard API rate</option>
                <option value="uncached">Without prompt caching</option>
              </select>
            </label>
            <label class="option-check">
              <input id="show-telemetry" name="telemetry" type="checkbox" />
              Show extra row notes (pace, tools, cache, commits)
            </label>
            <div class="option-scenarios" role="group" aria-label="Explore a subset of runs">
              <span>Look for</span>
              <button type="button" class="scenario-pill" data-scenario="pareto" aria-pressed="false">Speed &amp; cost tradeoffs</button>
              <button type="button" class="scenario-pill" data-scenario="under-1" aria-pressed="false">Runs under $1</button>
              <button type="button" class="scenario-pill" data-scenario="spec-miss" aria-pressed="false">Incomplete runs</button>
            </div>
          </div>
        </details>
        <div id="leaderboard-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
      </search>
      <p id="default-sort-note" class="controls-result-count">
        Default: most stages completed, then shortest time.
      </p>

      <div class="reading-table-ledger">
      <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="leaderboard-caption">
        <table class="app-table leaderboard-table readable-run-table" id="leaderboard-table">
          <caption id="leaderboard-caption" class="visually-hidden">
            Capy Bench evaluation runs showing stage completion, agent tests, elapsed time,
            LLM turns, exact token usage, and API cost. Default order: most stages completed,
            then shortest elapsed time.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="col-rank">#</th>
              <th scope="col">Model &amp; harness</th>
              <th scope="col" class="sortable active-sort" data-sort-col="plan" aria-sort="descending">
                <button
                  type="button"
                  class="sort-header-btn"
                  aria-describedby="default-sort-note"
                  title="Sort by S1–S7 holdout completion, then shortest elapsed time"
                >
                  <span>Outcome</span>
                  <span class="sort-indicator" aria-hidden="true">↓</span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="tests">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by agent-authored ExUnit test suite pass ratio"
                >
                  <span>Agent tests</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="duration">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by active wall-clock run duration"
                >
                  <span>Time</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="turns">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by total agentic LLM turns"
                >
                  <span>Turns</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="tokens">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by exact total token volume"
                >
                  <span>Tokens</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="cost">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by cost in USD under the active pricing lens"
                >
                  <span id="cost-col-header-label">Cost</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody id="leaderboard-tbody">
            {
              enrichedRuns.map((run, index) => {
                const { data, plan, telemetry } = run;
                const rank = index + 1;
                const hasTokens =
                  data.tokens && (data.tokens.input || data.tokens.output || data.tokens.cacheHitRate);
                const incompleteStages = plan.entries
                  .filter(([, done]) => !done)
                  .map(([stageId]) => stageId);

                const displayHarness = telemetry.displayHarness;
                const displayProvider = telemetry.displayProvider;
                const billedCost = data.costUsd;
                const standardCost = telemetry.costMetrics.standardApiCostUsd;
                const uncachedCost = telemetry.costMetrics.uncachedCounterfactualCostUsd;
                const cacheSavings = telemetry.costMetrics.cacheSavingsUsd;

                const maxRowStageCost = Math.max(
                  0.01,
                  ...BENCHMARK_STAGES.map(
                    (st) => telemetry.stages[st.id as keyof typeof telemetry.stages]?.costUsd ?? 0
                  )
                );
                const hasPerSlice = BENCHMARK_STAGES.some(
                  (st) => (telemetry.stages[st.id as keyof typeof telemetry.stages]?.llmCalls ?? 0) > 0
                );

                return (
                  <>
                    <tr
                      class="run-row"
                      data-run-id={run.id}
                      data-run-label={`${displayHarness} / ${data.model}`}
                      data-href={`/runs/${run.id}`}
                      data-harness={data.codingHarness}
                      data-provider={data.provider}
                      data-search={`${data.codingHarness} ${displayHarness} ${data.model} ${data.provider} ${displayProvider} ${data.effort ?? ''} ${telemetry.isParetoFrontier ? 'pareto frontier' : ''}`.toLowerCase()}
                      data-plan={plan.ratio}
                      data-plan-str={`${plan.completed}/${plan.total}`}
                      data-pareto={telemetry.isParetoFrontier ? '1' : '0'}
                      data-duration={data.durationMinutes}
                      data-duration-str={formatDuration(data.durationMinutes)}
                      data-cost={billedCost}
                      data-cost-str={formatCost(billedCost)}
                      data-cost-billed={billedCost}
                      data-cost-standard={standardCost}
                      data-cost-uncached={uncachedCost}
                      data-cache-savings={cacheSavings}
                      data-pricing-badge={telemetry.costMetrics.profile?.pricingBadge ?? 'free tier'}
                      data-turns={telemetry.llmCalls}
                      data-turns-str={telemetry.llmCalls > 0 ? String(telemetry.llmCalls) : '—'}
                      data-tokens={run.totalTokens}
                      data-tokens-str={data.tokens?.total ?? '—'}
                      data-tests={run.testsRatio}
                      data-tests-passed={run.testsPassed}
                      data-timestamp={run.timeMs}
                    >
                      <td data-cell="Rank">
                        <span
                          class:list={[
                            'rank-badge',
                            { 'rank-1': rank === 1, 'rank-2': rank === 2, 'rank-3': rank === 3 },
                          ]}
                        >
                          #{rank}
                        </span>
                      </td>

                      <th scope="row" data-cell="Model & harness">
                        <div class="cell-stack">
                          <div class="entry-title-row">
                            <a href={`/runs/${run.id}`} class="entry-title-link">
                              <span class="entry-model">{data.model}</span>
                            </a>
                            {telemetry.isParetoFrontier && (
                              <span
                                class="pareto-inline-badge extra-detail"
                                title={`Pareto Frontier #${telemetry.paretoOrder}: non-dominated on 7/7 speed (${formatDuration(data.durationMinutes)}) and cost (${formatCost(billedCost)})`}
                              >
                                Speed &amp; cost frontier
                              </span>
                            )}
                          </div>
                          <div class="entry-meta">
                            <span class="entry-meta-harness">{displayHarness}</span>
                            <span class="entry-meta-sep extra-detail" aria-hidden="true">·</span>
                            <span class="extra-detail">{displayProvider}</span>
                            {data.effort && (
                              <>
                                <span class="entry-meta-sep" aria-hidden="true">·</span>
                                <span>{data.effort}</span>
                              </>
                            )}
                            <span class="entry-meta-sep extra-detail" aria-hidden="true">·</span>
                            <time
                              datetime={data.timestamp}
                              title={formatTimestamp(data.timestamp)}
                              class="metric-sub metric-inline entry-timestamp extra-detail"
                            >
                              {run.shortDate}
                            </time>
                          </div>
                        </div>
                      </th>

                      <td data-cell="Outcome">
                        <button
                          type="button"
                          class="outcome-button"
                          data-peek-toggle={run.id}
                          aria-expanded="false"
                          aria-controls={`drawer-${run.id}`}
                          aria-label={`Explore ${displayHarness} / ${data.model}: ${plan.completed} of ${plan.total} stages passed${incompleteStages.length ? `; missed ${incompleteStages.join(', ')}` : ''}`}
                        >
                          <span class="metric-primary">{plan.completed}/{plan.total}</span>
                          <span>stages</span>
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="m5 6 3 3 3-3" />
                          </svg>
                        </button>
                      </td>

                      <td data-cell="Agent tests">
                        <div class="cell-stack">
                          {data.tests ? (
                            <div
                              class="metric-primary"
                              title="Agent-authored ExUnit test suite results"
                            >
                              {data.tests.passed}/{data.tests.total}
                            </div>
                          ) : (
                            <div class="metric-empty">—</div>
                          )}
                          <div class="metric-sub extra-detail">
                            {data.commits !== undefined ? `${data.commits} commits` : ''}
                            {telemetry.toolSuccessRatePct !== null && (
                              <>
                                {data.commits !== undefined && <span aria-hidden="true"> · </span>}
                                <span title={`${telemetry.toolErrorCalls} tool errors out of ${telemetry.toolTotalCalls} tool calls`}>
                                  {Math.round(telemetry.toolSuccessRatePct)}% ok
                                </span>
                              </>
                            )}
                          </div>
                        </div>
                      </td>

                      <td data-cell="Time">
                        <div class="cell-stack">
                          <div class="metric-primary">{formatDuration(data.durationMinutes)}</div>
                          {run.secPerTurn && (
                            <div
                              class="metric-sub extra-detail"
                              title={`Average wall-clock pace across ${telemetry.llmCalls} LLM turns`}
                            >
                              {run.secPerTurn}s/turn
                            </div>
                          )}
                        </div>
                      </td>

                      <td data-cell="Turns">
                        {telemetry.llmCalls > 0 ? (
                          <div class="cell-stack">
                            <div
                              class="metric-primary"
                              title={`${telemetry.llmCalls} LLM turns · ${telemetry.toolTotalCalls} tool calls`}
                            >
                              {telemetry.llmCalls}
                            </div>
                            {telemetry.toolTotalCalls > 0 && (
                              <div
                                class="metric-sub extra-detail"
                                title={`${telemetry.toolTotalCalls} tool calls across ${telemetry.llmCalls} LLM turns (${run.toolsPerTurn} tool calls per turn)`}
                              >
                                {telemetry.toolTotalCalls} tools
                                {run.toolsPerTurn && (
                                  <>
                                    <span aria-hidden="true"> · </span>
                                    <span>{run.toolsPerTurn}×</span>
                                  </>
                                )}
                              </div>
                            )}
                          </div>
                        ) : (
                          <span class="metric-empty">—</span>
                        )}
                      </td>

                      <td data-cell="Tokens">
                        {hasTokens ? (
                          <div class="cell-stack">
                            <div
                              class="metric-primary"
                              title={`Exact tokens: ${telemetry.tokens.total.toLocaleString('en-US')} total`}
                            >
                              {data.tokens?.total ?? '—'}
                            </div>
                            <div class="metric-sub extra-detail">
                              {data.tokens?.cacheHitRate && <span>{data.tokens.cacheHitRate} hit</span>}
                              {run.peakCtxCompact && (
                                <>
                                  {Boolean(data.tokens?.cacheHitRate) && <span aria-hidden="true"> · </span>}
                                  <span title={data.contextWindow}>{run.peakCtxCompact}</span>
                                </>
                              )}
                            </div>
                          </div>
                        ) : (
                          <span class="metric-empty">—</span>
                        )}
                      </td>

                      <td data-cell="Cost">
                        <div class="cell-stack">
                          <div class="cost-cell-head">
                            <span class="metric-primary cost-mono cost-primary-display">
                              {formatCost(billedCost)}
                            </span>
                          </div>
                          <div
                            class="metric-sub cost-sub-display extra-detail"
                            title={telemetry.costMetrics.profile?.pricingStatusNote}
                          >
                            {cacheSavings > 0
                              ? `-${formatCost(cacheSavings)} saved`
                              : standardCost > billedCost
                                ? `${formatCost(standardCost)} API equiv.`
                                : (telemetry.costMetrics.profile?.pricingBadge ?? 'free tier')}
                          </div>
                        </div>
                      </td>

                    </tr>

                    <tr
                      class="forensic-drawer-row"
                      id={`drawer-${run.id}`}
                      data-drawer-for={run.id}
                      hidden
                    >
                      <td colspan="8" class="forensic-drawer-cell">
                        <div class="forensic-drawer-inner">
                          <div class="forensic-stages-col">
                            <div class="forensic-col-head">
                              <span class="forensic-col-title">
                                The seven stages
                              </span>
                              <span class="mono forensic-col-meta">
                                {hasPerSlice
                                  ? `Peak: ${telemetry.peakStageId ?? '—'} · ${telemetry.llmCalls} turns (${formatCost(billedCost)})`
                                  : `Full run: ${telemetry.llmCalls} turns (${formatCost(billedCost)})`}
                              </span>
                            </div>
                            <div class="forensic-stage-grid">
                              {BENCHMARK_STAGES.map((st) => {
                                const sCell = telemetry.stages[st.id as keyof typeof telemetry.stages];
                                const barW = Math.min(100, ((sCell?.costUsd ?? 0) / maxRowStageCost) * 100).toFixed(0);
                                return (
                                  <div
                                    class:list={[
                                      'forensic-stage-card',
                                      {
                                        'is-peak': sCell?.isPeakCost,
                                        'is-miss': !sCell?.completed,
                                      },
                                    ]}
                                  >
                                    <div class="forensic-stage-top">
                                      <span class="mono forensic-stage-id">{st.id}</span>
                                      {!sCell?.completed && (
                                        <span class="forensic-stage-status is-miss">Missed</span>
                                      )}
                                    </div>
                                    <div class="mono forensic-stage-cost">
                                      {sCell && sCell.llmCalls > 0 ? formatCost(sCell.costUsd) : '—'}
                                    </div>
                                    <div class="mono forensic-stage-turns">
                                      {sCell && sCell.llmCalls > 0 ? `${sCell.llmCalls}t` : st.title}
                                    </div>
                                    {hasPerSlice && (
                                      <div class="forensic-stage-bar-track" aria-hidden="true">
                                        <span
                                          class="forensic-stage-bar-fill"
                                          style={`inline-size: ${barW}%`}
                                        />
                                      </div>
                                    )}
                                  </div>
                                );
                              })}
                            </div>
                          </div>

                          <div class="forensic-notes-col">
                            <div class="forensic-col-head">
                              <span class="forensic-col-title">Field notes</span>
                              <div class="forensic-quick-links">
                                <button
                                  type="button"
                                  class="btn btn-sm btn-secondary pin-diff-btn"
                                  data-pin-run={run.id}
                                  aria-pressed="false"
                                  title="Pin run to head-to-head comparison dock"
                                >
                                  Add to comparison
                                </button>
                                <a
                                  href={`/compare?a=${run.id}&b=${rank === 1 && enrichedRuns[1] ? enrichedRuns[1].id : enrichedRuns[0].id}`}
                                  class="forensic-action-link"
                                >
                                  Compare →
                                </a>
                                <a href={`/runs/${run.id}`} class="forensic-action-link is-primary">
                                  Read the run →
                                </a>
                              </div>
                            </div>
                            {run.leadNotes.length > 0 ? (
                              <ul class="forensic-notes-list">
                                {run.leadNotes.map((note) => (
                                  <li>{note}</li>
                                ))}
                              </ul>
                            ) : (
                              <p class="forensic-notes-empty">
                                This run passed {plan.completed} of {plan.total} stages in {formatDuration(data.durationMinutes)}, at a billed cost of {formatCost(billedCost)}.
                              </p>
                            )}
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })
            }
            <tr id="empty-state-row" hidden>
              <td colspan="8" class="empty-state-cell">
                <div class="empty-state-wrap">
                  <p id="empty-state-msg" class="empty-state-copy">
                    No benchmark runs match the current filters.
                  </p>
                  <button
                    id="empty-reset-btn"
                    type="button"
                    class="btn btn-sm btn-secondary"
                  >
                    Reset all filters
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    </section>

    <!-- Comparison appears only after a run is selected. -->
    <aside
      id="quick-compare-dock"
      class="quick-compare-dock"
      aria-label="Pinned head-to-head run comparison"
      hidden
    >
      <div class="qc-dock-inner">
        <div class="qc-contenders">
          <span class="qc-pair-text" id="qc-pair-text">Select a second run to compare</span>
        </div>
        <div class="mono qc-deltas" id="qc-deltas"></div>
        <div class="qc-actions">
          <a href="/compare" id="qc-open-link" class="btn btn-sm">
            Compare runs →
          </a>
          <button type="button" id="qc-clear-btn" class="btn btn-sm btn-secondary">
            Clear
          </button>
        </div>
      </div>
    </aside>

    <section class="reading-exploration" aria-labelledby="exploration-heading">
      <h2 id="exploration-heading">Follow a question</h2>
      <p class="exploration-description">There’s more here when you want to look a little closer.</p>
      <details class="reading-disclosure" id="pareto-section">
        <summary>Where do speed and cost meet?</summary>
        <div class="disclosure-body analytics-panel">
        <div class="panel-top-row">
          <p class="section-subnote">
            Each point passed all seven stages. The frontier joins runs with no alternative
            that is both faster and cheaper. Hover or focus a point to explore it.
          </p>
          <a href="/compare?preset=pareto-cost-vs-speed" class="action-link">
            Compare the tradeoffs <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="pareto-layout">
          <div class="pareto-svg-frame">
            <svg
              viewBox={`0 0 ${chartW} ${chartH}`}
              class="pareto-svg"
              role="img"
              aria-labelledby="pareto-svg-title pareto-svg-desc"
            >
              <title id="pareto-svg-title">7/7 Full-Pass Speed vs Cost Pareto Frontier</title>
              <desc id="pareto-svg-desc">
                Scatter plot of duration in minutes versus cost in USD for all 7/7 passing runs, with a stepped line connecting the {paretoFrontierRuns.length} Pareto-optimal runs.
              </desc>

              {[0, 3, 6, 9, 12].map((cVal) => {
                const y = Number(toSvgY(cVal).toFixed(1));
                return (
                  <g>
                    <line x1={padL} y1={y} x2={chartW - padR} y2={y} class="pareto-grid-line" />
                    <text x={padL - 8} y={y + 4} text-anchor="end" class="pareto-axis-label">
                      ${cVal}
                    </text>
                  </g>
                );
              })}

              {[20, 40, 60, 80, 100].map((dVal) => {
                const x = Number(toSvgX(dVal).toFixed(1));
                return (
                  <g>
                    <line x1={x} y1={padT} x2={x} y2={chartH - padB} class="pareto-grid-line" />
                    <text x={x} y={chartH - padB + 16} text-anchor="middle" class="pareto-axis-label">
                      {dVal}m
                    </text>
                  </g>
                );
              })}

              <line x1={padL} y1={padT} x2={padL} y2={chartH - padB} class="pareto-axis-line" />
              <line x1={padL} y1={chartH - padB} x2={chartW - padR} y2={chartH - padB} class="pareto-axis-line" />

              {paretoStepPath && (
                <path d={paretoStepPath} class="pareto-step-path" fill="none" />
              )}

              {fullPassRuns.map((r) => {
                const cx = Number(toSvgX(r.data.durationMinutes).toFixed(1));
                const cy = Number(toSvgY(r.data.costUsd).toFixed(1));
                const isFront = r.telemetry.isParetoFrontier;
                const pOrder = r.telemetry.paretoOrder;
                const shortLabel = isFront
                  ? `F${pOrder} · ${r.telemetry.displayHarness} / ${r.data.model.replace('-contributor', '')} (${formatCost(r.data.costUsd)})`
                  : `${r.telemetry.displayHarness} / ${r.data.model.replace('-contributor', '')} (${formatCost(r.data.costUsd)})`;
                const anchorEnd = pOrder === 2 || (!isFront && cx > 400);
                const labelOffsetY =
                  pOrder === 1
                    ? -10
                    : pOrder === 2
                      ? 4
                      : pOrder === 3
                        ? -10
                        : pOrder === 4
                          ? 13
                          : -8;
                const labelOffsetX = anchorEnd ? -10 : 9;
                return (
                  <a
                    href={`/runs/${r.id}`}
                    class="pareto-point-link"
                    data-pareto-run={r.id}
                    data-pareto-title={`${r.telemetry.displayHarness} / ${r.data.model}`}
                    data-pareto-dur={formatDuration(r.data.durationMinutes)}
                    data-pareto-cost={formatCost(r.data.costUsd)}
                    data-pareto-tokens={r.data.tokens?.total ?? '—'}
                    data-pareto-cache={`${r.telemetry.tokens.cacheHitRatePct}%`}
                    data-pareto-status={isFront ? `Frontier #${r.telemetry.paretoOrder}` : '7/7 Full Pass'}
                  >
                    <title>
                      {r.telemetry.displayHarness} / {r.data.model} ({r.data.effort ?? 'std'}): {formatDuration(r.data.durationMinutes)} · {formatCost(r.data.costUsd)}{isFront ? ' (PARETO OPTIMAL)' : ''}
                    </title>
                    {isFront ? (
                      <rect x={cx - 6} y={cy - 6} width="12" height="12" class="pareto-node-optimal" />
                    ) : (
                      <circle cx={cx} cy={cy} r="5" class="pareto-node-dominated" />
                    )}
                    {(isFront || r.data.costUsd > 5) && (
                      <text
                        x={cx + labelOffsetX}
                        y={cy + labelOffsetY}
                        text-anchor={anchorEnd ? 'end' : 'start'}
                        class:list={[
                          'pareto-node-label',
                          isFront ? 'is-optimal' : 'is-dominated',
                        ]}
                      >
                        {shortLabel}
                      </text>
                    )}
                  </a>
                );
              })}
            </svg>
          </div>

          <div class="pareto-sidebar">
            <ol class="command-list pareto-step-list" role="list">
              {paretoFrontierRuns.map((r, idx) => (
                <li
                  class:list={['command-row pareto-step-row', { 'is-active': idx === 0 }]}
                  data-pareto-item={r.id}
                >
                  <div class="pareto-step-left">
                    <span class="pareto-order-pill">F{r.telemetry.paretoOrder}</span>
                    <a href={`/runs/${r.id}`} class="pareto-step-link">
                      <strong>{r.telemetry.displayHarness} / {r.data.model}</strong>
                    </a>
                  </div>
                  <div class="mono pareto-step-metrics">
                    <span>{formatDuration(r.data.durationMinutes)}</span>
                    <span aria-hidden="true">·</span>
                    <strong class="cost-mono">{formatCost(r.data.costUsd)}</strong>
                  </div>
                </li>
              ))}
            </ol>

            {paretoFrontierRuns[0] && (
              <div class="pareto-inspector" id="pareto-inspector" aria-live="polite">
                <div class="pareto-inspector-head">
                  <span class="mono pareto-inspector-tag" id="pi-status">
                    Frontier #{paretoFrontierRuns[0].telemetry.paretoOrder}
                  </span>
                  <a href={`/runs/${paretoFrontierRuns[0].id}`} class="mono pareto-inspector-link" id="pi-link">
                    Inspect Dossier →
                  </a>
                </div>
                <strong class="pareto-inspector-title" id="pi-title">
                  {paretoFrontierRuns[0].telemetry.displayHarness} / {paretoFrontierRuns[0].data.model}
                </strong>
                <div class="mono pareto-inspector-stats" id="pi-stats">
                  {formatDuration(paretoFrontierRuns[0].data.durationMinutes)} · {formatCost(paretoFrontierRuns[0].data.costUsd)} · {paretoFrontierRuns[0].data.tokens?.total ?? '—'} tok ({paretoFrontierRuns[0].telemetry.tokens.cacheHitRatePct}% cache)
                </div>
              </div>
            )}
          </div>
        </div>
        </div>
      </details>

      <details class="reading-disclosure" id="bottleneck-section">
        <summary>Which stages ask the most of an agent?</summary>
        <div class="disclosure-body analytics-panel">
        <div class="panel-top-row">
          <p class="section-subnote">
            Compare completion, call share, cost share, and thinking tokens for each stage
            across all {enrichedRuns.length} published runs.
          </p>
          <a href="/about#stages" class="action-link">
            Read the stage specifications <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="table-wrapper bottleneck-table-wrap" tabindex="0" role="region" aria-label="Stage bottleneck matrix">
          <table class="app-table leaderboard-table static-table bottleneck-table">
            <thead>
              <tr>
                <th scope="col">Stage</th>
                <th scope="col">Holdout Pass Rate</th>
                <th scope="col">Avg Call Share</th>
                <th scope="col">Avg Cost Share</th>
                <th scope="col">Avg Thinking</th>
                <th scope="col">Peak Bottleneck</th>
              </tr>
            </thead>
            <tbody>
              {stageMatrix.map((st) => {
                const title = stageTitleMap.get(st.stageId) ?? st.stageId;
                const isTopBottleneck = st.peakCostCount >= 2;
                const isHighMiss = st.passRatePct < 70;
                return (
                  <tr>
                    <th scope="row">
                      <div class="bottleneck-stage-cell">
                        <span class:list={['stage-legend-id', { 'is-peak-id': isTopBottleneck }]}>
                          {st.stageId}
                        </span>
                        <strong>{title}</strong>
                      </div>
                    </th>
                    <td class="mono" data-cell="Holdout Pass Rate">
                      <span class:list={[isHighMiss ? 'hl hl-magenta' : '']}>
                        {st.passCount}/{st.totalRuns} ({st.passRatePct}%)
                      </span>
                    </td>
                    <td class="mono" data-cell="Avg Call Share">
                      {st.avgCallSharePct}% <span class="text-muted">({st.avgLlmCalls} turns)</span>
                    </td>
                    <td class="mono" data-cell="Avg Cost Share">
                      <div class="bottleneck-bar-wrap">
                        <span class:list={[{ 'is-peak-text': isTopBottleneck }]}>{st.avgCostSharePct}%</span>
                        <div class="bottleneck-bar-track" aria-hidden="true">
                          <span
                            class:list={[
                              'bottleneck-bar-fill',
                              isTopBottleneck ? 'is-peak' : 'is-normal',
                            ]}
                            style={`inline-size: ${Math.min(100, st.avgCostSharePct * 3).toFixed(1)}%`}
                          />
                        </div>
                      </div>
                    </td>
                    <td class="mono" data-cell="Avg Thinking">
                      {st.avgThinkingTokens.toLocaleString('en-US')} tok
                    </td>
                    <td class="mono" data-cell="Peak Bottleneck">
                      {st.peakCostCount > 0 ? (
                        <span class:list={['peak-count-pill', { 'is-top-peak': isTopBottleneck }]}>
                          {st.peakCostCount} {st.peakCostCount === 1 ? 'run' : 'runs'} #1 peak
                        </span>
                      ) : (
                        <span class="text-muted">0 runs</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        </div>
      </details>

      <details class="reading-disclosure" id="ablations-teaser">
        <summary>What changes with a different harness or effort?</summary>
        <div class="disclosure-body analytics-panel">
        <div class="panel-top-row">
          <p class="section-subnote">
            Paired runs let you look at one difference at a time: harness, reasoning effort,
            or model generation.
          </p>
          <a href="/compare" class="action-link">
            Choose a comparison <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="ablation-cards-grid">
          {ablationPresets.map((preset) => (
            <a
              href={`/compare?a=${preset.runAId}&b=${preset.runBId}&preset=${preset.id}`}
              class="ablation-teaser-card"
            >
              <div class="ablation-teaser-top">
                <span class="ablation-badge">{preset.badge}</span>
                <span class="ablation-cta">Compare runs →</span>
              </div>
              <strong class="ablation-teaser-title">{preset.title}</strong>
              <p class="ablation-teaser-copy">{preset.findingHeadline}</p>
            </a>
          ))}
        </div>
        </div>
      </details>
    </section>
  </div>
</BaseLayout>

