---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  parseTokenString,
  formatCompactContextWindow,
  formatHarnessName,
  formatProviderName,
  getPlanStats,
} from '../utils/format';
import { BENCHMARK_STAGES } from '../data/benchmark';

const stageTitleMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));
const allRuns = await getCollection('runs', ({ data }) => data.published !== false);

const enrichedRuns = allRuns
  .map((entry) => {
    const d = entry.data;
    const plan = getPlanStats(d.planCompletion);
    const inputTokens = parseTokenString(d.tokens?.input);
    const cachedTokens = parseTokenString(d.tokens?.cachedInput);
    const outputTokens = parseTokenString(d.tokens?.output);
    const totalTokens =
      parseTokenString(d.tokens?.total) || inputTokens + cachedTokens + outputTokens;
    const compactContext = formatCompactContextWindow(d.contextWindow);
    const hasCalls =
      d.calls && (d.calls.llmCalls !== undefined || d.calls.toolCalls?.total !== undefined);
    const totalCalls = hasCalls
      ? (d.calls?.llmCalls ?? 0) + (d.calls?.toolCalls?.total ?? 0)
      : undefined;
    const testsRatio =
      d.tests && d.tests.total > 0 ? d.tests.passed / d.tests.total : -1;
    const testsPassed = d.tests?.passed ?? -1;
    const timeMs = new Date(d.timestamp).getTime() || 0;

    return {
      id: entry.id,
      data: d,
      plan,
      inputTokens,
      cachedTokens,
      outputTokens,
      totalTokens,
      compactContext,
      totalCalls,
      testsRatio,
      testsPassed,
      timeMs,
    };
  })
  .sort((a, b) => {
    if (b.plan.ratio !== a.plan.ratio) return b.plan.ratio - a.plan.ratio;
    if (b.testsRatio !== a.testsRatio) return b.testsRatio - a.testsRatio;
    if (a.data.costUsd !== b.data.costUsd) return a.data.costUsd - b.data.costUsd;
    return a.data.durationMinutes - b.data.durationMinutes;
  });

const harnesses = [...new Set(enrichedRuns.map((r) => r.data.codingHarness))].sort((a, b) =>
  formatHarnessName(a).localeCompare(formatHarnessName(b), undefined, { sensitivity: 'base' })
);
const providers = [...new Set(enrichedRuns.map((r) => r.data.provider))].sort((a, b) =>
  formatProviderName(a).localeCompare(formatProviderName(b), undefined, { sensitivity: 'base' })
);

const durations = enrichedRuns.map((r) => r.data.durationMinutes);
const costs = enrichedRuns.map((r) => r.data.costUsd);
const fastestMin = durations.length > 0 ? Math.min(...durations) : 0;
const slowestMin = durations.length > 0 ? Math.max(...durations) : 0;
const lowestCost = costs.length > 0 ? Math.min(...costs) : 0;
const highestCost = costs.length > 0 ? Math.max(...costs) : 0;
const fullPassRuns = enrichedRuns.filter((r) => r.plan.ratio === 1);
const fullPassCount = fullPassRuns.length;

const leaderPool = fullPassRuns.length > 0 ? fullPassRuns : enrichedRuns;
const lowestCostLeader =
  leaderPool.length > 0
    ? [...leaderPool].sort(
        (a, b) => a.data.costUsd - b.data.costUsd || a.data.durationMinutes - b.data.durationMinutes
      )[0]
    : undefined;
const fastestLeader =
  leaderPool.length > 0
    ? [...leaderPool].sort(
        (a, b) => a.data.durationMinutes - b.data.durationMinutes || a.data.costUsd - b.data.costUsd
      )[0]
    : undefined;
const deepestTestsLeader =
  leaderPool.length > 0
    ? [...leaderPool].sort(
        (a, b) => b.testsPassed - a.testsPassed || a.data.costUsd - b.data.costUsd
      )[0]
    : undefined;
const passedCounts = enrichedRuns
  .map((r) => r.testsPassed)
  .filter((n) => n >= 0);
const minTestsPassed = passedCounts.length > 0 ? Math.min(...passedCounts) : 0;
const maxTestsPassed = passedCounts.length > 0 ? Math.max(...passedCounts) : 0;
---

<BaseLayout title="Leaderboard" activeNav="leaderboard">
  <div class="leaderboard-quiet">
  <!-- 01. HERO & TWO-TONE UNBOUNDED TYPOGRAPHY -->
  <section class="hero-box" aria-labelledby="hero-heading">
    <div class="pixel-mosaic" aria-hidden="true">
      <div class="px-acid"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-white"></div><div class="px-acid"></div>
      <div class="px-gray"></div><div class="px-white"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-soft"></div>
      <div class="px-mint"></div><div class="px-gray"></div><div class="px-acid"></div><div class="px-white"></div><div class="px-acid"></div>
      <div class="px-mint"></div><div class="px-white"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-0"></div>
      <div class="px-acid"></div><div class="px-gray"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div>
      <div class="px-mint"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div>
    </div>

    <h1 id="hero-heading" class="headline-two-tone">
      Capy Bench Leaderboard.{' '}
      <span class="muted">
        Coding harnesses and models, ranked on real-world CLI engineering.
      </span>
    </h1>

    <p class="hero-subtitle">
      Each run challenges a coding harness and model to build a rate-paced HTTP/TLS benchmark CLI
      from scratch using strict Outside-In TDD—tracking test rigor, wall-clock speed, token
      efficiency, and real API spend.
    </p>
  </section>

  <!-- 02. EVIDENCE-BACKED METRIC STRIP -->
  <dl class="hero-stats-grid" aria-label="Benchmark summary statistics">
    <div class="card stat-card">
      <dt class="section-kicker">FULL-SPEC PASS RATE</dt>
      <dd class="stat-value">
        {fullPassCount}/{enrichedRuns.length}
      </dd>
      <dd class="stat-meta">
        {Math.round((fullPassCount / Math.max(enrichedRuns.length, 1)) * 100)}% completed 7/7 slices · {harnesses.length} harnesses · {providers.length} providers
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">LOWEST 7/7 COST</dt>
      <dd class="stat-value">
        {lowestCostLeader ? formatCost(lowestCostLeader.data.costUsd) : formatCost(lowestCost)}
      </dd>
      <dd class="stat-meta">
        {lowestCostLeader ? (
          <>
            <a href={`/runs/${lowestCostLeader.id}`} class="stat-leader-link">
              {formatHarnessName(lowestCostLeader.data.codingHarness)} / {lowestCostLeader.data.model}
            </a>
            {' · '}range {formatCost(lowestCost)}–{formatCost(highestCost)}
          </>
        ) : (
          `n=${enrichedRuns.length} runs · range ${formatCost(lowestCost)}–${formatCost(highestCost)}`
        )}
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">FASTEST 7/7 RUN</dt>
      <dd class="stat-value">
        {fastestLeader
          ? formatDuration(fastestLeader.data.durationMinutes)
          : formatDuration(fastestMin)}
      </dd>
      <dd class="stat-meta">
        {fastestLeader ? (
          <>
            <a href={`/runs/${fastestLeader.id}`} class="stat-leader-link">
              {formatHarnessName(fastestLeader.data.codingHarness)} / {fastestLeader.data.model}
            </a>
            {' · '}range {formatDuration(fastestMin)}–{formatDuration(slowestMin)}
          </>
        ) : (
          `n=${enrichedRuns.length} runs · range ${formatDuration(fastestMin)}–${formatDuration(slowestMin)}`
        )}
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">DEEPEST TEST SUITE</dt>
      <dd class="stat-value">
        {deepestTestsLeader && deepestTestsLeader.testsPassed >= 0
          ? `${deepestTestsLeader.testsPassed}`
          : '—'}
      </dd>
      <dd class="stat-meta">
        {deepestTestsLeader && deepestTestsLeader.testsPassed >= 0 ? (
          <>
            <a href={`/runs/${deepestTestsLeader.id}`} class="stat-leader-link">
              {formatHarnessName(deepestTestsLeader.data.codingHarness)} / {deepestTestsLeader.data.model}
            </a>
            {' · '}range {minTestsPassed}–{maxTestsPassed} tests
          </>
        ) : (
          `n=${enrichedRuns.length} runs`
        )}
      </dd>
    </div>
  </dl>

  <!-- 03. FILTER & SORT COMMAND BAR -->
  <search class="controls-bar" aria-label="Leaderboard filters and sorting">
    <div class="controls-search-col">
      <div class="field-label-row">
        <label class="field-label" for="search-input">Filter Playbook Runs</label>
        <kbd class="menu-kbd" title="Press / to focus search" aria-hidden="true">/</kbd>
      </div>
      <div class="command-input-wrap">
        <span class="command-input-prefix">/filter</span>
        <input
          id="search-input"
          name="q"
          type="search"
          class="input"
          placeholder="Harness, model, provider, effort..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
      </div>
    </div>

    <div class="controls-select-row">
      <div class="control-field">
        <label class="field-label" for="harness-filter">Harness</label>
        <select id="harness-filter" name="harness" class="select control-select">
          <option value="all">All Harnesses</option>
          {harnesses.map((h) => <option value={h}>{formatHarnessName(h)}</option>)}
        </select>
      </div>

      <div class="control-field">
        <label class="field-label" for="provider-filter">Provider</label>
        <select id="provider-filter" name="provider" class="select control-select">
          <option value="all">All Providers</option>
          {providers.map((p) => <option value={p}>{formatProviderName(p)}</option>)}
        </select>
      </div>

      <div class="control-field">
        <label class="field-label" for="sort-select">Sort Metric</label>
        <div class="sort-control-pair">
          <select id="sort-select" name="sort" class="select control-select">
            <option value="plan" selected>Plan Completion (S1–S7)</option>
            <option value="duration">Duration (Time Elapsed)</option>
            <option value="cost">Total Cost ($)</option>
            <option value="tokens">Total Tokens (All Billed)</option>
            <option value="tests">Tests Passed</option>
            <option value="timestamp">Run Date</option>
          </select>
          <button
            id="sort-dir-btn"
            type="button"
            class="btn btn-sm btn-secondary sort-dir-btn"
            data-dir="desc"
            aria-label="Sort direction: descending. Activate to switch to ascending"
          >
            <span aria-hidden="true">↓</span> DESC
          </button>
        </div>
      </div>
    </div>

    <div class="controls-footer-row">
      <label class="check-label controls-check-label" for="full-pass-toggle">
        <input
          id="full-pass-toggle"
          name="fullPass"
          type="checkbox"
          class="check-input"
        />
        <span>7/7 Full Pass Only ({fullPassCount})</span>
      </label>

      <div class="controls-meta-actions">
        <span id="visible-count-badge" class="controls-result-count">
          Showing {enrichedRuns.length} of {enrichedRuns.length} runs
        </span>
        <button
          id="reset-filters-btn"
          type="button"
          class="btn btn-sm btn-secondary"
          hidden
        >
          Reset filters
        </button>
      </div>
    </div>

    <div class="stage-legend-bar" aria-label="Benchmark stage key (S1 through S7)">
      <span class="stage-legend-kicker">Stages:</span>
      <ul class="stage-legend-list">
        {
          BENCHMARK_STAGES.map((stage) => (
            <li class="stage-legend-item">
              <span class="stage-legend-id">{stage.id}</span>
              <span class="stage-legend-title">{stage.title}</span>
            </li>
          ))
        }
      </ul>
      <a href="/about#stages" class="stage-legend-link">Full spec →</a>
    </div>

    <div
      id="leaderboard-status"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
  </search>

  <!-- 04. LEADERBOARD DATA TABLE -->
  <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="leaderboard-caption">
    <table class="app-table leaderboard-table" id="leaderboard-table">
      <caption id="leaderboard-caption" class="visually-hidden">
        Capy Bench evaluation runs ranked by plan completion, tests passed, duration, token usage,
        and cost
      </caption>
      <thead>
        <tr>
          <th scope="col" class="col-rank">Rank</th>
          <th scope="col">Coding Harness &amp; Model</th>
          <th scope="col" class="sortable active-sort" data-sort-col="plan" aria-sort="descending">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by S1–S7 plan completion ratio (ties broken by test pass ratio, lowest cost, fastest duration)"
            >
              <span>Plan Completion</span>
              <span class="sort-indicator" aria-hidden="true">↓</span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tests" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by test suite pass ratio, then total passing tests"
            >
              <span>Tests &amp; Commits</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="duration" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by wall-clock run duration"
            >
              <span>Duration</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tokens" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by total token volume (uncached input + cached input + output)"
            >
              <span>Token Usage</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="cost" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by total API cost in USD"
            >
              <span>Cost</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="col-details">Action</th>
        </tr>
      </thead>
      <tbody id="leaderboard-tbody">
        {
          enrichedRuns.map((run, index) => {
            const { data, plan } = run;
            const rank = index + 1;
            const hasTokens =
              data.tokens && (data.tokens.input || data.tokens.output || data.tokens.cacheHitRate);
            const vtName = `run-${run.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
            const incompleteStages = plan.entries
              .filter(([, done]) => !done)
              .map(([stageId]) => stageId);

            const displayHarness = formatHarnessName(data.codingHarness);
            const displayProvider = formatProviderName(data.provider);
            const showInOutSub = Boolean(
              data.tokens?.total && data.tokens?.input && data.tokens?.output
            );

            return (
              <tr
                class="run-row"
                style={`--vt-name: ${vtName};`}
                data-href={`/runs/${run.id}`}
                data-harness={data.codingHarness}
                data-provider={data.provider}
                data-search={`${data.codingHarness} ${displayHarness} ${data.model} ${data.provider} ${displayProvider} ${data.effort ?? ''}`.toLowerCase()}
                data-plan={plan.ratio}
                data-duration={data.durationMinutes}
                data-cost={data.costUsd}
                data-tokens={run.totalTokens}
                data-tests={run.testsRatio}
                data-tests-passed={run.testsPassed}
                data-timestamp={run.timeMs}
              >
                <td data-cell="Rank">
                  <span
                    class:list={[
                      'rank-badge',
                      { 'rank-1': rank === 1, 'rank-2': rank === 2, 'rank-3': rank === 3 },
                    ]}
                  >
                    #{rank}
                  </span>
                </td>

                <th scope="row" data-cell="Harness & Model">
                  <div class="cell-stack">
                    <div class="entry-title">
                      <a href={`/runs/${run.id}`} class="entry-title-link">
                        <span>{displayHarness}</span>
                        <span class="text-muted-sep" aria-hidden="true">/</span>
                        <span class="entry-model">{data.model}</span>
                      </a>
                    </div>
                    <div class="entry-meta">
                      <span>{displayProvider}</span>
                      {data.effort && (
                        <>
                          <span class="entry-meta-sep" aria-hidden="true">·</span>
                          <span>effort:{data.effort}</span>
                        </>
                      )}
                      {data.interface?.type && (
                        <>
                          <span class="entry-meta-sep" aria-hidden="true">·</span>
                          <span class="entry-meta-tag">{data.interface.type}</span>
                        </>
                      )}
                      <span class="entry-meta-sep" aria-hidden="true">·</span>
                      <time datetime={data.timestamp} class="metric-sub metric-inline entry-timestamp">
                        {formatTimestamp(data.timestamp)}
                      </time>
                    </div>
                  </div>
                </th>

                <td data-cell="Plan Completion">
                  <div class="plan-cell cell-stack">
                    <div class="plan-primary-row">
                      <span class="metric-primary">
                        {plan.completed}/{plan.total} stages
                      </span>
                      <span
                        class:list={[
                          'plan-pct-badge',
                          plan.ratio === 1
                            ? 'hl hl-mint'
                            : plan.ratio >= 0.7
                              ? 'plan-pct-partial'
                              : 'hl hl-magenta',
                        ]}
                      >
                        {Math.round(plan.ratio * 100)}%
                      </span>
                      {incompleteStages.length > 0 && (
                        <span class="visually-hidden">
                          (Incomplete stages: {incompleteStages.join(', ')})
                        </span>
                      )}
                    </div>
                    <div class="stage-strip" aria-hidden="true">
                      {plan.entries.map(([stageId, done]) => {
                        const stageTitle = stageTitleMap.get(stageId) ?? stageId;
                        return (
                          <span
                            class:list={['stage-pill', done ? 'done' : 'pending']}
                            title={`${stageId}: ${stageTitle} (${done ? 'Completed' : 'Incomplete'})`}
                          >
                            {stageId}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                </td>

                <td data-cell="Tests & Commits">
                  <div class="cell-stack">
                    {data.tests ? (
                      <div class="metric-primary">
                        {data.tests.passed}/{data.tests.total} passed
                      </div>
                    ) : (
                      <div class="metric-empty">—</div>
                    )}
                    {data.commits !== undefined && (
                      <div class="metric-sub">{data.commits} commits</div>
                    )}
                  </div>
                </td>

                <td data-cell="Duration">
                  <div class="cell-stack">
                    <div class="metric-primary">{formatDuration(data.durationMinutes)}</div>
                    {run.totalCalls !== undefined && (
                      <div class="metric-sub">{run.totalCalls.toLocaleString()} calls</div>
                    )}
                  </div>
                </td>

                <td data-cell="Token Usage">
                  {hasTokens ? (
                    <div class="cell-stack">
                      <div
                        class="metric-primary"
                        title={`Uncached in: ${data.tokens?.input ?? '—'} · Cached in: ${data.tokens?.cachedInput ?? '—'} · Out: ${data.tokens?.output ?? '—'}${data.tokens?.thinking ? ` · Thinking: ${data.tokens.thinking}` : ''}`}
                      >
                        {data.tokens?.total
                          ? `${data.tokens.total} total`
                          : `${data.tokens?.input ?? '—'} in / ${data.tokens?.output ?? '—'} out`}
                      </div>
                      <div class="metric-sub">
                        {showInOutSub && (
                          <span>
                            {data.tokens?.input} in / {data.tokens?.output} out
                          </span>
                        )}
                        {data.tokens?.cacheHitRate && (
                          <>
                            {showInOutSub && <span aria-hidden="true"> · </span>}
                            <span>{data.tokens.cacheHitRate} cache</span>
                          </>
                        )}
                        {run.compactContext && (
                          <>
                            {(showInOutSub || Boolean(data.tokens?.cacheHitRate)) && (
                              <span aria-hidden="true"> · </span>
                            )}
                            <span title={data.contextWindow}>Ctx: {run.compactContext}</span>
                          </>
                        )}
                      </div>
                    </div>
                  ) : (
                    <span class="metric-empty">—</span>
                  )}
                </td>

                <td data-cell="Cost">
                  {lowestCostLeader && run.id === lowestCostLeader.id ? (
                    <span
                      class="hl hl-mint cost-pill"
                      title="Lowest 7/7 full-pass cost leader"
                    >
                      {formatCost(data.costUsd)}
                    </span>
                  ) : (
                    <span class="metric-primary cost-mono">{formatCost(data.costUsd)}</span>
                  )}
                </td>

                <td data-cell="Action">
                  <a
                    href={`/runs/${run.id}`}
                    class="btn btn-sm btn-secondary view-btn"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <span>Inspect</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </td>
              </tr>
            );
          })
        }
        <tr id="empty-state-row" hidden>
          <td colspan="8" class="empty-state-cell">
            <div class="empty-state-wrap">
              <p id="empty-state-msg" class="empty-state-copy">
                No benchmark runs match the current filters.
              </p>
              <button
                id="empty-reset-btn"
                type="button"
                class="btn btn-sm btn-secondary"
              >
                Reset all filters
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     QUIETER LEADERBOARD REFINEMENTS (Neo-Acid Operate Restraint)
     Preserves brand color (--hl-acid, --hl-mint, --hl-sky, --hl-magenta) for
     earned semantic anchors while stripping decorative container chrome,
     redundant cell badges, and heavy full-cell header fills.
     ========================================================================== */
  .leaderboard-quiet .hero-box {
    padding: 1.5rem 100px 1.35rem 0;
    margin-block-end: 1.25rem;
  }

  .leaderboard-quiet .headline-two-tone {
    font-size: clamp(1.45rem, 2.8vw, 2.05rem);
  }

  .leaderboard-quiet .hero-subtitle {
    font-size: 0.96875rem;
    line-height: 1.55;
    margin-block-start: 0.65rem;
    max-inline-size: 92ch;
  }

  .leaderboard-quiet .pixel-mosaic {
    inset-block-start: 1.35rem;
    grid-template-columns: repeat(5, 13px);
    grid-template-rows: repeat(6, 13px);
    opacity: 0.85;
  }

  /* Unified architectural telemetry strip instead of 4 separated heavy boxes */
  .leaderboard-quiet .hero-stats-grid {
    gap: 0;
    margin-block: 0 1.5rem;
    border: var(--border-frame);
    background-color: transparent;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .leaderboard-quiet .stat-card {
    border: none;
    border-inline-end: var(--border-row);
    background-color: transparent;
    padding: 1rem 1.2rem;
    gap: 0.3rem;
  }

  .leaderboard-quiet .stat-card:last-child {
    border-inline-end: none;
  }

  .leaderboard-quiet .stat-value {
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
  }

  @media (max-width: 900px) {
    .leaderboard-quiet .hero-stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .leaderboard-quiet .stat-card:nth-child(2) {
      border-inline-end: none;
    }

    .leaderboard-quiet .stat-card:nth-child(-n + 2) {
      border-block-end: var(--border-row);
    }
  }

  @media (max-width: 520px) {
    .leaderboard-quiet .hero-stats-grid {
      grid-template-columns: 1fr;
    }

    .leaderboard-quiet .stat-card {
      border-inline-end: none;
      border-block-end: var(--border-row);
    }

    .leaderboard-quiet .stat-card:last-child {
      border-block-end: none;
    }
  }

  /* Quieter command bar: open structural rules instead of a nested heavy box */
  .leaderboard-quiet .controls-bar {
    background-color: transparent;
    border: none;
    border-block-end: var(--border-frame);
    padding: 0 0 1rem;
    margin-block-end: 1.25rem;
    gap: 1rem 1.25rem;
  }

  .leaderboard-quiet .command-input-prefix {
    background: var(--bg-surface);
    color: var(--hl-acid);
    border-inline-end: var(--border-row);
    font-size: 0.78rem;
  }

  :global([data-theme="light"]) .leaderboard-quiet .command-input-prefix {
    color: var(--accent-cobalt);
  }

  .leaderboard-quiet .input,
  .leaderboard-quiet .select {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-strong-color);
  }

  .leaderboard-quiet .command-input-wrap {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-strong-color);
  }

  .leaderboard-quiet .command-input-wrap .input {
    border: none;
  }

  .leaderboard-quiet .sort-dir-btn {
    border-width: 1px;
  }

  .leaderboard-quiet .controls-footer-row {
    padding-block-start: 0.65rem;
  }

  .leaderboard-quiet .stage-legend-bar {
    padding-block-start: 0.6rem;
    color: var(--text-muted);
  }

  /* Quieter table headers & row density */
  .leaderboard-quiet .leaderboard-table thead th {
    background-color: var(--bg-canvas);
    padding: 0.7rem 0.9rem;
  }

  .leaderboard-quiet .leaderboard-table thead th.sortable {
    padding: 0;
  }

  .leaderboard-quiet .sort-header-btn {
    min-block-size: 2.5rem;
    padding: 0.7rem 0.9rem;
  }

  .leaderboard-quiet .leaderboard-table thead th.active-sort .sort-header-btn {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: inset 0 -3px 0 var(--hl-acid);
  }

  .leaderboard-quiet .leaderboard-table thead th.active-sort .sort-indicator {
    color: var(--hl-acid);
  }

  :global([data-theme="light"]) .leaderboard-quiet .leaderboard-table thead th.active-sort .sort-header-btn {
    box-shadow: inset 0 -3px 0 var(--accent-cobalt);
  }

  :global([data-theme="light"]) .leaderboard-quiet .leaderboard-table thead th.active-sort .sort-indicator {
    color: var(--accent-cobalt);
  }

  .leaderboard-quiet .leaderboard-table thead th.sortable:hover .sort-header-btn {
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .leaderboard-quiet .leaderboard-table :is(td, tbody th, tfoot th) {
    padding: 0.8rem 0.9rem;
  }

  /* Quieter rank badges: #1 keeps full brand acid fill; #2 & #3 use clean semantic accents */
  .leaderboard-quiet .rank-badge {
    border-width: 1px;
    border-color: var(--border-subtle-color);
    background-color: transparent;
    color: var(--text-muted);
    min-inline-size: 2rem;
    block-size: 1.75rem;
    font-size: 0.75rem;
  }

  .leaderboard-quiet .rank-badge.rank-1 {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    border-width: 2px;
    border-color: var(--raw-ebony);
  }

  .leaderboard-quiet .rank-badge.rank-2 {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--border-strong-color);
    border-block-end: 2px solid var(--hl-mint);
  }

  .leaderboard-quiet .rank-badge.rank-3 {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--border-strong-color);
    border-block-end: 2px solid var(--hl-sky);
  }

  /* Quieter row metadata: clean monospace inline line instead of 3 boxed pills per row */
  .leaderboard-quiet .entry-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    gap: 0.35rem;
    margin-block-start: 0.3rem;
  }

  .leaderboard-quiet .entry-meta-sep {
    color: var(--border-strong-color);
  }

  .leaderboard-quiet .entry-meta-tag {
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Plan percentage & stage strip */
  .leaderboard-quiet .plan-pct-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.08rem 0.38rem;
  }

  .leaderboard-quiet .plan-pct-partial {
    border: 1px solid var(--hl-acid);
    color: var(--hl-acid);
    background-color: transparent;
  }

  :global([data-theme="light"]) .leaderboard-quiet .plan-pct-partial {
    border-color: var(--raw-ebony);
    background-color: var(--hl-acid);
    color: var(--hl-ink);
  }

  .leaderboard-quiet .stage-pill {
    font-size: 0.65rem;
    padding: 0.16rem 0.28rem;
  }

  .leaderboard-quiet .stage-pill.done {
    background-color: transparent;
  }

  /* Quieter row action: subtle text affordance that lights up with brand acid on row hover */
  .leaderboard-quiet .view-btn {
    border-width: 1px;
    border-color: transparent;
    color: var(--text-muted);
    padding: 0.32rem 0.6rem;
  }

  .leaderboard-quiet .leaderboard-table:not(.static-table) tbody tr.run-row:hover .view-btn {
    background-color: var(--hl-acid);
    color: var(--hl-ink);
    border-color: var(--raw-ebony);
  }
</style>

<script>
  const table = document.getElementById('leaderboard-table') as HTMLTableElement | null;
  const tbody = document.getElementById('leaderboard-tbody') as HTMLTableSectionElement | null;
  const emptyStateRow = document.getElementById('empty-state-row') as HTMLTableRowElement | null;
  const emptyStateMsg = document.getElementById('empty-state-msg') as HTMLElement | null;
  const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const harnessFilter = document.getElementById('harness-filter') as HTMLSelectElement | null;
  const providerFilter = document.getElementById('provider-filter') as HTMLSelectElement | null;
  const fullPassToggle = document.getElementById('full-pass-toggle') as HTMLInputElement | null;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const sortDirBtn = document.getElementById('sort-dir-btn') as HTMLButtonElement | null;
  const visibleCountBadge = document.getElementById('visible-count-badge') as HTMLElement | null;
  const resetFiltersBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement | null;
  const statusRegion = document.getElementById('leaderboard-status') as HTMLElement | null;
  const sortableHeaders = document.querySelectorAll<HTMLTableCellElement>('th.sortable');

  const defaultSortDirs: Record<string, 'asc' | 'desc'> = {
    plan: 'desc',
    tests: 'desc',
    duration: 'asc',
    cost: 'asc',
    tokens: 'asc',
    timestamp: 'desc',
  };

  let announceTimer: ReturnType<typeof setTimeout> | null = null;

  function setSortDirButtonState(dir: 'asc' | 'desc') {
    if (!sortDirBtn) return;
    sortDirBtn.dataset.dir = dir;
    sortDirBtn.innerHTML = `<span aria-hidden="true">${dir === 'asc' ? '↑' : '↓'}</span> ${dir === 'asc' ? 'ASC' : 'DESC'}`;
    sortDirBtn.setAttribute(
      'aria-label',
      `Sort direction: ${dir === 'asc' ? 'ascending' : 'descending'}. Activate to switch to ${dir === 'asc' ? 'descending' : 'ascending'}`
    );
  }

  function syncUrlState(
    query: string,
    harness: string,
    provider: string,
    fullPassOnly: boolean,
    sortBy: string,
    sortDir: 'asc' | 'desc'
  ) {
    try {
      const params = new URLSearchParams(window.location.search);
      if (query) params.set('q', query);
      else params.delete('q');

      if (harness !== 'all') params.set('harness', harness);
      else params.delete('harness');

      if (provider !== 'all') params.set('provider', provider);
      else params.delete('provider');

      if (fullPassOnly) params.set('pass', '1');
      else params.delete('pass');

      const defaultDir = defaultSortDirs[sortBy] ?? 'desc';
      if (sortBy !== 'plan' || sortDir !== defaultDir) {
        params.set('sort', sortBy);
        params.set('dir', sortDir);
      } else {
        params.delete('sort');
        params.delete('dir');
      }

      const qs = params.toString();
      const nextUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      if (nextUrl !== `${window.location.pathname}${window.location.search}`) {
        window.history.replaceState(null, '', nextUrl);
      }
    } catch {}
  }

  function hydrateFromUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      const harness = params.get('harness');
      const provider = params.get('provider');
      const pass = params.get('pass');
      const sort = params.get('sort');
      const dir = params.get('dir');

      if (q && searchInput) searchInput.value = q;
      if (
        harness &&
        harnessFilter &&
        Array.from(harnessFilter.options).some((o) => o.value === harness)
      ) {
        harnessFilter.value = harness;
      }
      if (
        provider &&
        providerFilter &&
        Array.from(providerFilter.options).some((o) => o.value === provider)
      ) {
        providerFilter.value = provider;
      }
      if (pass === '1' && fullPassToggle) {
        fullPassToggle.checked = true;
      }
      if (
        sort &&
        sortSelect &&
        Array.from(sortSelect.options).some((o) => o.value === sort)
      ) {
        sortSelect.value = sort;
        const resolvedDir =
          dir === 'asc' || dir === 'desc' ? dir : (defaultSortDirs[sort] ?? 'desc');
        setSortDirButtonState(resolvedDir);
      } else if (dir === 'asc' || dir === 'desc') {
        setSortDirButtonState(dir);
      }
    } catch {}
  }

  function applyLeaderboardUpdate() {
    if (!tbody || !sortSelect || !sortDirBtn) return;

    const query = (searchInput?.value ?? '').trim().toLowerCase();
    const harness = harnessFilter?.value ?? 'all';
    const provider = providerFilter?.value ?? 'all';
    const fullPassOnly = Boolean(fullPassToggle?.checked);
    const sortBy = sortSelect.value;
    const sortDir = (sortDirBtn.dataset.dir as 'asc' | 'desc') || 'desc';

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row'));
    const totalCount = rows.length;

    // Filter rows
    rows.forEach((row) => {
      const rowSearch = row.dataset.search ?? '';
      const rowHarness = row.dataset.harness ?? '';
      const rowProvider = row.dataset.provider ?? '';
      const rowPlan = parseFloat(row.dataset.plan ?? '0');

      const matchesSearch = !query || rowSearch.includes(query);
      const matchesHarness = harness === 'all' || rowHarness === harness;
      const matchesProvider = provider === 'all' || rowProvider === provider;
      const matchesFullPass = !fullPassOnly || rowPlan === 1;

      row.hidden = !(matchesSearch && matchesHarness && matchesProvider && matchesFullPass);
    });

    // Sort rows
    rows.sort((a, b) => {
      const valA = parseFloat(a.dataset[sortBy] ?? '0');
      const valB = parseFloat(b.dataset[sortBy] ?? '0');

      const missingA =
        (sortBy === 'tokens' && valA <= 0) || (sortBy === 'tests' && valA < 0);
      const missingB =
        (sortBy === 'tokens' && valB <= 0) || (sortBy === 'tests' && valB < 0);
      if (missingA !== missingB) {
        return missingA ? 1 : -1;
      }

      if (valA !== valB) {
        return sortDir === 'asc' ? valA - valB : valB - valA;
      }
      if (sortBy === 'tests') {
        const passedA = parseFloat(a.dataset.testsPassed ?? '0');
        const passedB = parseFloat(b.dataset.testsPassed ?? '0');
        if (passedA !== passedB) {
          return sortDir === 'asc' ? passedA - passedB : passedB - passedA;
        }
      }
      // Canonical 4-key tie-breaker chain: plan ratio -> test pass ratio -> lowest cost -> fastest duration
      const planDiff =
        parseFloat(b.dataset.plan ?? '0') - parseFloat(a.dataset.plan ?? '0');
      if (planDiff !== 0) return planDiff;

      const testsDiff =
        parseFloat(b.dataset.tests ?? '0') - parseFloat(a.dataset.tests ?? '0');
      if (testsDiff !== 0) return testsDiff;

      const costDiff =
        parseFloat(a.dataset.cost ?? '0') - parseFloat(b.dataset.cost ?? '0');
      if (costDiff !== 0) return costDiff;

      return parseFloat(a.dataset.duration ?? '0') - parseFloat(b.dataset.duration ?? '0');
    });

    // Re-order and re-rank visible rows using moveBefore when supported to preserve DOM state
    const supportsMoveBefore = 'moveBefore' in Element.prototype;
    let visibleRank = 1;
    rows.forEach((row) => {
      const refNode = emptyStateRow ?? null;
      if (supportsMoveBefore) {
        (tbody as unknown as { moveBefore: (node: Node, child: Node | null) => void }).moveBefore(
          row,
          refNode
        );
      } else {
        tbody.insertBefore(row, refNode);
      }

      if (!row.hidden) {
        const badge = row.querySelector('.rank-badge');
        if (badge) {
          badge.textContent = `#${visibleRank}`;
          badge.classList.remove('rank-1', 'rank-2', 'rank-3');
          if (visibleRank === 1) badge.classList.add('rank-1');
          if (visibleRank === 2) badge.classList.add('rank-2');
          if (visibleRank === 3) badge.classList.add('rank-3');
        }
        visibleRank++;
      }
    });

    const visibleCount = visibleRank - 1;
    const hasActiveFilters =
      Boolean(query) || harness !== 'all' || provider !== 'all' || fullPassOnly;
    const isNonDefaultSort =
      sortBy !== 'plan' || sortDir !== (defaultSortDirs.plan ?? 'desc');

    if (visibleCountBadge) {
      visibleCountBadge.textContent = `Showing ${visibleCount} of ${totalCount} ${totalCount === 1 ? 'run' : 'runs'}`;
      visibleCountBadge.classList.toggle('is-filtered', hasActiveFilters);
    }

    harnessFilter?.classList.toggle('is-active-filter', harness !== 'all');
    providerFilter?.classList.toggle('is-active-filter', provider !== 'all');
    sortSelect?.classList.toggle('is-active-filter', isNonDefaultSort);
    sortDirBtn?.classList.toggle(
      'is-active-filter',
      sortDir !== (defaultSortDirs[sortBy] ?? 'desc')
    );
    fullPassToggle
      ?.closest('.controls-check-label')
      ?.classList.toggle('is-active-filter', fullPassOnly);
    searchInput?.closest('.command-input-wrap')?.classList.toggle('is-active-filter', Boolean(query));

    if (resetFiltersBtn) {
      resetFiltersBtn.hidden = !(hasActiveFilters || isNonDefaultSort);
    }

    if (emptyStateRow) {
      emptyStateRow.hidden = visibleCount > 0;
      if (visibleCount === 0 && emptyStateMsg) {
        const activeParts: string[] = [];
        const harnessLabel = harnessFilter?.selectedOptions[0]?.textContent ?? harness;
        const providerLabel = providerFilter?.selectedOptions[0]?.textContent ?? provider;
        if (query) activeParts.push(`query "${searchInput?.value.trim()}"`);
        if (harness !== 'all') activeParts.push(`harness "${harnessLabel}"`);
        if (provider !== 'all') activeParts.push(`provider "${providerLabel}"`);
        if (fullPassOnly) activeParts.push('7/7 full pass only');
        emptyStateMsg.textContent =
          activeParts.length > 0
            ? `No benchmark runs match ${activeParts.join(' + ')}.`
            : 'No benchmark runs match the current filters.';
      }
    }

    // Highlight timestamps when sorting by Run Date
    table?.classList.toggle('is-sorted-by-date', sortBy === 'timestamp');

    // Update table header indicators and aria-sort
    sortableHeaders.forEach((th) => {
      const col = th.dataset.sortCol;
      const indicator = th.querySelector('.sort-indicator');
      if (col === sortBy) {
        th.classList.add('active-sort');
        th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
        if (indicator) indicator.textContent = sortDir === 'asc' ? '↑' : '↓';
      } else {
        th.classList.remove('active-sort');
        th.setAttribute('aria-sort', 'none');
        if (indicator) indicator.textContent = '';
      }
    });

    syncUrlState(query, harness, provider, fullPassOnly, sortBy, sortDir);

    // Debounce polite live region announcement
    if (statusRegion) {
      if (announceTimer) clearTimeout(announceTimer);
      const sortLabel = sortSelect.selectedOptions[0]?.textContent ?? sortBy;
      announceTimer = setTimeout(() => {
        statusRegion.textContent = `Showing ${visibleCount} of ${totalCount} ${totalCount === 1 ? 'run' : 'runs'}, sorted by ${sortLabel} (${sortDir === 'asc' ? 'ascending' : 'descending'}).`;
      }, 250);
    }
  }

  function updateLeaderboard(withTransition = true) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (withTransition && !prefersReducedMotion && 'startViewTransition' in document) {
      document.startViewTransition(() => applyLeaderboardUpdate());
    } else {
      applyLeaderboardUpdate();
    }
  }

  function resetAllControls() {
    if (searchInput) searchInput.value = '';
    if (harnessFilter) harnessFilter.value = 'all';
    if (providerFilter) providerFilter.value = 'all';
    if (fullPassToggle) fullPassToggle.checked = false;
    if (sortSelect) sortSelect.value = 'plan';
    setSortDirButtonState('desc');
    updateLeaderboard(true);
  }

  // Hydrate initial URL query state if present
  if (window.location.search) {
    hydrateFromUrlState();
    applyLeaderboardUpdate();
  }

  searchInput?.addEventListener('input', () => updateLeaderboard(false));
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      if (searchInput.value) {
        searchInput.value = '';
        updateLeaderboard(false);
      }
      searchInput.blur();
    }
  });
  harnessFilter?.addEventListener('change', () => updateLeaderboard(true));
  providerFilter?.addEventListener('change', () => updateLeaderboard(true));
  fullPassToggle?.addEventListener('change', () => updateLeaderboard(true));
  resetFiltersBtn?.addEventListener('click', resetAllControls);
  emptyResetBtn?.addEventListener('click', resetAllControls);

  // Press '/' to focus the search input when not typing in an input
  window.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const active = document.activeElement;
    if (
      active &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.tagName === 'SELECT' ||
        (active as HTMLElement).isContentEditable)
    ) {
      return;
    }
    e.preventDefault();
    searchInput?.focus();
    searchInput?.select();
  });

  sortSelect?.addEventListener('change', () => {
    const col = sortSelect.value;
    const defaultDir = defaultSortDirs[col] ?? 'desc';
    setSortDirButtonState(defaultDir);
    updateLeaderboard(true);
  });

  sortDirBtn?.addEventListener('click', () => {
    const current = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
    setSortDirButtonState(current);
    updateLeaderboard(true);
  });

  sortableHeaders.forEach((th) => {
    const btn = th.querySelector<HTMLButtonElement>('.sort-header-btn');
    (btn ?? th).addEventListener('click', () => {
      const col = th.dataset.sortCol;
      if (!col || !sortSelect || !sortDirBtn) return;

      if (sortSelect.value === col) {
        const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
        setSortDirButtonState(nextDir);
      } else {
        sortSelect.value = col;
        const defaultDir = defaultSortDirs[col] ?? 'desc';
        setSortDirButtonState(defaultDir);
      }
      updateLeaderboard(true);
    });
  });

  // Row click navigation (respects text selection and modifier keys)
  document.querySelectorAll<HTMLTableRowElement>('tr.run-row').forEach((row) => {
    row.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button, input, label')) return;
      const selection = window.getSelection();
      if (selection && selection.toString().trim().length > 0) return;

      const href = row.dataset.href;
      if (!href) return;

      if (e.metaKey || e.ctrlKey) {
        window.open(href, '_blank', 'noopener');
        return;
      }
      window.location.href = href;
    });
  });
</script>
