---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatDuration,
  formatCost,
  formatTimestamp,
  formatCompactContextWindow,
  formatHarnessName,
  formatProviderName,
} from '../utils/format';
import {
  analyzeAndRankRuns,
  computeStageBottleneckMatrix,
  discoverAblationPresets,
} from '../utils/telemetry';
import { BENCHMARK_STAGES } from '../data/benchmark';

const stageTitleMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));
const allRuns = await getCollection('runs', ({ data }) => data.published !== false);

const analyzedRuns = analyzeAndRankRuns(
  allRuns.map((entry) => ({ id: entry.id, data: entry.data }))
);
const stageMatrix = computeStageBottleneckMatrix(analyzedRuns);
const ablationPresets = discoverAblationPresets(analyzedRuns).slice(0, 3);

const enrichedRuns = analyzedRuns.map((run) => {
  const d = run.data;
  const compactContext = formatCompactContextWindow(d.contextWindow);
  const hasCalls =
    d.calls && (d.calls.llmCalls !== undefined || d.calls.toolCalls?.total !== undefined);
  const totalCalls = hasCalls
    ? (d.calls?.llmCalls ?? 0) + (d.calls?.toolCalls?.total ?? 0)
    : undefined;
  const testsRatio =
    d.tests && d.tests.total > 0 ? d.tests.passed / d.tests.total : -1;
  const testsPassed = d.tests?.passed ?? -1;
  const timeMs = new Date(d.timestamp).getTime() || 0;

  return {
    id: run.id,
    data: d,
    telemetry: run,
    plan: run.plan,
    inputTokens: run.tokens.uncachedInput,
    cachedTokens: run.tokens.cachedInput,
    outputTokens: run.tokens.output,
    totalTokens: run.tokens.total,
    compactContext,
    totalCalls,
    testsRatio,
    testsPassed,
    timeMs,
  };
});

const harnesses = [...new Set(enrichedRuns.map((r) => r.data.codingHarness))].sort((a, b) =>
  formatHarnessName(a).localeCompare(formatHarnessName(b), undefined, { sensitivity: 'base' })
);
const providers = [...new Set(enrichedRuns.map((r) => r.data.provider))].sort((a, b) =>
  formatProviderName(a).localeCompare(formatProviderName(b), undefined, { sensitivity: 'base' })
);

const durations = enrichedRuns.map((r) => r.data.durationMinutes);
const costs = enrichedRuns.map((r) => r.data.costUsd);
const fastestMin = durations.length > 0 ? Math.min(...durations) : 0;
const slowestMin = durations.length > 0 ? Math.max(...durations) : 0;
const lowestCost = costs.length > 0 ? Math.min(...costs) : 0;
const highestCost = costs.length > 0 ? Math.max(...costs) : 0;
const fullPassRuns = enrichedRuns.filter((r) => r.plan.ratio === 1);
const fullPassCount = fullPassRuns.length;
const paretoFrontierRuns = fullPassRuns
  .filter((r) => r.telemetry.isParetoFrontier)
  .sort((a, b) => (a.telemetry.paretoOrder ?? 99) - (b.telemetry.paretoOrder ?? 99));

const leaderPool = fullPassRuns.length > 0 ? fullPassRuns : enrichedRuns;
const lowestCostLeader =
  leaderPool.length > 0
    ? [...leaderPool].sort(
        (a, b) => a.data.costUsd - b.data.costUsd || a.data.durationMinutes - b.data.durationMinutes
      )[0]
    : undefined;
const fastestLeader =
  leaderPool.length > 0
    ? [...leaderPool].sort(
        (a, b) => a.data.durationMinutes - b.data.durationMinutes || a.data.costUsd - b.data.costUsd
      )[0]
    : undefined;

const totalCacheSavingsUsd = enrichedRuns.reduce(
  (sum, r) => sum + r.telemetry.costMetrics.cacheSavingsUsd,
  0
);
const topCacheSaver = [...enrichedRuns].sort(
  (a, b) => b.telemetry.costMetrics.cacheSavingsUsd - a.telemetry.costMetrics.cacheSavingsUsd
)[0];

// SVG coordinates for the 7/7 Speed x Cost Pareto Frontier Plot
const chartW = 680;
const chartH = 260;
const padL = 56;
const padR = 28;
const padT = 24;
const padB = 42;
const plotW = chartW - padL - padR;
const plotH = chartH - padT - padB;

const maxPlotDur = Math.max(120, ...fullPassRuns.map((r) => r.data.durationMinutes));
const maxPlotCost = Math.max(14, ...fullPassRuns.map((r) => r.data.costUsd));

const toSvgX = (dur: number) => padL + (dur / maxPlotDur) * plotW;
const toSvgY = (cost: number) => padT + plotH - (cost / maxPlotCost) * plotH;

// Build stepped Pareto path from fastest (leftmost) to cheapest (bottommost)
let paretoStepPath = '';
if (paretoFrontierRuns.length > 0) {
  const pts = paretoFrontierRuns.map((r) => ({
    x: Number(toSvgX(r.data.durationMinutes).toFixed(1)),
    y: Number(toSvgY(r.data.costUsd).toFixed(1)),
  }));
  const segs: string[] = [`M ${pts[0].x} ${pts[0].y}`];
  for (let i = 1; i < pts.length; i++) {
    segs.push(`L ${pts[i].x} ${pts[i - 1].y}`);
    segs.push(`L ${pts[i].x} ${pts[i].y}`);
  }
  paretoStepPath = segs.join(' ');
}
---

<BaseLayout title="Leaderboard" activeNav="leaderboard">
  <div class="leaderboard-quiet">
  <!-- 01. HERO & TWO-TONE UNBOUNDED TYPOGRAPHY -->
  <section class="hero-box" aria-labelledby="hero-heading">
    <div class="pixel-mosaic" aria-hidden="true">
      <div class="px-acid"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-white"></div><div class="px-acid"></div>
      <div class="px-gray"></div><div class="px-white"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-soft"></div>
      <div class="px-mint"></div><div class="px-gray"></div><div class="px-acid"></div><div class="px-white"></div><div class="px-acid"></div>
      <div class="px-mint"></div><div class="px-white"></div><div class="px-gray"></div><div class="px-mint"></div><div class="px-0"></div>
      <div class="px-acid"></div><div class="px-gray"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div>
      <div class="px-mint"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div><div class="px-0"></div>
    </div>

    <h1 id="hero-heading" class="headline-two-tone">
      Capy Bench Leaderboard.{' '}
      <span class="muted">
        Coding harnesses and models, ranked on real-world CLI engineering.
      </span>
    </h1>

    <p class="hero-subtitle">
      Each run challenges a coding harness and model to build a rate-paced HTTP/TLS benchmark CLI
      from scratch using strict Outside-In TDD—verified against an external 7-slice holdout contract
      and audited for exact token conservation, Pareto efficiency, and stage bottlenecks.
    </p>
  </section>

  <!-- 02. EVIDENCE-BACKED METRIC STRIP -->
  <dl class="hero-stats-grid" aria-label="Benchmark summary statistics">
    <div class="card stat-card">
      <dt class="section-kicker">HOLDOUT SPEC PASS RATE</dt>
      <dd class="stat-value">
        {fullPassCount}/{enrichedRuns.length}
      </dd>
      <dd class="stat-meta">
        {Math.round((fullPassCount / Math.max(enrichedRuns.length, 1)) * 100)}% passed 7/7 slices ·{' '}
        <a href="#pareto-section" class="stat-leader-link">
          {paretoFrontierRuns.length} on Pareto frontier ↓
        </a>
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">LOWEST 7/7 COST</dt>
      <dd class="stat-value">
        {lowestCostLeader ? formatCost(lowestCostLeader.data.costUsd) : formatCost(lowestCost)}
      </dd>
      <dd class="stat-meta">
        {lowestCostLeader ? (
          <>
            <a href={`/runs/${lowestCostLeader.id}`} class="stat-leader-link">
              {formatHarnessName(lowestCostLeader.data.codingHarness)} / {lowestCostLeader.data.model}
            </a>
            {' · '}range {formatCost(lowestCost)}–{formatCost(highestCost)}
          </>
        ) : (
          `n=${enrichedRuns.length} runs · range ${formatCost(lowestCost)}–${formatCost(highestCost)}`
        )}
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">FASTEST 7/7 RUN</dt>
      <dd class="stat-value">
        {fastestLeader
          ? formatDuration(fastestLeader.data.durationMinutes)
          : formatDuration(fastestMin)}
      </dd>
      <dd class="stat-meta">
        {fastestLeader ? (
          <>
            <a href={`/runs/${fastestLeader.id}`} class="stat-leader-link">
              {formatHarnessName(fastestLeader.data.codingHarness)} / {fastestLeader.data.model}
            </a>
            {' · '}range {formatDuration(fastestMin)}–{formatDuration(slowestMin)}
          </>
        ) : (
          `n=${enrichedRuns.length} runs · range ${formatDuration(fastestMin)}–${formatDuration(slowestMin)}`
        )}
      </dd>
    </div>

    <div class="card stat-card">
      <dt class="section-kicker">PROMPT CACHE SAVINGS</dt>
      <dd class="stat-value">
        {formatCost(totalCacheSavingsUsd)}
      </dd>
      <dd class="stat-meta">
        {topCacheSaver ? (
          <>
            Saved vs. uncached · peak{' '}
            <a href={`/runs/${topCacheSaver.id}`} class="stat-leader-link">
              {formatCost(topCacheSaver.telemetry.costMetrics.cacheSavingsUsd)} ({topCacheSaver.telemetry.costMetrics.cacheSavingsPct}%)
            </a>
          </>
        ) : (
          `n=${enrichedRuns.length} runs`
        )}
      </dd>
    </div>
  </dl>

  <!-- 03. FILTER & SORT COMMAND BAR -->
  <search class="controls-bar" aria-label="Leaderboard filters and sorting">
    <div class="controls-search-col">
      <div class="field-label-row">
        <label class="field-label" for="search-input">Filter Playbook Runs</label>
        <kbd class="menu-kbd" title="Press / to focus search" aria-hidden="true">/</kbd>
      </div>
      <div class="command-input-wrap">
        <span class="command-input-prefix">/filter</span>
        <input
          id="search-input"
          name="q"
          type="search"
          class="input"
          placeholder="Harness, model, provider, effort..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
      </div>
    </div>

    <div class="controls-select-row">
      <div class="control-field">
        <label class="field-label" for="harness-filter">Harness</label>
        <select id="harness-filter" name="harness" class="select control-select">
          <option value="all">All Harnesses</option>
          {harnesses.map((h) => <option value={h}>{formatHarnessName(h)}</option>)}
        </select>
      </div>

      <div class="control-field">
        <label class="field-label" for="provider-filter">Provider</label>
        <select id="provider-filter" name="provider" class="select control-select">
          <option value="all">All Providers</option>
          {providers.map((p) => <option value={p}>{formatProviderName(p)}</option>)}
        </select>
      </div>

      <div class="control-field">
        <label class="field-label" for="pricing-lens-select">Pricing Lens</label>
        <select id="pricing-lens-select" name="lens" class="select control-select">
          <option value="billed" selected>Billed Cost (Actual USD)</option>
          <option value="standard">Standard API Rate USD</option>
          <option value="uncached">Uncached Counterfactual (0% Cache)</option>
        </select>
      </div>

      <div class="control-field">
        <label class="field-label" for="sort-select">Sort Metric</label>
        <div class="sort-control-pair">
          <select id="sort-select" name="sort" class="select control-select">
            <option value="plan" selected>Holdout Spec Completion (S1–S7)</option>
            <option value="duration">Duration (Time Elapsed)</option>
            <option value="cost">Cost (Selected Lens $)</option>
            <option value="tokens">Total Tokens (Exact Int)</option>
            <option value="tests">Agent Self-Tests Passed</option>
            <option value="timestamp">Run Date</option>
          </select>
          <button
            id="sort-dir-btn"
            type="button"
            class="btn btn-sm btn-secondary sort-dir-btn"
            data-dir="desc"
            aria-label="Sort direction: descending. Activate to switch to ascending"
          >
            <span aria-hidden="true">↓</span> DESC
          </button>
        </div>
      </div>
    </div>

    <div class="controls-footer-row">
      <div class="controls-toggles-wrap">
        <label class="check-label controls-check-label" for="full-pass-toggle">
          <input
            id="full-pass-toggle"
            name="fullPass"
            type="checkbox"
            class="check-input"
          />
          <span>7/7 Holdout Full Pass ({fullPassCount})</span>
        </label>

        <label class="check-label controls-check-label" for="pareto-only-toggle">
          <input
            id="pareto-only-toggle"
            name="paretoOnly"
            type="checkbox"
            class="check-input"
          />
          <span>Pareto Frontier Only ({paretoFrontierRuns.length})</span>
        </label>
      </div>

      <div class="controls-meta-actions">
        <span id="visible-count-badge" class="controls-result-count">
          Showing {enrichedRuns.length} of {enrichedRuns.length} runs
        </span>
        <a href="/compare" class="btn btn-sm btn-secondary">
          Compare &amp; Ablations →
        </a>
        <button
          id="reset-filters-btn"
          type="button"
          class="btn btn-sm btn-secondary"
          hidden
        >
          Reset filters
        </button>
      </div>
    </div>

    <div class="stage-legend-bar" aria-label="Benchmark stage key (S1 through S7)">
      <span class="stage-legend-kicker">Stages:</span>
      <ul class="stage-legend-list">
        {
          BENCHMARK_STAGES.map((stage) => (
            <li class="stage-legend-item">
              <span class="stage-legend-id">{stage.id}</span>
              <span class="stage-legend-title">{stage.title}</span>
            </li>
          ))
        }
      </ul>
      <a href="#bottleneck-section" class="stage-legend-link">Bottleneck matrix ↓</a>
    </div>

    <div
      id="leaderboard-status"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
  </search>

  <!-- 04. LEADERBOARD DATA TABLE -->
  <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="leaderboard-caption">
    <table class="app-table leaderboard-table" id="leaderboard-table">
      <caption id="leaderboard-caption" class="visually-hidden">
        Capy Bench evaluation runs ranked by holdout spec completion, agent test suite, duration,
        exact token usage, and API cost
      </caption>
      <thead>
        <tr>
          <th scope="col" class="col-rank">Rank</th>
          <th scope="col">Coding Harness &amp; Model</th>
          <th scope="col" class="sortable active-sort" data-sort-col="plan" aria-sort="descending">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by S1–S7 external holdout spec completion ratio"
            >
              <span>Spec Verification</span>
              <span class="sort-indicator" aria-hidden="true">↓</span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tests" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by agent-authored ExUnit test suite pass ratio, then total passing tests"
            >
              <span>Agent Suite &amp; Git</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="duration" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by active wall-clock run duration"
            >
              <span>Duration</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="tokens" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by exact total token volume (uncached input + cached input + output)"
            >
              <span>Token Usage</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="sortable" data-sort-col="cost" aria-sort="none">
            <button
              type="button"
              class="sort-header-btn"
              title="Sort by cost in USD under the active pricing lens"
            >
              <span id="cost-col-header-label">Cost (Billed)</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="col-details">Action</th>
        </tr>
      </thead>
      <tbody id="leaderboard-tbody">
        {
          enrichedRuns.map((run, index) => {
            const { data, plan, telemetry } = run;
            const rank = index + 1;
            const hasTokens =
              data.tokens && (data.tokens.input || data.tokens.output || data.tokens.cacheHitRate);
            const vtName = `run-${run.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
            const incompleteStages = plan.entries
              .filter(([, done]) => !done)
              .map(([stageId]) => stageId);

            const displayHarness = telemetry.displayHarness;
            const displayProvider = telemetry.displayProvider;
            const showInOutSub = Boolean(
              data.tokens?.total && data.tokens?.input && data.tokens?.output
            );
            const billedCost = data.costUsd;
            const standardCost = telemetry.costMetrics.standardApiCostUsd;
            const uncachedCost = telemetry.costMetrics.uncachedCounterfactualCostUsd;
            const cacheSavings = telemetry.costMetrics.cacheSavingsUsd;

            return (
              <tr
                class="run-row"
                style={`--vt-name: ${vtName};`}
                data-href={`/runs/${run.id}`}
                data-harness={data.codingHarness}
                data-provider={data.provider}
                data-search={`${data.codingHarness} ${displayHarness} ${data.model} ${data.provider} ${displayProvider} ${data.effort ?? ''} ${telemetry.isParetoFrontier ? 'pareto frontier' : ''}`.toLowerCase()}
                data-plan={plan.ratio}
                data-pareto={telemetry.isParetoFrontier ? '1' : '0'}
                data-duration={data.durationMinutes}
                data-cost={billedCost}
                data-cost-billed={billedCost}
                data-cost-standard={standardCost}
                data-cost-uncached={uncachedCost}
                data-cache-savings={cacheSavings}
                data-tokens={run.totalTokens}
                data-tests={run.testsRatio}
                data-tests-passed={run.testsPassed}
                data-timestamp={run.timeMs}
              >
                <td data-cell="Rank">
                  <span
                    class:list={[
                      'rank-badge',
                      { 'rank-1': rank === 1, 'rank-2': rank === 2, 'rank-3': rank === 3 },
                    ]}
                  >
                    #{rank}
                  </span>
                </td>

                <th scope="row" data-cell="Harness & Model">
                  <div class="cell-stack">
                    <div class="entry-title-row">
                      <a href={`/runs/${run.id}`} class="entry-title-link">
                        <span>{displayHarness}</span>
                        <span class="text-muted-sep" aria-hidden="true">/</span>
                        <span class="entry-model">{data.model}</span>
                      </a>
                      {telemetry.isParetoFrontier && (
                        <span
                          class="hl hl-acid pareto-inline-badge"
                          title={`Pareto Frontier #${telemetry.paretoOrder}: non-dominated on 7/7 speed (${formatDuration(data.durationMinutes)}) and cost (${formatCost(billedCost)})`}
                        >
                          PARETO
                        </span>
                      )}
                    </div>
                    <div class="entry-meta">
                      <span>{displayProvider}</span>
                      {data.effort && (
                        <>
                          <span class="entry-meta-sep" aria-hidden="true">·</span>
                          <span>effort:{data.effort}</span>
                        </>
                      )}
                      {data.interface?.type && (
                        <>
                          <span class="entry-meta-sep" aria-hidden="true">·</span>
                          <span class="entry-meta-tag">{data.interface.type}</span>
                        </>
                      )}
                      <span class="entry-meta-sep" aria-hidden="true">·</span>
                      <time datetime={data.timestamp} class="metric-sub metric-inline entry-timestamp">
                        {formatTimestamp(data.timestamp)}
                      </time>
                    </div>
                  </div>
                </th>

                <td data-cell="Spec Verification">
                  <div class="plan-cell cell-stack">
                    <div class="plan-primary-row">
                      <span class="metric-primary">
                        {plan.completed}/{plan.total} stages
                      </span>
                      <span
                        class:list={[
                          'plan-pct-badge',
                          plan.ratio === 1
                            ? 'hl hl-mint'
                            : plan.ratio >= 0.7
                              ? 'plan-pct-partial'
                              : 'hl hl-magenta',
                        ]}
                      >
                        {Math.round(plan.ratio * 100)}%
                      </span>
                      {incompleteStages.length > 0 && (
                        <span class="visually-hidden">
                          (Incomplete stages: {incompleteStages.join(', ')})
                        </span>
                      )}
                    </div>
                    <div class="stage-strip" aria-hidden="true">
                      {plan.entries.map(([stageId, done]) => {
                        const stageTitle = stageTitleMap.get(stageId) ?? stageId;
                        const isPeak = telemetry.peakStageId === stageId;
                        return (
                          <span
                            class:list={[
                              'stage-pill',
                              done ? 'done' : 'pending',
                              { 'is-peak-stage': isPeak },
                            ]}
                            title={`${stageId}: ${stageTitle} (${done ? 'Holdout PASS' : 'Holdout MISS'}${isPeak ? ` · Peak cost stage: ${formatCost(telemetry.stages[stageId as keyof typeof telemetry.stages].costUsd)}` : ''})`}
                          >
                            {stageId}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                </td>

                <td data-cell="Agent Suite & Git">
                  <div class="cell-stack">
                    {data.tests ? (
                      <div
                        class="metric-primary"
                        title="Agent-authored ExUnit test suite results (separate from holdout S1–S7 spec verification)"
                      >
                        {data.tests.passed}/{data.tests.total} ExUnit
                      </div>
                    ) : (
                      <div class="metric-empty">—</div>
                    )}
                    <div class="metric-sub">
                      {data.commits !== undefined ? `${data.commits} commits` : ''}
                      {telemetry.toolSuccessRatePct !== null && (
                        <>
                          {data.commits !== undefined && <span aria-hidden="true"> · </span>}
                          <span title={`${telemetry.toolErrorCalls} tool errors out of ${telemetry.toolTotalCalls} tool calls`}>
                            {telemetry.toolSuccessRatePct}% tool ok
                          </span>
                        </>
                      )}
                    </div>
                  </div>
                </td>

                <td data-cell="Duration">
                  <div class="cell-stack">
                    <div class="metric-primary">{formatDuration(data.durationMinutes)}</div>
                    {run.totalCalls !== undefined && (
                      <div class="metric-sub">
                        {telemetry.llmCalls} LLM / {telemetry.toolTotalCalls} tool
                      </div>
                    )}
                  </div>
                </td>

                <td data-cell="Token Usage">
                  {hasTokens ? (
                    <div class="cell-stack">
                      <div
                        class="metric-primary"
                        title={`Exact tokens: ${telemetry.tokens.total.toLocaleString('en-US')} total (${telemetry.tokens.uncachedInput.toLocaleString('en-US')} uncached in · ${telemetry.tokens.cachedInput.toLocaleString('en-US')} cached in · ${telemetry.tokens.output.toLocaleString('en-US')} out · ${telemetry.tokens.thinking.toLocaleString('en-US')} thinking)`}
                      >
                        {data.tokens?.total
                          ? `${data.tokens.total} total`
                          : `${data.tokens?.input ?? '—'} in / ${data.tokens?.output ?? '—'} out`}
                      </div>
                      <div class="metric-sub">
                        {showInOutSub && (
                          <span>
                            {data.tokens?.input} in / {data.tokens?.output} out
                          </span>
                        )}
                        {data.tokens?.cacheHitRate && (
                          <>
                            {showInOutSub && <span aria-hidden="true"> · </span>}
                            <span>{data.tokens.cacheHitRate} cache</span>
                          </>
                        )}
                        {run.compactContext && (
                          <>
                            {(showInOutSub || Boolean(data.tokens?.cacheHitRate)) && (
                              <span aria-hidden="true"> · </span>
                            )}
                            <span title={data.contextWindow}>Ctx: {run.compactContext}</span>
                          </>
                        )}
                      </div>
                    </div>
                  ) : (
                    <span class="metric-empty">—</span>
                  )}
                </td>

                <td data-cell="Cost">
                  <div class="cell-stack">
                    <div>
                      {lowestCostLeader && run.id === lowestCostLeader.id ? (
                        <span
                          class="hl hl-mint cost-pill cost-primary-display"
                          title="Lowest 7/7 full-pass cost leader"
                        >
                          {formatCost(billedCost)}
                        </span>
                      ) : (
                        <span class="metric-primary cost-mono cost-primary-display">
                          {formatCost(billedCost)}
                        </span>
                      )}
                    </div>
                    <div class="metric-sub cost-sub-display">
                      {cacheSavings > 0
                        ? `-${formatCost(cacheSavings)} cache saved`
                        : standardCost > billedCost
                          ? `${formatCost(standardCost)} API equiv.`
                          : 'free tier'}
                    </div>
                  </div>
                </td>

                <td data-cell="Action">
                  <div class="row-action-stack">
                    <a
                      href={`/runs/${run.id}`}
                      class="btn btn-sm btn-secondary view-btn"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <span>Inspect</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </td>
              </tr>
            );
          })
        }
        <tr id="empty-state-row" hidden>
          <td colspan="8" class="empty-state-cell">
            <div class="empty-state-wrap">
              <p id="empty-state-msg" class="empty-state-copy">
                No benchmark runs match the current filters.
              </p>
              <button
                id="empty-reset-btn"
                type="button"
                class="btn btn-sm btn-secondary"
              >
                Reset all filters
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- 05. CROSS-RUN ECONOMETRICS: PARETO FRONTIER & STAGE BOTTLENECK MATRIX -->
  <div class="analytics-grid">
    <!-- Panel A: 7/7 Speed x Cost Pareto Frontier -->
    <section
      class="card analytics-card"
      id="pareto-section"
      aria-labelledby="pareto-heading"
    >
      <div class="card-title">
        <div class="card-title-group">
          <h2 id="pareto-heading" class="card-heading headline-two-tone">
            Speed × Cost Pareto Frontier{' '}
            <span class="muted">/ {paretoFrontierRuns.length} Optimal 7/7 Runs</span>
          </h2>
        </div>
        <div class="card-title-group">
          <a href="/compare?preset=pareto-cost-vs-speed" class="action-link">
            Diff Frontier Extremes <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <p class="mono section-subnote">
        Non-dominated 7/7 full-pass runs where no other evaluation is simultaneously faster and cheaper.
      </p>

      <div class="pareto-layout">
        <div class="pareto-svg-frame">
          <svg
            viewBox={`0 0 ${chartW} ${chartH}`}
            class="pareto-svg"
            role="img"
            aria-labelledby="pareto-svg-title pareto-svg-desc"
          >
            <title id="pareto-svg-title">7/7 Full-Pass Speed vs Cost Pareto Frontier</title>
            <desc id="pareto-svg-desc">
              Scatter plot of duration in minutes versus cost in USD for all 7/7 passing runs, with a stepped line connecting the {paretoFrontierRuns.length} Pareto-optimal runs from {fastestLeader?.data.durationMinutes}m (${fastestLeader?.data.costUsd}) down to {lowestCostLeader?.data.durationMinutes}m (${lowestCostLeader?.data.costUsd}).
            </desc>

            <!-- Horizontal Cost Grid Lines -->
            {[0, 3, 6, 9, 12].map((cVal) => {
              const y = Number(toSvgY(cVal).toFixed(1));
              return (
                <g>
                  <line
                    x1={padL}
                    y1={y}
                    x2={chartW - padR}
                    y2={y}
                    class="pareto-grid-line"
                  />
                  <text x={padL - 8} y={y + 4} text-anchor="end" class="pareto-axis-label">
                    ${cVal}
                  </text>
                </g>
              );
            })}

            <!-- Vertical Duration Grid Lines -->
            {[20, 40, 60, 80, 100].map((dVal) => {
              const x = Number(toSvgX(dVal).toFixed(1));
              return (
                <g>
                  <line
                    x1={x}
                    y1={padT}
                    x2={x}
                    y2={chartH - padB}
                    class="pareto-grid-line"
                  />
                  <text x={x} y={chartH - padB + 18} text-anchor="middle" class="pareto-axis-label">
                    {dVal}m
                  </text>
                </g>
              );
            })}

            <!-- Axes -->
            <line
              x1={padL}
              y1={padT}
              x2={padL}
              y2={chartH - padB}
              class="pareto-axis-line"
            />
            <line
              x1={padL}
              y1={chartH - padB}
              x2={chartW - padR}
              y2={chartH - padB}
              class="pareto-axis-line"
            />

            <!-- Stepped Pareto Frontier Path -->
            {paretoStepPath && (
              <path d={paretoStepPath} class="pareto-step-path" fill="none" />
            )}

            <!-- Plot All 7/7 Full Pass Runs -->
            {fullPassRuns.map((r) => {
              const cx = Number(toSvgX(r.data.durationMinutes).toFixed(1));
              const cy = Number(toSvgY(r.data.costUsd).toFixed(1));
              const isFront = r.telemetry.isParetoFrontier;
              const shortLabel = `${r.telemetry.displayHarness} / ${r.data.model.replace('-contributor', '')}`;
              const labelOffsetY =
                r.data.model === 'gpt-6-sol' && r.telemetry.displayHarness === 'Pi'
                  ? 15
                  : -10;
              return (
                <a href={`/runs/${r.id}`} class="pareto-point-link">
                  <title>
                    {r.telemetry.displayHarness} / {r.data.model} ({r.data.effort ?? 'std'}): {formatDuration(r.data.durationMinutes)} · {formatCost(r.data.costUsd)}{isFront ? ' (PARETO OPTIMAL)' : ''}
                  </title>
                  {isFront ? (
                    <rect
                      x={cx - 6}
                      y={cy - 6}
                      width="12"
                      height="12"
                      class="pareto-node-optimal"
                    />
                  ) : (
                    <circle cx={cx} cy={cy} r="5" class="pareto-node-dominated" />
                  )}
                  <text
                    x={cx + 9}
                    y={cy + labelOffsetY}
                    class:list={[
                      'pareto-node-label',
                      isFront ? 'is-optimal' : 'is-dominated',
                    ]}
                  >
                    {shortLabel} ({r.data.durationMinutes}m, {formatCost(r.data.costUsd)})
                  </text>
                </a>
              );
            })}
          </svg>
        </div>

        <ol class="command-list pareto-step-list" role="list">
          {paretoFrontierRuns.map((r) => (
            <li class="command-row pareto-step-row">
              <div class="pareto-step-left">
                <span class="hl hl-acid pareto-order-pill">
                  F{r.telemetry.paretoOrder}
                </span>
                <a href={`/runs/${r.id}`} class="pareto-step-link">
                  <strong>{r.telemetry.displayHarness} / {r.data.model}</strong>
                </a>
              </div>
              <div class="mono pareto-step-metrics">
                <span>{formatDuration(r.data.durationMinutes)}</span>
                <span aria-hidden="true">·</span>
                <strong class="cost-mono">{formatCost(r.data.costUsd)}</strong>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Panel B: Cross-Run Stage Bottleneck Matrix (S1-S7) -->
    <section
      class="card analytics-card"
      id="bottleneck-section"
      aria-labelledby="bottleneck-heading"
    >
      <div class="card-title">
        <div class="card-title-group">
          <h2 id="bottleneck-heading" class="card-heading headline-two-tone">
            Stage Bottleneck Matrix{' '}
            <span class="muted">/ S1–S7 Cross-Run Telemetry</span>
          </h2>
        </div>
        <div class="card-title-group">
          <a href="/about#stages" class="action-link">
            Stage Specifications <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <p class="mono section-subnote">
        Aggregated across all {enrichedRuns.length} runs: S3 (streaming HTTP/TLS + 2s timeouts) and S7 (foreground PTY Ctrl-C) dominate token burn, while S5 has the highest spec miss rate.
      </p>

      <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="bottleneck-heading">
        <table class="app-table leaderboard-table static-table bottleneck-table">
          <caption class="visually-hidden">
            Stage-by-stage pass rate, average LLM call share, average cost share, average thinking tokens, and peak bottleneck frequency across S1 through S7
          </caption>
          <thead>
            <tr>
              <th scope="col">Stage</th>
              <th scope="col">Holdout Pass Rate</th>
              <th scope="col">Avg Call Share</th>
              <th scope="col">Avg Cost Share</th>
              <th scope="col">Avg Thinking</th>
              <th scope="col">Peak Cost Stage</th>
            </tr>
          </thead>
          <tbody>
            {stageMatrix.map((st) => {
              const title = stageTitleMap.get(st.stageId) ?? st.stageId;
              const isTopBottleneck = st.peakCostCount >= 2;
              const isHighMiss = st.passRatePct < 70;
              return (
                <tr>
                  <th scope="row" data-cell="Stage">
                    <div class="bottleneck-stage-cell">
                      <span class:list={['stage-legend-id', { 'hl hl-violet': isTopBottleneck }]}>
                        {st.stageId}
                      </span>
                      <strong>{title}</strong>
                    </div>
                  </th>
                  <td class="mono" data-cell="Holdout Pass Rate">
                    <span class:list={[isHighMiss ? 'hl hl-magenta' : '']}>
                      {st.passCount}/{st.totalRuns} ({st.passRatePct}%)
                    </span>
                  </td>
                  <td class="mono" data-cell="Avg Call Share">
                    {st.avgCallSharePct}% ({st.avgLlmCalls} calls)
                  </td>
                  <td class="mono" data-cell="Avg Cost Share">
                    <div class="bottleneck-bar-wrap">
                      <span>{st.avgCostSharePct}%</span>
                      <div class="bottleneck-bar-track" aria-hidden="true">
                        <span
                          class:list={[
                            'bottleneck-bar-fill',
                            isTopBottleneck ? 'is-peak' : 'is-normal',
                          ]}
                          style={`inline-size: ${Math.min(100, st.avgCostSharePct * 3).toFixed(1)}%`}
                        />
                      </div>
                    </div>
                  </td>
                  <td class="mono" data-cell="Avg Thinking">
                    {st.avgThinkingTokens.toLocaleString('en-US')} tok
                  </td>
                  <td class="mono" data-cell="Peak Cost Stage">
                    {st.peakCostCount > 0 ? (
                      <span class:list={[isTopBottleneck ? 'hl hl-violet' : 'badge-static']}>
                        {st.peakCostCount} {st.peakCostCount === 1 ? 'run' : 'runs'} #1 peak
                      </span>
                    ) : (
                      <span class="text-muted">0 runs</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Panel C: Featured Controlled Ablations Teaser -->
    <section
      class="card analytics-card"
      id="ablations-teaser"
      aria-labelledby="ablations-teaser-heading"
    >
      <div class="card-title">
        <div class="card-title-group">
          <h2 id="ablations-teaser-heading" class="card-heading headline-two-tone">
            Controlled Ablation Experiments{' '}
            <span class="muted">/ Isolating Harness, Effort &amp; Model Tier</span>
          </h2>
        </div>
        <div class="card-title-group">
          <a href="/compare" class="action-link">
            Open Full Comparison Workbench <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="ablation-cards-grid">
        {ablationPresets.map((preset) => (
          <a
            href={`/compare?a=${preset.runAId}&b=${preset.runBId}&preset=${preset.id}`}
            class="card card-interactive ablation-teaser-card"
          >
            <div class="ablation-teaser-top">
              <span class="hl hl-sky ablation-badge">{preset.badge}</span>
              <span class="mono ablation-cta">Diff runs →</span>
            </div>
            <strong class="ablation-teaser-title">{preset.title}</strong>
            <p class="ablation-teaser-copy">{preset.findingHeadline}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </div>
</BaseLayout>

