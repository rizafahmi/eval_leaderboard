  function formatDurShort(mins: number): string {
    if (mins < 60) return `${mins}m`;
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return m === 0 ? `${h}h` : `${h}h ${m}m`;
  }

  function formatLensLabel(lens: PricingLens): string {
    if (lens === 'standard') return 'Standard API';
    if (lens === 'uncached') return 'Uncached';
    return 'Billed';
  }

  function resolveHighlightedRunIds(raw: string): {
    ids: Set<string>;
    kind: 'none' | 'run' | 'model' | 'harness' | 'query';
    label: string;
    caveat: string;
    singleRun: AnalyzedRun | null;
  } {
    const val = raw.trim();
    if (!val) {
      return { ids: new Set(), kind: 'none', label: '', caveat: '', singleRun: null };
    }

    // 1. Exact run ID
    const exactRun = frontierRunById.get(val);
    if (exactRun) {
      const mStat = groupStats.byModel[exactRun.data.model];
      const hStat = groupStats.byHarness[exactRun.data.codingHarness];
      const parts: string[] = [];
      if (mStat) parts.push(`model n=${mStat.n}`);
      if (hStat) {
        parts.push(
          `harness ${exactRun.displayHarness} n=${hStat.n}${hStat.singlePeerCaveat ? ' (single-model caveat)' : ''}`
        );
      }
      if (exactRun.costMetrics.profile?.pricingBadge) {
        parts.push(exactRun.costMetrics.profile.pricingBadge);
      }
      return {
        ids: new Set([exactRun.id]),
        kind: 'run',
        label: `${exactRun.displayHarness} / ${exactRun.data.model}${exactRun.data.effort ? ` (${exactRun.data.effort})` : ''}`,
        caveat: parts.join(' · '),
        singleRun: exactRun,
      };
    }

    // 2. Explicit model:<name>
    if (val.toLowerCase().startsWith('model:')) {
      const targetModel = val.slice(6).trim().toLowerCase();
      const matched = frontierRuns.filter((r) => r.data.model.toLowerCase() === targetModel);
      if (matched.length > 0) {
        const canonical = matched[0].data.model;
        const mStat = groupStats.byModel[canonical];
        return {
          ids: new Set(matched.map((r) => r.id)),
          kind: 'model',
          label: `Model: ${canonical}`,
          caveat: `n=${mStat?.n ?? matched.length} (${mStat?.fullPass ?? 0}/${matched.length} passed 7/7 · harnesses: ${mStat?.peers.join(', ') ?? ''})`,
          singleRun: matched.length === 1 ? matched[0] : null,
        };
      }
    }

    // 3. Explicit harness:<slug>
    if (val.toLowerCase().startsWith('harness:')) {
      const targetHarness = val.slice(8).trim().toLowerCase();
      const matched = frontierRuns.filter(
        (r) =>
          r.data.codingHarness.toLowerCase() === targetHarness ||
          r.displayHarness.toLowerCase() === targetHarness
      );
      if (matched.length > 0) {
        const canonicalSlug = matched[0].data.codingHarness;
        const hStat = groupStats.byHarness[canonicalSlug];
        return {
          ids: new Set(matched.map((r) => r.id)),
          kind: 'harness',
          label: `Harness: ${matched[0].displayHarness}`,
          caveat: `n=${hStat?.n ?? matched.length} (${hStat?.fullPass ?? 0}/${matched.length} passed 7/7${hStat?.singlePeerCaveat ? ' · single-model harness: harness & model effects are confounded' : ` · ${hStat?.peers.length ?? 0} models`})`,
          singleRun: matched.length === 1 ? matched[0] : null,
        };
      }
    }

    // 4. Bare model or harness name (e.g. ?highlight=gemini-4-argon or ?highlight=gpt-6-sol)
    const lower = val.toLowerCase();
    const matched = frontierRuns.filter(
      (r) =>
        r.data.model.toLowerCase().includes(lower) ||
        r.displayHarness.toLowerCase() === lower ||
        r.data.codingHarness.toLowerCase() === lower
    );
    if (matched.length > 0) {
      const models = [...new Set(matched.map((r) => r.data.model))];
      const harnesses = [...new Set(matched.map((r) => r.displayHarness))];
      return {
        ids: new Set(matched.map((r) => r.id)),
        kind: 'query',
        label: val,
        caveat: `n=${matched.length} matching runs (${models.length} ${models.length === 1 ? 'model' : 'models'}, ${harnesses.join(', ')})`,
        singleRun: matched.length === 1 ? matched[0] : null,
      };
    }

    return { ids: new Set(), kind: 'none', label: '', caveat: '', singleRun: null };
  }

  function applyCrossHighlightToTable() {
    const resolved = resolveHighlightedRunIds(activeHighlight);
    const hasHl = resolved.ids.size > 0;

    if (highlightBanner) {
      highlightBanner.hidden = !hasHl;
      if (hasHl) {
        if (hbTitle) hbTitle.textContent = resolved.label;
        if (hbCaveat) hbCaveat.textContent = resolved.caveat;
        if (hbDossierLink) {
          if (resolved.singleRun) {
            hbDossierLink.hidden = false;
            hbDossierLink.href = `/runs/${resolved.singleRun.id}`;
          } else {
            hbDossierLink.hidden = true;
          }
        }
        if (hbScopeModel) {
          const sr = resolved.singleRun;
          const mStat = sr ? groupStats.byModel[sr.data.model] : null;
          if (sr && mStat && mStat.n > 1 && resolved.kind === 'run') {
            hbScopeModel.hidden = false;
            hbScopeModel.textContent = `All ${sr.data.model} (n=${mStat.n})`;
            hbScopeModel.dataset.targetHighlight = `model:${sr.data.model}`;
          } else {
            hbScopeModel.hidden = true;
          }
        }
        if (hbScopeHarness) {
          const sr = resolved.singleRun;
          const hStat = sr ? groupStats.byHarness[sr.data.codingHarness] : null;
          if (sr && hStat && hStat.n > 1 && resolved.kind === 'run') {
            hbScopeHarness.hidden = false;
            hbScopeHarness.textContent = `All ${sr.displayHarness} (n=${hStat.n})`;
            hbScopeHarness.dataset.targetHighlight = `harness:${sr.data.codingHarness}`;
          } else {
            hbScopeHarness.hidden = true;
          }
        }
      }
    }

    if (!tbody) return;
    tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row').forEach((row) => {
      const id = row.dataset.runId ?? '';
      const isMatch = hasHl && resolved.ids.has(id);
      row.classList.toggle('is-highlighted', isMatch);
      row.classList.toggle('is-dimmed', hasHl && !isMatch);
    });
  }

  function setHighlight(nextValue: string) {
    activeHighlight = activeHighlight === nextValue ? '' : nextValue;
    const resolved = resolveHighlightedRunIds(activeHighlight);
    if (resolved.singleRun) {
      activeInspectedRunId = resolved.singleRun.id;
    }
    updateLeaderboard();
  }

  function updateInspectorFromRun(runId: string, lens: PricingLens) {
    const run = frontierRunById.get(runId);
    if (!run) return;
    activeInspectedRunId = runId;

    const plotModel = buildFrontierPlotModel(frontierRuns, {
      lens,
      mode: activeVfMode,
      includeZeroCostPromos: activeVfIncludePromos,
      highlightedIds: resolveHighlightedRunIds(activeHighlight).ids,
    });
    const pt =
      plotModel.points.find((p) => p.id === runId) ??
      plotModel.hiddenPromoPoints.find((p) => p.id === runId);

    const lensCost =
      lens === 'standard'
        ? run.costMetrics.standardApiCostUsd
        : lens === 'uncached'
          ? run.costMetrics.uncachedCounterfactualCostUsd
          : run.data.costUsd;

    const isPromo = lensCost <= 0;
    const costPerStage =
      !isPromo && run.plan.completed > 0 ? usdFmt.format(lensCost / run.plan.completed) : null;

    if (vfInsBadge) {
      vfInsBadge.className = 'hl vf-inspector-badge';
      if (isPromo) {
        vfInsBadge.classList.add('hl-mint');
        vfInsBadge.textContent = pt?.isFrontier
          ? `$0 Promo · Frontier #${pt.frontierOrder}`
          : '$0 Promo (limited time)';
      } else if (pt?.isFrontier) {
        vfInsBadge.classList.add('hl-acid');
        vfInsBadge.textContent = `Paid Frontier #${pt.frontierOrder}`;
      } else if (run.plan.ratio === 1) {
        vfInsBadge.classList.add('hl-sky');
        vfInsBadge.textContent = `7/7 Full Pass · dominated by ${pt?.dominatedByCount ?? 0}`;
      } else {
        vfInsBadge.classList.add('hl-magenta');
        vfInsBadge.textContent = `${run.plan.completed}/${run.plan.total} Partial`;
      }
    }

    if (vfInsTitle) {
      vfInsTitle.textContent = `${run.displayHarness} / ${run.data.model} (${run.data.effort ?? 'Standard'})`;
    }
    if (vfInsStats) {
      const costSummary = isPromo
        ? '$0.00 (promo)'
        : `${usdFmt.format(lensCost)} (${costPerStage}/stage)`;
      const testsPart = run.data.tests ? ` · ${run.data.tests.passed}/${run.data.tests.total} tests` : '';
      vfInsStats.textContent = `${run.plan.completed}/${run.plan.total} · ${formatDurShort(run.data.durationMinutes)} · ${costSummary} · ${run.data.tokens?.total ?? '—'} tok (${run.tokens.cacheHitRatePct}% cache)${testsPart}`;
    }
    if (vfInsNote) {
      const mStat = groupStats.byModel[run.data.model];
      const hStat = groupStats.byHarness[run.data.codingHarness];
      const notes: string[] = [];
      if (run.costMetrics.profile?.pricingStatusNote) {
        notes.push(run.costMetrics.profile.pricingStatusNote);
      }
      if (mStat && hStat) {
        notes.push(
          `Sample size: model n=${mStat.n} (${mStat.peers.join(', ')}) · harness ${run.displayHarness} n=${hStat.n}${hStat.singlePeerCaveat ? ' (single-model harness — harness & model effects are confounded)' : ` (${hStat.peers.length} models)`}.`
        );
      }
      vfInsNote.textContent = notes.join(' ');
    }
    if (vfInsLink) {
      vfInsLink.href = `/runs/${run.id}`;
    }
    if (vfInsFocusBtn) {
      vfInsFocusBtn.dataset.focusRun = run.id;
      const isFocused = activeHighlight === run.id;
      vfInsFocusBtn.setAttribute('aria-pressed', String(isFocused));
      vfInsFocusBtn.textContent = isFocused ? 'Focused' : 'Focus';
    }
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(
    tag: K,
    attrs: Record<string, string | number> = {},
    text?: string
  ): SVGElementTagNameMap[K] {
    const el = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) {
      el.setAttribute(k, String(v));
    }
    if (text !== undefined) el.textContent = text;
    return el;
  }

  function renderValueFrontierVisuals(lens: PricingLens) {
    if (!vfSvg || frontierRuns.length === 0) return;

    const resolved = resolveHighlightedRunIds(activeHighlight);
    const hlIds = resolved.ids;
    const hasHl = hlIds.size > 0;

    // Sync toolbar pressed states
    vfModeBtns.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.vfMode === activeVfMode));
    });
    vfLensBtns.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.vfLens === lens));
    });
    vfToggleQuadrants?.setAttribute('aria-pressed', String(activeVfShowQuadrants));
    vfTogglePromos?.setAttribute('aria-pressed', String(activeVfIncludePromos));

    const model = buildFrontierPlotModel(frontierRuns, {
      lens,
      mode: activeVfMode,
      includeZeroCostPromos: activeVfIncludePromos,
      highlightedIds: hlIds,
    });

    const gridLayer = vfSvg.querySelector('#vf-layer-grid');
    const quadLayer = vfSvg.querySelector('#vf-layer-quadrants');
    const axesLayer = vfSvg.querySelector('#vf-layer-axes');
    const frontierLayer = vfSvg.querySelector('#vf-layer-frontier');
    const labelsLayer = vfSvg.querySelector('#vf-layer-labels');
    const pointsLayer = vfSvg.querySelector('#vf-layer-points');

    if (gridLayer) {
      gridLayer.replaceChildren();
      if (model.includeZeroCostPromos && model.promoBreakX !== null && model.promoGutterCenter !== null) {
        gridLayer.append(
          svgEl('rect', {
            x: model.padL,
            y: model.padT,
            width: model.promoBreakX - model.padL,
            height: model.height - model.padT - model.padB,
            class: 'vf-promo-gutter-bg',
          }),
          svgEl('line', {
            x1: model.promoBreakX,
            y1: model.padT,
            x2: model.promoBreakX,
            y2: model.height - model.padB,
            class: 'vf-promo-break',
          }),
          svgEl(
            'text',
            {
              x: model.promoGutterCenter,
              y: model.height - model.padB + 16,
              'text-anchor': 'middle',
              class: 'vf-axis-label',
            },
            '$0 promo'
          )
        );
      }

      for (const t of model.yTicks) {
        gridLayer.append(
          svgEl('line', {
            x1: model.paidXStart,
            y1: t.pos,
            x2: model.width - model.padR,
            y2: t.pos,
            class: 'vf-grid-line',
          }),
          svgEl(
            'text',
            {
              x: model.padL - 8,
              y: t.pos + 4,
              'text-anchor': 'end',
              class: 'vf-axis-label',
            },
            t.label
          )
        );
      }

      for (const t of model.xTicks) {
        gridLayer.append(
          svgEl('line', {
            x1: t.pos,
            y1: model.padT,
            x2: t.pos,
            y2: model.height - model.padB,
            class: 'vf-grid-line',
          }),
          svgEl(
            'text',
            {
              x: t.pos,
              y: model.height - model.padB + 16,
              'text-anchor': 'middle',
              class: 'vf-axis-label',
            },
            t.label
          )
        );
      }
    }

    if (quadLayer) {
      quadLayer.replaceChildren();
      if (model.passGateY !== null) {
        quadLayer.append(
          svgEl('line', {
            x1: model.padL,
            y1: model.passGateY,
            x2: model.width - model.padR,
            y2: model.passGateY,
            class: 'vf-pass-gate-line',
          })
        );
      }
      if (activeVfShowQuadrants) {
        if (model.quadrant.xCut !== null) {
          quadLayer.append(
            svgEl('line', {
              x1: model.quadrant.xCut,
              y1: model.padT,
              x2: model.quadrant.xCut,
              y2: model.height - model.padB,
              class: 'vf-threshold-line',
            })
          );
        }
        if (model.quadrant.yCut !== null && model.mode === 'speed-7-of-7') {
          quadLayer.append(
            svgEl('line', {
              x1: model.paidXStart,
              y1: model.quadrant.yCut,
              x2: model.width - model.padR,
              y2: model.quadrant.yCut,
              class: 'vf-threshold-line',
            })
          );
        }
        for (const z of model.quadrant.zones) {
          quadLayer.append(
            svgEl(
              'text',
              {
                x: z.x,
                y: z.y,
                'text-anchor': z.anchor,
                class: 'vf-zone-label',
              },
              z.label
            )
          );
        }
      }
    }

    if (axesLayer) {
      const xTitle = axesLayer.querySelector('#vf-x-axis-title');
      if (xTitle) {
        xTitle.setAttribute(
          'x',
          String((model.paidXStart + model.width - model.padR) / 2)
        );
        xTitle.textContent = `Cost per run (USD, log scale · ${formatLensLabel(lens)})`;
      }
      const yTitle = axesLayer.querySelector('#vf-y-axis-title');
      if (yTitle) {
        yTitle.textContent =
          model.mode === 'speed-7-of-7'
            ? 'Elapsed time (faster ↑)'
            : 'Stages completed (faster ↑ within band)';
      }
    }

    if (frontierLayer) {
      frontierLayer.replaceChildren();
      if (model.frontierStepPath) {
        frontierLayer.append(
          svgEl('path', {
            d: model.frontierStepPath,
            class: 'vf-frontier-path',
            fill: 'none',
          })
        );
      }
    }

    const pointById = new Map<string, FrontierPlotPoint>(model.points.map((p) => [p.id, p]));

    if (labelsLayer) {
      labelsLayer.replaceChildren();
      for (const lbl of model.labels) {
        const pt = pointById.get(lbl.id);
        const isMatch = hasHl && hlIds.has(lbl.id);
        const grp = svgEl('g', {
          class: `vf-label-group${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`,
          'data-label-for': lbl.id,
        });
        if (lbl.needsLeader && pt) {
          grp.append(
            svgEl('line', {
              x1: pt.cx,
              y1: pt.cy,
              x2: lbl.x,
              y2: lbl.y - 3,
              class: 'vf-leader',
            })
          );
        }
        grp.append(
          svgEl(
            'text',
            {
              x: lbl.x,
              y: lbl.y,
              'text-anchor': lbl.anchor,
              class: `vf-node-label${pt?.isFrontier ? ' is-frontier' : ''}`,
            },
            lbl.text
          )
        );
        labelsLayer.append(grp);
      }
    }

    if (pointsLayer) {
      pointsLayer.replaceChildren();
      for (const pt of model.points) {
        const isMatch = hasHl && hlIds.has(pt.id);
        const cls = [
          'vf-point',
          pt.isFrontier ? 'is-frontier' : '',
          !pt.isFullPass ? 'is-partial' : '',
          pt.isZeroCostPromo ? 'is-promo' : '',
          isMatch ? 'is-highlighted' : '',
          hasHl && !isMatch ? 'is-dimmed' : '',
        ]
          .filter(Boolean)
          .join(' ');

        const g = svgEl('g', {
          class: cls,
          role: 'button',
          tabindex: '0',
          'data-vf-run': pt.id,
          'aria-pressed': String(isMatch),
          'aria-label': `${pt.harness} / ${pt.model} (${pt.effort}): ${pt.completed}/${pt.total} stages, ${pt.durationMinutes}m, ${usdFmt.format(pt.lensCostUsd)}${pt.isFrontier ? `, Frontier #${pt.frontierOrder}` : ''}${pt.isOffPeak ? ', Off-Peak 50% discount' : ''}`,
        });

        g.append(svgEl('circle', { cx: pt.cx, cy: pt.cy, r: 14, class: 'vf-hit-target' }));
        if (pt.isZeroCostPromo) {
          g.append(
            svgEl('polygon', {
              points: `${pt.cx},${pt.cy - 7} ${pt.cx + 7},${pt.cy + 5} ${pt.cx - 7},${pt.cy + 5}`,
              class: 'vf-marker-promo',
            })
          );
        } else if (pt.isFrontier) {
          g.append(
            svgEl('rect', {
              x: pt.cx - 6,
              y: pt.cy - 6,
              width: 12,
              height: 12,
              class: 'vf-marker-frontier',
            })
          );
        } else if (!pt.isFullPass) {
          g.append(
            svgEl('polygon', {
              points: `${pt.cx},${pt.cy - 6} ${pt.cx + 6},${pt.cy} ${pt.cx},${pt.cy + 6} ${pt.cx - 6},${pt.cy}`,
              class: 'vf-marker-partial',
            })
          );
        } else {
          g.append(
            svgEl('circle', {
              cx: pt.cx,
              cy: pt.cy,
              r: 5.5,
              class: 'vf-marker-peer',
            })
          );
        }

        pointsLayer.append(g);
      }
    }

    if (vfCaption) {
      const th = model.frontier.thresholds;
      const medCostStr =
        th.medianPaid7of7CostUsd !== null ? formatShortCostTick(th.medianPaid7of7CostUsd) : '—';
      const medDurStr =
        th.medianPaid7of7DurationMinutes !== null
          ? `${Math.round(th.medianPaid7of7DurationMinutes)}m`
          : '—';
      const promoNote = model.includeZeroCostPromos
        ? `${th.promoFullPassCount} $0 promos shown in left gutter`
        : `${th.promoFullPassCount} $0 promos separated from log axis`;
      vfCaption.textContent =
        model.mode === 'speed-7-of-7'
          ? `${th.paidFullPassCount} paid 7/7 runs plotted · ${promoNote} · Median paid 7/7: ${medCostStr} / ${medDurStr} (${formatLensLabel(lens)})`
          : `All ${model.points.length} runs plotted (${th.totalFullPassCount} full 7/7, ${th.partialCount} partial) · ${promoNote} · Median paid 7/7 cost: ${medCostStr} (${formatLensLabel(lens)})`;
    }

    // Update Frontier Ledger
    if (vfFrontierHeading) {
      vfFrontierHeading.textContent = `${activeVfIncludePromos ? 'All 7/7' : 'Paid 7/7'} Frontier (${model.frontier.frontierIds.length} · ${formatLensLabel(lens)})`;
    }
    if (vfFrontierList) {
      vfFrontierList.replaceChildren();
      model.frontier.frontierIds.forEach((fid, idx) => {
        const pt = pointById.get(fid);
        if (!pt) return;
        const isMatch = hasHl && hlIds.has(pt.id);
        const li = document.createElement('li');
        li.className = 'command-row vf-frontier-row';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'vf-frontier-btn';
        btn.dataset.vfRun = pt.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <span class="mono vf-order-tag">F${idx + 1}</span>
          <span class="vf-frontier-name">${pt.harness} / ${pt.model}</span>
          <span class="mono vf-frontier-meta">${formatDurShort(pt.durationMinutes)} · <strong>${usdFmt.format(pt.lensCostUsd)}</strong></span>
        `;
        li.append(btn);
        vfFrontierList.append(li);
      });
    }

    // Update Promo buttons pressed state
    document.querySelectorAll<HTMLButtonElement>('.vf-promo-btn').forEach((btn) => {
      const rid = btn.dataset.vfRun ?? '';
      btn.setAttribute('aria-pressed', String(hasHl && hlIds.has(rid)));
    });

    // Update Paired Execution vs. Cost Efficiency Bars
    const bars = computePairedValueBars(frontierRuns, lens);
    if (vfPairedLensPill) {
      vfPairedLensPill.textContent = `Lens: ${formatLensLabel(lens)}`;
    }
    if (vfExecBars) {
      vfExecBars.replaceChildren();
      bars.executionRows.forEach((item, idx) => {
        const prev = idx > 0 ? bars.executionRows[idx - 1] : null;
        if (prev && prev.isFullPass && !item.isFullPass) {
          const div = document.createElement('div');
          div.className = 'mono vf-bar-divider';
          div.setAttribute('role', 'separator');
          div.textContent = '7/7 pass gate — partial runs below';
          vfExecBars.append(div);
        }
        const isMatch = hasHl && hlIds.has(item.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${!item.isFullPass ? ' is-partial' : ''}${item.isPaidFrontier ? ' is-frontier' : ''}${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="mono vf-bar-rank">#${item.executionRank}</span>
            <span class="vf-bar-label">
              ${item.harness} / ${item.model}
              ${item.isOffPeak ? '<span class="mono vf-tag-offpeak">off-peak</span>' : ''}
              ${item.isZeroCostPromo ? '<span class="mono vf-tag-promo">$0 promo</span>' : ''}
            </span>
            <span class="mono vf-bar-val">${item.completed}/${item.total} · ${formatDurShort(item.durationMinutes)}</span>
          </div>
          <div class="vf-bar-track" aria-hidden="true">
            <span class="vf-bar-fill ${item.isPaidFrontier ? 'is-frontier' : item.isFullPass ? 'is-pass' : 'is-partial'}" style="inline-size: ${item.executionBarPct}%"></span>
          </div>
        `;
        vfExecBars.append(btn);
      });
    }

    if (vfValueBars) {
      vfValueBars.replaceChildren();
      bars.paidValueRows.forEach((item, idx) => {
        const prev = idx > 0 ? bars.paidValueRows[idx - 1] : null;
        if (prev && prev.isFullPass && !item.isFullPass) {
          const div = document.createElement('div');
          div.className = 'mono vf-bar-divider';
          div.setAttribute('role', 'separator');
          div.textContent = 'Partial paid runs (<7/7)';
          vfValueBars.append(div);
        }
        const isMatch = hasHl && hlIds.has(item.id);
        const deltaLabel =
          item.rankDelta !== null && item.rankDelta !== 0
            ? item.rankDelta > 0
              ? `↑+${item.rankDelta}`
              : `↓${item.rankDelta}`
            : '—';
        const deltaClass =
          (item.rankDelta ?? 0) > 0 ? ' is-up' : (item.rankDelta ?? 0) < 0 ? ' is-down' : '';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `vf-bar-row${!item.isFullPass ? ' is-partial' : ''}${item.isPaidFrontier ? ' is-frontier' : ''}${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
        btn.dataset.barRun = item.id;
        btn.setAttribute('aria-pressed', String(isMatch));
        btn.innerHTML = `
          <div class="vf-bar-meta">
            <span class="mono vf-bar-rank">#${item.valueRank}</span>
            <span class="vf-bar-label">
              ${item.harness} / ${item.model}
              ${item.isOffPeak ? '<span class="mono vf-tag-offpeak">off-peak</span>' : ''}
            </span>
            <span class="mono vf-bar-val">
              ${usdFmt.format(item.lensCostUsd)}
              <span class="vf-bar-subval"> (${usdFmt.format(item.costPerCompletedStageUsd ?? 0)}/stg)</span>
              <span class="vf-delta${deltaClass}">${deltaLabel}</span>
            </span>
          </div>
          <div class="vf-bar-track" aria-hidden="true">
            <span class="vf-bar-fill ${item.isPaidFrontier ? 'is-frontier' : item.isFullPass ? 'is-value' : 'is-partial'}" style="inline-size: ${item.valueBarPct ?? 14}%"></span>
          </div>
        `;
        vfValueBars.append(btn);
      });

      if (bars.promoRows.length > 0) {
        const promoWrap = document.createElement('div');
        promoWrap.className = 'vf-promo-bar-group';
        const div = document.createElement('div');
        div.className = 'mono vf-bar-divider';
        div.textContent = '$0 limited-time promos (not ranked on paid $/stage)';
        promoWrap.append(div);
        for (const item of bars.promoRows) {
          const isMatch = hasHl && hlIds.has(item.id);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `vf-bar-row is-promo${isMatch ? ' is-highlighted' : hasHl ? ' is-dimmed' : ''}`;
          btn.dataset.barRun = item.id;
          btn.setAttribute('aria-pressed', String(isMatch));
          btn.innerHTML = `
            <div class="vf-bar-meta">
              <span class="mono vf-bar-rank">$0</span>
              <span class="vf-bar-label">
                ${item.harness} / ${item.model}
                <span class="mono vf-tag-promo">free (limited time)</span>
              </span>
              <span class="mono vf-bar-val">${item.completed}/${item.total} · ${formatDurShort(item.durationMinutes)} · $0.00</span>
            </div>
          `;
          promoWrap.append(btn);
        }
        vfValueBars.append(promoWrap);
      }
    }

    // Keep inspector synced with active inspected run or first frontier run
    const defaultId =
      (activeInspectedRunId && frontierRunById.has(activeInspectedRunId)
        ? activeInspectedRunId
        : null) ??
      model.frontier.frontierIds[0] ??
      model.points[0]?.id;
    if (defaultId) {
      updateInspectorFromRun(defaultId, lens);
    }
  }

  // Toolbar controls
  vfModeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextMode = btn.dataset.vfMode as FrontierViewMode | undefined;
      if (!nextMode || nextMode === activeVfMode) return;
      activeVfMode = nextMode;
      renderValueFrontierVisuals((pricingLensSelect?.value ?? 'billed') as PricingLens);
    });
  });

  vfLensBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextLens = btn.dataset.vfLens as PricingLens | undefined;
      if (!nextLens) return;
      if (pricingLensSelect && pricingLensSelect.value !== nextLens) {
        pricingLensSelect.value = nextLens;
      }
      updateLeaderboard();
    });
  });

  vfToggleQuadrants?.addEventListener('click', () => {
    activeVfShowQuadrants = !activeVfShowQuadrants;
    renderValueFrontierVisuals((pricingLensSelect?.value ?? 'billed') as PricingLens);
  });

  vfTogglePromos?.addEventListener('click', () => {
    activeVfIncludePromos = !activeVfIncludePromos;
    renderValueFrontierVisuals((pricingLensSelect?.value ?? 'billed') as PricingLens);
  });

  // Focusgroup roving-tabindex fallback for browsers without native focusgroup
  const vfToolbar = document.querySelector<HTMLElement>('.vf-toolbar[role="toolbar"]');
  if (vfToolbar && !('focusGroup' in HTMLElement.prototype)) {
    const items = Array.from(vfToolbar.querySelectorAll<HTMLButtonElement>('button'));
    items.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
    });
    vfToolbar.addEventListener('focusin', (e) => {
      const target = e.target as HTMLButtonElement | null;
      if (target && items.includes(target)) {
        items.forEach((b) => {
          b.tabIndex = b === target ? 0 : -1;
        });
      }
    });
    vfToolbar.addEventListener('keydown', (e) => {
      const current = document.activeElement as HTMLButtonElement | null;
      const idx = current ? items.indexOf(current) : -1;
      if (idx === -1) return;
      const rtl = getComputedStyle(vfToolbar).direction === 'rtl';
      let nextIdx: number | null = null;
      if (e.key === 'ArrowRight') nextIdx = (idx + (rtl ? -1 : 1) + items.length) % items.length;
      else if (e.key === 'ArrowLeft') nextIdx = (idx + (rtl ? 1 : -1) + items.length) % items.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = items.length - 1;
      if (nextIdx !== null) {
        e.preventDefault();
        items[nextIdx].focus();
      }
    });
  }

  // Delegated pointer + keyboard interaction for SVG points, frontier rows, promo rows, and paired bars
  const paretoPanel = document.getElementById('pareto-section');
  paretoPanel?.addEventListener('mouseover', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) {
      updateInspectorFromRun(runId, (pricingLensSelect?.value ?? 'billed') as PricingLens);
    }
  });

  paretoPanel?.addEventListener('focusin', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) {
      updateInspectorFromRun(runId, (pricingLensSelect?.value ?? 'billed') as PricingLens);
    }
  });

  paretoPanel?.addEventListener('click', (e) => {
    const target = (e.target as Element | null)?.closest<HTMLElement | SVGElement>(
      '[data-vf-run], [data-bar-run]'
    );
    const runId = target?.getAttribute('data-vf-run') ?? target?.getAttribute('data-bar-run');
    if (runId) {
      setHighlight(runId);
    }
  });

  // Custom role="button" SVG points: Enter on keydown, Space on keyup (per WCAG/accessibility guide)
  vfSvg?.addEventListener('keydown', (e) => {
    const pt = (e.target as Element | null)?.closest<SVGElement>('.vf-point[data-vf-run]');
    if (!pt) return;
    const runId = pt.getAttribute('data-vf-run');
    if (!runId) return;
    if (e.key === 'Enter') {
      e.preventDefault();
      setHighlight(runId);
    } else if (e.key === ' ') {
      e.preventDefault();
    }
  });
  vfSvg?.addEventListener('keyup', (e) => {
    if (e.key !== ' ') return;
    const pt = (e.target as Element | null)?.closest<SVGElement>('.vf-point[data-vf-run]');
    const runId = pt?.getAttribute('data-vf-run');
    if (runId) {
      e.preventDefault();
      setHighlight(runId);
    }
  });

  vfInsFocusBtn?.addEventListener('click', () => {
    const runId = vfInsFocusBtn.dataset.focusRun;
    if (runId) setHighlight(runId);
  });

  hbScopeModel?.addEventListener('click', () => {
    const target = hbScopeModel.dataset.targetHighlight;
    if (target) {
      activeHighlight = target;
      updateLeaderboard();
    }
  });
  hbScopeHarness?.addEventListener('click', () => {
    const target = hbScopeHarness.dataset.targetHighlight;
    if (target) {
      activeHighlight = target;
      updateLeaderboard();
    }
  });
  hbClearBtn?.addEventListener('click', () => {
    activeHighlight = '';
    updateLeaderboard();
  });

  function updateDetailVisibility() {
    const expanded = Boolean(showTelemetry?.checked);
    table?.classList.toggle('show-telemetry', expanded);
  }

  hydrateFromUrlState();
  updateDetailVisibility();
  applyLeaderboardUpdate();

  showTelemetry?.addEventListener('change', () => {
    updateDetailVisibility();
    updateLeaderboard();
  });

  searchInput?.addEventListener('input', updateLeaderboard);
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      if (searchInput.value) {
        searchInput.value = '';
        updateLeaderboard();
      }
      searchInput.blur();
    }
  });
  harnessFilter?.addEventListener('change', updateLeaderboard);
  providerFilter?.addEventListener('change', updateLeaderboard);
  pricingLensSelect?.addEventListener('change', updateLeaderboard);
  sortSelect?.addEventListener('change', () => {
    setSortDirButtonState(defaultSortDirs[sortSelect.value] ?? 'desc');
    updateLeaderboard();
  });
  sortDirBtn?.addEventListener('click', () => {
    setSortDirButtonState(sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc');
    updateLeaderboard();
  });
  resetFiltersBtn?.addEventListener('click', resetAllControls);
  emptyResetBtn?.addEventListener('click', resetAllControls);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && activeHighlight) {
      const active = document.activeElement;
      if (active === searchInput && searchInput?.value) return;
      activeHighlight = '';
      updateLeaderboard();
      return;
    }
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const active = document.activeElement;
    if (
      active &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.tagName === 'SELECT' ||
        (active as HTMLElement).isContentEditable)
    ) {
      return;
    }
    e.preventDefault();
    searchInput?.focus();
    searchInput?.select();
  });

  sortableHeaders.forEach((th) => {
    const btn = th.querySelector<HTMLButtonElement>('.sort-header-btn');
    (btn ?? th).addEventListener('click', () => {
      const col = th.dataset.sortCol;
      if (!col || !sortSelect || !sortDirBtn) return;

      if (sortSelect.value === col) {
        const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
        setSortDirButtonState(nextDir);
      } else {
        sortSelect.value = col;
        const defaultDir = defaultSortDirs[col] ?? 'desc';
        setSortDirButtonState(defaultDir);
      }
      updateLeaderboard();
    });
  });

  // Delegated click handler for Peek and + Diff buttons inside table
  tbody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const peekBtn = target.closest<HTMLElement>('[data-peek-toggle]');
    if (peekBtn) {
      e.stopPropagation();
      const runId = peekBtn.dataset.peekToggle;
      if (runId) toggleForensicDrawer(runId);
      return;
    }
    const pinBtn = target.closest<HTMLButtonElement>('[data-pin-run]');
    if (pinBtn) {
      e.stopPropagation();
      const runId = pinBtn.dataset.pinRun;
      if (!runId) return;
      const existingIdx = pinnedRunIds.indexOf(runId);
      if (existingIdx !== -1) {
        pinnedRunIds.splice(existingIdx, 1);
      } else {
        if (pinnedRunIds.length >= 2) pinnedRunIds.shift();
        pinnedRunIds.push(runId);
      }
      renderQuickCompareDock();
      return;
    }
  });

  // Row click toggles cross-highlight across table, scatter plot, and value bars
  document.querySelectorAll<HTMLTableRowElement>('tr.run-row').forEach((row) => {
    row.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button, input, label')) return;
      const selection = window.getSelection();
      if (selection && selection.toString().trim().length > 0) return;

      const runId = row.dataset.runId;
      if (!runId) return;

      if (e.metaKey || e.ctrlKey) {
        const href = row.dataset.href;
        if (href) window.open(href, '_blank', 'noopener');
        return;
      }
      setHighlight(runId);
    });
  });
</script>
