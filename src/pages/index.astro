---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	formatDuration,
	formatCost,
	formatTimestamp,
	formatCompactContextWindow,
	formatHarnessName,
	formatProviderName,
} from "../utils/format";
import {
	analyzeAndRankRuns,
	computeGroupSampleStats,
	computePairedValueBars,
	computeStageBottleneckMatrix,
	discoverAblationPresets,
	type AnalyzedRun,
} from "../utils/telemetry";
import { buildFrontierPlotModel, formatShortCostTick } from "../utils/frontier-chart";
import { BENCHMARK_STAGES } from "../data/benchmark";

const stageTitleMap = new Map(BENCHMARK_STAGES.map((s) => [s.id, s.title]));
const allRuns = await getCollection(
	"runs",
	({ data }) => data.published !== false,
);

const analyzedRuns = analyzeAndRankRuns(
	allRuns.map((entry) => ({ id: entry.id, data: entry.data })),
);
const stageMatrix = computeStageBottleneckMatrix(analyzedRuns);
const ablationPresets = discoverAblationPresets(analyzedRuns).slice(0, 3);

const enrichedRuns = analyzedRuns.map((run) => {
	const d = run.data;
	const compactContext = formatCompactContextWindow(d.contextWindow);
	const toolsPerTurn =
		run.llmCalls > 0 && run.toolTotalCalls > 0
			? (run.toolTotalCalls / run.llmCalls).toFixed(2)
			: null;
	const secPerTurn =
		run.llmCalls > 0 && d.durationMinutes > 0
			? ((d.durationMinutes * 60) / run.llmCalls).toFixed(1)
			: null;
	const testsRatio =
		d.tests && d.tests.total > 0 ? d.tests.passed / d.tests.total : -1;
	const testsPassed = d.tests?.passed ?? -1;
	const timeMs = new Date(d.timestamp).getTime() || 0;

	return {
		id: run.id,
		data: d,
		telemetry: run,
		plan: run.plan,
		inputTokens: run.tokens.uncachedInput,
		cachedTokens: run.tokens.cachedInput,
		outputTokens: run.tokens.output,
		totalTokens: run.tokens.total,
		compactContext,
		toolsPerTurn,
		secPerTurn,
		testsRatio,
		testsPassed,
		timeMs,
		leadNotes: [
			...(d.notes ?? []),
			...(d.notesDetails ?? []).flatMap((n) => n.bullets ?? []),
		]
			.slice(0, 2)
			.map((b) => (b.length > 220 ? `${b.slice(0, 217)}...` : b)),
		shortDate: new Date(d.timestamp).toLocaleDateString("en-US", {
			month: "short",
			day: "numeric",
			timeZone: "UTC",
		}),
		peakCtxCompact: run.context.peakTokens
			? `${Math.round(run.context.peakTokens / 1000)}k peak`
			: compactContext,
	};
});

const harnesses = [
	...new Set(enrichedRuns.map((r) => r.data.codingHarness)),
].sort((a, b) =>
	formatHarnessName(a).localeCompare(formatHarnessName(b), undefined, {
		sensitivity: "base",
	}),
);
const providers = [...new Set(enrichedRuns.map((r) => r.data.provider))].sort(
	(a, b) =>
		formatProviderName(a).localeCompare(formatProviderName(b), undefined, {
			sensitivity: "base",
		}),
);

const fullPassRuns = enrichedRuns.filter((r) => r.plan.ratio === 1);
const fullPassCount = fullPassRuns.length;

const initialPlotModel = buildFrontierPlotModel(analyzedRuns, {
	lens: "billed",
	mode: "speed-7-of-7",
	includeZeroCostPromos: false,
});
const initialPairedBars = computePairedValueBars(analyzedRuns, "billed");
const groupSampleStats = computeGroupSampleStats(analyzedRuns);

// Compact client payload for live lens/mode/promo/highlight recomputation via the exact same pure functions
const clientAnalyzedRunsPayload = analyzedRuns.map((r: AnalyzedRun) => ({
	id: r.id,
	data: {
		timestamp: r.data.timestamp,
		codingHarness: r.data.codingHarness,
		model: r.data.model,
		effort: r.data.effort,
		provider: r.data.provider,
		durationMinutes: r.data.durationMinutes,
		costUsd: r.data.costUsd,
		tests: r.data.tests ? { passed: r.data.tests.passed, total: r.data.tests.total } : undefined,
		planCompletion: r.data.planCompletion,
		tokens: r.data.tokens ? { total: r.data.tokens.total, cacheHitRate: r.data.tokens.cacheHitRate } : undefined,
	},
	displayHarness: r.displayHarness,
	displayProvider: r.displayProvider,
	plan: r.plan,
	tokens: r.tokens,
	costMetrics: {
		billedCostUsd: r.costMetrics.billedCostUsd,
		standardApiCostUsd: r.costMetrics.standardApiCostUsd,
		uncachedCounterfactualCostUsd: r.costMetrics.uncachedCounterfactualCostUsd,
		cacheSavingsUsd: r.costMetrics.cacheSavingsUsd,
		cacheSavingsPct: r.costMetrics.cacheSavingsPct,
		comparisonCostUsd: r.costMetrics.comparisonCostUsd,
		comparisonLabel: r.costMetrics.comparisonLabel,
		profile: r.costMetrics.profile
			? {
					pricingBadge: r.costMetrics.profile.pricingBadge,
					pricingStatusNote: r.costMetrics.profile.pricingStatusNote,
				}
			: null,
	},
}));
---

<BaseLayout title="Personal Coding-Agent Field Notes" activeNav="leaderboard">
  <div class="leaderboard-quiet">
    <header class="reading-intro">
      <div class="reading-intro-copy">
        <h1 id="hero-heading" class="headline-two-tone">
          Same task.<br />
          <span class="muted">Different journeys.</span>
        </h1>
        <p class="reading-intro-description">
          My personal evaluation of how coding agents build an Elixir/OTP CLI.
          Start with the results. Follow the details that interest you.
        </p>
        <p class="reading-intro-context">
          {enrichedRuns.length} published runs <span aria-hidden="true">·</span> Seven stages
          <a href="/about#evaluation-scope">Why the stack matters</a>
        </p>
      </div>
      {fullPassCount > 1 && (
        <aside class="reading-invitation" aria-label="A question to explore">
          <a href="/compare?preset=pareto-cost-vs-speed">
            Does faster always cost more?
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
          </a>
          <p>Compare two complete runs. See what happens along the way.</p>
        </aside>
      )}
    </header>

    <section class="run-ledger" aria-labelledby="runs-heading">
      <div class="ledger-heading-row">
        <h2 id="runs-heading">The runs</h2>
        <span id="visible-count-badge" class="controls-result-count">{enrichedRuns.length} runs</span>
      </div>
      <search class="reading-controls" aria-label="Filter and sort benchmark runs">
        <div class="reading-toolbar">
          <div class="scenario-pills-group" role="group" aria-label="Run outcomes">
            <button type="button" class="scenario-pill is-active" data-scenario="all" aria-pressed="true">
              All runs
            </button>
            <button type="button" class="scenario-pill" data-scenario="full-pass" aria-pressed="false">
              Completed all stages
            </button>
          </div>
          <div class="toolbar-search">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" />
              <path d="m13 13 4 4" />
            </svg>
            <input
              id="search-input"
              name="q"
              type="search"
              class="input"
              placeholder="Find a model or harness"
              aria-label="Filter runs by harness, model, provider, or effort"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            />
          </div>
          <button id="reset-filters-btn" type="button" class="btn btn-sm btn-secondary" hidden>
            Reset
          </button>
        </div>

        <details class="reading-disclosure run-options" id="run-options">
          <summary>Filter &amp; sort</summary>
          <div class="disclosure-body options-grid">
            <label class="option-field">
              Harness
              <select id="harness-filter" name="harness" class="select">
                <option value="all">All harnesses</option>
                {harnesses.map((h) => <option value={h}>{formatHarnessName(h)}</option>)}
              </select>
            </label>
            <label class="option-field">
              Provider
              <select id="provider-filter" name="provider" class="select">
                <option value="all">All providers</option>
                {providers.map((p) => <option value={p}>{formatProviderName(p)}</option>)}
              </select>
            </label>
            <label class="option-field">
              Sort by
              <select id="sort-select" name="sort" class="select">
                <option value="plan" selected>Completion, then time</option>
                <option value="duration">Time elapsed</option>
                <option value="turns">Turns (LLM calls)</option>
                <option value="cost">Cost in selected lens</option>
                <option value="tokens">Total tokens</option>
                <option value="tests">Agent tests passed</option>
                <option value="timestamp">Run date</option>
              </select>
            </label>
            <div class="option-field">
              <span>Sort direction</span>
              <button id="sort-dir-btn" type="button" class="btn btn-secondary" data-dir="desc" aria-label="Sort descending; activate to sort ascending">
                Descending
              </button>
            </div>
            <label class="option-field">
              Cost lens
              <select id="pricing-lens-select" name="lens" class="select">
                <option value="billed" selected>Actually billed</option>
                <option value="standard">Standard API rate</option>
                <option value="uncached">Without prompt caching</option>
              </select>
            </label>
            <label class="option-check">
              <input id="show-telemetry" name="telemetry" type="checkbox" />
              Show extra row notes (pace, tools, cache, commits)
            </label>
            <div class="option-scenarios" role="group" aria-label="Explore a subset of runs">
              <span>Look for</span>
              <button type="button" class="scenario-pill" data-scenario="pareto" aria-pressed="false">Speed &amp; cost tradeoffs</button>
              <button type="button" class="scenario-pill" data-scenario="under-1" aria-pressed="false">Runs under $1</button>
              <button type="button" class="scenario-pill" data-scenario="spec-miss" aria-pressed="false">Incomplete runs</button>
            </div>
          </div>
        </details>
        <div id="leaderboard-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
      </search>
      <p id="default-sort-note" class="controls-result-count">
        Default: most stages completed, then shortest time. Click any row to focus it across the table and frontier charts.
      </p>

      <div id="highlight-banner" class="highlight-banner" role="region" aria-label="Focused run highlight" hidden>
        <div class="highlight-banner-main">
          <span class="hl hl-acid">Focused</span>
          <strong id="hb-title" class="highlight-banner-title"></strong>
          <span id="hb-caveat" class="mono highlight-banner-caveat"></span>
        </div>
        <div class="highlight-banner-actions">
          <button type="button" id="hb-scope-model" class="btn btn-sm btn-secondary" hidden></button>
          <button type="button" id="hb-scope-harness" class="btn btn-sm btn-secondary" hidden></button>
          <a id="hb-dossier-link" href="/" class="btn btn-sm btn-secondary" hidden>Read dossier →</a>
          <button type="button" id="hb-clear-btn" class="btn btn-sm btn-secondary">Clear (Esc)</button>
        </div>
      </div>

      <div class="reading-table-ledger">
      <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="leaderboard-caption">
        <table class="app-table leaderboard-table readable-run-table" id="leaderboard-table">
          <caption id="leaderboard-caption" class="visually-hidden">
            Capy Bench evaluation runs showing stage completion, agent tests, elapsed time,
            LLM turns, exact token usage, and API cost. Default order: most stages completed,
            then shortest elapsed time.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="col-rank">#</th>
              <th scope="col">Model &amp; harness</th>
              <th scope="col" class="sortable active-sort" data-sort-col="plan" aria-sort="descending">
                <button
                  type="button"
                  class="sort-header-btn"
                  aria-describedby="default-sort-note"
                  title="Sort by S1–S7 holdout completion, then shortest elapsed time"
                >
                  <span>Outcome</span>
                  <span class="sort-indicator" aria-hidden="true">↓</span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="tests">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by agent-authored ExUnit test suite pass ratio"
                >
                  <span>Agent tests</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="duration">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by active wall-clock run duration"
                >
                  <span>Time</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="turns">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by total agentic LLM turns"
                >
                  <span>Turns</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="tokens">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by exact total token volume"
                >
                  <span>Tokens</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="sortable" data-sort-col="cost">
                <button
                  type="button"
                  class="sort-header-btn"
                  title="Sort by cost in USD under the active pricing lens"
                >
                  <span id="cost-col-header-label">Cost</span>
                  <span class="sort-indicator" aria-hidden="true"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody id="leaderboard-tbody">
            {
              enrichedRuns.map((run, index) => {
                const { data, plan, telemetry } = run;
                const rank = index + 1;
                const hasTokens =
                  data.tokens && (data.tokens.input || data.tokens.output || data.tokens.cacheHitRate);
                const incompleteStages = plan.entries
                  .filter(([, done]) => !done)
                  .map(([stageId]) => stageId);

                const displayHarness = telemetry.displayHarness;
                const displayProvider = telemetry.displayProvider;
                const billedCost = data.costUsd;
                const standardCost = telemetry.costMetrics.standardApiCostUsd;
                const uncachedCost = telemetry.costMetrics.uncachedCounterfactualCostUsd;
                const cacheSavings = telemetry.costMetrics.cacheSavingsUsd;

                const maxRowStageCost = Math.max(
                  0.01,
                  ...BENCHMARK_STAGES.map(
                    (st) => telemetry.stages[st.id as keyof typeof telemetry.stages]?.costUsd ?? 0
                  )
                );
                const hasPerSlice = BENCHMARK_STAGES.some(
                  (st) => (telemetry.stages[st.id as keyof typeof telemetry.stages]?.llmCalls ?? 0) > 0
                );

                return (
                  <>
                    <tr
                      class="run-row"
                      data-run-id={run.id}
                      data-run-label={`${displayHarness} / ${data.model}`}
                      data-href={`/runs/${run.id}`}
                      data-harness={data.codingHarness}
                      data-harness-label={displayHarness}
                      data-model={data.model}
                      data-provider={data.provider}
                      data-search={`${data.codingHarness} ${displayHarness} ${data.model} ${data.provider} ${displayProvider} ${data.effort ?? ''} ${telemetry.isParetoFrontier ? 'pareto frontier' : ''}`.toLowerCase()}
                      data-plan={plan.ratio}
                      data-plan-str={`${plan.completed}/${plan.total}`}
                      data-pareto={telemetry.isParetoFrontier ? '1' : '0'}
                      data-duration={data.durationMinutes}
                      data-duration-str={formatDuration(data.durationMinutes)}
                      data-cost={billedCost}
                      data-cost-str={formatCost(billedCost)}
                      data-cost-billed={billedCost}
                      data-cost-standard={standardCost}
                      data-cost-uncached={uncachedCost}
                      data-cache-savings={cacheSavings}
                      data-pricing-badge={telemetry.costMetrics.profile?.pricingBadge ?? 'free tier'}
                      data-turns={telemetry.llmCalls}
                      data-turns-str={telemetry.llmCalls > 0 ? String(telemetry.llmCalls) : '—'}
                      data-tokens={run.totalTokens}
                      data-tokens-str={data.tokens?.total ?? '—'}
                      data-tests={run.testsRatio}
                      data-tests-passed={run.testsPassed}
                      data-timestamp={run.timeMs}
                    >
                      <td data-cell="Rank">
                        <span
                          class:list={[
                            'rank-badge',
                            { 'rank-1': rank === 1, 'rank-2': rank === 2, 'rank-3': rank === 3 },
                          ]}
                        >
                          #{rank}
                        </span>
                      </td>

                      <th scope="row" data-cell="Model & harness">
                        <div class="cell-stack">
                          <div class="entry-title-row">
                            <a href={`/runs/${run.id}`} class="entry-title-link">
                              <span class="entry-model">{data.model}</span>
                            </a>
                            {plan.ratio === 1 && (
                              <span
                                class="pareto-inline-badge extra-detail"
                                hidden={!telemetry.isParetoFrontier}
                                title={
                                  telemetry.isParetoFrontier
                                    ? `Pareto Frontier #${telemetry.paretoOrder}: non-dominated on 7/7 speed (${formatDuration(data.durationMinutes)}) and cost (${formatCost(billedCost)})`
                                    : ''
                                }
                              >
                                Speed &amp; cost frontier
                              </span>
                            )}
                          </div>
                          <div class="entry-meta">
                            <span class="entry-meta-harness">{displayHarness}</span>
                            <span class="entry-meta-sep extra-detail" aria-hidden="true">·</span>
                            <span class="extra-detail">{displayProvider}</span>
                            {data.effort && (
                              <>
                                <span class="entry-meta-sep" aria-hidden="true">·</span>
                                <span>{data.effort}</span>
                              </>
                            )}
                            <span class="entry-meta-sep extra-detail" aria-hidden="true">·</span>
                            <time
                              datetime={data.timestamp}
                              title={formatTimestamp(data.timestamp)}
                              class="metric-sub metric-inline entry-timestamp extra-detail"
                            >
                              {run.shortDate}
                            </time>
                          </div>
                        </div>
                      </th>

                      <td data-cell="Outcome">
                        <button
                          type="button"
                          class="outcome-button"
                          data-peek-toggle={run.id}
                          aria-expanded="false"
                          aria-controls={`drawer-${run.id}`}
                          aria-label={`Explore ${displayHarness} / ${data.model}: ${plan.completed} of ${plan.total} stages passed${incompleteStages.length ? `; missed ${incompleteStages.join(', ')}` : ''}`}
                        >
                          <span class="metric-primary">{plan.completed}/{plan.total}</span>
                          <span>stages</span>
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="m5 6 3 3 3-3" />
                          </svg>
                        </button>
                      </td>

                      <td data-cell="Agent tests">
                        <div class="cell-stack">
                          {data.tests ? (
                            <div
                              class="metric-primary"
                              title="Agent-authored ExUnit test suite results"
                            >
                              {data.tests.passed}/{data.tests.total}
                            </div>
                          ) : (
                            <div class="metric-empty">—</div>
                          )}
                          <div class="metric-sub extra-detail">
                            {data.commits !== undefined ? `${data.commits} commits` : ''}
                            {telemetry.toolSuccessRatePct !== null && (
                              <>
                                {data.commits !== undefined && <span aria-hidden="true"> · </span>}
                                <span title={`${telemetry.toolErrorCalls} tool errors out of ${telemetry.toolTotalCalls} tool calls`}>
                                  {Math.round(telemetry.toolSuccessRatePct)}% ok
                                </span>
                              </>
                            )}
                          </div>
                        </div>
                      </td>

                      <td data-cell="Time">
                        <div class="cell-stack">
                          <div class="metric-primary">{formatDuration(data.durationMinutes)}</div>
                          {run.secPerTurn && (
                            <div
                              class="metric-sub extra-detail"
                              title={`Average wall-clock pace across ${telemetry.llmCalls} LLM turns`}
                            >
                              {run.secPerTurn}s/turn
                            </div>
                          )}
                        </div>
                      </td>

                      <td data-cell="Turns">
                        {telemetry.llmCalls > 0 ? (
                          <div class="cell-stack">
                            <div
                              class="metric-primary"
                              title={`${telemetry.llmCalls} LLM turns · ${telemetry.toolTotalCalls} tool calls`}
                            >
                              {telemetry.llmCalls}
                            </div>
                            {telemetry.toolTotalCalls > 0 && (
                              <div
                                class="metric-sub extra-detail"
                                title={`${telemetry.toolTotalCalls} tool calls across ${telemetry.llmCalls} LLM turns (${run.toolsPerTurn} tool calls per turn)`}
                              >
                                {telemetry.toolTotalCalls} tools
                                {run.toolsPerTurn && (
                                  <>
                                    <span aria-hidden="true"> · </span>
                                    <span>{run.toolsPerTurn}×</span>
                                  </>
                                )}
                              </div>
                            )}
                          </div>
                        ) : (
                          <span class="metric-empty">—</span>
                        )}
                      </td>

                      <td data-cell="Tokens">
                        {hasTokens ? (
                          <div class="cell-stack">
                            <div
                              class="metric-primary"
                              title={`Exact tokens: ${telemetry.tokens.total.toLocaleString('en-US')} total`}
                            >
                              {data.tokens?.total ?? '—'}
                            </div>
                            <div class="metric-sub extra-detail">
                              {data.tokens?.cacheHitRate && <span>{data.tokens.cacheHitRate} hit</span>}
                              {run.peakCtxCompact && (
                                <>
                                  {Boolean(data.tokens?.cacheHitRate) && <span aria-hidden="true"> · </span>}
                                  <span title={data.contextWindow}>{run.peakCtxCompact}</span>
                                </>
                              )}
                            </div>
                          </div>
                        ) : (
                          <span class="metric-empty">—</span>
                        )}
                      </td>

                      <td data-cell="Cost">
                        <div class="cell-stack">
                          <div class="cost-cell-head">
                            <span class="metric-primary cost-mono cost-primary-display">
                              {formatCost(billedCost)}
                            </span>
                          </div>
                          <div
                            class="metric-sub cost-sub-display extra-detail"
                            title={telemetry.costMetrics.profile?.pricingStatusNote}
                          >
                            {cacheSavings > 0
                              ? `-${formatCost(cacheSavings)} saved`
                              : standardCost > billedCost
                                ? `${formatCost(standardCost)} API equiv.`
                                : (telemetry.costMetrics.profile?.pricingBadge ?? 'free tier')}
                          </div>
                        </div>
                      </td>

                    </tr>

                    <tr
                      class="forensic-drawer-row"
                      id={`drawer-${run.id}`}
                      data-drawer-for={run.id}
                      hidden
                    >
                      <td colspan="8" class="forensic-drawer-cell">
                        <div class="forensic-drawer-inner">
                          <div class="forensic-stages-col">
                            <div class="forensic-col-head">
                              <span class="forensic-col-title">
                                The seven stages
                              </span>
                              <span class="mono forensic-col-meta">
                                {hasPerSlice
                                  ? `Peak: ${telemetry.peakStageId ?? '—'} · ${telemetry.llmCalls} turns (${formatCost(billedCost)})`
                                  : `Full run: ${telemetry.llmCalls} turns (${formatCost(billedCost)})`}
                              </span>
                            </div>
                            <div class="forensic-stage-grid">
                              {BENCHMARK_STAGES.map((st) => {
                                const sCell = telemetry.stages[st.id as keyof typeof telemetry.stages];
                                const barW = Math.min(100, ((sCell?.costUsd ?? 0) / maxRowStageCost) * 100).toFixed(0);
                                return (
                                  <div
                                    class:list={[
                                      'forensic-stage-card',
                                      {
                                        'is-peak': sCell?.isPeakCost,
                                        'is-miss': !sCell?.completed,
                                      },
                                    ]}
                                  >
                                    <div class="forensic-stage-top">
                                      <span class="mono forensic-stage-id">{st.id}</span>
                                      {!sCell?.completed && (
                                        <span class="forensic-stage-status is-miss">Missed</span>
                                      )}
                                    </div>
                                    <div class="mono forensic-stage-cost">
                                      {sCell && sCell.llmCalls > 0 ? formatCost(sCell.costUsd) : '—'}
                                    </div>
                                    <div class="mono forensic-stage-turns">
                                      {sCell && sCell.llmCalls > 0 ? `${sCell.llmCalls}t` : st.title}
                                    </div>
                                    {hasPerSlice && (
                                      <div class="forensic-stage-bar-track" aria-hidden="true">
                                        <span
                                          class="forensic-stage-bar-fill"
                                          style={`inline-size: ${barW}%`}
                                        />
                                      </div>
                                    )}
                                  </div>
                                );
                              })}
                            </div>
                          </div>

                          <div class="forensic-notes-col">
                            <div class="forensic-col-head">
                              <span class="forensic-col-title">Field notes</span>
                              <div class="forensic-quick-links">
                                <button
                                  type="button"
                                  class="btn btn-sm btn-secondary pin-diff-btn"
                                  data-pin-run={run.id}
                                  aria-pressed="false"
                                  title="Pin run to head-to-head comparison dock"
                                >
                                  Add to comparison
                                </button>
                                <a
                                  href={`/compare?a=${run.id}&b=${rank === 1 && enrichedRuns[1] ? enrichedRuns[1].id : enrichedRuns[0].id}`}
                                  class="forensic-action-link"
                                >
                                  Compare →
                                </a>
                                <a href={`/runs/${run.id}`} class="forensic-action-link is-primary">
                                  Read the run →
                                </a>
                              </div>
                            </div>
                            {run.leadNotes.length > 0 ? (
                              <ul class="forensic-notes-list">
                                {run.leadNotes.map((note) => (
                                  <li>{note}</li>
                                ))}
                              </ul>
                            ) : (
                              <p class="forensic-notes-empty">
                                This run passed {plan.completed} of {plan.total} stages in {formatDuration(data.durationMinutes)}, at a billed cost of {formatCost(billedCost)}.
                              </p>
                            )}
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })
            }
            <tr id="empty-state-row" hidden>
              <td colspan="8" class="empty-state-cell">
                <div class="empty-state-wrap">
                  <p id="empty-state-msg" class="empty-state-copy">
                    No benchmark runs match the current filters.
                  </p>
                  <button
                    id="empty-reset-btn"
                    type="button"
                    class="btn btn-sm btn-secondary"
                  >
                    Reset all filters
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    </section>

    <!-- Comparison appears only after a run is selected. -->
    <aside
      id="quick-compare-dock"
      class="quick-compare-dock"
      aria-label="Pinned head-to-head run comparison"
      hidden
    >
      <div class="qc-dock-inner">
        <div class="qc-contenders">
          <span class="qc-pair-text" id="qc-pair-text">Select a second run to compare</span>
        </div>
        <div class="mono qc-deltas" id="qc-deltas"></div>
        <div class="qc-actions">
          <a href="/compare" id="qc-open-link" class="btn btn-sm">
            Compare runs →
          </a>
          <button type="button" id="qc-clear-btn" class="btn btn-sm btn-secondary">
            Clear
          </button>
        </div>
      </div>
    </aside>

    <section class="reading-exploration" aria-labelledby="exploration-heading">
      <h2 id="exploration-heading">Follow a question</h2>
      <p class="exploration-description">There’s more here when you want to look a little closer.</p>
      <details class="reading-disclosure" id="pareto-section">
        <summary>Where do speed, outcome, and cost meet?</summary>
        <div class="disclosure-body analytics-panel">
          <div class="panel-top-row">
            <p class="section-subnote">
              Log-scale cost (left = cheaper) vs. measured Capy Bench execution (top = better).
              Limited-time <strong>$0 promos</strong> are separated from the paid frontier by default so they never distort paid value ratios.
              Click any point, bar, or table row to cross-highlight.
            </p>
            <a href="/compare?preset=pareto-cost-vs-speed" class="action-link">
              Compare the tradeoffs <span aria-hidden="true">→</span>
            </a>
          </div>

          <div
            class="vf-toolbar"
            role="toolbar"
            focusgroup="toolbar wrap"
            aria-label="Value and execution frontier controls"
            aria-controls="vf-svg vf-paired-bars"
          >
            <div class="vf-toolbar-group" role="group" aria-label="Chart view">
              <button
                type="button"
                class="vf-ctrl-btn"
                data-vf-mode="speed-7-of-7"
                aria-pressed="true"
              >
                7/7 Speed vs. Cost
              </button>
              <button
                type="button"
                class="vf-ctrl-btn"
                data-vf-mode="all-outcomes"
                aria-pressed="false"
              >
                All {enrichedRuns.length} Runs (Outcome)
              </button>
            </div>

            <span class="vf-toolbar-sep" role="separator" aria-orientation="vertical"></span>

            <div class="vf-toolbar-group" role="group" aria-label="Chart overlays">
              <button
                type="button"
                class="vf-ctrl-btn"
                id="vf-toggle-quadrants"
                aria-pressed="true"
              >
                Threshold quadrants
              </button>
              <button
                type="button"
                class="vf-ctrl-btn"
                id="vf-toggle-promos"
                aria-pressed="false"
              >
                Include $0 promos ({initialPlotModel.frontier.promoFullPassIds.length})
              </button>
            </div>

            <span class="vf-toolbar-sep" role="separator" aria-orientation="vertical"></span>

            <div class="vf-toolbar-group" role="group" aria-label="Pricing lens">
              <button type="button" class="vf-ctrl-btn" data-vf-lens="billed" aria-pressed="true">
                Billed
              </button>
              <button type="button" class="vf-ctrl-btn" data-vf-lens="standard" aria-pressed="false">
                Standard API
              </button>
              <button type="button" class="vf-ctrl-btn" data-vf-lens="uncached" aria-pressed="false">
                Uncached
              </button>
            </div>
          </div>

          <div class="vf-layout">
            <figure class="vf-figure">
              <div class="vf-svg-frame">
                <svg
                  id="vf-svg"
                  viewBox={`0 0 ${initialPlotModel.width} ${initialPlotModel.height}`}
                  class="vf-svg"
                  role="img"
                  aria-labelledby="vf-svg-title vf-svg-desc"
                >
                  <title id="vf-svg-title">Value &amp; Execution Frontier (Log-Scale Cost vs. Speed)</title>
                  <desc id="vf-svg-desc">
                    Interactive scatter plot of Capy Bench runs plotted by log-scale USD cost on the horizontal axis against speed or stage completion on the vertical axis, with non-dominated Pareto frontier runs connected.
                  </desc>

                  <g id="vf-layer-grid">
                    {initialPlotModel.yTicks.map((t) => (
                      <g>
                        <line
                          x1={initialPlotModel.paidXStart}
                          y1={t.pos}
                          x2={initialPlotModel.width - initialPlotModel.padR}
                          y2={t.pos}
                          class="vf-grid-line"
                        />
                        <text x={initialPlotModel.padL - 8} y={t.pos + 4} text-anchor="end" class="vf-axis-label">
                          {t.label}
                        </text>
                      </g>
                    ))}
                    {initialPlotModel.xTicks.map((t) => (
                      <g>
                        <line
                          x1={t.pos}
                          y1={initialPlotModel.padT}
                          x2={t.pos}
                          y2={initialPlotModel.height - initialPlotModel.padB}
                          class="vf-grid-line"
                        />
                        <text x={t.pos} y={initialPlotModel.height - initialPlotModel.padB + 16} text-anchor="middle" class="vf-axis-label">
                          {t.label}
                        </text>
                      </g>
                    ))}
                  </g>

                  <g id="vf-layer-quadrants">
                    {initialPlotModel.quadrant.xCut !== null && (
                      <line
                        x1={initialPlotModel.quadrant.xCut}
                        y1={initialPlotModel.padT}
                        x2={initialPlotModel.quadrant.xCut}
                        y2={initialPlotModel.height - initialPlotModel.padB}
                        class="vf-threshold-line"
                      />
                    )}
                    {initialPlotModel.quadrant.yCut !== null && (
                      <line
                        x1={initialPlotModel.paidXStart}
                        y1={initialPlotModel.quadrant.yCut}
                        x2={initialPlotModel.width - initialPlotModel.padR}
                        y2={initialPlotModel.quadrant.yCut}
                        class="vf-threshold-line"
                      />
                    )}
                    {initialPlotModel.quadrant.zones.map((z) => (
                      <text x={z.x} y={z.y} text-anchor={z.anchor} class="vf-zone-label">
                        {z.label}
                      </text>
                    ))}
                  </g>

                  <g id="vf-layer-axes">
                    <line
                      x1={initialPlotModel.padL}
                      y1={initialPlotModel.padT}
                      x2={initialPlotModel.padL}
                      y2={initialPlotModel.height - initialPlotModel.padB}
                      class="vf-axis-line"
                    />
                    <line
                      x1={initialPlotModel.padL}
                      y1={initialPlotModel.height - initialPlotModel.padB}
                      x2={initialPlotModel.width - initialPlotModel.padR}
                      y2={initialPlotModel.height - initialPlotModel.padB}
                      class="vf-axis-line"
                    />
                    <text
                      x={(initialPlotModel.paidXStart + initialPlotModel.width - initialPlotModel.padR) / 2}
                      y={initialPlotModel.height - 8}
                      text-anchor="middle"
                      class="vf-axis-title"
                      id="vf-x-axis-title"
                    >
                      Cost per run (USD, log scale · Billed)
                    </text>
                    <text
                      x={16}
                      y={initialPlotModel.padT + (initialPlotModel.height - initialPlotModel.padT - initialPlotModel.padB) / 2}
                      text-anchor="middle"
                      transform={`rotate(-90 16 ${initialPlotModel.padT + (initialPlotModel.height - initialPlotModel.padT - initialPlotModel.padB) / 2})`}
                      class="vf-axis-title"
                      id="vf-y-axis-title"
                    >
                      Elapsed time (faster ↑)
                    </text>
                  </g>

                  <g id="vf-layer-frontier">
                    {initialPlotModel.frontierStepPath && (
                      <path d={initialPlotModel.frontierStepPath} class="vf-frontier-path" fill="none" />
                    )}
                  </g>

                  <g id="vf-layer-labels">
                    {initialPlotModel.labels.map((lbl) => {
                      const pt = initialPlotModel.points.find((p) => p.id === lbl.id);
                      return (
                        <g class="vf-label-group" data-label-for={lbl.id}>
                          {lbl.needsLeader && pt && (
                            <line x1={pt.cx} y1={pt.cy} x2={lbl.x} y2={lbl.y - 3} class="vf-leader" />
                          )}
                          <text
                            x={lbl.x}
                            y={lbl.y}
                            text-anchor={lbl.anchor}
                            class:list={['vf-node-label', { 'is-frontier': pt?.isFrontier }]}
                          >
                            {lbl.text}
                          </text>
                        </g>
                      );
                    })}
                  </g>

                  <g id="vf-layer-points">
                    {initialPlotModel.points.map((pt) => (
                      <g
                        class:list={[
                          'vf-point',
                          {
                            'is-frontier': pt.isFrontier,
                            'is-partial': !pt.isFullPass,
                            'is-promo': pt.isZeroCostPromo,
                          },
                        ]}
                        role="button"
                        tabindex="0"
                        data-vf-run={pt.id}
                        aria-pressed="false"
                        aria-label={`${pt.harness} / ${pt.model} (${pt.effort}): ${pt.completed}/${pt.total} stages, ${pt.durationMinutes}m, ${formatCost(pt.lensCostUsd)}${pt.isFrontier ? `, Paid Frontier #${pt.frontierOrder}` : ''}${pt.isOffPeak ? ', Off-Peak 50% discount' : ''}`}
                      >
                        <circle cx={pt.cx} cy={pt.cy} r="14" class="vf-hit-target" />
                        {pt.isFrontier ? (
                          <rect x={pt.cx - 6} y={pt.cy - 6} width="12" height="12" class="vf-marker-frontier" />
                        ) : (
                          <circle cx={pt.cx} cy={pt.cy} r="5.5" class="vf-marker-peer" />
                        )}
                      </g>
                    ))}
                  </g>
                </svg>
              </div>
              <figcaption class="mono vf-caption" id="vf-caption">
                {initialPlotModel.frontier.thresholds.paidFullPassCount} paid 7/7 runs plotted · {initialPlotModel.frontier.thresholds.promoFullPassCount} $0 promos separated · Median paid 7/7: {initialPlotModel.frontier.thresholds.medianPaid7of7CostUsd !== null ? formatShortCostTick(initialPlotModel.frontier.thresholds.medianPaid7of7CostUsd) : '—'} / {initialPlotModel.frontier.thresholds.medianPaid7of7DurationMinutes !== null ? `${Math.round(initialPlotModel.frontier.thresholds.medianPaid7of7DurationMinutes)}m` : '—'}
              </figcaption>
            </figure>

            <div class="vf-sidebar">
              {(() => {
                const firstId = initialPlotModel.frontier.frontierIds[0];
                const firstPt = initialPlotModel.points.find((p) => p.id === firstId) ?? initialPlotModel.points[0];
                const firstModelStat = firstPt ? groupSampleStats.byModel[firstPt.model] : null;
                const firstHarnessStat = firstPt ? groupSampleStats.byHarness[firstPt.harnessSlug] : null;
                return firstPt ? (
                  <div class="vf-inspector" id="vf-inspector" aria-live="polite">
                    <div class="vf-inspector-head">
                      <span class="hl hl-acid vf-inspector-badge" id="vf-ins-badge">
                        {firstPt.isFrontier ? `Paid Frontier #${firstPt.frontierOrder}` : `${firstPt.completed}/${firstPt.total} stages`}
                      </span>
                      <div class="vf-inspector-actions">
                        <button type="button" class="vf-mini-btn" id="vf-ins-focus" data-focus-run={firstPt.id}>
                          Focus
                        </button>
                        <a href={`/runs/${firstPt.id}`} class="mono vf-inspector-link" id="vf-ins-link">
                          Dossier →
                        </a>
                      </div>
                    </div>
                    <strong class="vf-inspector-title" id="vf-ins-title">
                      {firstPt.harness} / {firstPt.model} ({firstPt.effort})
                    </strong>
                    <div class="mono vf-inspector-stats" id="vf-ins-stats">
                      {firstPt.completed}/{firstPt.total} · {formatDuration(firstPt.durationMinutes)} · {formatCost(firstPt.lensCostUsd)} ({formatCost(firstPt.lensCostUsd / Math.max(1, firstPt.completed))}/stage) · {firstPt.tokensTotal} tok ({firstPt.cacheHitRatePct}% cache)
                    </div>
                    <div class="vf-inspector-note" id="vf-ins-note">
                      {firstModelStat && firstHarnessStat
                        ? `Sample size: model n=${firstModelStat.n} (${firstModelStat.peers.join(', ')}) · harness ${firstPt.harness} n=${firstHarnessStat.n}${firstHarnessStat.singlePeerCaveat ? ' (single-model harness — harness & model effects are confounded)' : ` (${firstHarnessStat.peers.length} models)`}.`
                        : ''}
                    </div>
                  </div>
                ) : null;
              })()}

              <div class="vf-ledger-block">
                <div class="vf-subhead" id="vf-frontier-heading">
                  Paid 7/7 Frontier ({initialPlotModel.frontier.frontierIds.length})
                </div>
                <ol class="command-list vf-frontier-list" id="vf-frontier-list" role="list">
                  {initialPlotModel.frontier.frontierIds.map((fid, idx) => {
                    const pt = initialPlotModel.points.find((p) => p.id === fid);
                    if (!pt) return null;
                    return (
                      <li class="command-row vf-frontier-row">
                        <button
                          type="button"
                          class="vf-frontier-btn"
                          data-vf-run={pt.id}
                          aria-pressed="false"
                        >
                          <span class="mono vf-order-tag">F{idx + 1}</span>
                          <span class="vf-frontier-name">{pt.harness} / {pt.model}</span>
                          <span class="mono vf-frontier-meta">
                            {formatDuration(pt.durationMinutes)} · <strong>{formatCost(pt.lensCostUsd)}</strong>
                          </span>
                        </button>
                      </li>
                    );
                  })}
                </ol>
              </div>

              {initialPairedBars.promoRows.length > 0 && (
                <div class="callout callout-mint vf-promo-callout" id="vf-promo-callout">
                  <div class="vf-promo-head">
                    <span class="hl hl-mint">$0 Promo Lane</span>
                    <span class="mono vf-promo-count">n={initialPairedBars.promoRows.length} limited-time free</span>
                  </div>
                  <p class="vf-promo-copy">
                    Excluded from the paid log-cost frontier by default so $0 promos never create infinite value ratios or mask paid budget leaders (<strong>Pi / muse-spark</strong> at $0.14, <strong>ZCode / glm-5.3-flash</strong> at $0.87).
                  </p>
                  <ul class="vf-promo-list" role="list">
                    {initialPairedBars.promoRows.map((pr) => (
                      <li>
                        <button
                          type="button"
                          class="vf-promo-btn"
                          data-vf-run={pr.id}
                          aria-pressed="false"
                        >
                          <span>{pr.harness} / {pr.model}</span>
                          <span class="mono">{pr.completed}/{pr.total} · {formatDuration(pr.durationMinutes)} · $0.00</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <div class="vf-paired-section" id="vf-paired-bars">
            <div class="vf-paired-header">
              <div>
                <h3 class="vf-paired-title">Raw Execution vs. Paid Cost Efficiency</h3>
                <p class="vf-paired-sub">
                  Watch how the ranking inverts when cost enters. Left sorts by holdout stages then speed; right sorts paid runs by USD per completed stage in the active lens (rank shift shown in brackets).
                </p>
              </div>
              <span class="mono vf-paired-lens-pill" id="vf-paired-lens-pill">Lens: Billed</span>
            </div>

            <div class="vf-paired-grid">
              <div class="vf-bar-col">
                <div class="vf-bar-col-head">
                  <span class="vf-bar-col-title">Execution: Completion &amp; Speed</span>
                  <span class="mono vf-bar-col-meta">n={initialPairedBars.executionRows.length} · faster = longer bar</span>
                </div>
                <div class="vf-bar-list" id="vf-exec-bars">
                  {initialPairedBars.executionRows.map((item, idx) => {
                    const prev = idx > 0 ? initialPairedBars.executionRows[idx - 1] : null;
                    const showPassDivider = prev && prev.isFullPass && !item.isFullPass;
                    return (
                      <>
                        {showPassDivider && (
                          <div class="mono vf-bar-divider" role="separator">
                            7/7 pass gate — partial runs below
                          </div>
                        )}
                        <button
                          type="button"
                          class:list={['vf-bar-row', { 'is-partial': !item.isFullPass, 'is-frontier': item.isPaidFrontier }]}
                          data-bar-run={item.id}
                          aria-pressed="false"
                        >
                          <div class="vf-bar-meta">
                            <span class="mono vf-bar-rank">#{item.executionRank}</span>
                            <span class="vf-bar-label">
                              {item.harness} / {item.model}
                              {item.isOffPeak && <span class="mono vf-tag-offpeak">off-peak</span>}
                              {item.isZeroCostPromo && <span class="mono vf-tag-promo">$0 promo</span>}
                            </span>
                            <span class="mono vf-bar-val">
                              {item.completed}/{item.total} · {formatDuration(item.durationMinutes)}
                            </span>
                          </div>
                          <div class="vf-bar-track" aria-hidden="true">
                            <span
                              class:list={[
                                'vf-bar-fill',
                                item.isPaidFrontier ? 'is-frontier' : item.isFullPass ? 'is-pass' : 'is-partial',
                              ]}
                              style={`inline-size: ${item.executionBarPct}%`}
                            />
                          </div>
                        </button>
                      </>
                    );
                  })}
                </div>
              </div>

              <div class="vf-bar-col">
                <div class="vf-bar-col-head">
                  <span class="vf-bar-col-title">Value: Paid Cost per Stage</span>
                  <span class="mono vf-bar-col-meta">n={initialPairedBars.paidValueRows.length} paid · cheaper = longer bar</span>
                </div>
                <div class="vf-bar-list" id="vf-value-bars">
                  {initialPairedBars.paidValueRows.map((item, idx) => {
                    const prev = idx > 0 ? initialPairedBars.paidValueRows[idx - 1] : null;
                    const showPassDivider = prev && prev.isFullPass && !item.isFullPass;
                    const deltaLabel =
                      item.rankDelta !== null && item.rankDelta !== 0
                        ? item.rankDelta > 0
                          ? `↑+${item.rankDelta}`
                          : `↓${item.rankDelta}`
                        : '—';
                    return (
                      <>
                        {showPassDivider && (
                          <div class="mono vf-bar-divider" role="separator">
                            Partial paid runs (&lt;7/7)
                          </div>
                        )}
                        <button
                          type="button"
                          class:list={['vf-bar-row', { 'is-partial': !item.isFullPass, 'is-frontier': item.isPaidFrontier }]}
                          data-bar-run={item.id}
                          aria-pressed="false"
                        >
                          <div class="vf-bar-meta">
                            <span class="mono vf-bar-rank">#{item.valueRank}</span>
                            <span class="vf-bar-label">
                              {item.harness} / {item.model}
                              {item.isOffPeak && <span class="mono vf-tag-offpeak">off-peak</span>}
                            </span>
                            <span class="mono vf-bar-val">
                              {formatCost(item.lensCostUsd)}
                              <span class="vf-bar-subval"> ({formatCost(item.costPerCompletedStageUsd ?? 0)}/stg)</span>
                              <span class:list={['vf-delta', { 'is-up': (item.rankDelta ?? 0) > 0, 'is-down': (item.rankDelta ?? 0) < 0 }]}>
                                {deltaLabel}
                              </span>
                            </span>
                          </div>
                          <div class="vf-bar-track" aria-hidden="true">
                            <span
                              class:list={[
                                'vf-bar-fill',
                                item.isPaidFrontier ? 'is-frontier' : item.isFullPass ? 'is-value' : 'is-partial',
                              ]}
                              style={`inline-size: ${item.valueBarPct ?? 14}%`}
                            />
                          </div>
                        </button>
                      </>
                    );
                  })}
                  {initialPairedBars.promoRows.length > 0 && (
                    <div class="vf-promo-bar-group">
                      <div class="mono vf-bar-divider">
                        $0 limited-time promos (not ranked on paid $/stage)
                      </div>
                      {initialPairedBars.promoRows.map((item) => (
                        <button
                          type="button"
                          class="vf-bar-row is-promo"
                          data-bar-run={item.id}
                          aria-pressed="false"
                        >
                          <div class="vf-bar-meta">
                            <span class="mono vf-bar-rank">$0</span>
                            <span class="vf-bar-label">
                              {item.harness} / {item.model}
                              <span class="mono vf-tag-promo">free (limited time)</span>
                            </span>
                            <span class="mono vf-bar-val">
                              {item.completed}/{item.total} · {formatDuration(item.durationMinutes)} · $0.00
                            </span>
                          </div>
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </details>

      <script
        id="frontier-runs-data"
        type="application/json"
        set:html={JSON.stringify(clientAnalyzedRunsPayload)}
      />

      <details class="reading-disclosure" id="bottleneck-section">
        <summary>Which stages ask the most of an agent?</summary>
        <div class="disclosure-body analytics-panel">
        <div class="panel-top-row">
          <p class="section-subnote">
            Compare completion, call share, cost share, and thinking tokens for each stage
            across all {enrichedRuns.length} published runs.
          </p>
          <a href="/about#stages" class="action-link">
            Read the stage specifications <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="table-wrapper bottleneck-table-wrap" tabindex="0" role="region" aria-label="Stage bottleneck matrix">
          <table class="app-table leaderboard-table static-table bottleneck-table">
            <thead>
              <tr>
                <th scope="col">Stage</th>
                <th scope="col">Holdout Pass Rate</th>
                <th scope="col">Avg Call Share</th>
                <th scope="col">Avg Cost Share</th>
                <th scope="col">Avg Thinking</th>
                <th scope="col">Peak Bottleneck</th>
              </tr>
            </thead>
            <tbody>
              {stageMatrix.map((st) => {
                const title = stageTitleMap.get(st.stageId) ?? st.stageId;
                const isTopBottleneck = st.peakCostCount >= 2;
                const isHighMiss = st.passRatePct < 70;
                return (
                  <tr>
                    <th scope="row">
                      <div class="bottleneck-stage-cell">
                        <span class:list={['stage-legend-id', { 'is-peak-id': isTopBottleneck }]}>
                          {st.stageId}
                        </span>
                        <strong>{title}</strong>
                      </div>
                    </th>
                    <td class="mono" data-cell="Holdout Pass Rate">
                      <span class:list={[isHighMiss ? 'hl hl-magenta' : '']}>
                        {st.passCount}/{st.totalRuns} ({st.passRatePct}%)
                      </span>
                    </td>
                    <td class="mono" data-cell="Avg Call Share">
                      {st.avgCallSharePct}% <span class="text-muted">({st.avgLlmCalls} turns)</span>
                    </td>
                    <td class="mono" data-cell="Avg Cost Share">
                      <div class="bottleneck-bar-wrap">
                        <span class:list={[{ 'is-peak-text': isTopBottleneck }]}>{st.avgCostSharePct}%</span>
                        <div class="bottleneck-bar-track" aria-hidden="true">
                          <span
                            class:list={[
                              'bottleneck-bar-fill',
                              isTopBottleneck ? 'is-peak' : 'is-normal',
                            ]}
                            style={`inline-size: ${Math.min(100, st.avgCostSharePct * 3).toFixed(1)}%`}
                          />
                        </div>
                      </div>
                    </td>
                    <td class="mono" data-cell="Avg Thinking">
                      {st.avgThinkingTokens.toLocaleString('en-US')} tok
                    </td>
                    <td class="mono" data-cell="Peak Bottleneck">
                      {st.peakCostCount > 0 ? (
                        <span class:list={['peak-count-pill', { 'is-top-peak': isTopBottleneck }]}>
                          {st.peakCostCount} {st.peakCostCount === 1 ? 'run' : 'runs'} #1 peak
                        </span>
                      ) : (
                        <span class="text-muted">0 runs</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        </div>
      </details>

      <details class="reading-disclosure" id="ablations-teaser">
        <summary>What changes with a different harness or effort?</summary>
        <div class="disclosure-body analytics-panel">
        <div class="panel-top-row">
          <p class="section-subnote">
            Paired runs let you look at one difference at a time: harness, reasoning effort,
            or model generation.
          </p>
          <a href="/compare" class="action-link">
            Choose a comparison <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="ablation-cards-grid">
          {ablationPresets.map((preset) => (
            <a
              href={`/compare?a=${preset.runAId}&b=${preset.runBId}&preset=${preset.id}`}
              class="ablation-teaser-card"
            >
              <div class="ablation-teaser-top">
                <span class="ablation-badge">{preset.badge}</span>
                <span class="ablation-cta">Compare runs →</span>
              </div>
              <strong class="ablation-teaser-title">{preset.title}</strong>
              <p class="ablation-teaser-copy">{preset.findingHeadline}</p>
            </a>
          ))}
        </div>
        </div>
      </details>
    </section>
  </div>
</BaseLayout>

