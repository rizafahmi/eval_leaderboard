  }

  .toolbar-select {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle-color);
    font-size: 0.72rem;
    padding: 0.26rem 1.6rem 0.26rem 0.5rem;
    inline-size: auto;
  }

  .toolbar-reset-btn {
    border-width: 1px;
    padding: 0.26rem 0.5rem;
    font-size: 0.7rem;
  }

  .controls-result-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-inline-start: 0.25rem;
  }

  /* 3. LEADERBOARD TABLE & INLINE FORENSIC DRAWER */
  .leaderboard-quiet .leaderboard-table .col-rank {
    inline-size: 2.8rem;
  }

  .leaderboard-quiet .leaderboard-table .col-details {
    inline-size: 4.2rem;
  }

  .leaderboard-quiet .leaderboard-table .metric-primary {
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .leaderboard-quiet .leaderboard-table .metric-sub {
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .leaderboard-quiet .leaderboard-table thead th {
    background-color: var(--bg-surface);
    padding: 0.55rem 0.6rem;
    font-size: 0.6875rem;
  }

  .leaderboard-quiet .leaderboard-table thead th.sortable {
    padding: 0;
  }

  .leaderboard-quiet .sort-header-btn {
    min-block-size: 2.25rem;
    padding: 0.55rem 0.6rem;
