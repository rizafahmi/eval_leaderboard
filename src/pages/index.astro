    border-inline-end: var(--border-row);
    background-color: transparent;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .leaderboard-quiet.lb-v1 .v1-kpi-strip .stat-card:last-child {
    border-inline-end: none;
  }

  .kpi-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0;
  }

  .leaderboard-quiet .stat-value {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    line-height: 1.15;
    margin: 0;
  }

