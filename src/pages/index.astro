</style>

<script>
  const table = document.getElementById('leaderboard-table') as HTMLTableElement | null;
  const tbody = document.getElementById('leaderboard-tbody') as HTMLTableSectionElement | null;
  const emptyStateRow = document.getElementById('empty-state-row') as HTMLTableRowElement | null;
  const emptyStateMsg = document.getElementById('empty-state-msg') as HTMLElement | null;
  const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const harnessFilter = document.getElementById('harness-filter') as HTMLSelectElement | null;
  const providerFilter = document.getElementById('provider-filter') as HTMLSelectElement | null;
  const pricingLensSelect = document.getElementById('pricing-lens-select') as HTMLSelectElement | null;
  const costColHeaderLabel = document.getElementById('cost-col-header-label') as HTMLElement | null;
  const showTelemetry = document.getElementById('show-telemetry') as HTMLInputElement | null;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const sortDirBtn = document.getElementById('sort-dir-btn') as HTMLButtonElement | null;
  const visibleCountBadge = document.getElementById('visible-count-badge') as HTMLElement | null;
  const resetFiltersBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement | null;
  const statusRegion = document.getElementById('leaderboard-status') as HTMLElement | null;
  const sortableHeaders = document.querySelectorAll<HTMLTableCellElement>('th.sortable');
  const scenarioPills = document.querySelectorAll<HTMLButtonElement>('.scenario-pill');

  let activeQuickScenario = 'all';
  const expandedRunIds = new Set<string>();
  const pinnedRunIds: string[] = [];

  const usdFmt = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  const defaultSortDirs: Record<string, 'asc' | 'desc'> = {
    plan: 'desc',
    tests: 'desc',
    duration: 'asc',
    turns: 'asc',
    cost: 'asc',
    tokens: 'asc',
    timestamp: 'desc',
  };

  let announceTimer: ReturnType<typeof setTimeout> | null = null;

  function setSortDirButtonState(dir: 'asc' | 'desc') {
    if (!sortDirBtn) return;
    sortDirBtn.dataset.dir = dir;
    sortDirBtn.textContent = dir === 'asc' ? 'Ascending' : 'Descending';
    sortDirBtn.setAttribute('aria-label', `Sort ${dir === 'asc' ? 'ascending; activate to sort descending' : 'descending; activate to sort ascending'}`);
  }

  function applyPricingLensToRows(lens: string) {
    if (!tbody) return;
    if (costColHeaderLabel) {
      costColHeaderLabel.textContent =
        lens === 'standard' ? 'API cost' : lens === 'uncached' ? 'Uncached cost' : 'Cost';
    }


    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row'));
    for (const row of rows) {
      const billed = parseFloat(row.dataset.costBilled ?? '0');
      const standard = parseFloat(row.dataset.costStandard ?? '0');
      const uncached = parseFloat(row.dataset.costUncached ?? '0');
      const savings = parseFloat(row.dataset.cacheSavings ?? '0');

      const activeCost =
        lens === 'standard' ? standard : lens === 'uncached' ? uncached : billed;
      row.dataset.cost = String(activeCost);
      row.dataset.costStr = usdFmt.format(activeCost);

      const primaryEl = row.querySelector<HTMLElement>('.cost-primary-display');
      const subEl = row.querySelector<HTMLElement>('.cost-sub-display');
      if (primaryEl) {
        primaryEl.textContent = usdFmt.format(activeCost);
      }
      if (subEl) {
        const freeBadge = row.dataset.pricingBadge ?? 'free tier';
        if (lens === 'uncached') {
          subEl.textContent =
            savings > 0 ? `vs ${usdFmt.format(standard)} cached` : freeBadge;
        } else if (lens === 'standard') {
          subEl.textContent =
            standard !== billed
              ? `billed ${usdFmt.format(billed)}`
              : savings > 0
                ? `-${usdFmt.format(savings)} saved`
                : billed === 0
                  ? freeBadge
                  : 'standard API';
        } else {
          subEl.textContent =
            savings > 0
              ? `-${usdFmt.format(savings)} saved`
              : standard > billed
                ? `${usdFmt.format(standard)} API equiv.`
                : freeBadge;
        }
      }
    }
  }

  function syncUrlState(
    query: string,
    harness: string,
    provider: string,
    lens: string,
    fullPassOnly: boolean,
    paretoOnly: boolean,
    sortBy: string,
    sortDir: 'asc' | 'desc'
  ) {
    try {
      const params = new URLSearchParams(window.location.search);
      if (query) params.set('q', query);
      else params.delete('q');

      if (harness !== 'all') params.set('harness', harness);
      else params.delete('harness');

      if (provider !== 'all') params.set('provider', provider);
      else params.delete('provider');

      if (lens !== 'billed') params.set('lens', lens);
      else params.delete('lens');

      if (fullPassOnly) params.set('pass', '1');
      else params.delete('pass');

      if (paretoOnly) params.set('pareto', '1');
      else params.delete('pareto');

      const defaultDir = defaultSortDirs[sortBy] ?? 'desc';
      if (sortBy !== 'plan' || sortDir !== defaultDir) {
        params.set('sort', sortBy);
        params.set('dir', sortDir);
      } else {
        params.delete('sort');
        params.delete('dir');
      }

      const qs = params.toString();
      const nextUrl = `${window.location.pathname}${qs ? `?${qs}` : ''}${window.location.hash}`;
      if (nextUrl !== `${window.location.pathname}${window.location.search}${window.location.hash}`) {
        window.history.replaceState(null, '', nextUrl);
      }
    } catch {}
  }

  function hydrateFromUrlState() {
    try {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      const harness = params.get('harness');
      const provider = params.get('provider');
      const lens = params.get('lens');
      const pass = params.get('pass');
      const pareto = params.get('pareto');
      const sort = params.get('sort');
      const dir = params.get('dir');

      if (q && searchInput) searchInput.value = q;
      if (
        harness &&
        harnessFilter &&
        Array.from(harnessFilter.options).some((o) => o.value === harness)
      ) {
        harnessFilter.value = harness;
      }
      if (
        provider &&
        providerFilter &&
        Array.from(providerFilter.options).some((o) => o.value === provider)
      ) {
        providerFilter.value = provider;
      }
      if (
        lens &&
        pricingLensSelect &&
        Array.from(pricingLensSelect.options).some((o) => o.value === lens)
      ) {
        pricingLensSelect.value = lens;
      }
      if (pass === '1') activeQuickScenario = 'full-pass';
      if (pareto === '1') activeQuickScenario = 'pareto';
      if (
        sort &&
        sortSelect &&
        Array.from(sortSelect.options).some((o) => o.value === sort)
      ) {
        sortSelect.value = sort;
        const resolvedDir =
          dir === 'asc' || dir === 'desc' ? dir : (defaultSortDirs[sort] ?? 'desc');
        setSortDirButtonState(resolvedDir);
      } else if (dir === 'asc' || dir === 'desc') {
        setSortDirButtonState(dir);
      }
    } catch {}
  }

  function applyLeaderboardUpdate() {
    if (!tbody || !sortSelect || !sortDirBtn) return;

    const query = (searchInput?.value ?? '').trim().toLowerCase();
    const harness = harnessFilter?.value ?? 'all';
    const provider = providerFilter?.value ?? 'all';
    const lens = pricingLensSelect?.value ?? 'billed';
    const fullPassOnly = activeQuickScenario === 'full-pass';
    const paretoOnly = activeQuickScenario === 'pareto';
    const sortBy = sortSelect.value;
    const sortDir = (sortDirBtn.dataset.dir as 'asc' | 'desc') || 'desc';

    applyPricingLensToRows(lens);

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row'));
    const totalCount = rows.length;

    rows.forEach((row) => {
      const rowSearch = row.dataset.search ?? '';
      const rowHarness = row.dataset.harness ?? '';
      const rowProvider = row.dataset.provider ?? '';
      const rowPlan = parseFloat(row.dataset.plan ?? '0');
      const rowPareto = row.dataset.pareto === '1';
      const rowCostBilled = parseFloat(row.dataset.costBilled ?? '0');

      const matchesSearch = !query || rowSearch.includes(query);
      const matchesHarness = harness === 'all' || rowHarness === harness;
      const matchesProvider = provider === 'all' || rowProvider === provider;
      const matchesFullPass = !fullPassOnly || rowPlan === 1;
      const matchesPareto = !paretoOnly || rowPareto;
      const matchesScenario =
        activeQuickScenario === 'under-1'
          ? rowCostBilled < 1.0
          : activeQuickScenario === 'spec-miss'
            ? rowPlan < 1
            : true;

      row.hidden = !(
        matchesSearch &&
        matchesHarness &&
        matchesProvider &&
        matchesFullPass &&
        matchesPareto &&
        matchesScenario
      );
    });

    rows.sort((a, b) => {
      const valA = parseFloat(a.dataset[sortBy] ?? '0');
      const valB = parseFloat(b.dataset[sortBy] ?? '0');

      const missingA =
        ((sortBy === 'tokens' || sortBy === 'turns') && valA <= 0) ||
        (sortBy === 'tests' && valA < 0);
      const missingB =
        ((sortBy === 'tokens' || sortBy === 'turns') && valB <= 0) ||
        (sortBy === 'tests' && valB < 0);
      if (missingA !== missingB) {
        return missingA ? 1 : -1;
      }

      if (valA !== valB) {
        return sortDir === 'asc' ? valA - valB : valB - valA;
      }
      if (sortBy === 'tests') {
        const passedA = parseFloat(a.dataset.testsPassed ?? '0');
        const passedB = parseFloat(b.dataset.testsPassed ?? '0');
        if (passedA !== passedB) {
          return sortDir === 'asc' ? passedA - passedB : passedB - passedA;
        }
      }
      const planDiff =
        parseFloat(b.dataset.plan ?? '0') - parseFloat(a.dataset.plan ?? '0');
      if (planDiff !== 0) return planDiff;
      const durationDiff =
        parseFloat(a.dataset.duration ?? '0') - parseFloat(b.dataset.duration ?? '0');
      if (durationDiff !== 0) return durationDiff;

      const testsDiff =
        parseFloat(b.dataset.tests ?? '0') - parseFloat(a.dataset.tests ?? '0');
      if (testsDiff !== 0) return testsDiff;

      return parseFloat(a.dataset.cost ?? '0') - parseFloat(b.dataset.cost ?? '0');
    });

    const supportsMoveBefore = 'moveBefore' in Element.prototype;
    let visibleRank = 1;
    rows.forEach((row) => {
      const refNode = emptyStateRow ?? null;
      const runId = row.dataset.runId ?? '';
      const drawerRow = tbody.querySelector<HTMLTableRowElement>(
        `tr.forensic-drawer-row[data-drawer-for="${runId}"]`
      );
      if (supportsMoveBefore) {
        (tbody as unknown as { moveBefore: (node: Node, child: Node | null) => void }).moveBefore(
          row,
          refNode
        );
        if (drawerRow) {
          (tbody as unknown as { moveBefore: (node: Node, child: Node | null) => void }).moveBefore(
            drawerRow,
            refNode
          );
        }
      } else {
        tbody.insertBefore(row, refNode);
        if (drawerRow) {
          tbody.insertBefore(drawerRow, refNode);
        }
      }

      if (drawerRow) {
        drawerRow.hidden = row.hidden || !expandedRunIds.has(runId);
      }

      if (!row.hidden) {
        const badge = row.querySelector('.rank-badge');
        if (badge) {
          badge.textContent = `#${visibleRank}`;
          badge.classList.remove('rank-1', 'rank-2', 'rank-3');
          if (visibleRank === 1) badge.classList.add('rank-1');
          if (visibleRank === 2) badge.classList.add('rank-2');
          if (visibleRank === 3) badge.classList.add('rank-3');
        }
        visibleRank++;
      }
    });

    const visibleCount = visibleRank - 1;
    const hasActiveFilters =
      Boolean(query) ||
      harness !== 'all' ||
      provider !== 'all' ||
      lens !== 'billed' ||
      fullPassOnly ||
      paretoOnly ||
      activeQuickScenario !== 'all';
    const isNonDefaultSort =
      sortBy !== 'plan' || sortDir !== (defaultSortDirs.plan ?? 'desc');

    if (visibleCountBadge) {
      visibleCountBadge.textContent =
        visibleCount === totalCount
          ? `${totalCount} runs`
          : `${visibleCount}/${totalCount} runs`;
      visibleCountBadge.classList.toggle('is-filtered', hasActiveFilters);
    }

    scenarioPills.forEach((pill) => {
      const active = pill.dataset.scenario === activeQuickScenario;
      pill.classList.toggle('is-active', active);
      pill.setAttribute('aria-pressed', String(active));
    });

    if (resetFiltersBtn) {
      resetFiltersBtn.hidden = !(hasActiveFilters || isNonDefaultSort);
    }

    if (emptyStateRow) {
      emptyStateRow.hidden = visibleCount > 0;
      if (visibleCount === 0 && emptyStateMsg) {
        emptyStateMsg.textContent = 'No benchmark runs match the current filters.';
      }
    }

    table?.classList.toggle('is-sorted-by-date', sortBy === 'timestamp');

    sortableHeaders.forEach((th) => {
      const col = th.dataset.sortCol;
      const indicator = th.querySelector('.sort-indicator');
      if (col === sortBy) {
        th.classList.add('active-sort');
        th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
        if (indicator) indicator.textContent = sortDir === 'asc' ? '↑' : '↓';
      } else {
        th.classList.remove('active-sort');
        th.removeAttribute('aria-sort');
        if (indicator) indicator.textContent = '';
      }
    });

    syncUrlState(query, harness, provider, lens, fullPassOnly, paretoOnly, sortBy, sortDir);

    if (statusRegion) {
      if (announceTimer) clearTimeout(announceTimer);
      const sortLabel = sortSelect.selectedOptions[0]?.textContent ?? sortBy;
      announceTimer = setTimeout(() => {
        statusRegion.textContent = `Showing ${visibleCount} of ${totalCount} runs, sorted by ${sortLabel} (${sortDir === 'asc' ? 'ascending' : 'descending'}).`;
      }, 250);
    }
  }

  function updateLeaderboard() {
    applyLeaderboardUpdate();
  }

  function resetAllControls() {
    activeQuickScenario = 'all';
    if (searchInput) searchInput.value = '';
    if (harnessFilter) harnessFilter.value = 'all';
    if (providerFilter) providerFilter.value = 'all';
    if (pricingLensSelect) pricingLensSelect.value = 'billed';
    if (sortSelect) sortSelect.value = 'plan';
    setSortDirButtonState('desc');
    updateLeaderboard();
  }

  // Scenario Lens Click Handlers
  scenarioPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const sc = pill.dataset.scenario ?? 'all';
      activeQuickScenario = sc;
      updateLeaderboard();
    });
  });


  // Toggle Inline Forensic Drawer
  function toggleForensicDrawer(runId: string) {
    if (!tbody) return;
    const drawerRow = tbody.querySelector<HTMLTableRowElement>(
      `tr.forensic-drawer-row[data-drawer-for="${runId}"]`
    );
    if (!drawerRow) return;
    const isOpen = expandedRunIds.has(runId);
    if (isOpen) {
      expandedRunIds.delete(runId);
      drawerRow.hidden = true;
    } else {
      expandedRunIds.add(runId);
      drawerRow.hidden = false;
    }
    document
      .querySelectorAll<HTMLElement>(`[data-peek-toggle="${runId}"]`)
      .forEach((btn) => {
        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (btn.classList.contains('peek-row-btn')) {
          btn.classList.toggle('is-open', !isOpen);
        }
      });
  }

  // Quick-Compare Dock management
  const qcDock = document.getElementById('quick-compare-dock');
  const qcPairText = document.getElementById('qc-pair-text');
  const qcDeltas = document.getElementById('qc-deltas');
  const qcOpenLink = document.getElementById('qc-open-link') as HTMLAnchorElement | null;
  const qcClearBtn = document.getElementById('qc-clear-btn');

  function renderQuickCompareDock() {
    document.querySelectorAll<HTMLButtonElement>('.pin-diff-btn').forEach((btn) => {
      const id = btn.dataset.pinRun ?? '';
      const idx = pinnedRunIds.indexOf(id);
      const isPinned = idx !== -1;
      btn.setAttribute('aria-pressed', isPinned ? 'true' : 'false');
      btn.textContent = isPinned ? (idx === 0 ? 'Selected as A' : 'Selected as B') : 'Add to comparison';
    });

    if (!qcDock || !tbody) return;
    if (pinnedRunIds.length === 0) {
      qcDock.hidden = true;
      return;
    }
    qcDock.hidden = false;
    const allRows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.run-row'));
    const rowA = allRows.find((r) => r.dataset.runId === pinnedRunIds[0]);
    const rowB =
      pinnedRunIds.length > 1
        ? allRows.find((r) => r.dataset.runId === pinnedRunIds[1])
        : allRows.find((r) => r.dataset.runId !== pinnedRunIds[0]);

    if (!rowA || !rowB) return;
    const labelA = rowA.dataset.runLabel ?? rowA.dataset.runId;
    const labelB = rowB.dataset.runLabel ?? rowB.dataset.runId;
    if (qcPairText) {
      qcPairText.textContent =
        pinnedRunIds.length === 1
          ? `A: ${labelA} vs. ${labelB}`
          : `A: ${labelA} vs. B: ${labelB}`;
    }
    if (qcDeltas) {
      qcDeltas.innerHTML = `
        <span>Spec: <strong>${rowA.dataset.planStr}</strong> vs <strong>${rowB.dataset.planStr}</strong></span>
        <span>Turns: <strong>${rowA.dataset.turnsStr}</strong> vs <strong>${rowB.dataset.turnsStr}</strong></span>
        <span>Cost: <strong>${rowA.dataset.costStr}</strong> vs <strong>${rowB.dataset.costStr}</strong></span>
        <span>Time: <strong>${rowA.dataset.durationStr}</strong> vs <strong>${rowB.dataset.durationStr}</strong></span>
      `;
    }
    if (qcOpenLink) {
      qcOpenLink.href = `/compare?a=${rowA.dataset.runId}&b=${rowB.dataset.runId}`;
    }
  }

  qcClearBtn?.addEventListener('click', () => {
    pinnedRunIds.length = 0;
    renderQuickCompareDock();
  });

  // Pareto Inspector Hover & Click
  const piStatus = document.getElementById('pi-status');
  const piTitle = document.getElementById('pi-title');
  const piStats = document.getElementById('pi-stats');
  const piLink = document.getElementById('pi-link') as HTMLAnchorElement | null;

  function inspectParetoNode(el: HTMLElement | SVGElement) {
    const runId = el.getAttribute('data-pareto-run');
    if (!runId) return;
    if (piStatus) piStatus.textContent = el.getAttribute('data-pareto-status') ?? '';
    if (piTitle) piTitle.textContent = el.getAttribute('data-pareto-title') ?? '';
    if (piStats) {
      piStats.textContent = `${el.getAttribute('data-pareto-dur')} · ${el.getAttribute('data-pareto-cost')} · ${el.getAttribute('data-pareto-tokens')} tok (${el.getAttribute('data-pareto-cache')} cache)`;
    }
    if (piLink) piLink.href = `/runs/${runId}`;
    document.querySelectorAll<HTMLElement>('[data-pareto-item]').forEach((li) => {
      li.classList.toggle('is-active', li.dataset.paretoItem === runId);
    });
  }

  document.querySelectorAll<SVGElement>('[data-pareto-run]').forEach((node) => {
    node.addEventListener('mouseenter', () => inspectParetoNode(node));
    node.addEventListener('focus', () => inspectParetoNode(node));
  });

  document.querySelectorAll<HTMLElement>('[data-pareto-item]').forEach((li) => {
    li.addEventListener('mouseenter', () => {
      const matchingNode = document.querySelector<SVGElement>(
        `[data-pareto-run="${li.dataset.paretoItem}"]`
      );
      if (matchingNode) inspectParetoNode(matchingNode);
    });
  });

  hydrateFromUrlState();
  applyLeaderboardUpdate();

  function updateDetailVisibility() {
    const expanded = Boolean(showTelemetry?.checked);
    table?.classList.toggle('show-telemetry', expanded);
  }

  showTelemetry?.addEventListener('change', updateDetailVisibility);
  updateDetailVisibility();

  searchInput?.addEventListener('input', updateLeaderboard);
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      if (searchInput.value) {
        searchInput.value = '';
        updateLeaderboard();
      }
      searchInput.blur();
    }
  });
  harnessFilter?.addEventListener('change', updateLeaderboard);
  providerFilter?.addEventListener('change', updateLeaderboard);
  pricingLensSelect?.addEventListener('change', updateLeaderboard);
  sortSelect?.addEventListener('change', () => {
    setSortDirButtonState(defaultSortDirs[sortSelect.value] ?? 'desc');
    updateLeaderboard();
  });
  sortDirBtn?.addEventListener('click', () => {
    setSortDirButtonState(sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc');
    updateLeaderboard();
  });
  resetFiltersBtn?.addEventListener('click', resetAllControls);
  emptyResetBtn?.addEventListener('click', resetAllControls);

  window.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const active = document.activeElement;
    if (
      active &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.tagName === 'SELECT' ||
        (active as HTMLElement).isContentEditable)
    ) {
      return;
    }
    e.preventDefault();
    searchInput?.focus();
    searchInput?.select();
  });

  sortableHeaders.forEach((th) => {
    const btn = th.querySelector<HTMLButtonElement>('.sort-header-btn');
    (btn ?? th).addEventListener('click', () => {
      const col = th.dataset.sortCol;
      if (!col || !sortSelect || !sortDirBtn) return;

      if (sortSelect.value === col) {
        const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
        setSortDirButtonState(nextDir);
      } else {
        sortSelect.value = col;
        const defaultDir = defaultSortDirs[col] ?? 'desc';
        setSortDirButtonState(defaultDir);
      }
      updateLeaderboard();
    });
  });

  // Delegated click handler for Peek and + Diff buttons inside table
  tbody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const peekBtn = target.closest<HTMLElement>('[data-peek-toggle]');
    if (peekBtn) {
      e.stopPropagation();
      const runId = peekBtn.dataset.peekToggle;
      if (runId) toggleForensicDrawer(runId);
      return;
    }
    const pinBtn = target.closest<HTMLButtonElement>('[data-pin-run]');
    if (pinBtn) {
      e.stopPropagation();
      const runId = pinBtn.dataset.pinRun;
      if (!runId) return;
      const existingIdx = pinnedRunIds.indexOf(runId);
      if (existingIdx !== -1) {
        pinnedRunIds.splice(existingIdx, 1);
      } else {
        if (pinnedRunIds.length >= 2) pinnedRunIds.shift();
        pinnedRunIds.push(runId);
      }
      renderQuickCompareDock();
      return;
    }
  });

  // Row click navigation
  document.querySelectorAll<HTMLTableRowElement>('tr.run-row').forEach((row) => {
    row.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button, input, label')) return;
      const selection = window.getSelection();
      if (selection && selection.toString().trim().length > 0) return;

      const href = row.dataset.href;
      if (!href) return;

      if (e.metaKey || e.ctrlKey) {
        window.open(href, '_blank', 'noopener');
        return;
      }
      window.location.href = href;
    });
  });
</script>
