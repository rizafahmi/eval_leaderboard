---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  BENCHMARK_STAGES,
  BENCHMARK_PLAN,
  BENCHMARK_README_CONTRACT,
  BENCHMARK_PROMPT,
} from '../data/benchmark';
import {
  formatCost,
  formatDuration,
  formatHarnessName,
} from '../utils/format';
import { analyzeAndRankRuns } from '../utils/telemetry';

const runs = await getCollection('runs', ({ data }) => data.published !== false);
const sortedRuns = analyzeAndRankRuns(runs);
const topRun = sortedRuns[0];
const topRunPlan = topRun?.plan;

const aboutSections = [
  { id: 'stages', label: 'S1–S7 Slices' },
  { id: 'end-product', label: 'Target CLI Output' },
  { id: 'judging', label: 'Evaluation Rubric' },
  { id: 'plan-spec', label: 'PLAN.md' },
  { id: 'contract-spec', label: 'V1 Contract' },
  { id: 'prompt-spec', label: 'PROMPT.md' },
];

interface InlineSegment {
  type: 'text' | 'code' | 'link';
  value: string;
  href?: string;
}

function parseInlineSegments(input: string): InlineSegment[] {
  const segments: InlineSegment[] = [];
  const pattern =
    /`([^`]+)`|\[([^\]]+)\]\(([^)]+)\)|(@[A-Z]+\.md)|\b(ceil\(p \* count\)|--help)\b/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = pattern.exec(input)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ type: 'text', value: input.slice(lastIndex, match.index) });
    }
    if (match[1] !== undefined) {
      segments.push({ type: 'code', value: match[1] });
    } else if (match[2] !== undefined && match[3] !== undefined) {
      segments.push({
        type: 'link',
        value: match[2],
        href: match[3].startsWith('README.md') ? '#contract-spec' : match[3],
      });
    } else if (match[4] !== undefined) {
      segments.push({ type: 'code', value: match[4] });
    } else if (match[5] !== undefined) {
      segments.push({ type: 'code', value: match[5] });
    }
    lastIndex = pattern.lastIndex;
  }

  if (input.length > lastIndex) {
    segments.push({ type: 'text', value: input.slice(lastIndex) });
  }
  return segments;
}

interface PlanBlock {
  kind: 'h3' | 'h4' | 'p' | 'task';
  text: string;
  checked?: boolean;
  lead?: string;
  body?: string;
}

const planBlocks: PlanBlock[] = BENCHMARK_PLAN.split(/\n\n+/).map((raw) => {
  const trimmed = raw.trim();
  if (trimmed.startsWith('# ')) {
    return { kind: 'h3', text: trimmed.replace(/^#\s+/, '') };
  }
  if (trimmed.startsWith('## ')) {
    return { kind: 'h4', text: trimmed.replace(/^##\s+/, '') };
  }
  const taskMatch = trimmed.match(/^- \[(x| )\] \*\*([^*]+)\*\*\s*([\s\S]*)$/);
  if (taskMatch) {
    return {
      kind: 'task',
      checked: taskMatch[1] === 'x',
      lead: taskMatch[2].trim(),
      body: taskMatch[3].replace(/\s*\n\s*/g, ' ').trim(),
      text: '',
    };
  }
  return { kind: 'p', text: trimmed.replace(/\s*\n\s*/g, ' ') };
});

const [contractSynopsisRaw, contractBulletsRaw = ''] = BENCHMARK_README_CONTRACT.split(/\n\n+/);
const contractSynopsisLines = contractSynopsisRaw.trim().split('\n');
const contractBullets: string[] = [];
for (const line of contractBulletsRaw.split('\n')) {
  if (line.startsWith('- ')) {
    contractBullets.push(line.slice(2).trim());
  } else if (contractBullets.length > 0) {
    contractBullets[contractBullets.length - 1] += ' ' + line.trim();
  }
}

const promptParagraphs = BENCHMARK_PROMPT.split(/\n\n+/).map((block) =>
  block.replace(/\s*\n\s*/g, ' ').trim()
);
const sampleEndProductOutput = `$ mix deps.get
$ mix escript.build
$ ./cb --help
$ mix test

$ ./cb https://example.com/
Target: https://example.com/
Elapsed: 5.02 s
Started: 50
HTTP responses: 49 (200: 48, 503: 1)
Transport failures: 1
Latency (HTTP responses): p50 38 ms, p95 91 ms`;
---

<BaseLayout
  title="About This Evaluation"
  description="Riza Fahmi’s personal coding-agent evaluation on an Elixir/OTP CLI task using outside-in TDD. Methodology, specifications, and why results may differ for other stacks."
  activeNav="about"
>
  <div class="about-quiet">
    <header class="about-masthead" aria-labelledby="about-hero-heading">
      <div class="about-masthead-main">
        <h1 id="about-hero-heading" class="headline-two-tone">
          My stack.<br />
          <span class="muted">My field notes.</span>
        </h1>
        <p class="hero-subtitle">
          I’m <a href="https://rizafahmi.com" class="prose-link">Riza Fahmi</a>.
          Capy Bench is my personal coding-agent evaluation, built around my chosen stack and
          workflow: Elixir/OTP, a command-line HTTP tool, and outside-in TDD.
        </p>
        <p class="hero-subtitle" id="evaluation-scope">
          A different language, framework, project, or way of working may produce different
          results—even a different ranking. Read these as field notes to guide your own
          experiments, not a universal verdict on which agent is best.
        </p>
      </div>

      <details class="reading-disclosure about-parameters">
        <summary>The task at a glance</summary>
        <p class="hero-subtitle">
          Each run builds <code>./cb</code>, a bounded HTTP benchmark CLI for macOS and Linux.
          Agents receive the same starter repository and work through seven stages, from the
          first executable to a verified foreground <code>Ctrl-C</code> exit.
        </p>
      <dl class="about-spec-strip" aria-label="Benchmark specification parameters">
        <div class="about-spec-param">
          <dt>Protocol</dt>
          <dd>
            <strong class="mono">S1–S7</strong>
            <span class="about-spec-note">Outside-In TDD slices</span>
          </dd>
        </div>
        <div class="about-spec-param">
          <dt>Window &amp; Timeout</dt>
          <dd>
            <strong class="mono">5s / 2s</strong>
            <span class="about-spec-note">Pacing window &amp; per-GET cap</span>
          </dd>
        </div>
        <div class="about-spec-param">
          <dt>Rate Cap</dt>
          <dd>
            <strong class="mono">&le; 50 GETs</strong>
            <span class="about-spec-note">&ge; 100 ms spacing (10 req/s)</span>
          </dd>
        </div>
        <div class="about-spec-param">
          <dt>Target Runtime</dt>
          <dd>
            <strong class="mono">Elixir / OTP</strong>
            <span class="about-spec-note">Standalone escript <code>./cb</code></span>
          </dd>
        </div>
      </dl>
      </details>
    </header>

    <div class="reading-doc-shell">
      <aside class="v1-doc-rail" aria-label="Specification navigation">
        <nav aria-label="On this page" class="v1-toc-box" id="about-jump-bar">
          <p class="v1-toc-title">On this page</p>
          <div class="v1-toc-list" id="about-jump-links">
            {aboutSections.map((sec) => (
              <a href={`#${sec.id}`} class="detail-jump-link">
                {sec.label}
              </a>
            ))}
          </div>
        </nav>
      </aside>

      <div class="reading-doc-spine section-grid">
        <section class="doc-section col-12" id="stages" aria-labelledby="stages-heading">
          <div class="doc-section-header">
            <h2 id="stages-heading" class="card-heading headline-two-tone">
              The Implementation Slices{' '}
              <span class="muted">/ Preparation &amp; S1–S7</span>
            </h2>
            <span class="doc-section-meta">Preparation + 7 sequential checkpoints</span>
          </div>
          <p class="section-lead">
            With <strong>Preparation</strong> (establishing the <code>README.md</code> contract)
            already checked off, agents complete <code>S1</code> through <code>S7</code> in order.
            Within each slice, agents write one failing behavior test at a time, implement only what
            passes it, keep <code>./cb</code> runnable after <code>S1</code>, simplify after each
            green step, and record verification commands and blockers beneath each task in{' '}
            <code>PLAN.md</code>.
          </p>

          <ol class="stage-spec-grid" role="list">
            <li id="stage-prep" class="stage-spec-card stage-spec-card-prep">
              <div class="stage-spec-gutter">
                <span class="stage-id-badge is-prep">PREP</span>
                <span class="stage-check-count">Completed before the run</span>
              </div>
              <div class="stage-spec-body">
                <h3 class="stage-spec-title">
                  <span class="visually-hidden">PREP: </span>Establish README Contract
                </h3>
                <p class="stage-spec-desc">
                  Move the V1 CLI product contract and example output into <code>README.md</code> and
                  link to it from <code>PLAN.md</code> without retaining a duplicate.
                </p>
                <details class="reading-disclosure stage-checks">
                  <summary>What gets checked</summary>
                <ul class="stage-deliverables-list" role="list">
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>V1 CLI product contract documented in README.md</span>
                  </li>
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>Duplicate contract text replaced with README link in PLAN.md</span>
                  </li>
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>Baseline repository state committed before S1 dispatch</span>
                  </li>
                </ul>
                </details>
              </div>
            </li>
            {BENCHMARK_STAGES.map((stage) => (
              <li id={`stage-${stage.id.toLowerCase()}`} class="stage-spec-card">
                <div class="stage-spec-gutter">
                  <span class="stage-id-badge">{stage.id}</span>
                  <span class="stage-check-count">{stage.deliverables.length} checks</span>
                </div>
                <div class="stage-spec-body">
                  <h3 class="stage-spec-title">
                    <span class="visually-hidden">{stage.id}: </span>{stage.title}
                  </h3>
                  <p class="stage-spec-desc">{stage.description}</p>
                  <details class="reading-disclosure stage-checks">
                    <summary>{stage.deliverables.length} things to check</summary>
                  <ul class="stage-deliverables-list" role="list">
                    {stage.deliverables.map((item) => (
                      <li class="stage-deliverable-item">
                        <span class="check-box-mark" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                  </details>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <details class="reading-disclosure doc-disclosure col-12" id="end-product">
          <summary>What does the finished CLI look like?</summary>
          <section class="doc-section disclosure-body" aria-labelledby="end-product-heading">
          <div class="doc-section-header">
            <h2 id="end-product-heading" class="card-heading headline-two-tone">
              Glimpse of the End Product{' '}
              <span class="muted">/ Target CLI Output</span>
            </h2>
            <div class="card-title-group">
              <button
                type="button"
                class="btn btn-sm btn-secondary"
                id="copy-cli-btn"
                data-prompt={sampleEndProductOutput}
              >
                Copy CLI Transcript
              </button>
              <span id="copy-cli-status" class="visually-hidden" role="status" aria-live="polite"></span>
            </div>
          </div>
          <p class="section-body-copy">
            A completed run produces the <code>./cb</code> escript executable that paces single-flight
            GET requests over a 5-second window, enforces a 2-second per-request total timeout,
            calculates completed-response <code>p50</code>/<code>p95</code> latencies via{' '}
            <code>ceil(p * count)</code>, and handles foreground <code>Ctrl-C</code> gracefully:
          </p>
          <pre class="terminal-box cli-transcript-box"><code><span class="cli-cmd-line"><span class="cli-prompt">$</span> mix deps.get</span>
<span class="cli-cmd-line"><span class="cli-prompt">$</span> mix escript.build</span>
<span class="cli-cmd-line"><span class="cli-prompt">$</span> ./cb --help</span>
<span class="cli-cmd-line"><span class="cli-prompt">$</span> mix test</span>

<span class="cli-cmd-line"><span class="cli-prompt">$</span> ./cb https://example.com/</span>
<span class="cli-out-line"><span class="cli-out-key">Target:</span> https://example.com/</span>
<span class="cli-out-line"><span class="cli-out-key">Elapsed:</span> 5.02 s</span>
<span class="cli-out-line"><span class="cli-out-key">Started:</span> 50</span>
<span class="cli-out-line"><span class="cli-out-key">HTTP responses:</span> 49 (200: 48, 503: 1)</span>
<span class="cli-out-line"><span class="cli-out-key">Transport failures:</span> 1</span>
<span class="cli-out-line"><span class="cli-out-key">Latency (HTTP responses):</span> p50 38 ms, p95 91 ms</span></code></pre>
        </section>
        </details>

        <section class="doc-section col-12" id="judging" aria-labelledby="judging-heading">
          <div class="doc-section-header">
            <h2 id="judging-heading" class="card-heading headline-two-tone">
              How Runs Are Judged{' '}
              <span class="muted">/ Evaluation Rubric</span>
            </h2>
            <span class="mono doc-section-meta">Verification &amp; scoring rules</span>
          </div>
          <dl class="judging-list">
            <div class="judging-row">
              <dt class="judging-term">Slice Verification &amp; Release Checks</dt>
              <dd class="judging-desc">
                Deterministic unit tests verify exact timing rules and percentile ranks, while actual
                CLI tests run against local HTTP/HTTPS servers. After <code>S7</code>, agents must
                verify <code>mix format --check-formatted</code>, <code>mix test</code>, the
                documented lint command, live HTTP/HTTPS runs, and foreground-terminal{' '}
                <code>Ctrl-C</code>.
              </dd>
            </div>
            <div class="judging-row">
              <dt class="judging-term">Cache Hit Rate Formula</dt>
              <dd class="judging-desc">
                Calculated as <code>cacheRead / (input + cacheRead + cacheWrite)</code>. High prompt
                cache reuse substantially lowers cost across long multi-step TDD runs.
              </dd>
            </div>
            <div class="judging-row">
              <dt class="judging-term">V1 Discipline &amp; Non-Goals</dt>
              <dd class="judging-desc">
                V1 excludes configurable duration/timeout/concurrency, distributed execution, non-GET
                workloads, and dashboards — agents are expected to avoid speculative architecture.
              </dd>
            </div>
          </dl>
        </section>

        <details class="reading-disclosure doc-disclosure col-12" id="plan-spec">
          <summary>Read the implementation plan · PLAN.md</summary>
          <section class="doc-section disclosure-body" aria-labelledby="plan-spec-heading">
          <div class="doc-section-header">
            <h2 id="plan-spec-heading" class="card-heading headline-two-tone">
              Implementation Plan{' '}
              <span class="muted">/ PLAN.md</span>
            </h2>
            <div class="card-title-group">
              <span class="mono doc-file-path">starter-repo/PLAN.md</span>
              <button
                type="button"
                class="btn btn-sm btn-secondary"
                id="copy-plan-btn"
                data-prompt={BENCHMARK_PLAN}
              >
                Copy PLAN.md
              </button>
              <span id="copy-plan-status" class="visually-hidden" role="status" aria-live="polite"></span>
            </div>
          </div>
          <p class="section-body-copy">
            Checked into the root of the benchmark starter repository. Agents update task checkboxes
            (<code>[x]</code>) and record verification commands and blockers in place as they progress
            from <code>S1</code> through <code>S7</code>.
          </p>

          <article class="spec-sheet terminal-box" aria-label="PLAN.md specification content">
            {planBlocks.map((block) => {
              if (block.kind === 'h3') {
                return <h3 class="spec-doc-h3">{block.text}</h3>;
              }
              if (block.kind === 'h4') {
                return <h4 class="spec-doc-h4">{block.text}</h4>;
              }
              if (block.kind === 'task') {
                return (
                  <div class:list={['spec-task-row', { 'is-checked': block.checked }]}>
                    <span class="mono spec-task-box" aria-hidden="true">
                      {block.checked ? '[x]' : '[ ]'}
                    </span>
                    <p class="spec-task-copy">
                      <strong class="spec-task-lead">{block.lead}</strong>{' '}
                      {parseInlineSegments(block.body || '').map((seg) =>
                        seg.type === 'code' ? (
                          <code>{seg.value}</code>
                        ) : seg.type === 'link' ? (
                          <a href={seg.href} class="prose-link">
                            {seg.value}
                          </a>
                        ) : (
                          seg.value
                        )
                      )}
                    </p>
                  </div>
                );
              }
              return (
                <p class="spec-doc-p">
                  {parseInlineSegments(block.text).map((seg) =>
                    seg.type === 'code' ? (
                      <code>{seg.value}</code>
                    ) : seg.type === 'link' ? (
                      <a href={seg.href} class="prose-link">
                        {seg.value}
                      </a>
                    ) : (
                      seg.value
                    )
                  )}
                </p>
              );
            })}
          </article>
        </section>
        </details>

        <details class="reading-disclosure doc-disclosure col-12" id="contract-spec">
          <summary>Read the CLI contract · README.md</summary>
          <section class="doc-section disclosure-body" aria-labelledby="contract-spec-heading">
          <div class="doc-section-header">
            <h2 id="contract-spec-heading" class="card-heading headline-two-tone">
              V1 CLI Product Contract{' '}
              <span class="muted">/ README.md</span>
            </h2>
            <div class="card-title-group">
              <span class="mono doc-file-path">starter-repo/README.md</span>
              <button
                type="button"
                class="btn btn-sm btn-secondary"
                id="copy-contract-btn"
                data-prompt={BENCHMARK_README_CONTRACT}
              >
                Copy V1 Contract
              </button>
              <span id="copy-contract-status" class="visually-hidden" role="status" aria-live="polite"></span>
            </div>
          </div>
          <p class="section-body-copy">
            Established during the pre-checked Preparation step as the single source of truth for
            invocation syntax, 5-second pacing, 2-second timeout cancellation, output formatting, and
            exit codes (<code>0</code>, <code>1</code>, <code>2</code>, <code>130</code>).
          </p>

          <article class="spec-sheet terminal-box" aria-label="README.md V1 CLI contract content">
            <pre class="spec-synopsis"><code>{contractSynopsisLines.join('\n')}</code></pre>
            <ul class="spec-contract-list" role="list">
              {contractBullets.map((bullet) => (
                <li class="spec-contract-item">
                  {parseInlineSegments(bullet).map((seg) =>
                    seg.type === 'code' ? <code>{seg.value}</code> : seg.value
                  )}
                </li>
              ))}
            </ul>
          </article>
        </section>
        </details>

        <details class="reading-disclosure doc-disclosure col-12" id="prompt-spec">
          <summary>Read the exact agent prompt · PROMPT.md</summary>
          <section class="doc-section disclosure-body" aria-labelledby="prompt-spec-heading">
          <div class="doc-section-header">
            <h2 id="prompt-spec-heading" class="card-heading headline-two-tone">
              Agent Dispatch Prompt{' '}
              <span class="muted">/ PROMPT.md</span>
            </h2>
            <div class="card-title-group">
              <span class="mono doc-file-path">starter-repo/PROMPT.md</span>
              <button
                type="button"
                class="btn btn-sm btn-secondary"
                id="copy-prompt-btn"
                data-prompt={BENCHMARK_PROMPT}
              >
                Copy PROMPT.md
              </button>
              <span id="copy-prompt-status" class="visually-hidden" role="status" aria-live="polite"></span>
            </div>
          </div>
          <p class="section-body-copy">
            Exact initial prompt dispatched to every Coding Harness + Model pair to initiate the
            autonomous Outside-In TDD loop across <code>S1</code>–<code>S7</code>.
          </p>

          <article class="spec-sheet terminal-box" aria-label="PROMPT.md dispatch prompt content">
            {promptParagraphs.map((para) => (
              <p class="spec-doc-p">
                {parseInlineSegments(para).map((seg) =>
                  seg.type === 'code' ? <code>{seg.value}</code> : seg.value
                )}
              </p>
            ))}
          </article>
        </section>
        </details>
      </div>
    </div>

    <nav aria-label="Benchmark navigation" class="detail-bottom-pager">
      <a href="/" class="card card-interactive detail-pager-card">
        <span class="detail-pager-dir">Back to the runs</span>
        <strong class="detail-pager-title">
          Explore all {sortedRuns.length} published runs
        </strong>
        <span class="mono detail-pager-meta">
          Compare results, then follow a run’s field notes.
        </span>
      </a>
      {topRun && topRunPlan ? (
        <a href={`/runs/${topRun.id}`} class="card card-interactive detail-pager-card">
          <span class="detail-pager-dir">A run to explore</span>
          <strong class="detail-pager-title">
            {formatHarnessName(topRun.data.codingHarness)} / {topRun.data.model}
            {topRun.data.effort ? ` (${topRun.data.effort})` : ''}
          </strong>
          <span class="mono detail-pager-meta">
            {topRunPlan.completed}/{topRunPlan.total} slices &middot; {formatCost(topRun.data.costUsd)} &middot;{' '}
            {formatDuration(topRun.data.durationMinutes)}
          </span>
        </a>
      ) : null}
    </nav>
  </div>
</BaseLayout>

<style>
  /* Calm reading surfaces; exact specifications remain available on demand. */
  .about-quiet {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding-block-start: 3.5rem;
    font-variant-numeric: tabular-nums;
  }

  .about-quiet .headline-two-tone {
    text-wrap: balance;
  }

  /* Softer inline code inside long-form reading paragraphs */
  .about-quiet :is(p, li, dd) code {
    font-weight: 400;
    font-size: 0.84em;
    padding: 0.08rem 0.32rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle-color);
    color: var(--text-primary);
  }

  /* --------------------------------------------------------------------------
     1. MASTHEAD & SPECIFICATION PARAMETER STRIP
     -------------------------------------------------------------------------- */
  .about-masthead {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block-end: 0;
    border-block-end: none;
  }

  .about-masthead-main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-masthead .headline-two-tone {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.3;
    max-inline-size: 34ch;
    margin: 0;
  }

  .about-masthead .hero-subtitle {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-inline-size: 66ch;
    margin: 0;
  }

  .about-spec-strip {
    margin: 0;
    padding-block: 0.75rem 1.5rem;
    border-block-start: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 1.5rem;
  }

  .about-spec-param {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .about-spec-param dt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .about-spec-param dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }


  .about-spec-note {
    font-size: 0.8125rem;
