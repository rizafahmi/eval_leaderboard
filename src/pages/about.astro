---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  BENCHMARK_STAGES,
  BENCHMARK_PLAN,
  BENCHMARK_README_CONTRACT,
  BENCHMARK_PROMPT,
} from '../data/benchmark';

const sampleEndProductOutput = `$ mix deps.get
$ mix escript.build
$ ./cb --help
$ mix test

$ ./cb https://example.com/
Target: https://example.com/
Elapsed: 5.02 s
Started: 50
HTTP responses: 49 (200: 48, 503: 1)
Transport failures: 1
Latency (HTTP responses): p50 38 ms, p95 91 ms`;
---

<BaseLayout
  title="About & Benchmark Plan"
  description="Methodology, V1 CLI product contract, and S1–S7 Outside-In TDD implementation slices for the Capy Bench Elixir/OTP coding agent benchmark."
  activeNav="about"
>
  <section class="hero-card" aria-labelledby="about-hero-heading">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span aria-hidden="true">📋</span>
        <span>METHODOLOGY & V1 CLI CONTRACT</span>
      </div>
      <h1 id="about-hero-heading" class="hero-title">About Capy Bench</h1>
      <p class="hero-subtitle">
        Capy Bench is a backend-focused Elixir/OTP command-line HTTP benchmark (<code>./cb</code>)
        for macOS and Linux. Every Coding Harness + Model pair is given the same starter repository
        (<code>README.md</code> V1 product contract, <code>PLAN.md</code> implementation slices{' '}
        <code>S1</code>–<code>S7</code>, and <code>AGENTS.md</code> conventions) and judged on how
        cleanly it builds, tests, and verifies the CLI, plus how much time, tokens, and money it
        consumes.
      </p>
      <p class="hero-note">
        <span class="badge badge-provider">Backend &amp; CLI Focus</span>
        <span>
          Zero UI/frontend boilerplate — evaluates core backend engineering fundamentals including
          HTTP/TLS networking, local test servers, monotonic rate pacing, in-flight timeout
          cancellation, and OS signal handling (<code>Ctrl-C</code>).
        </span>
      </p>
    </div>

    <dl class="hero-stats">
      <div class="stat-box">
        <dt class="stat-label">Checkpoints</dt>
        <dd class="stat-value">S1–S7</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Window / Timeout</dt>
        <dd class="stat-value">5s / 2s</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Max Requests</dt>
        <dd class="stat-value">50</dd>
      </div>
      <div class="stat-box">
        <dt class="stat-label">Target Stack</dt>
        <dd class="stat-value">Elixir</dd>
      </div>
    </dl>
  </section>

  <div class="section-grid">
    <!-- The S1 - S7 Implementation Plan -->
    <section class="card col-12" id="stages" aria-labelledby="stages-heading">
      <div class="card-title">
        <h2 id="stages-heading" class="card-heading">1. The Implementation Slices (S1 – S7)</h2>
        <span class="badge badge-effort">Preparation + 7 Slices • Outside-In TDD</span>
      </div>
      <p class="section-lead">
        With <strong>Preparation</strong> (establishing the <code>README.md</code> contract) already
        checked off, agents complete <code>S1</code> through <code>S7</code> in order. Within each
        slice, agents add one failing behavior test at a time, implement only what passes it, keep{' '}
        <code>./cb</code> runnable after <code>S1</code>, simplify after each green step, and record
        verification commands and blockers beneath each task in <code>PLAN.md</code>.
      </p>

      <ol class="stage-spec-grid" role="list">
        {
          BENCHMARK_STAGES.map((stage) => (
            <li class="stage-spec-card">
              <div class="stage-spec-header">
                <span class="stage-pill done">{stage.id}</span>
                <h3 class="stage-spec-title">{stage.title}</h3>
              </div>
              <p class="stage-spec-desc">{stage.description}</p>
              <ul class="stage-deliverables-list" role="list">
                {stage.deliverables.map((item) => (
                  <li class="stage-deliverable-item">
                    <span class="check-icon" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Glimpse of the End Product -->
    <section class="card col-6" aria-labelledby="end-product-heading">
      <div class="card-title">
        <h2 id="end-product-heading" class="card-heading">2. Glimpse of the End Product</h2>
        <span class="badge badge-success">Target State</span>
      </div>
      <p class="section-body-copy">
        A completed run produces the <code>./cb</code> escript executable that paces single-flight
        GET requests over a 5-second window, enforces a 2-second per-request total timeout,
        calculates completed-response <code>p50</code>/<code>p95</code> latencies via{' '}
        <code>ceil(p * count)</code>, and handles foreground <code>Ctrl-C</code> gracefully (exit{' '}
        <code>130</code> with a partial summary):
      </p>
      <pre class="terminal-box" tabindex="0"><code>{sampleEndProductOutput}</code></pre>
    </section>

    <!-- How We Judge & Calculate Metrics -->
    <section class="card col-6" aria-labelledby="judging-heading">
      <div class="card-title">
        <h2 id="judging-heading" class="card-heading">3. How Runs Are Judged</h2>
      </div>
      <dl class="judging-list">
        <div class="kpi-box">
          <dt class="kpi-label">Slice Verification & Release Checks</dt>
          <dd class="judging-desc">
            Deterministic unit tests verify exact timing rules and percentile ranks, while actual CLI
            tests run against local HTTP/HTTPS servers. After <code>S7</code>, agents must verify{' '}
            <code>mix format --check-formatted</code>, <code>mix test</code>, the documented lint
            command, live HTTP/HTTPS runs, and foreground-terminal <code>Ctrl-C</code>.
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">Cache Hit Rate Formula</dt>
          <dd class="judging-desc">
            Calculated as <code>CacheRead / (input + cacheRead + cacheWrite)</code>. High cache hit
            rates drastically reduce cost on long multi-step agent runs.
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">V1 Discipline & Non-Goals</dt>
          <dd class="judging-desc">
            V1 excludes configurable duration/timeout/concurrency, distributed execution, non-GET
            workloads, and dashboards — agents are expected to avoid premature architecture and keep
            telemetry fields optional across CLI, Desktop, and Web harnesses.
          </dd>
        </div>
      </dl>
    </section>

    <!-- Implementation Plan (PLAN.md) -->
    <section class="card col-12 deferred-section" aria-labelledby="plan-spec-heading">
      <div class="card-title">
        <h2 id="plan-spec-heading" class="card-heading">
          4. Implementation Plan (PLAN.md)
        </h2>
        <div>
          <button
            type="button"
            class="copy-btn"
            id="copy-plan-btn"
            data-prompt={BENCHMARK_PLAN}
          >
            Copy PLAN.md
          </button>
          <span
            id="copy-plan-status"
            class="visually-hidden"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre class="terminal-box" tabindex="0"><code>{BENCHMARK_PLAN}</code></pre>
    </section>

    <!-- V1 CLI Contract (README.md) -->
    <section class="card col-12 deferred-section" aria-labelledby="contract-spec-heading">
      <div class="card-title">
        <h2 id="contract-spec-heading" class="card-heading">
          5. V1 CLI Product Contract (README.md)
        </h2>
        <div>
          <button
            type="button"
            class="copy-btn"
            id="copy-contract-btn"
            data-prompt={BENCHMARK_README_CONTRACT}
          >
            Copy V1 Contract
          </button>
          <span
            id="copy-contract-status"
            class="visually-hidden"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre class="terminal-box" tabindex="0"><code>{BENCHMARK_README_CONTRACT}</code></pre>
    </section>

    <!-- Instructions Given to the Coding Agent (PROMPT.md) -->
    <section class="card col-12 deferred-section" aria-labelledby="prompt-spec-heading">
      <div class="card-title">
        <h2 id="prompt-spec-heading" class="card-heading">
          6. Instructions Given to the Coding Agent (PROMPT.md)
        </h2>
        <div>
          <button
            type="button"
            class="copy-btn"
            id="copy-prompt-btn"
            data-prompt={BENCHMARK_PROMPT}
          >
            Copy PROMPT.md
          </button>
          <span
            id="copy-prompt-status"
            class="visually-hidden"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre class="terminal-box" tabindex="0"><code>{BENCHMARK_PROMPT}</code></pre>
    </section>
  </div>
</BaseLayout>

<script>
  function bindCopyButton(btnId: string, statusId: string, label: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const status = document.getElementById(statusId) as HTMLElement | null;
    btn?.addEventListener('click', async () => {
      const text = btn.dataset.prompt;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = `✓ Copied ${label}!`;
        if (status) status.textContent = `${label} copied to clipboard.`;
        setTimeout(() => {
          btn.textContent = original;
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        btn.textContent = 'Failed to copy';
        if (status) status.textContent = `Failed to copy ${label}.`;
      }
    });
  }

  bindCopyButton('copy-plan-btn', 'copy-plan-status', 'PLAN.md');
  bindCopyButton('copy-contract-btn', 'copy-contract-status', 'V1 Contract');
  bindCopyButton('copy-prompt-btn', 'copy-prompt-status', 'PROMPT.md');
</script>
