---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BENCHMARK_STAGES, BENCHMARK_PROMPT } from '../data/benchmark';

const sampleEndProductOutput = `$ mix test
Running ExUnit with seed: 40812, max_cases: 16
...........................................................
Finished in 1.8 seconds (0.4s async, 1.4s sync)
59 tests, 0 failures

$ ./capy_runner --mode auto --print "Run healthcheck"
[09:15:02.110] [S1] Supervision tree started (workers: 4)
[09:15:02.450] [S2] Task spawned pid=#PID<0.241.0> os_pid=48192
[09:15:03.012] [S4] Event stream flushed -> records/events.jsonl (14 events)
✓ Completed in 902ms (0 orphan processes)`;
---

<BaseLayout title="About & Benchmark Plan" activeNav="about">
  <section class="hero-card" aria-labelledby="about-hero-heading">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span aria-hidden="true">📋</span>
        <span>METHODOLOGY & TASK SPECIFICATION</span>
      </div>
      <h1 id="about-hero-heading" class="hero-title">About Capy Bench</h1>
      <p class="hero-subtitle">
        Capy Bench is a personal coding agent evaluation suite. Instead of isolated trivia
        snippets, every Coding Harness + Model pair is given the exact same multi-stage
        engineering plan (<code>S1</code>–<code>S7</code>) and judged on how far it gets, how
        cleanly its tests pass, and how much time, tokens, and money it consumes.
      </p>
    </div>
  </section>

  <div class="section-grid">
    <!-- The S1 - S7 Implementation Plan -->
    <section class="card col-12" id="stages" aria-labelledby="stages-heading">
      <div class="card-title">
        <h2 id="stages-heading" class="card-heading">1. The Plan Checkpoints (S1 – S7)</h2>
        <span class="badge badge-effort">7 Stages • 59 Tests</span>
      </div>
      <p class="section-lead">
        Agents are instructed to work sequentially through seven checkpoints. Each stage builds on
        the previous one, testing process orchestration, OS signal handling (<code>SIGINT</code> /
        <code>Ctrl-C</code>), persistence, and fault recovery.
      </p>

      <ol class="stage-spec-grid" role="list">
        {
          BENCHMARK_STAGES.map((stage) => (
            <li class="stage-spec-card">
              <div class="stage-spec-header">
                <span class="stage-pill done">{stage.id}</span>
                <h3 class="stage-spec-title">{stage.title}</h3>
              </div>
              <p class="stage-spec-desc">{stage.description}</p>
              <ul class="stage-deliverables-list" role="list">
                {stage.deliverables.map((item) => (
                  <li class="stage-deliverable-item">
                    <span class="check-icon" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Glimpse of the End Product -->
    <section class="card col-6" aria-labelledby="end-product-heading">
      <div class="card-title">
        <h2 id="end-product-heading" class="card-heading">2. Glimpse of the End Product</h2>
        <span class="badge badge-success">Target State</span>
      </div>
      <p class="section-body-copy">
        A completed run produces a working CLI and supervised process engine that passes all 59
        automated test assertions, handles <code>Ctrl-C</code> gracefully without leaking background
        processes, and outputs structured JSONL telemetry:
      </p>
      <pre class="terminal-box" tabindex="0"><code>{sampleEndProductOutput}</code></pre>
    </section>

    <!-- How We Judge & Calculate Metrics -->
    <section class="card col-6" aria-labelledby="judging-heading">
      <div class="card-title">
        <h2 id="judging-heading" class="card-heading">3. How Runs Are Judged</h2>
      </div>
      <dl class="judging-list">
        <div class="kpi-box">
          <dt class="kpi-label">Plan Completion (S1–S7) & Tests</dt>
          <dd class="judging-desc">
            Each checkpoint is marked <code>[x]</code> only when its implementation and unit/integration
            tests pass cleanly.
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">Cache Hit Rate Formula</dt>
          <dd class="judging-desc">
            Calculated as <code>CacheRead / (input + cacheRead + cacheWrite)</code>. High cache hit
            rates drastically reduce cost on long multi-step agent runs.
          </dd>
        </div>

        <div class="kpi-box">
          <dt class="kpi-label">Interface Agnostic (CLI / Desktop / Web)</dt>
          <dd class="judging-desc">
            Whether an agent runs headless in a CLI, inside a Desktop IDE, or in a Web sandbox, all
            detailed telemetry fields are optional so every run can be logged.
          </dd>
        </div>
      </dl>
    </section>

    <!-- Instructions Given to the Coding Agent (PROMPT.md) -->
    <section class="card col-12 deferred-section" aria-labelledby="prompt-spec-heading">
      <div class="card-title">
        <h2 id="prompt-spec-heading" class="card-heading">
          4. Instructions Given to the Coding Agent (PROMPT.md)
        </h2>
        <div>
          <button
            type="button"
            class="copy-btn"
            id="copy-prompt-btn"
            data-prompt={BENCHMARK_PROMPT}
          >
            Copy PROMPT.md
          </button>
          <span
            id="copy-prompt-status"
            class="visually-hidden"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre class="terminal-box" tabindex="0"><code>{BENCHMARK_PROMPT}</code></pre>
    </section>
  </div>
</BaseLayout>

<script>
  const copyPromptBtn = document.getElementById('copy-prompt-btn') as HTMLButtonElement | null;
  const copyPromptStatus = document.getElementById('copy-prompt-status') as HTMLElement | null;
  copyPromptBtn?.addEventListener('click', async () => {
    const promptText = copyPromptBtn.dataset.prompt;
    if (!promptText) return;
    try {
      await navigator.clipboard.writeText(promptText);
      const original = copyPromptBtn.textContent;
      copyPromptBtn.textContent = '✓ Copied PROMPT.md!';
      if (copyPromptStatus) copyPromptStatus.textContent = 'PROMPT.md copied to clipboard.';
      setTimeout(() => {
        copyPromptBtn.textContent = original;
        if (copyPromptStatus) copyPromptStatus.textContent = '';
      }, 1800);
    } catch {
      copyPromptBtn.textContent = 'Failed to copy';
      if (copyPromptStatus) copyPromptStatus.textContent = 'Failed to copy PROMPT.md.';
    }
  });
</script>
