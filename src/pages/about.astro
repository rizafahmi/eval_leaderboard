    border-width: 1px;
    border-color: var(--border-strong-color);
    padding: 1.15rem 1.35rem;
  }
</style>

<script>
  function bindCopyButton(btnId: string, statusId: string, label: string, sectionId?: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const status = document.getElementById(statusId) as HTMLElement | null;
    if (!btn) return;

    const originalText = btn.textContent?.trim() || `Copy ${label}`;
    let resetTimer: number | undefined;

    btn.addEventListener('click', async () => {
      const text = btn.dataset.prompt;
      if (!text) return;

      if (resetTimer !== undefined) {
        window.clearTimeout(resetTimer);
      }

      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = `✓ Copied ${label}`;
        btn.classList.add('btn-acid');
        btn.classList.remove('btn-secondary');
        if (status) status.textContent = `${label} copied to clipboard.`;
        resetTimer = window.setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('btn-acid');
          btn.classList.add('btn-secondary');
          if (status) status.textContent = '';
          resetTimer = undefined;
        }, 1800);
      } catch {
        const container =
          (sectionId ? document.getElementById(sectionId) : null) ?? btn.closest('section');
        const codeEl = container?.querySelector<HTMLElement>('.terminal-box');
        if (codeEl && window.getSelection) {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(codeEl);
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        btn.textContent = 'Select text: press ⌘C / Ctrl+C';
        btn.classList.remove('btn-acid');
        btn.classList.add('btn-secondary');
        if (status) {
          status.textContent = `Clipboard unavailable. Selected ${label} text—press Ctrl+C or Command+C to copy.`;
        }
        resetTimer = window.setTimeout(() => {
          btn.textContent = originalText;
          if (status) status.textContent = '';
          resetTimer = undefined;
        }, 3200);
      }
    });
  }

  bindCopyButton('copy-cli-btn', 'copy-cli-status', 'CLI Transcript', 'end-product');
  bindCopyButton('copy-plan-btn', 'copy-plan-status', 'PLAN.md', 'plan-spec');
  bindCopyButton('copy-contract-btn', 'copy-contract-status', 'V1 Contract', 'contract-spec');
  bindCopyButton('copy-prompt-btn', 'copy-prompt-status', 'PROMPT.md', 'prompt-spec');

  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#about-jump-bar .detail-jump-link')
  );
  const supportsScrollTargetGroup =
    typeof CSS !== 'undefined' && CSS.supports('scroll-target-group: auto');

  if (supportsScrollTargetGroup) {
    const syncAriaCurrent = () => {
      const currentLink = document.querySelector<HTMLAnchorElement>(
        '#about-jump-bar .detail-jump-link:target-current'
      );
      if (!currentLink) return;
      for (const link of jumpLinks) {
        link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
      }
    };
    syncAriaCurrent();
    document.addEventListener('scrollend', syncAriaCurrent);
  } else if (jumpLinks.length > 0 && 'IntersectionObserver' in window) {
    const sections = document.querySelectorAll<HTMLElement>('.section-grid > section[id]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            for (const link of jumpLinks) {
              const isActive = link.getAttribute('href') === `#${id}`;
              link.classList.toggle(':target-current', isActive);
              link.setAttribute('aria-current', isActive ? 'true' : 'false');
            }
          }
        }
      },
      { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
    );
    for (const section of sections) {
      observer.observe(section);
    }
  }
</script>
