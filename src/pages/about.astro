  }

  /* Terminal Boxes & Bottom Pager */
  .about-quiet .terminal-box {
    border-width: 1px;
    border-color: var(--border-strong-color);
  }

  .about-quiet .detail-pager-card {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-strong-color);
    padding: 1.15rem 1.35rem;
  }
</style>

<script>
  const copyLabels: Record<string, string> = {
    'copy-cli-btn': 'CLI Transcript',
    'copy-plan-btn': 'PLAN.md',
    'copy-contract-btn': 'V1 Contract',
    'copy-prompt-btn': 'PROMPT.md',
  };

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const btn = target.closest<HTMLButtonElement>(
      '[id="copy-cli-btn"], [id="copy-plan-btn"], [id="copy-contract-btn"], [id="copy-prompt-btn"]'
    );
    if (!btn) return;

    const label = copyLabels[btn.id] || 'Snippet';
    const originalText = btn.dataset.origLabel || btn.textContent?.trim() || `Copy ${label}`;
    btn.dataset.origLabel = originalText;
    const text = btn.dataset.prompt;
    if (!text) return;

    const status = btn.parentElement?.querySelector<HTMLElement>('[role="status"]');
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = `Copied ${label}`;
      btn.classList.add('btn-acid');
      btn.classList.remove('btn-secondary');
      if (status) status.textContent = `${label} copied to clipboard.`;
      window.setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('btn-acid');
        btn.classList.add('btn-secondary');
        if (status) status.textContent = '';
      }, 1800);
    } catch {
      const container = btn.closest('section, .v2-dossier-right');
      const codeEl = container?.querySelector<HTMLElement>('.terminal-box');
      if (codeEl && window.getSelection) {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(codeEl);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      btn.textContent = 'Select text: press ⌘C / Ctrl+C';
      if (status) {
        status.textContent = `Clipboard unavailable. Selected ${label} text—press Ctrl+C or Command+C to copy.`;
      }
      window.setTimeout(() => {
        btn.textContent = originalText;
        if (status) status.textContent = '';
      }, 3200);
    }
  });
  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#about-jump-bar .detail-jump-link')
  );
  const supportsScrollTargetGroup =
    typeof CSS !== 'undefined' && CSS.supports('scroll-target-group: auto');

  if (supportsScrollTargetGroup) {
    const syncAriaCurrent = () => {
      const currentLink = document.querySelector<HTMLAnchorElement>(
        '#about-jump-bar .detail-jump-link:target-current'
      );
      if (!currentLink) return;
      for (const link of jumpLinks) {
        link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
      }
    };
    syncAriaCurrent();
    document.addEventListener('scrollend', syncAriaCurrent);
  } else if (jumpLinks.length > 0 && 'IntersectionObserver' in window) {
    const sections = document.querySelectorAll<HTMLElement>('.v1-doc-spine section[id]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            for (const link of jumpLinks) {
              const isActive = link.getAttribute('href') === `#${id}`;
              link.classList.toggle(':target-current', isActive);
              link.setAttribute('aria-current', isActive ? 'true' : 'false');
            }
          }
        }
      },
      { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
    );
    for (const section of sections) {
      observer.observe(section);
    }
  }
</script>
