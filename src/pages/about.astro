</style>

<script>
  const copyLabels: Record<string, string> = {
    'copy-cli-btn': 'CLI Transcript',
    'copy-plan-btn': 'PLAN.md',
    'copy-contract-btn': 'V1 Contract',
    'copy-prompt-btn': 'PROMPT.md',
  };

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const btn = target.closest<HTMLButtonElement>(
      '[id="copy-cli-btn"], [id="copy-plan-btn"], [id="copy-contract-btn"], [id="copy-prompt-btn"]'
    );
    if (!btn) return;

    const label = copyLabels[btn.id] || 'Snippet';
    const originalText = btn.dataset.origLabel || btn.textContent?.trim() || `Copy ${label}`;
    btn.dataset.origLabel = originalText;
    const text = btn.dataset.prompt;
    if (!text) return;

    const status = btn.parentElement?.querySelector<HTMLElement>('[role="status"]');
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = `Copied ${label}`;
      btn.classList.add('btn-acid');
      btn.classList.remove('btn-secondary');
      if (status) status.textContent = `${label} copied to clipboard.`;
      window.setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('btn-acid');
        btn.classList.add('btn-secondary');
        if (status) status.textContent = '';
      }, 1800);
    } catch {
      const container = btn.closest('section');
      const codeEl = container?.querySelector<HTMLElement>('.terminal-box');
      if (codeEl && window.getSelection) {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(codeEl);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      btn.textContent = 'Select text: press ⌘C / Ctrl+C';
      if (status) {
        status.textContent = `Clipboard unavailable. Selected ${label} text—press Ctrl+C or Command+C to copy.`;
      }
      window.setTimeout(() => {
        btn.textContent = originalText;
        if (status) status.textContent = '';
      }, 3200);
    }
  });
  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#about-jump-bar .detail-jump-link')
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('.reading-doc-spine > [id]')
  );

  if (jumpLinks.length > 0 && sections.length > 0) {
    const updateActiveSection = () => {
      const triggerY = window.innerHeight * 0.28;
      let activeId = sections[0].id;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= triggerY) {
          activeId = sec.id;
        }
      }
      for (const link of jumpLinks) {
        const isActive = link.getAttribute('href') === `#${activeId}`;
        link.setAttribute('aria-current', isActive ? 'true' : 'false');
      }
    };
    updateActiveSection();
    document.addEventListener('scroll', updateActiveSection, { passive: true });
    window.addEventListener('resize', updateActiveSection, { passive: true });
  }
</script>
