---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import { createCssVariablesTheme } from 'shiki';
import {
  BENCHMARK_STAGES,
  BENCHMARK_PLAN,
  BENCHMARK_README_CONTRACT,
  BENCHMARK_PROMPT,
} from '../data/benchmark';
import {
  formatCost,
  formatDuration,
  formatHarnessName,
  getPlanStats,
} from '../utils/format';

const runs = await getCollection('runs', ({ data }) => data.published !== false);
const sortedRuns = [...runs].sort((a, b) => {
  const planA = getPlanStats(a.data.planCompletion);
  const planB = getPlanStats(b.data.planCompletion);
  if (planB.ratio !== planA.ratio) return planB.ratio - planA.ratio;
  const testsA =
    a.data.tests && a.data.tests.total > 0 ? a.data.tests.passed / a.data.tests.total : -1;
  const testsB =
    b.data.tests && b.data.tests.total > 0 ? b.data.tests.passed / b.data.tests.total : -1;
  if (testsB !== testsA) return testsB - testsA;
  if (a.data.costUsd !== b.data.costUsd) return a.data.costUsd - b.data.costUsd;
  return a.data.durationMinutes - b.data.durationMinutes;
});
const topRun = sortedRuns[0];
const topRunPlan = topRun ? getPlanStats(topRun.data.planCompletion) : null;

const aboutSections = [
  { id: 'stages', label: 'S1–S7 Slices' },
  { id: 'end-product', label: 'Target CLI Output' },
  { id: 'judging', label: 'Evaluation Rubric' },
  { id: 'plan-spec', label: 'PLAN.md' },
  { id: 'contract-spec', label: 'V1 Contract' },
  { id: 'prompt-spec', label: 'PROMPT.md' },
];

const neoAcidCodeTheme = createCssVariablesTheme({
  name: 'neo-acid',
  variablePrefix: '--code-',
});

const shikiResetTransformer = {
  pre(node: { properties: Record<string, unknown> }) {
    delete node.properties.style;
  },
};

const sampleEndProductOutput = `$ mix deps.get
$ mix escript.build
$ ./cb --help
$ mix test

$ ./cb https://example.com/
Target: https://example.com/
Elapsed: 5.02 s
Started: 50
HTTP responses: 49 (200: 48, 503: 1)
Transport failures: 1
Latency (HTTP responses): p50 38 ms, p95 91 ms`;
---

<BaseLayout
  title="About & Benchmark Plan"
  description="Methodology, V1 CLI product contract, and S1–S7 Outside-In TDD implementation slices for the Capy Bench Elixir/OTP coding agent benchmark."
  activeNav="about"
>
  <div class="about-quiet about-v1">
      <header class="v1-masthead" aria-labelledby="about-hero-heading">
        <div>
          <h1 id="about-hero-heading" class="headline-two-tone">
            One starter repo, seven TDD slices.{' '}
            <span class="muted">
              The rest is the coding agent shipping a real HTTP benchmark CLI.
            </span>
          </h1>
          <p class="hero-subtitle">
            Capy Bench is a backend-focused Elixir/OTP command-line HTTP benchmark (<code>./cb</code>)
            for macOS and Linux. Every Coding Harness + Model pair receives the identical starter
            repository (<code>README.md</code> V1 product contract, <code>PLAN.md</code> implementation
            slices <code>S1</code>–<code>S7</code>, and <code>AGENTS.md</code> conventions) and is judged
            on completion, test rigor, wall-clock duration, token efficiency, and cost.
          </p>
        </div>

        <div class="v1-masthead-note">
          <div class="row-wrap">
            <span class="hl hl-sky">Backend &amp; CLI Focus</span>
            <span class="hl hl-mint">Outside-In TDD</span>
          </div>
          <p class="hero-callout-copy" style="margin: 0; font-size: 0.875rem;">
            Zero UI/frontend boilerplate — evaluates HTTP/TLS networking, local test servers,
            monotonic rate pacing, in-flight timeout cancellation, and foreground <code>Ctrl-C</code>.
          </p>
        </div>
      </header>

      <div class="v1-doc-shell">
        <aside class="v1-doc-rail" aria-label="Specification navigation and parameters">
          <nav aria-label="On this page" class="v1-toc-box" id="about-jump-bar">
            <h2 class="v1-toc-title">Specification Index</h2>
            <div class="v1-toc-list" id="about-jump-links">
              {aboutSections.map((sec) => (
                <a href={`#${sec.id}`} class="mono detail-jump-link">
                  {sec.label}
                </a>
              ))}
            </div>
          </nav>

          <dl class="v1-rail-stats" aria-label="Benchmark specification parameters">
            <div class="card stat-card">
              <dt class="section-kicker">CHECKPOINTS</dt>
              <dd class="stat-value">S1–S7</dd>
              <dd class="stat-meta">7 TDD slices</dd>
            </div>
            <div class="card stat-card">
              <dt class="section-kicker">WINDOW / CAP</dt>
              <dd class="stat-value">5s / 2s</dd>
              <dd class="stat-meta">Pacing &amp; timeout</dd>
            </div>
            <div class="card stat-card">
              <dt class="section-kicker">MAX REQUESTS</dt>
              <dd class="stat-value">50</dd>
              <dd class="stat-meta">10 req/s GET</dd>
            </div>
            <div class="card stat-card">
              <dt class="section-kicker">RUNTIME</dt>
              <dd class="stat-value">Elixir</dd>
              <dd class="stat-meta">OTP escript ./cb</dd>
            </div>
          </dl>
        </aside>

        <div class="v1-doc-spine section-grid">
          <section class="card col-12" id="stages" aria-labelledby="stages-heading">
            <div class="card-title">
              <div class="card-title-group">
                <h2 id="stages-heading" class="card-heading headline-two-tone">
                  The Implementation Slices{' '}<span class="muted">/ Preparation &amp; S1–S7</span>
                </h2>
              </div>
              <span class="badge-static">Preparation + 7 Slices · Outside-In TDD</span>
            </div>
            <p class="section-lead">
              With <strong>Preparation</strong> (establishing the <code>README.md</code> contract) already
              checked off, agents complete <code>S1</code> through <code>S7</code> in order. Within each
              slice, agents add one failing behavior test at a time, implement only what passes it, keep{' '}
              <code>./cb</code> runnable after <code>S1</code>, simplify after each green step, and record
              verification commands and blockers beneath each task in <code>PLAN.md</code>.
            </p>

            <ol class="stage-spec-grid" role="list">
              <li id="stage-prep" class="stage-spec-card stage-spec-card-prep">
                <div class="stage-spec-header">
                  <div class="stage-spec-meta">
                    <span class="hl hl-mint" aria-hidden="true">PREP</span>
                    <span class="badge-static">Pre-checked [x]</span>
                  </div>
                  <h3 class="stage-spec-title">
                    <span class="visually-hidden">PREP: </span>Establish README Contract
                  </h3>
                </div>
                <p class="stage-spec-desc">
                  Move the V1 CLI product contract and example output into README.md and link to it from
                  PLAN.md without retaining a duplicate.
                </p>
                <ul class="stage-deliverables-list" role="list">
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>V1 CLI product contract documented in README.md</span>
                  </li>
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>Duplicate contract text replaced with README link in PLAN.md</span>
                  </li>
                  <li class="stage-deliverable-item">
                    <span class="check-box-mark" aria-hidden="true"></span>
                    <span>Baseline repository state committed before S1 dispatch</span>
                  </li>
                </ul>
              </li>
              {BENCHMARK_STAGES.map((stage) => (
                <li id={`stage-${stage.id.toLowerCase()}`} class="stage-spec-card">
                  <div class="stage-spec-header">
                    <div class="stage-spec-meta">
                      <span class="hl hl-violet" aria-hidden="true">{stage.id}</span>
                      <span class="badge-static">{stage.deliverables.length} checks</span>
                    </div>
                    <h3 class="stage-spec-title">
                      <span class="visually-hidden">{stage.id}: </span>{stage.title}
                    </h3>
                  </div>
                  <p class="stage-spec-desc">{stage.description}</p>
                  <ul class="stage-deliverables-list" role="list">
                    {stage.deliverables.map((item) => (
                      <li class="stage-deliverable-item">
                        <span class="check-box-mark" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </section>

          <div class="v1-dual-row col-12">
            <section class="card" id="end-product" aria-labelledby="end-product-heading">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="end-product-heading" class="card-heading headline-two-tone">
                    Glimpse of the End Product{' '}<span class="muted">/ Target CLI Output</span>
                  </h2>
                </div>
                <div class="card-title-group">
                  <button
                    type="button"
                    class="btn btn-sm btn-secondary"
                    id="copy-cli-btn"
                    data-prompt={sampleEndProductOutput}
                  >
                    Copy CLI Transcript
                  </button>
                  <span id="copy-cli-status" class="visually-hidden" role="status" aria-live="polite"></span>
                </div>
              </div>
              <p class="section-body-copy">
                A completed run produces the <code>./cb</code> escript executable that paces single-flight
                GET requests over a 5-second window, enforces a 2-second per-request total timeout,
                calculates completed-response <code>p50</code>/<code>p95</code> latencies via{' '}
                <code>ceil(p * count)</code>, and handles foreground <code>Ctrl-C</code> gracefully:
              </p>
              <Code
                code={sampleEndProductOutput}
                lang="bash"
                theme={neoAcidCodeTheme}
                wrap={null}
                transformers={[shikiResetTransformer]}
                class="terminal-box"
              />
            </section>

            <section class="card" id="judging" aria-labelledby="judging-heading">
              <div class="card-title">
                <div class="card-title-group">
                  <h2 id="judging-heading" class="card-heading headline-two-tone">
                    How Runs Are Judged{' '}<span class="muted">/ Evaluation Rubric</span>
                  </h2>
                </div>
                <span class="badge-static">Verification Rules</span>
              </div>
              <dl class="judging-list">
                <div class="callout callout-mint">
                  <dt class="section-kicker callout-kicker">SLICE VERIFICATION &amp; RELEASE CHECKS</dt>
                  <dd class="judging-desc">
                    Deterministic unit tests verify exact timing rules and percentile ranks, while actual CLI
                    tests run against local HTTP/HTTPS servers. After <code>S7</code>, agents must verify{' '}
                    <code>mix format --check-formatted</code>, <code>mix test</code>, the documented lint
                    command, live HTTP/HTTPS runs, and foreground-terminal <code>Ctrl-C</code>.
                  </dd>
                </div>
                <div class="callout callout-sky">
                  <dt class="section-kicker callout-kicker">CACHE HIT RATE FORMULA</dt>
                  <dd class="judging-desc">
                    Calculated as <code>CacheRead / (input + cacheRead + cacheWrite)</code>. High cache hit
                    rates drastically reduce cost on long multi-step agent runs.
                  </dd>
                </div>
                <div class="callout callout-magenta">
                  <dt class="section-kicker callout-kicker">V1 DISCIPLINE &amp; NON-GOALS</dt>
                  <dd class="judging-desc">
                    V1 excludes configurable duration/timeout/concurrency, distributed execution, non-GET
                    workloads, and dashboards — agents are expected to avoid premature architecture.
                  </dd>
                </div>
              </dl>
            </section>
          </div>

          <section class="card col-12 deferred-section" id="plan-spec" aria-labelledby="plan-spec-heading">
            <div class="card-title">
              <div class="card-title-group">
                <h2 id="plan-spec-heading" class="card-heading headline-two-tone">
                  Implementation Plan{' '}<span class="muted">/ PLAN.md</span>
                </h2>
              </div>
              <div class="card-title-group">
                <span class="badge-static">starter-repo/PLAN.md</span>
                <button type="button" class="btn btn-sm btn-secondary" id="copy-plan-btn" data-prompt={BENCHMARK_PLAN}>
                  Copy PLAN.md
                </button>
                <span id="copy-plan-status" class="visually-hidden" role="status" aria-live="polite"></span>
              </div>
            </div>
            <p class="section-body-copy">
              Checked into the root of the benchmark starter repository. Agents update task checkboxes
              (<code>[x]</code>) and record verification commands and blockers in place as they progress
              from <code>S1</code> through <code>S7</code>.
            </p>
            <Code
              code={BENCHMARK_PLAN}
              lang="markdown"
              theme={neoAcidCodeTheme}
              wrap={null}
              transformers={[shikiResetTransformer]}
              class="terminal-box terminal-box-wrap"
            />
          </section>

          <section class="card col-12 deferred-section" id="contract-spec" aria-labelledby="contract-spec-heading">
            <div class="card-title">
              <div class="card-title-group">
                <h2 id="contract-spec-heading" class="card-heading headline-two-tone">
                  V1 CLI Product Contract{' '}<span class="muted">/ README.md</span>
                </h2>
              </div>
              <div class="card-title-group">
                <span class="badge-static">starter-repo/README.md</span>
                <button type="button" class="btn btn-sm btn-secondary" id="copy-contract-btn" data-prompt={BENCHMARK_README_CONTRACT}>
                  Copy V1 Contract
                </button>
                <span id="copy-contract-status" class="visually-hidden" role="status" aria-live="polite"></span>
              </div>
            </div>
            <p class="section-body-copy">
              Established during the pre-checked Preparation step as the single source of truth for
              invocation syntax, 5-second pacing, 2-second timeout cancellation, output formatting, and
              exit codes (<code>0</code>, <code>2</code>, <code>130</code>).
            </p>
            <Code
              code={BENCHMARK_README_CONTRACT}
              lang="markdown"
              theme={neoAcidCodeTheme}
              wrap={null}
              transformers={[shikiResetTransformer]}
              class="terminal-box terminal-box-wrap"
            />
          </section>

          <section class="card col-12 deferred-section" id="prompt-spec" aria-labelledby="prompt-spec-heading">
            <div class="card-title">
              <div class="card-title-group">
                <h2 id="prompt-spec-heading" class="card-heading headline-two-tone">
                  Agent Dispatch Prompt{' '}<span class="muted">/ PROMPT.md</span>
                </h2>
              </div>
              <div class="card-title-group">
                <span class="badge-static">starter-repo/PROMPT.md</span>
                <button type="button" class="btn btn-sm btn-secondary" id="copy-prompt-btn" data-prompt={BENCHMARK_PROMPT}>
                  Copy PROMPT.md
                </button>
                <span id="copy-prompt-status" class="visually-hidden" role="status" aria-live="polite"></span>
              </div>
            </div>
            <p class="section-body-copy">
              Exact initial prompt dispatched to every Coding Harness + Model pair to initiate the
              autonomous Outside-In TDD loop across <code>S1</code>–<code>S7</code>.
            </p>
            <Code
              code={BENCHMARK_PROMPT}
              lang="markdown"
              theme={neoAcidCodeTheme}
              wrap={null}
              transformers={[shikiResetTransformer]}
              class="terminal-box terminal-box-wrap"
            />
          </section>
        </div>
      </div>

      <nav aria-label="Benchmark navigation" class="detail-bottom-pager">
        <a href="/" class="card card-interactive detail-pager-card">
          <span class="mono detail-pager-dir">← LEADERBOARD TABLE</span>
          <strong class="detail-pager-title">
            Compare All {sortedRuns.length} Verified Agent Runs
          </strong>
          <span class="mono detail-pager-meta">
            Filter &amp; sort S1–S7 completion, test pass rates, token efficiency, and API cost
          </span>
        </a>
        {topRun && topRunPlan ? (
          <a href={`/runs/${topRun.id}`} class="card card-interactive detail-pager-card">
            <span class="mono detail-pager-dir">INSPECT #1 VERIFIED RUN →</span>
            <strong class="detail-pager-title">
              {formatHarnessName(topRun.data.codingHarness)} / {topRun.data.model}
              {topRun.data.effort ? ` (${topRun.data.effort})` : ''}
            </strong>
            <span class="mono detail-pager-meta">
              {topRunPlan.completed}/{topRunPlan.total} slices · {formatCost(topRun.data.costUsd)} ·{' '}
              {formatDuration(topRun.data.durationMinutes)}
            </span>
          </a>
        ) : null}
      </nav>
    </div>
</BaseLayout>

<style>
  /* ==========================================================================
     QUIETER ABOUT & SPECS REFINEMENTS (Neo-Acid Read Restraint)
     Matches index.astro and runs/[id].astro: preserves semantic brand colors
     (--hl-acid, --hl-mint, --hl-sky, --hl-violet, --hl-magenta) for earned
     markers while removing nested box chrome and widening reading measures.
     ========================================================================== */
  .about-quiet {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    padding-block-start: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .about-quiet .headline-two-tone {
    text-wrap: balance;
  }

  .about-quiet .terminal-box {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong-color) var(--bg-surface);
  }

  .about-quiet .check-box-mark {
    display: inline-block;
    inline-size: 0.48rem;
    block-size: 0.48rem;
    background-color: var(--hl-mint);
    margin-block-start: 0.42rem;
    flex-shrink: 0;
  }

  .v1-masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 1.5rem;
    align-items: end;
    padding-block-end: 1.15rem;
    border-block-end: var(--border-frame);
  }

  .v1-masthead .headline-two-tone {
    font-size: clamp(1.45rem, 2.7vw, 2rem);
    margin: 0 0 0.6rem;
  }

  .v1-masthead .hero-subtitle {
    font-size: 0.96875rem;
    line-height: 1.55;
    margin: 0;
    max-inline-size: 68ch;
  }

  .v1-masthead-note {
    border: var(--border-frame);
    background-color: var(--bg-surface);
    padding: 0.95rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .v1-doc-shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .v1-doc-rail {
    position: sticky;
    inset-block-start: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .v1-toc-box {
    border: var(--border-frame);
    background-color: var(--bg-surface);
  }

  .v1-toc-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-block-end: var(--border-frame);
  }

  .v1-toc-list {
    display: flex;
    flex-direction: column;
  }

  .v1-toc-list .detail-jump-link {
    display: block;
    padding: 0.55rem 0.9rem;
    background-color: transparent;
    border: none;
    border-block-end: var(--border-row);
    border-inline-start: 3px solid transparent;
    text-decoration: none;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .v1-toc-list .detail-jump-link:last-child {
    border-block-end: none;
  }

  .v1-toc-list .detail-jump-link:hover,
  .v1-toc-list .detail-jump-link:target-current,
  .v1-toc-list .detail-jump-link.\:target-current {
    background-color: var(--bg-elevated);
    color: var(--text-primary);
    border-inline-start-color: var(--hl-acid);
  }

  :global([data-theme="light"]) .v1-toc-list .detail-jump-link:target-current,
  :global([data-theme="light"]) .v1-toc-list .detail-jump-link.\:target-current {
    border-inline-start-color: var(--accent-cobalt);
  }

  .v1-rail-stats {
    border: var(--border-frame);
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: transparent;
  }

  .v1-rail-stats .stat-card {
    padding: 0.75rem;
    border: none;
    border-block-end: var(--border-row);
    border-inline-end: var(--border-row);
    background-color: transparent;
    gap: 0.25rem;
  }

  .v1-rail-stats .stat-card:nth-child(2n) {
    border-inline-end: none;
  }

  .v1-rail-stats .stat-card:nth-last-child(-n + 2) {
    border-block-end: none;
  }

  .v1-rail-stats .stat-value {
    font-size: 1.15rem;
  }

  .v1-doc-spine {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    min-inline-size: 0;
  }

  .v1-dual-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .v1-dual-row > .card {
    background-color: transparent;
    padding: 1.35rem 1.5rem;
  }

  .v1-doc-spine .deferred-section .terminal-box {
    max-block-size: 28rem;
    overflow-y: auto;
  }

  @media (max-width: 980px) {
    .v1-masthead,
    .v1-doc-shell,
    .v1-dual-row {
      grid-template-columns: 1fr;
    }

    .v1-doc-rail {
      position: static;
    }
  }
  /* Section Cards & Widen Full-Width Lead Paragraphs */
  .about-quiet .section-grid > .card {
    background-color: transparent;
    padding: 1.35rem 1.5rem;
  }

  .about-quiet .section-grid > .card .card-heading {
    font-size: 1.25rem;
  }

  .about-quiet .card-title .badge-static {
    border: none;
    background-color: transparent;
    color: var(--text-muted);
    padding: 0;
  }

  .about-quiet .card-title .btn-secondary {
    border-width: 1px;
    border-color: var(--border-strong-color);
  }

  .about-quiet .section-lead,
  .about-quiet .section-body-copy {
    max-inline-size: none;
  }

  /* 2-Column Editorial Split for Spec Sections (PLAN.md, README.md, PROMPT.md)
     Eliminates the dead right half inside ~80ch hard-wrapped <pre> blocks by placing
     the section header, description, and copy action in a left sidebar column
     and giving the right column to the terminal box without soft-wrap orphans. */
  @media (width >= 62em) {
    .about-quiet #plan-spec,
    .about-quiet #contract-spec,
    .about-quiet #prompt-spec {
      display: grid;
      grid-template-columns: minmax(15rem, 17.5rem) minmax(0, 1fr);
      column-gap: 1.5rem;
      row-gap: 0.75rem;
      align-items: start;
    }

    .about-quiet :is(#plan-spec, #contract-spec, #prompt-spec) > .card-title {
      grid-column: 1;
      flex-direction: column;
      align-items: flex-start;
      border-block-end: none;
      padding-block-end: 0;
      gap: 0.65rem;
    }

    .about-quiet :is(#plan-spec, #contract-spec, #prompt-spec) > .section-body-copy {
      grid-column: 1;
      margin: 0;
    }

    .about-quiet :is(#plan-spec, #contract-spec, #prompt-spec) > .terminal-box {
      grid-column: 2;
      grid-row: 1 / span 3;
      inline-size: 100%;
      font-size: 0.75rem;
      padding-inline: 1rem;
    }
  }

  /* Unified 8-Card Stage Matrix (PREP + S1–S7) */
  .about-quiet .stage-spec-grid {
    gap: 0;
    border: 1px solid var(--border-strong-color);
    background-color: transparent;
  }

  .about-quiet .stage-spec-card {
    background-color: transparent;
    border: none;
    border-block-end: var(--border-row);
    padding: 1.15rem;
  }

  .about-quiet .stage-spec-card:last-child {
    border-block-end: none;
  }

  @media (width >= 38em) and (width < 68em) {
    .about-quiet .stage-spec-card:nth-child(odd) {
      border-inline-end: var(--border-row);
    }

    .about-quiet .stage-spec-card:nth-last-child(-n + 2) {
      border-block-end: none;
    }
  }

  @media (width >= 68em) {
    .about-quiet .stage-spec-card:not(:nth-child(4n)) {
      border-inline-end: var(--border-row);
    }

    .about-quiet .stage-spec-card:nth-child(n + 5) {
      border-block-end: none;
    }
  }

  .about-quiet .stage-spec-meta .badge-static {
    border: none;
    background-color: transparent;
    color: var(--text-muted);
    padding: 0;
  }

  .about-quiet .stage-spec-meta .hl-violet {
    background-color: transparent;
    color: var(--text-primary);
    border-block-end: 2px solid var(--hl-violet);
    padding: 0.05rem 0.2rem;
  }

  /* Judging Rubric Callouts: clean 3px semantic left rule without outer 2px box */
  .about-quiet .judging-list {
    gap: 0;
    border-block-start: var(--border-row);
  }

  .about-quiet .judging-list .callout {
    border: none;
    border-inline-start: 3px solid var(--border-strong-color);
    border-block-end: var(--border-row);
    background-color: transparent;
    padding: 0.85rem 0 0.85rem 1rem;
  }

  .about-quiet .judging-list .callout:last-child {
    border-block-end: none;
  }

  .about-quiet .judging-list .callout-mint {
    border-inline-start-color: var(--hl-mint);
  }

  .about-quiet .judging-list .callout-sky {
    border-inline-start-color: var(--hl-sky);
  }

  .about-quiet .judging-list .callout-magenta {
