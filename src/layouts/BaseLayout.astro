---
import '@fontsource/unbounded/latin-800.css';
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-700.css';
import '@fontsource/martian-mono/latin-400.css';
import '@fontsource/martian-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'leaderboard' | 'about';
  breadcrumbLabel?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
}

const DEFAULT_DESCRIPTION =
  'Capy Bench — Personal coding agent & LLM benchmark evaluating end-to-end Elixir/OTP CLI engineering (S1–S7) on completion, tests, tokens, and cost.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  activeNav,
  breadcrumbLabel,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'Capy Bench Leaderboard — Personal coding agent and LLM benchmark for Elixir/OTP CLI engineering (S1–S7)',
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://eval.rizafahmi.com')).origin;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = pathname ? `${siteOrigin}${pathname}` : siteOrigin;
const fullTitle = `${title} | Capy Bench`;
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonicalUrl,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Capy Bench',
    url: siteOrigin,
  },
  author: {
    '@type': 'Person',
    name: 'Riza Fahmi',
    url: 'https://rizafahmi.com',
  },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('neo-acid-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) meta.setAttribute('content', theme);
      } catch {}
    </script>
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" content="#121519" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121519" media="(prefers-color-scheme: dark)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Capy Bench" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- X / Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rizafahmi22" />
    <meta name="twitter:creator" content="@rizafahmi22" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "tag": "capy-prefetch",
            "where": { "href_matches": "/*" },
            "eagerness": "eager"
          }
        ],
        "prerender": [
          {
            "tag": "capy-prerender",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <div class="app-shell">
      <header class="app-navbar">
        <a href="/" class="app-brand">
          <span class="app-brand-mark" aria-hidden="true">
            <span class="mark-cell mark-acid"></span>
            <span class="mark-cell mark-ebony"></span>
            <span class="mark-cell mark-mint"></span>
            <span class="mark-cell mark-violet"></span>
          </span>
          <span>CAPY.BENCH</span>
          <span class="hl hl-acid brand-pill">S1–S7</span>
        </a>

        <nav aria-label="Main">
          <ul class="app-nav-links">
            <li>
              <a
                href="/"
                class:list={['app-nav-item', { 'is-active': activeNav === 'leaderboard' }]}
                aria-current={activeNav === 'leaderboard' ? 'page' : undefined}
              >
                Leaderboard
              </a>
            </li>
            <li>
              <a
                href="/about"
                class:list={['app-nav-item', { 'is-active': activeNav === 'about' }]}
                aria-current={activeNav === 'about' ? 'page' : undefined}
              >
                About &amp; Specs
              </a>
            </li>
          </ul>
        </nav>

        <div class="row-wrap">
          <button
            type="button"
            class="btn btn-sm btn-secondary"
            id="toggle-theme"
            aria-label="Toggle color theme"
          >
            Theme: <span id="theme-label">Dark</span>
          </button>
        </div>
      </header>

      <!-- Sub-nav: Breadcrumbs + Spec Telemetry Bar -->
      <div class="subnav-bar">
        <ol class="app-breadcrumbs" aria-label="Breadcrumb">
          <li><a href="/">eval.rizafahmi.com</a></li>
          <li aria-hidden="true">/</li>
          {
            activeNav === 'leaderboard' ? (
              <li>
                <span class="hl hl-acid">Leaderboard</span>
              </li>
            ) : activeNav === 'about' ? (
              <li>
                <span class="hl hl-violet">About &amp; S1–S7 Contract</span>
              </li>
            ) : (
              <>
                <li>
                  <a href="/">Runs</a>
                </li>
                <li aria-hidden="true">/</li>
                <li>
                  <span class="hl hl-mint">{breadcrumbLabel ?? title}</span>
                </li>
              </>
            )
          }
        </ol>
        <span class="subnav-meta">
          Elixir/OTP CLI · Outside-In TDD · Neo-Acid v1.0
        </span>
      </div>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="app-footer">
        <div class="app-footer-grid">
          <div>
            <a href="/" class="app-brand footer-brand">
              <span class="app-brand-mark" aria-hidden="true">
                <span class="mark-cell mark-acid"></span>
                <span class="mark-cell mark-ebony"></span>
                <span class="mark-cell mark-mint"></span>
                <span class="mark-cell mark-violet"></span>
              </span>
              <span>CAPY.BENCH</span>
            </a>
            <p class="footer-blurb">
              Personal coding agent &amp; LLM evaluation harness tracking end-to-end Elixir/OTP CLI
              engineering across stages S1–S7.
            </p>
            <div class="footer-status">
              <span class="status-dot" aria-hidden="true"></span>
              <span>ALL BENCHMARK TELEMETRY VERIFIED</span>
            </div>
          </div>

          <div class="app-footer-col">
            <span class="section-kicker">NAVIGATION</span>
            <ul>
              <li><a href="/">Leaderboard Table</a></li>
              <li><a href="/about">Methodology &amp; Judging</a></li>
              <li><a href="/about#stages">Slices S1–S7</a></li>
              <li><a href="/about#contract-spec-heading">V1 CLI Contract</a></li>
            </ul>
          </div>

          <div class="app-footer-col">
            <span class="section-kicker">BENCHMARK SLICES</span>
            <ul>
              <li><a href="/about#stages">/cb S1–S2 CLI &amp; HTTP</a></li>
              <li><a href="/about#stages">/cb S3–S4 Pacing &amp; TLS</a></li>
              <li><a href="/about#stages">/cb S5–S6 Timeout &amp; p95</a></li>
              <li><a href="/about#stages">/cb S7 SIGINT Ctrl-C</a></li>
            </ul>
          </div>

          <div class="app-footer-col">
            <span class="section-kicker">COLOPHON</span>
            <ul>
              <li><a href="https://rizafahmi.com">rizafahmi.com</a></li>
              <li><a href="/about#prompt-spec-heading">Agent Prompt (PROMPT.md)</a></li>
              <li><a href="/about#plan-spec-heading">TDD Plan (PLAN.md)</a></li>
              <li><a href="#main-content">Back to top ↑</a></li>
            </ul>
          </div>
        </div>

        <div class="app-footer-colophon">
          <span>capy-bench · single-task field evaluations (S1–S7)</span>
          <span>rizafahmi.com · Neo-Acid Design System</span>
        </div>
      </footer>
    </div>

    <script>
      const html = document.documentElement;
      const toggleBtn = document.getElementById('toggle-theme');
      const themeLabel = document.getElementById('theme-label');
      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');

      function syncThemeUI(theme: string) {
        if (themeLabel) {
          themeLabel.textContent = theme === 'light' ? 'Light' : 'Dark';
        }
        if (metaColorScheme) {
          metaColorScheme.setAttribute('content', theme);
        }
      }

      syncThemeUI(html.getAttribute('data-theme') || 'dark');

      toggleBtn?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        syncThemeUI(next);
        try {
          localStorage.setItem('neo-acid-theme', next);
        } catch {}
      });

      window.addEventListener('storage', (e) => {
        if (e.key === 'neo-acid-theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
          html.setAttribute('data-theme', e.newValue);
          syncThemeUI(e.newValue);
        }
      });
    </script>
  </body>
</html>
