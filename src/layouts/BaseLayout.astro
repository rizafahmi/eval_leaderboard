---
import '@fontsource/unbounded/latin-800.css';
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-700.css';
import '@fontsource/martian-mono/latin-400.css';
import '@fontsource/martian-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'leaderboard' | 'compare' | 'about';
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
}

const DEFAULT_DESCRIPTION =
  'Capy Bench — Personal coding agent & LLM benchmark evaluating end-to-end Elixir/OTP CLI engineering (S1–S7) on completion, tests, tokens, and cost.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  activeNav,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'Capy Bench Leaderboard — Personal coding agent and LLM benchmark for Elixir/OTP CLI engineering (S1–S7)',
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://eval.rizafahmi.com')).origin;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = pathname ? `${siteOrigin}${pathname}` : siteOrigin;
const fullTitle = `${title} | Capy Bench`;
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonicalUrl,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Capy Bench',
    url: siteOrigin,
  },
  author: {
    '@type': 'Person',
    name: 'Riza Fahmi',
    url: 'https://rizafahmi.com',
  },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('neo-acid-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) meta.setAttribute('content', theme);
      } catch {}
    </script>
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" content="#121519" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121519" media="(prefers-color-scheme: dark)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Capy Bench" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- X / Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rizafahmi22" />
    <meta name="twitter:creator" content="@rizafahmi22" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "tag": "capy-prefetch",
            "where": { "href_matches": "/*" },
            "eagerness": "eager"
          }
        ],
        "prerender": [
          {
            "tag": "capy-prerender",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <div class="app-shell">
      <header class="app-navbar">
        <a href="/" class="app-brand">
          <span class="app-brand-mark" aria-hidden="true">
            <span class="mark-cell mark-acid"></span>
            <span class="mark-cell mark-ebony"></span>
            <span class="mark-cell mark-mint"></span>
            <span class="mark-cell mark-violet"></span>
          </span>
          <span>CAPY.BENCH</span>
        </a>

        <nav aria-label="Main">
          <ul class="app-nav-links">
            <li>
              <a
                href="/"
                class:list={[
                  'app-nav-item',
                  { 'is-active': activeNav === 'leaderboard' },
                ]}
                aria-current={activeNav === 'leaderboard' ? (pathname ? 'true' : 'page') : undefined}
              >
                Leaderboard
              </a>
            </li>
            <li>
              <a
                href="/compare"
                class:list={['app-nav-item', { 'is-active': activeNav === 'compare' }]}
                aria-current={activeNav === 'compare' ? 'page' : undefined}
              >
                Compare
              </a>
            </li>
            <li>
              <a
                href="/about"
                class:list={['app-nav-item', { 'is-active': activeNav === 'about' }]}
                aria-current={activeNav === 'about' ? 'page' : undefined}
              >
                About
              </a>
            </li>
          </ul>
        </nav>

        <button
          type="button"
          class="btn btn-sm btn-secondary theme-toggle"
          id="toggle-theme"
          aria-label="Toggle color theme"
        >
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M16.5 12A7 7 0 0 1 8 3.5 7 7 0 1 0 16.5 12Z" />
          </svg>
          <span id="theme-label">Dark</span>
        </button>
      </header>


      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="app-footer">
        <div class="reading-footer">
          <p>Capy Bench <span aria-hidden="true">·</span> Field notes by <a href="https://rizafahmi.com">Riza Fahmi</a></p>
          <nav aria-label="Footer">
            <a href="/about">Methodology &amp; specifications</a>
            <a href="#main-content">Back to top ↑</a>
          </nav>
        </div>
      </footer>
    </div>

    <script>
      const html = document.documentElement;
      const toggleBtn = document.getElementById('toggle-theme');
      const themeLabel = document.getElementById('theme-label');
      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');

      function syncThemeUI(theme: string) {
        if (themeLabel) {
          themeLabel.textContent = theme === 'light' ? 'Light' : 'Dark';
        }
        if (metaColorScheme) {
          metaColorScheme.setAttribute('content', theme);
        }
      }

      syncThemeUI(html.getAttribute('data-theme') || 'dark');

      toggleBtn?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        syncThemeUI(next);
        try {
          localStorage.setItem('neo-acid-theme', next);
        } catch {}
      });

      window.addEventListener('storage', (e) => {
        if (e.key === 'neo-acid-theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
          html.setAttribute('data-theme', e.newValue);
          syncThemeUI(e.newValue);
        }
      });

      function revealHashTarget() {
        if (!window.location.hash) return;
        let id: string;
        try {
          id = decodeURIComponent(window.location.hash.slice(1));
        } catch {
          return;
        }
        const target = document.getElementById(id);
        if (!target) return;
        let element: HTMLElement | null = target;
        while (element) {
          if (element instanceof HTMLDetailsElement) element.open = true;
          element = element.parentElement;
        }
        requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      }

      revealHashTarget();
      window.addEventListener('hashchange', revealHashTarget);
      document.addEventListener('click', (event) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
        if (link?.hash && link.hash === window.location.hash) revealHashTarget();
      });
    </script>
  </body>
</html>
