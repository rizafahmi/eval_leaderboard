---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'leaderboard' | 'about';
}

const {
  title,
  description = 'Capy Bench — Personal Coding Agent & LLM Evaluation Leaderboard',
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Capy Bench</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link">
          <span class="brand-logo" aria-hidden="true">🦫</span>
          <span>Capy Bench</span>
          <span class="brand-tag">v1.0</span>
        </a>
        <nav class="site-nav" aria-label="Main Navigation">
          <a href="/" class:list={['nav-link', { active: activeNav === 'leaderboard' }]}>
            Leaderboard
          </a>
          <a href="/about" class:list={['nav-link', { active: activeNav === 'about' }]}>
            About & Tasks
          </a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>🦫 Capy Bench Leaderboard</strong> — Real-world coding harness & LLM evaluation
          runs.
        </div>
        <div class="mono" style="font-size: 0.78rem;">
          Static Astro + TypeScript • Data in <code>src/content/runs/*.json</code>
        </div>
      </div>
    </footer>
  </body>
</html>
