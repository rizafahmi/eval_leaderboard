---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'leaderboard' | 'about';
}

const {
  title,
  description = 'Capy Bench — Personal Coding Agent & LLM Evaluation Leaderboard',
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <title>{title} | Capy Bench</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "tag": "capy-prefetch",
            "where": { "href_matches": "/*" },
            "eagerness": "eager"
          }
        ],
        "prerender": [
          {
            "tag": "capy-prerender",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link">
          <span class="brand-logo" aria-hidden="true">🦫</span>
          <span>Capy Bench</span>
          <span class="brand-tag">Personal Eval</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a
            href="/"
            class:list={['nav-link', { active: activeNav === 'leaderboard' }]}
            aria-current={activeNav === 'leaderboard' ? 'page' : undefined}
          >
            Leaderboard
          </a>
          <a
            href="/about"
            class:list={['nav-link', { active: activeNav === 'about' }]}
            aria-current={activeNav === 'about' ? 'page' : undefined}
          >
            About & Tasks
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>🦫 Capy Bench Leaderboard</strong> — A personal coding agent & LLM evaluation
          project. Results reflect single-task runs on an opinionated personal benchmark, not a
          scientific or industry-wide study.
        </div>
        <div class="mono footer-meta">
          Personal Code Evaluation • Static Astro + TypeScript
        </div>
      </div>
    </footer>
  </body>
</html>
