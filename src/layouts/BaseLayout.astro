---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'leaderboard' | 'about';
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
}

const DEFAULT_DESCRIPTION =
  'Capy Bench — Personal coding agent & LLM benchmark evaluating end-to-end Elixir/OTP CLI engineering (S1–S7) on completion, tests, tokens, and cost.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  activeNav,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'Capy Bench Leaderboard — Personal coding agent and LLM benchmark for Elixir/OTP CLI engineering (S1–S7)',
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://eval.rizafahmi.com')).origin;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = pathname ? `${siteOrigin}${pathname}` : siteOrigin;
const fullTitle = `${title} | Capy Bench`;
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonicalUrl,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Capy Bench',
    url: siteOrigin,
  },
  author: {
    '@type': 'Person',
    name: 'Riza Fahmi',
    url: 'https://rizafahmi.com',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" content="#c86d51" />
    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & Web App Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Capy Bench" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- X / Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rizafahmi" />
    <meta name="twitter:creator" content="@rizafahmi" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "tag": "capy-prefetch",
            "where": { "href_matches": "/*" },
            "eagerness": "eager"
          }
        ],
        "prerender": [
          {
            "tag": "capy-prerender",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link">
          <span class="brand-logo" aria-hidden="true">🦫</span>
          <span>Capy Bench</span>
          <span class="brand-tag">Personal Eval</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a
            href="/"
            class:list={['nav-link', { active: activeNav === 'leaderboard' }]}
            aria-current={activeNav === 'leaderboard' ? 'page' : undefined}
          >
            Leaderboard
          </a>
          <a
            href="/about"
            class:list={['nav-link', { active: activeNav === 'about' }]}
            aria-current={activeNav === 'about' ? 'page' : undefined}
          >
            About & Tasks
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>🦫 Capy Bench Leaderboard</strong> — A personal coding agent & LLM evaluation
          project. Results reflect single-task runs on an opinionated personal benchmark, not a
          scientific or industry-wide study.
        </div>
      </div>
    </footer>
  </body>
</html>
